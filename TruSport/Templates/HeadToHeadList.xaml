<?xml version="1.0" encoding="UTF-8"?>
<ViewCell xmlns="http://xamarin.com/schemas/2014/forms" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:ff="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms" xmlns:converters="clr-namespace:TruSport.Converters" x:Class="TruSport.Templates.HeadToHeadList">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="FillAndExpand" Padding="8,8,8,8">
                <Grid x:Name="grid" Padding="0,0,0,0"
                      RowSpacing="5"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">
                    <Grid.Resources>
                        <ResourceDictionary>
                            <converters:InverseBooleanConverter x:Key="inverseBooleanConverter"/>
                            <converters:ImageConverter x:Key="imageConverter"/>
                            <converters:ShowScoreConverter x:Key="showScoreConverter"/>
                            <converters:TimeConverter x:Key="timeConverter"/>
                            <converters:TeamNameConverter x:Key="teamNameConverter"/>
                        </ResourceDictionary>
                    </Grid.Resources>
                <Grid.ColumnDefinitions>
                        <!--<ColumnDefinition Width="50"/>-->
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <!--<ColumnDefinition Width="50"/>-->
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="50" />
                        <RowDefinition Height="1" />
                    </Grid.RowDefinitions>
                    <!--<ContentView Grid.ColumnSpan="3" BackgroundColor="{DynamicResource controlHeaderBackgroundColor}" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" />-->
                    <Frame Grid.Row="0" Grid.Column="0" Padding="10,0" HeightRequest="30" CornerRadius="15" HasShadow="False" BackgroundColor="{DynamicResource controlHeaderBackgroundColor}" VerticalOptions="CenterAndExpand" HorizontalOptions="Start">
                    <StackLayout Spacing="5" Padding="5,10"
                                 HorizontalOptions="FillAndExpand"
                                     Orientation="Horizontal">
                            <StackLayout>
                                <Label x:Name="LeagueName"
                                   FontSize="Micro"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                    Text="{Binding League.Name}"/>
                                </StackLayout>
                        </StackLayout>
                        </Frame>
                    <Frame Grid.Row="0" Grid.Column="2" Padding="10,0" HeightRequest="30" CornerRadius="15" HasShadow="False" BackgroundColor="{DynamicResource controlHeaderBackgroundColor}" VerticalOptions="CenterAndExpand" HorizontalOptions="End">
                    <StackLayout Spacing="5" Padding="5,10"
                                 HorizontalOptions="FillAndExpand"
                                     Orientation="Horizontal">
                            <StackLayout>
                                <Label x:Name="MatchDate"
                                   FontSize="Micro"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                    Text="{Binding Date, StringFormat='{0:dd MMM yyyy}'}"/>
                                </StackLayout>
                        </StackLayout>
                        </Frame>
                        <!--<StackLayout Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="EndAndExpand"
                                     Orientation="Horizontal"
                                 Padding="5,10">
                                <Label x:Name="TimeIcon"
                                   FontSize="Small"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                        Text="&#xe904;"
                                       FontFamily="{StaticResource fontFamily}"/>
                            <Label x:Name="TimeLabel"
                                   FontSize="Small"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   IsVisible="{Binding IsPostponedOrCancelled, Converter={StaticResource inverseBooleanConverter}}"
                                   VerticalTextAlignment="End"
                                        Text="{Binding Time, Converter={StaticResource timeConverter}}"/>
                            <Label x:Name="PostponedLabel"
                                   IsVisible="{Binding IsPostponedOrCancelled}"
                                   FontSize="Small"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   VerticalTextAlignment="End"
                                        Text="{Binding PostOrCanc}"/>
                        </StackLayout>-->
                    <!--<StackLayout Grid.Row="1" Grid.Column="0" Padding="5,0" HorizontalOptions="Center" VerticalOptions="Center">
                            <Frame HeightRequest="40" WidthRequest="40" CornerRadius="20" Padding="0" BackgroundColor="{DynamicResource frameBackgroundColor}">
                        <ff:CachedImage Source="{Binding HomeTeam.TeamLogo, Converter={StaticResource imageConverter}}"
                                                        ErrorPlaceholder="ontracklogo.png"
                                        LoadingPlaceholder="ontracklogo.png"
                                                        CacheDuration="50"
                                                        RetryCount="3"
                                                        RetryDelay="600"
                                         Aspect="AspectFit"
                                        HeightRequest="30"
                                                  WidthRequest="30"
                                                        DownsampleToViewSize="True">

                        </ff:CachedImage>
                            </Frame>
                    </StackLayout>-->
                    <!--<StackLayout Grid.Row="1" Grid.Column="4" Padding="5,0" HorizontalOptions="Center" VerticalOptions="Center">
                             <Frame HeightRequest="40" WidthRequest="40" CornerRadius="20" Padding="0" BackgroundColor="{DynamicResource frameBackgroundColor}">
                        <ff:CachedImage Source="{Binding AwayTeam.TeamLogo, Converter={StaticResource imageConverter}}"
                                                        ErrorPlaceholder="ontracklogo.png"
                                        LoadingPlaceholder="ontracklogo.png"
                                                        CacheDuration="50"
                                                        RetryCount="3"
                                                        RetryDelay="600"
                                         Aspect="AspectFit"
                                        HeightRequest="30"
                                                  WidthRequest="30"
                                                        DownsampleToViewSize="True">  
                                        </ff:CachedImage>
                            </Frame>
                    </StackLayout>-->
                            <!--<StackLayout Grid.Row="1" Grid.Column="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                         Orientation="Horizontal"
                                 Padding="5,2"
                                 Spacing="0">
                           <Label 
                                   x:Name="Versus"
                                   FontSize="Small"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                        Text="V"/>
                            </StackLayout>-->
                    <StackLayout Grid.Row="1" Grid.Column="1" VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                         Orientation="Vertical"
                                 Padding="5,2"
                                 Spacing="5">
                            <StackLayout IsVisible="{Binding Match.IsPenalties}" Orientation="Horizontal" HorizontalOptions="Center" >
                            <Label x:Name="HomeTeamPenaltyLabel"
                                   FontSize="Micro"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                        Text="{Binding Match.HomeTeamPenalty, StringFormat='({0}'}"/>
                            <Label 
                                   
                                   FontSize="Micro"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                        Text="-"/>
                            <Label x:Name="AwayTeamPenaltyLabel"
                                   FontSize="Micro"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   FontAttributes="Bold"
                                        Text="{Binding Match.AwayTeamPenalty, StringFormat='{0})'}"/>
                                
                        </StackLayout>
                     <StackLayout Orientation="Horizontal"  HorizontalOptions="Center" >
                            <Label x:Name="HomeTeamScoreLabel"
                                   FontSize="Medium"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                        Text="{Binding Match.HomeTeamScore}"/>
                            <Label 
                                   x:Name="Versus"
                                   FontSize="Small"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                        Text="{Binding Match.HomeTeamScore, Converter={StaticResource showScoreConverter}}" />
                            <Label x:Name="AwayTeamScoreLabel"
                                   FontSize="Medium"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   FontAttributes="Bold"
                                        Text="{Binding Match.AwayTeamScore}"/>
                                
                        </StackLayout>
                    </StackLayout>
                            <StackLayout Grid.Row="1" Grid.Column="0"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="5,2"
                                 Spacing="0">
                                <Label x:Name="HomeTeamAlias" Text="{Binding HomeTeam.Alias}" IsVisible="false"/>
                            <Label x:Name="HomeTeamNameLabel"
                                   HorizontalOptions="EndAndExpand"
                                   HorizontalTextAlignment="End"
                                   FontSize="Small"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                        Text="{Binding HomeTeam.Name, Converter={StaticResource teamNameConverter}, ConverterParameter={x:Reference HomeTeamAlias}}">
                                <Label.FontSize>
                                    <OnPlatform x:TypeArguments="x:Double">  
                        <OnPlatform.Android> 
                            <OnIdiom x:TypeArguments="x:Double" Phone="10"  Tablet="17" /> 
                        </OnPlatform.Android> 
                        <OnPlatform.iOS> 
                            <OnIdiom x:TypeArguments="x:Double"  Phone="11"  Tablet="16" /> 
                        </OnPlatform.iOS> 
                    </OnPlatform> 
                                </Label.FontSize>
                            </Label>
                        </StackLayout>
                            <StackLayout Grid.Row="1" Grid.Column="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="5,2"
                                 Spacing="0">
                                <Label x:Name="AwayTeamAlias" Text="{Binding AwayTeam.Alias}" IsVisible="false"/>
                            <Label x:Name="AwayTeamNameLabel"
                                   HorizontalOptions="StartAndExpand"
                                   HorizontalTextAlignment="Start"
                                   FontSize="Small"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   FontAttributes="Bold"
                                        Text="{Binding AwayTeam.Name, Converter={StaticResource teamNameConverter}, ConverterParameter={x:Reference AwayTeamAlias}}">
                                <Label.FontSize>
                                    <OnPlatform x:TypeArguments="x:Double">  
                        <OnPlatform.Android> 
                            <OnIdiom x:TypeArguments="x:Double" Phone="10"  Tablet="17" /> 
                        </OnPlatform.Android> 
                        <OnPlatform.iOS> 
                            <OnIdiom x:TypeArguments="x:Double"  Phone="11"  Tablet="16" /> 
                        </OnPlatform.iOS> 
                    </OnPlatform> 
                                </Label.FontSize>
                            </Label>
                        </StackLayout>
                    <BoxView HeightRequest="1" BackgroundColor="{DynamicResource borderColor}" Grid.ColumnSpan="3" Grid.Row="2" Opacity="0.3"/>
                        </Grid>
                    </StackLayout>
</ViewCell>
