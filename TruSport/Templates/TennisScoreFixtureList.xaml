<?xml version="1.0" encoding="UTF-8"?>
<ViewCell xmlns="http://xamarin.com/schemas/2014/forms" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:converters="clr-namespace:TruSport.Converters" xmlns:ff="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms" x:Class="TruSport.Templates.TennisScoreFixtureList">
    <ViewCell.View>
        
        <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="FillAndExpand" Padding="8,8,8,8">
            <StackLayout.Resources>
                <converters:SelectedTeamProfileConverter x:Key="selectedPlayerConverter"/>
            </StackLayout.Resources>
            <Label x:Name="SelectedPlayerIDLabel" IsVisible="false" Text="{Binding SelectedPlayerID}"/>
                    <Frame Padding="0" CornerRadius="10" BackgroundColor="Transparent" >
                        <Frame Padding="0" CornerRadius="10" IsClippedToBounds="True" BackgroundColor="{DynamicResource frameBackgroundColor}">
                <Grid x:Name="grid" Padding="0,0,0,0"
                      RowSpacing="5"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">
                    <Grid.Resources>
                        <ResourceDictionary>
                            <converters:InverseBooleanConverter x:Key="inverseBooleanConverter"/>
                            <converters:ImageConverter x:Key="imageConverter"/>
                            <converters:TimeConverter x:Key="timeConverter"/>
                            <converters:TeamNameConverter x:Key="teamNameConverter"/>
                        </ResourceDictionary>
                    </Grid.Resources>
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ContentView Grid.ColumnSpan="3" BackgroundColor="{DynamicResource controlHeaderBackgroundColor}" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" />
                        <StackLayout Grid.Row="0" Grid.Column="0" Spacing="5" Padding="10"
                                 VerticalOptions="EndAndExpand"
                                     HorizontalOptions="StartAndExpand"
                                     Orientation="Horizontal">
                            <StackLayout>
                                <Label x:Name="MatchTypeName"
                                   FontSize="Small"
                                       FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimaryColor}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding TournamentMatchType.MatchType.Name}" TextColor="{DynamicResource TextPrimaryColor}" FontAttributes="Bold" FontSize="Small" />                                            
                                            <Span Text=" " />
                                            <Span Text="{Binding MatchType.Name}" TextColor="{DynamicResource TextPrimaryColor}" FontAttributes="Bold" FontSize="Small" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                </StackLayout>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="EndAndExpand"
                                     Orientation="Horizontal"
                                 Padding="5,10">
                                <Label x:Name="TimeIcon"
                                   FontSize="Small"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                        Text="&#xe904;"
                                       FontFamily="{StaticResource fontFamily}"/>
                            <Label x:Name="TimeLabel"
                                   FontSize="Small"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   IsVisible="{Binding IsPostponedOrCancelled, Converter={StaticResource inverseBooleanConverter}}"
                                   VerticalTextAlignment="End"
                                        Text="{Binding Time, Converter={StaticResource timeConverter}}"/>
                            <Label x:Name="PostponedLabel"
                                   IsVisible="{Binding IsPostponedOrCancelled}"
                                   FontSize="Small"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   VerticalTextAlignment="End"
                                        Text="{Binding PostOrCanc}"/>
                        </StackLayout>
                    <!--<StackLayout Grid.Row="1" Grid.Column="0" Padding="5,0" HorizontalOptions="Start" VerticalOptions="Center">
                            <Frame HeightRequest="40" WidthRequest="40" CornerRadius="20" Padding="0" HorizontalOptions="Center" VerticalOptions="Center" HasShadow="False" IsClippedToBounds="True">
                        <ff:CachedImage Source="{Binding HomeTeam.TeamLogo, Converter={StaticResource imageConverter}}"
                                                        ErrorPlaceholder="bcblogo.png"
                                        LoadingPlaceholder="bcblogo.png"
                                                        CacheDuration="50"
                                                        RetryCount="3"
                                                        RetryDelay="600"
                                         Aspect="AspectFit"
                                        HeightRequest="30"
                                                  WidthRequest="30"
                                                        DownsampleToViewSize="True">

                        </ff:CachedImage>
                            </Frame>
                    </StackLayout>-->
                    <!--<StackLayout Grid.Row="3" Grid.Column="0" Padding="5,0" HorizontalOptions="Start" VerticalOptions="Center">
                             <Frame HeightRequest="40" WidthRequest="40" CornerRadius="20" Padding="0" HorizontalOptions="Center" VerticalOptions="Center" HasShadow="False" IsClippedToBounds="True">
                        <ff:CachedImage Source="{Binding AwayTeam.TeamLogo, Converter={StaticResource imageConverter}}"
                                                        ErrorPlaceholder="bcblogo.png"
                                        LoadingPlaceholder="bcblogo.png"
                                                        CacheDuration="50"
                                                        RetryCount="3"
                                                        RetryDelay="600"
                                         Aspect="AspectFit"
                                        HeightRequest="30"
                                                  WidthRequest="30"
                                                        DownsampleToViewSize="True">  
                                        </ff:CachedImage>
                            </Frame>
                    </StackLayout>-->
                    <StackLayout Grid.Row="1" Grid.Column="2" VerticalOptions="Center"
                                     HorizontalOptions="CenterAndExpand"
                                         Orientation="Vertical"
                                 Padding="10,2"
                                 Spacing="5">
                     <StackLayout Orientation="Horizontal"  HorizontalOptions="Center" >
                            <Label x:Name="Player1ScoreLabel"
                                   FontSize="Small"
                                   FontAttributes="{Binding TennisMatch[0].ID, Converter={StaticResource selectedPlayerConverter}, ConverterParameter={x:Reference Name=SelectedPlayerIDLabel}}"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                        Text="{Binding Player1Score}"/>   
                        </StackLayout>
                    </StackLayout>
                    <StackLayout Grid.Row="3" Grid.Column="2"
                                     HorizontalOptions="CenterAndExpand"
                                 Padding="10,2"
                                 Spacing="5">
                         <Label x:Name="Player2ScoreLabel"
                                   FontSize="Small"
                                FontAttributes="{Binding TennisMatch[1].ID, Converter={StaticResource selectedPlayerConverter}, ConverterParameter={x:Reference Name=SelectedPlayerIDLabel}}"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                        Text="{Binding Player2Score}"/>
                    </StackLayout>
                            <StackLayout Grid.Row="1" Grid.Column="0"
                                 VerticalOptions="CenterAndExpand"
                                     HorizontalOptions="FillAndExpand" Padding="10,2" Spacing="5">
                                <Label x:Name="Player1NameLabel"
                                   HorizontalOptions="StartAndExpand"
                                   HorizontalTextAlignment="Start"
                                   FontSize="Small"
                                        FontAttributes="{Binding TennisMatch[0].ID, Converter={StaticResource selectedPlayerConverter}, ConverterParameter={x:Reference Name=SelectedPlayerIDLabel}}"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                        Text="{Binding TennisMatch[0].Player1.Player.Name}">
                                <Label.FontSize>
                                    <OnPlatform x:TypeArguments="x:Double">  
                        <OnPlatform.Android> 
                            <OnIdiom x:TypeArguments="x:Double" Phone="12"  Tablet="19" /> 
                        </OnPlatform.Android> 
                        <OnPlatform.iOS> 
                            <OnIdiom x:TypeArguments="x:Double"  Phone="13"  Tablet="18" /> 
                        </OnPlatform.iOS> 
                    </OnPlatform> 
                                </Label.FontSize>
                            </Label>
                                <Label x:Name="Player2NameLabel"
                                   HorizontalOptions="StartAndExpand"
                                   HorizontalTextAlignment="Start"
                                   FontSize="Small"
                                        FontAttributes="{Binding TennisMatch[0].ID, Converter={StaticResource selectedPlayerConverter}, ConverterParameter={x:Reference Name=SelectedPlayerIDLabel}}"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                        Text="{Binding TennisMatch[0].Player2.Player.Name}">
                                <Label.FontSize>
                                    <OnPlatform x:TypeArguments="x:Double">  
                        <OnPlatform.Android> 
                            <OnIdiom x:TypeArguments="x:Double" Phone="12"  Tablet="19" /> 
                        </OnPlatform.Android> 
                        <OnPlatform.iOS> 
                            <OnIdiom x:TypeArguments="x:Double"  Phone="13"  Tablet="18" /> 
                        </OnPlatform.iOS> 
                    </OnPlatform> 
                                </Label.FontSize>
                            </Label>
                        </StackLayout>
                            <StackLayout Grid.Row="3" Grid.Column="0"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="10,2"
                                 Spacing="5">
                                <Label x:Name="Player3NameLabel"
                                   HorizontalOptions="StartAndExpand"
                                   HorizontalTextAlignment="Start"
                                   FontSize="Small"
                                        FontAttributes="{Binding TennisMatch[1].ID, Converter={StaticResource selectedPlayerConverter}, ConverterParameter={x:Reference Name=SelectedPlayerIDLabel}}"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                        Text="{Binding TennisMatch[1].Player1.Player.Name}">
                                <Label.FontSize>
                                    <OnPlatform x:TypeArguments="x:Double">  
                        <OnPlatform.Android> 
                            <OnIdiom x:TypeArguments="x:Double" Phone="12"  Tablet="19" /> 
                        </OnPlatform.Android> 
                        <OnPlatform.iOS> 
                            <OnIdiom x:TypeArguments="x:Double"  Phone="13"  Tablet="18" /> 
                        </OnPlatform.iOS> 
                    </OnPlatform> 
                                </Label.FontSize>
                            </Label>
                                <Label x:Name="Player4NameLabel"
                                   HorizontalOptions="StartAndExpand"
                                   HorizontalTextAlignment="Start"
                                   FontSize="Small"
                                        FontAttributes="{Binding TennisMatch[1].ID, Converter={StaticResource selectedPlayerConverter}, ConverterParameter={x:Reference Name=SelectedPlayerIDLabel}}"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                        Text="{Binding TennisMatch[1].Player2.Player.Name}">
                                <Label.FontSize>
                                    <OnPlatform x:TypeArguments="x:Double">  
                                        <OnPlatform.Android> 
                                            <OnIdiom x:TypeArguments="x:Double" Phone="12"  Tablet="19" /> 
                                        </OnPlatform.Android> 
                                        <OnPlatform.iOS> 
                                            <OnIdiom x:TypeArguments="x:Double"  Phone="13"  Tablet="18" /> 
                                        </OnPlatform.iOS> 
                                    </OnPlatform> 
                                </Label.FontSize>
                            </Label>
                        </StackLayout>

                    <StackLayout Grid.Row="1" Grid.Column="1" Padding="10,2">
                        <Grid HorizontalOptions="FillAndExpand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackLayout VerticalOptions="CenterAndExpand" Orientation="Horizontal" Spacing="0">
                                <Label FontSize="Small" Text="{Binding TennisMatch[0].Set1}" FontAttributes="{Binding TennisMatch[0].ID, Converter={StaticResource selectedPlayerConverter}, ConverterParameter={x:Reference Name=SelectedPlayerIDLabel}}" TextColor="{DynamicResource TextPrimaryColor}" VerticalOptions="CenterAndExpand"/>
                                <Label FontSize="8" Text="{Binding TennisMatch[0].TiebreakSet1}" TextColor="{DynamicResource TextPrimaryColor}" VerticalOptions="CenterAndExpand"/>
                            </StackLayout>
                            <StackLayout Grid.Column="1" VerticalOptions="CenterAndExpand" Orientation="Horizontal" Spacing="0">
                                <Label FontSize="Small" Text="{Binding TennisMatch[0].Set2}" TextColor="{DynamicResource TextPrimaryColor}" FontAttributes="{Binding TennisMatch[0].ID, Converter={StaticResource selectedPlayerConverter}, ConverterParameter={x:Reference Name=SelectedPlayerIDLabel}}" VerticalOptions="CenterAndExpand"/>
                                <Label FontSize="8" Text="{Binding TennisMatch[0].TiebreakSet2}" TextColor="{DynamicResource TextPrimaryColor}" VerticalOptions="StartAndExpand"/>
                            </StackLayout>
                            <StackLayout Grid.Column="2" VerticalOptions="CenterAndExpand" Orientation="Horizontal" Spacing="0">
                                <Label FontSize="Small" Text="{Binding TennisMatch[0].Set3}" TextColor="{DynamicResource TextPrimaryColor}" FontAttributes="{Binding TennisMatch[0].ID, Converter={StaticResource selectedPlayerConverter}, ConverterParameter={x:Reference Name=SelectedPlayerIDLabel}}" VerticalOptions="CenterAndExpand"/>
                                <Label FontSize="8" Text="{Binding TennisMatch[0].TiebreakSet3}" TextColor="{DynamicResource TextPrimaryColor}" VerticalOptions="StartAndExpand"/>
                            </StackLayout>
                            <StackLayout Grid.Column="3" VerticalOptions="CenterAndExpand" Orientation="Horizontal" Spacing="0">
                                <Label FontSize="Small" Text="{Binding TennisMatch[0].Set4}" TextColor="{DynamicResource TextPrimaryColor}" FontAttributes="{Binding TennisMatch[0].ID, Converter={StaticResource selectedPlayerConverter}, ConverterParameter={x:Reference Name=SelectedPlayerIDLabel}}" VerticalOptions="CenterAndExpand"/>
                                <Label FontSize="8" Text="{Binding TennisMatch[0].TiebreakSet4}" TextColor="{DynamicResource TextPrimaryColor}" VerticalOptions="StartAndExpand"/>
                            </StackLayout>
                            <StackLayout Grid.Column="4" VerticalOptions="CenterAndExpand" Orientation="Horizontal" Spacing="0">
                                <Label FontSize="Small" Text="{Binding TennisMatch[0].Set5}" TextColor="{DynamicResource TextPrimaryColor}" FontAttributes="{Binding TennisMatch[0].ID, Converter={StaticResource selectedPlayerConverter}, ConverterParameter={x:Reference Name=SelectedPlayerIDLabel}}" VerticalOptions="CenterAndExpand"/>
                                <Label FontSize="8" Text="{Binding TennisMatch[0].TiebreakSet5}" TextColor="{DynamicResource TextPrimaryColor}" VerticalOptions="StartAndExpand"/>
                            </StackLayout>

                        </Grid>
                    </StackLayout>

                    <StackLayout Grid.Row="3" Grid.Column="1" Padding="10,2">
                        <Grid HorizontalOptions="FillAndExpand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackLayout VerticalOptions="CenterAndExpand" Orientation="Horizontal" Spacing="0">
                                <Label FontSize="Small" Text="{Binding TennisMatch[1].Set1}" TextColor="{DynamicResource TextPrimaryColor}" FontAttributes="{Binding TennisMatch[1].ID, Converter={StaticResource selectedPlayerConverter}, ConverterParameter={x:Reference Name=SelectedPlayerIDLabel}}" VerticalOptions="CenterAndExpand"/>
                                <Label FontSize="8" Text="{Binding TennisMatch[1].TiebreakSet1}" TextColor="{DynamicResource TextPrimaryColor}" VerticalOptions="CenterAndExpand"/>
                            </StackLayout>
                            <StackLayout Grid.Column="1" VerticalOptions="CenterAndExpand" Orientation="Horizontal" Spacing="0">
                                <Label FontSize="Small" Text="{Binding TennisMatch[1].Set2}" TextColor="{DynamicResource TextPrimaryColor}" FontAttributes="{Binding TennisMatch[1].ID, Converter={StaticResource selectedPlayerConverter}, ConverterParameter={x:Reference Name=SelectedPlayerIDLabel}}" VerticalOptions="CenterAndExpand"/>
                                <Label FontSize="8" Text="{Binding TennisMatch[1].TiebreakSet2}" TextColor="{DynamicResource TextPrimaryColor}" VerticalOptions="StartAndExpand"/>
                            </StackLayout>
                            <StackLayout Grid.Column="2" VerticalOptions="CenterAndExpand" Orientation="Horizontal" Spacing="0">
                                <Label FontSize="Small" Text="{Binding TennisMatch[1].Set3}" TextColor="{DynamicResource TextPrimaryColor}" FontAttributes="{Binding TennisMatch[1].ID, Converter={StaticResource selectedPlayerConverter}, ConverterParameter={x:Reference Name=SelectedPlayerIDLabel}}" VerticalOptions="CenterAndExpand"/>
                                <Label FontSize="8" Text="{Binding TennisMatch[1].TiebreakSet3}" TextColor="{DynamicResource TextPrimaryColor}" VerticalOptions="StartAndExpand"/>
                            </StackLayout>
                            <StackLayout Grid.Column="3" VerticalOptions="CenterAndExpand" Orientation="Horizontal" Spacing="0">
                                <Label FontSize="Small" Text="{Binding TennisMatch[1].Set4}" TextColor="{DynamicResource TextPrimaryColor}" FontAttributes="{Binding TennisMatch[1].ID, Converter={StaticResource selectedPlayerConverter}, ConverterParameter={x:Reference Name=SelectedPlayerIDLabel}}" VerticalOptions="CenterAndExpand"/>
                                <Label FontSize="8" Text="{Binding TennisMatch[1].TiebreakSet4}" TextColor="{DynamicResource TextPrimaryColor}" VerticalOptions="StartAndExpand"/>
                            </StackLayout>
                            <StackLayout Grid.Column="4" VerticalOptions="CenterAndExpand" Orientation="Horizontal" Spacing="0">
                                <Label FontSize="Small" Text="{Binding TennisMatch[1].Set5}" TextColor="{DynamicResource TextPrimaryColor}" FontAttributes="{Binding TennisMatch[1].ID, Converter={StaticResource selectedPlayerConverter}, ConverterParameter={x:Reference Name=SelectedPlayerIDLabel}}" VerticalOptions="CenterAndExpand"/>
                                <Label FontSize="8" Text="{Binding TennisMatch[1].TiebreakSet5}" TextColor="{DynamicResource TextPrimaryColor}" VerticalOptions="StartAndExpand"/>
                            </StackLayout>

                        </Grid>
                    </StackLayout>

                        <StackLayout Grid.ColumnSpan="2" Grid.Row="2" Padding="10,0">
                            <BoxView HeightRequest="1" BackgroundColor="{DynamicResource TextPrimaryColor}" Opacity="0.05"/>
                        </StackLayout>
                    <StackLayout Grid.ColumnSpan="3" Grid.Row="4" Padding="5,2">
                        <Label Text="{Binding MatchResult}" FontSize="Micro" TextColor="Gray"/>
                    </StackLayout>
                        </Grid>
                        </Frame>
                        </Frame>
                    </StackLayout>
    </ViewCell.View>
</ViewCell>
