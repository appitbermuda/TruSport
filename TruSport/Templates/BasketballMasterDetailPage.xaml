<?xml version="1.0" encoding="UTF-8" ?>
<FlyoutPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="TruSport.Views.Basketball.BasketballMasterDetailPage"
    xmlns:local="clr-namespace:TruSport.Views.Basketball"
    Title="ONTRACK Basketball"
    IconImageSource="menu.png">
    <FlyoutPage.Flyout>
        <local:BasketballMenuPage x:Name="flyoutPage" />
    </FlyoutPage.Flyout>
    <FlyoutPage.Detail>
        <NavigationPage BarBackgroundColor="{DynamicResource navBackgroundColor}"
                BarTextColor="{DynamicResource navTextColor}">
            <x:Arguments>
                <local:BasketballMainPage />
            </x:Arguments>
        </NavigationPage>
    </FlyoutPage.Detail>
</FlyoutPage>
