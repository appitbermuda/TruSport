<?xml version="1.0" encoding="utf-8"?>
<FlyoutPage xmlns="http://xamarin.com/schemas/2014/forms" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="TruSport.Views.Tennis.TennisMasterDetailPage" xmlns:pages="clr-namespace:TruSport.Views.Tennis"
                  NavigationPage.HasNavigationBar="False"
                  IconImageSource="menu">
    <FlyoutPage.Flyout>
        <pages:TennisMasterDetailPageMaster x:Name="MasterPage" />
    </FlyoutPage.Flyout>
    <FlyoutPage.Detail>
        <NavigationPage BarBackgroundColor="{DynamicResource navBackgroundColor}"
                BarTextColor="{DynamicResource navTextColor}">
            <x:Arguments>
                <pages:TennisMasterDetailPageDetail />
            </x:Arguments>
        </NavigationPage>
    </FlyoutPage.Detail>
</FlyoutPage>
