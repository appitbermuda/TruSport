<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns:converter="clr-namespace:TruSport.Converters"
             xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             xmlns:model="clr-namespace:TruSport.Model" xmlns:extension="clr-namespace:TruSport.Extensions"
             x:Class="TruSport.Views.Football.CompetitionsPage"
             Title="Competitions">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:InverseBooleanConverter x:Key="inverseBooleanConverter"/>
            <converter:TableIndexToColorConverter x:Key="tableIndexConverter"/>
            <OnPlatform x:TypeArguments="x:String" x:Key="fontFamily" iOS="icomoon" Android="icomoon.ttf#icomoon" />
            <DataTemplate x:Name="LeagueItemTemplate"  x:Key="LeagueItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="FillAndExpand"
                             Padding="0">

                <Grid x:Name="grid"
                      RowSpacing="0"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">    
                    <Grid.RowDefinitions>
                            <RowDefinition Height="50" />
                        <RowDefinition Height="1" />
                    </Grid.RowDefinitions>
                        <!--<Image Aspect="AspectFill"
                               Source="{Binding BackgroundImage}"
                               />-->
                        <!--<ContentView BackgroundColor="Black" Opacity=".5"/>-->
                    <!--<ContentView BackgroundColor="WhiteSmoke" />-->
                        <StackLayout
                             VerticalOptions="Center"
                             Padding="20,0"
                             Spacing="0">
                        <Label x:Name="LeagueName" VerticalOptions="CenterAndExpand"
                                        Text="{Binding Name}"
                                   LineBreakMode="WordWrap"
                                  HorizontalTextAlignment="Start"
                               FontSize="Medium"
                                        TextColor="{DynamicResource TextPrimaryColor}"/>
                        </StackLayout>
                    <BoxView Grid.Row="1" HeightRequest="1" BackgroundColor="{DynamicResource controlHeaderBackgroundColor}" HorizontalOptions="FillAndExpand"/>
                        </Grid>
                    </StackLayout>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid BackgroundColor="{DynamicResource backgroundColor}"
                                  Padding="0,0,0,0" RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <!--<BoxView HeightRequest="3" BackgroundColor="{StaticResource primaryPink}" HorizontalOptions="FillAndExpand"/>-->
                                <listView:SfListView Grid.Row="0" IsVisible="{Binding NoConnectivity, Converter={StaticResource inverseBooleanConverter}}"  x:Name="LeagueList"
                                ItemsSource="{Binding LeagueCollection}"
                                    ItemTemplate="{StaticResource LeagueItemTemplate}"
                                   SelectionMode="Single"
                                                      HorizontalOptions="FillAndExpand"
                                    VerticalOptions="FillAndExpand"
                                    ItemTapped="Handle_ItemTapped"
                                   ItemSpacing="1"
                                    SelectionBackgroundColor="{DynamicResource listSelectedBackgroundColor}"
                                 AutoFitMode="DynamicHeight"
                                >
                <!--<listView:SfListView.LayoutManager>
                <listView:GridLayout>
                    <listView:GridLayout.SpanCount>
                    <OnPlatform x:TypeArguments="x:Int32">
                      <OnPlatform.Android>
                        <OnIdiom x:TypeArguments="x:Int32" Phone="2" Tablet="4" />
                      </OnPlatform.Android>
                      <OnPlatform.iOS>
                        <OnIdiom x:TypeArguments="x:Int32" Phone="2" Tablet="4" />
                      </OnPlatform.iOS>
                    </OnPlatform>
                  </listView:GridLayout.SpanCount>
                </listView:GridLayout>
              </listView:SfListView.LayoutManager>-->
            </listView:SfListView>
            <StackLayout Padding="10"  IsVisible="{Binding NoConnectivity}">
                <Label Text="There are no competitions available" FontSize="Caption" TextColor="{DynamicResource TextPrimaryColor}" HorizontalOptions="Center" HorizontalTextAlignment="Center"  IsVisible="{Binding NoConnectivity}"/>
            </StackLayout>
            <extension:CustomBusyIndicator IsVisible="{Binding IsActivityIndicatorVisible}"/>
            <StackLayout Grid.Row="1" Padding="0,0,0,0" HeightRequest="45" WidthRequest="200" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand">
                        <Image Source="ontrack_wordmark_reversed" VerticalOptions="CenterAndExpand" Aspect="AspectFit"/>
                    </StackLayout>
            <StackLayout Grid.Row="1" Padding="0,0,0,0" HeightRequest="50" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
                <StackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AdTappedCommand}"/>
                </StackLayout.GestureRecognizers>
                <Image Source="{Binding Ad.Image}" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Aspect="AspectFill"/>
            </StackLayout>
            <!--<model:AdMobView Size="Standardbanner" Grid.Row="1" VerticalOptions="EndAndExpand" MinimumHeightRequest="50"/>-->
                            </Grid>
    </ContentPage.Content>
</ContentPage>
