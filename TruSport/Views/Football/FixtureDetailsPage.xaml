<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:abstractions="clr-namespace:ImageCircle.Forms.Plugin.Abstractions;assembly=ImageCircle.Forms.Plugin"
             xmlns:tabview="clr-namespace:Syncfusion.XForms.TabView;assembly=Syncfusion.SfTabView.XForms"
             xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             xmlns:ff="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"  
             xmlns:ffSvg="clr-namespace:FFImageLoading.Svg.Forms;assembly=FFImageLoading.Svg.Forms"  
             xmlns:ffTransformations="clr-namespace:FFImageLoading.Transformations;assembly=FFImageLoading.Transformations"
             xmlns:converter="clr-namespace:TruSport.Converters"
             xmlns:extensions="clr-namespace:TruSport.Extensions"
             xmlns:data="clr-namespace:Syncfusion.DataSource;assembly=Syncfusion.DataSource.Portable"
             xmlns:model="clr-namespace:TruSport.Model"
             x:Class="TruSport.Views.Football.FixtureDetailsPage"
             BackgroundColor="{StaticResource primaryDarkBlueTwo}">
    <ContentPage.Resources>
        <converter:IsNullConverter x:Key="isNullConverter" />
        <converter:MatchSummaryConverter x:Key="matchSummaryConverter"/>
        <converter:InverseBooleanConverter x:Key="inverseBooleanConverter"/>
        <converter:SeasonFixtureDateConverter x:Key="seasonFixtureDateConverter"/>
        <converter:SelectedTeamConverter x:Key="selectedTeamConverter"/>
            <converter:SelectedTeamBackgroundConverter x:Key="selectedTeamBackgroundConverter"/>
            <converter:SelectedTeamTextConverter x:Key="selectedTeamTextConverter"/>
        <converter:GameTimeConverter x:Key="gameTimeConverter"/>
        <converter:MatchTimeConverter x:Key="matchTimeConverter"/>
            <converter:TimeConverter x:Key="timeConverter"/>
        <converter:SelectedTeamResultConverter x:Key="selectedTeamResultConverter"/>
            <converter:SelectedTeamProfileConverter x:Key="selectedTeamProfileConverter"/>
            <converter:TeamNameConverter x:Key="teamNameConverter" />
        <converter:GroupHeaderNameConverter x:Key="groupHeaderNameConverter"/>
            <converter:GroupHeaderSizeConverter x:Key="groupHeaderSizeConverter"/>
            <converter:GroupHeaderFontConverter x:Key="groupHeaderFontConverter"/>
            <converter:GroupingSelectionConverter x:Key="groupingSelectionConverter"/>
            <converter:FavouriteFontConverter x:Key="favouriteFontConverter"/>
            <converter:FavouriteConverter x:Key="favouriteConverter"/>
        <converter:SummaryMinuteConverter x:Key="summaryMinuteConverter"/>
        <converter:ImageConverter x:Key="imageConverter"/>
        <DataTemplate x:Name="MatchRosterItemTemplate"  x:Key="MatchRosterItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="FillAndExpand"
                             Padding="0,0"
                             >
                <Grid x:Name="grid"
                      Padding="0"
                      RowSpacing="0"
                      ColumnSpacing="2"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">    
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                        
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                            <!--<RowDefinition Height="35" />-->
                            <!--<RowDefinition Height="1" />-->
                    </Grid.RowDefinitions>
                    <StackLayout Grid.Row="0" Grid.Column="0"
                                 VerticalOptions="Center"
                                     HorizontalOptions="StartAndExpand">
                            <Label x:Name="HomeJerseyNumberLabel"
                                   FontSize="Micro"
                                   TextColor="White"
                                        Text="{Binding HomeJerseyNumber}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="1"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="0">
                                <Label x:Name="HomePlayerNameLabel"
                                   FontSize="Small"
                                       FontAttributes="Bold"
                                       Text="{Binding HomePlayerName}"
                                   TextColor="White"/>
                        </StackLayout>
                    <BoxView  Grid.Column="2" VerticalOptions="FillAndExpand"
                                         BackgroundColor="White" Opacity="0.1"
                                         WidthRequest="1"/>
                        <StackLayout Grid.Row="0" Grid.Column="3"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="0">
                                <Label x:Name="AwayPlayerNameLabel"
                                   FontSize="Small"
                                       HorizontalTextAlignment="End"
                                       FontAttributes="Bold"
                                       Text="{Binding AwayPlayerName}"
                                   TextColor="White"/>
                        </StackLayout>
                    <StackLayout Grid.Row="0" Grid.Column="4"
                                 VerticalOptions="Center"
                                     HorizontalOptions="EndAndExpand">
                            <Label x:Name="AwayJerseyNumberLabel"
                                   FontSize="Micro"
                                   TextColor="White"
                                        Text="{Binding AwayJerseyNumber}"/>
                        </StackLayout>
                        <!--<BoxView Grid.Row="1" Grid.ColumnSpan="3"
                                         BackgroundColor="White" Opacity="0.1"
                                         HeightRequest="1"/>-->
                        </Grid>
                        
                    </StackLayout>
            </DataTemplate>
        <DataTemplate x:Name="MatchRosterAwayItemTemplate"  x:Key="MatchRosterAwayItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="Center"
                             Padding="0,0"
                             >
                <Grid x:Name="grid"
                      Padding="0,0"
                      RowSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">    
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                            <RowDefinition Height="35" />
                            <RowDefinition Height="1" />
                    </Grid.RowDefinitions>
                    <StackLayout Grid.Row="0" Grid.Column="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label x:Name="JerseyNumberLabel"
                                   FontSize="Micro"
                                   TextColor="White"
                                        Text="{Binding JerseyNumber}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="1"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="0">
                                <Label x:Name="FirstNameLabel"
                                   FontSize="Small"
                                       FontAttributes="Bold"
                                       Text="{Binding Player.Name}"
                                   TextColor="White"/>
                            <!--<Label x:Name="LastNameLabel"
                                   FontSize="Small"
                                   FontAttributes="Bold"
                                       Text="{Binding Player.LafstName}"
                                   TextColor="White"/>-->
                        </StackLayout>
                    <StackLayout Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsStarter}" HorizontalOptions="EndAndExpand" VerticalOptions="Center" >
                        <BoxView CornerRadius="5" WidthRequest="10" HeightRequest="10" HorizontalOptions="Center" VerticalOptions="Center" BackgroundColor="Green"/>
                    </StackLayout>
                        <BoxView Grid.Row="1" Grid.ColumnSpan="3"
                                         BackgroundColor="White" Opacity="0.1"
                                         HeightRequest="1"/>
                        </Grid>
                        
                    </StackLayout>
            </DataTemplate>
        <DataTemplate x:Name="MatchSummaryItemTemplate"  x:Key="MatchSummaryItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="Center"
                             Padding="0,10"
                             >
                <Grid x:Name="grid"
                      Padding="0,0"
                      RowSpacing="1"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">    
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackLayout Grid.Column="0" Padding="5,0" IsVisible="{Binding IsHomeTeam}" VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                        <Label Text="{Binding Minute, Converter={StaticResource summaryMinuteConverter}}" TextColor="White" FontAttributes="Bold" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" FontSize="Micro"/>
                    </StackLayout>
                    <StackLayout Grid.Column="1" Padding="5" IsVisible="{Binding IsHomeTeam}"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label x:Name="HomeTeamPlayer"
                                   FontSize="Small"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                        Text="{Binding PlayerName}"/>
                        <Label x:Name="HomeTeamSubPlayer"
                                   FontSize="Micro"
                                   TextColor="White"
                                   FontAttributes="Bold" IsVisible="{Binding IsSub}"
                                        Text="{Binding SubstitutePlayerName, StringFormat='Off for {0}'}"/>
                        <Label x:Name="HomeTeamAssistPlayer" IsVisible="{Binding AssistPlayerName, Converter={StaticResource isNullConverter}}"
                                   FontSize="Micro"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                        Text="{Binding AssistPlayerName, StringFormat='Assist {0}'}"/>
                        </StackLayout>
                    <StackLayout Grid.Column="2" Padding="5,0">
                        <Label Text="" FontSize="Medium" TextColor="White" IsVisible="{Binding Goal, Converter={StaticResource matchSummaryConverter}}" FontFamily="{StaticResource fontAwesomeSolidFamily}" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"/>
                        <Label Text="" FontSize="Medium" TextColor="White" IsVisible="{Binding IsSub}" FontFamily="{StaticResource fontAwesomeSolidFamily}" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"/>
                        <Label Text="" FontSize="Medium" TextColor="Yellow" IsVisible="{Binding YellowCard, Converter={StaticResource matchSummaryConverter}}" FontFamily="{StaticResource fontAwesomeSolidFamily}" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"/>
                        <Label Text="" FontSize="Medium" TextColor="Red" IsVisible="{Binding RedCard, Converter={StaticResource matchSummaryConverter}}" FontFamily="{StaticResource fontAwesomeSolidFamily}" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"/>
                    </StackLayout>
                    <StackLayout Grid.Column="3" Padding="5" IsVisible="{Binding IsHomeTeam, Converter={StaticResource inverseBooleanConverter}}"
                                 VerticalOptions="Center"
                                     HorizontalOptions="EndAndExpand">
                            <Label x:Name="AwayTeamPlayer"
                                   FontSize="Small"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   Text="{Binding PlayerName}"/>
                        <Label x:Name="AwayTeamSubPlayer"
                                   FontSize="Micro"
                                   TextColor="White"
                                   FontAttributes="Bold" IsVisible="{Binding IsSub}"
                                        Text="{Binding SubstitutePlayerName, StringFormat='Off for {0}'}"/>
                        <Label x:Name="AwayTeamAssistPlayer"
                                   FontSize="Micro"
                                   TextColor="White"
                                   FontAttributes="Bold"  IsVisible="{Binding AssistPlayerName, Converter={StaticResource isNullConverter}}"
                                        Text="{Binding AssistPlayerName, StringFormat='Assist {0}'}"/>
                        </StackLayout>
                        <StackLayout Grid.Column="4" Padding="5,0"  IsVisible="{Binding IsHomeTeam, Converter={StaticResource inverseBooleanConverter}}" VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                        <Label Text="{Binding Minute, Converter={StaticResource summaryMinuteConverter}}" TextColor="White" FontAttributes="Bold" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" FontSize="Micro"/>
                    </StackLayout>
                        </Grid>
                        
                    </StackLayout>
            </DataTemplate>

        <DataTemplate x:Name="PlayerItemTemplate"  x:Key="PlayerItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="Center"
                             Padding="0,0"
                             >
                    
                <Grid x:Name="grid"
                      Padding="0,0"
                      RowSpacing="1"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">    
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="1" />
                    </Grid.RowDefinitions>
                    <StackLayout Grid.Row="0" Grid.Column="0"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label x:Name="JerseyNumberLabel"
                                   FontSize="Small"
                                   TextColor="White"
                                        Text="{Binding MatchRoster.Player.JerseyNumber}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="1"
                                     Spacing="5"
                                     Orientation="Horizontal"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="0">
                                <Label x:Name="FirstNameLabel"
                                   FontSize="Small"
                                       FontAttributes="Bold"
                                       Text="{Binding MatchRoster.Player.FirstName}"
                                   TextColor="White"/>
                            <Label x:Name="LastNameLabel"
                                   FontSize="Small"
                                   FontAttributes="Bold"
                                       Text="{Binding MatchRoster.Player.LastName}"
                                   TextColor="White"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label x:Name="GamesPlayedLabel"
                                   FontSize="Small"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding Played}"/>
                        </StackLayout>
                           <StackLayout Grid.Row="0" Grid.Column="3"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label x:Name="GoalsLabel"
                                   FontSize="Micro"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding Goals}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="4"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label x:Name="YellowCardsLabel"
                                   FontSize="Micro"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding YellowCards}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="5"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label x:Name="RedCardsLabel"
                                   FontSize="Micro"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding RedCards}"/>
                        </StackLayout>
                        <BoxView Grid.Row="1" Grid.ColumnSpan="6"
                                         BackgroundColor="White" Opacity="0.2"
                                         HeightRequest="1"/>
                        </Grid>
                        
                    </StackLayout>
            </DataTemplate>
        <DataTemplate x:Name="HomeTeamFixtureItemTemplate"  x:Key="HomeTeamFixtureItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="FillAndExpand">
                <Grid x:Name="grid"
                      Padding="0"
                      RowSpacing="1"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">    
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                     <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                            <RowDefinition Height="25" />
                            <RowDefinition Height="25" />
                        <RowDefinition Height="1" />
                    </Grid.RowDefinitions>
                    <Label x:Name="SelectedTeamIDLabel" IsVisible="false"
                                        Text="{Binding SelectedTeamID}"/>
                        <StackLayout Grid.Column="0" Grid.Row="0"
                                 VerticalOptions="End"
                                     HorizontalOptions="Center"
                                 Padding="5,2">
                            <Label x:Name="SeasonLabel" Text="{Binding Season.Key}" IsVisible="false"/>
                            <Label x:Name="DateLabel"
                                   FontSize="10"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding Date, Converter={StaticResource seasonFixtureDateConverter}, ConverterParameter={x:Reference Name=SeasonLabel}}"/>
                        </StackLayout>
                    <StackLayout Grid.Column="0" Grid.Row="1"
                                 VerticalOptions="Start"
                                     HorizontalOptions="Center"
                                 Padding="5,2">
                            <Label x:Name="TTLabel"
                                   FontSize="10"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"
                                        Text="FT"/>
                        </StackLayout>
                            
                            <StackLayout Grid.Row="0" Grid.Column="1"
                                 VerticalOptions="FillAndExpand"
                                     HorizontalOptions="Start"
                                 Padding="5,2"
                                 Spacing="0">
                                <Label x:Name="HomeTeamAlias" Text="{Binding HomeTeam.Alias}" IsVisible="false"/>
                            <Label x:Name="HomeTeamNameLabel"
                                   FontSize="14"
                                   FontAttributes="{Binding HomeTeamID, Converter={StaticResource selectedTeamProfileConverter}, ConverterParameter={x:Reference Name=SelectedTeamIDLabel}}"
                                   TextColor="White"
                                        Text="{Binding HomeTeam.Name, Converter={StaticResource teamNameConverter}, ConverterParameter={x:Reference HomeTeamAlias}}"/>
                        </StackLayout>
                            <StackLayout Grid.Row="1" Grid.Column="1"
                                 VerticalOptions="FillAndExpand"
                                     HorizontalOptions="Start"
                                 Padding="5,2"
                                 Spacing="0">
                                <Label x:Name="AwayTeamAlias" Text="{Binding AwayTeam.Alias}" IsVisible="false"/>
                            <Label x:Name="AwayTeamNameLabel"
                                   FontSize="14"
                                   TextColor="White"
                                   FontAttributes="{Binding AwayTeamID, Converter={StaticResource selectedTeamProfileConverter}, ConverterParameter={x:Reference Name=SelectedTeamIDLabel}}"
                                    Text="{Binding AwayTeam.Name, Converter={StaticResource teamNameConverter}, ConverterParameter={x:Reference AwayTeamAlias}}"/>
                        </StackLayout>
                    
                            <StackLayout Grid.Row="0" Grid.Column="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                 Padding="5,2"
                                 Spacing="0">
                            <Label x:Name="HomeTeamScoreLabel"
                                   FontSize="15"
                                   TextColor="White"
                                   FontAttributes="{Binding HomeTeamID, Converter={StaticResource selectedTeamProfileConverter}, ConverterParameter={x:Reference Name=SelectedTeamIDLabel}}"
                                        Text="{Binding Match.HomeTeamScore}"/>
                        </StackLayout>
                            <StackLayout Grid.Row="1" Grid.Column="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                 Padding="5,2"
                                 Spacing="0">
                            <Label x:Name="AwayTeamScoreLabel"
                                   FontSize="15"
                                   TextColor="White"
                                   FontAttributes="{Binding AwayTeamID, Converter={StaticResource selectedTeamProfileConverter}, ConverterParameter={x:Reference Name=SelectedTeamIDLabel}}"
                                        Text="{Binding Match.AwayTeamScore}"/>
                                
                        </StackLayout>
                    <StackLayout Grid.RowSpan="2" Grid.Column="3" Padding="5"  VerticalOptions="Center" HorizontalOptions="Center">
                        <Grid VerticalOptions="Center" HorizontalOptions="Center">
                            <!--<Frame BackgroundColor="Green" HasShadow="False" WidthRequest="40" HeightRequest="40" CornerRadius="20" VerticalOptions="Center" HorizontalOptions="Center"/>-->
                            <BoxView BackgroundColor="{Binding SelectedTeamResult, Converter={StaticResource selectedTeamResultConverter}}" HeightRequest="40" WidthRequest="40" HorizontalOptions="Center" VerticalOptions="Center" CornerRadius="20"/>
                            <Label Text="{Binding SelectedTeamResult}" TextColor="White" FontAttributes="Bold" FontSize="Micro" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Grid>
                    </StackLayout>
                    <BoxView Grid.Row="2" Grid.ColumnSpan="4" Opacity=".3"
                                         BackgroundColor="White"
                                         HeightRequest="1"/>
                        </Grid>
                    </StackLayout>
            </DataTemplate>
