             Title="Leaderboard">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:InverseBooleanConverter x:Key="inverseBooleanConverter"/>
            <converter:ImageConverter x:Key="imageConverter"/>
            <converter:GroupHeaderNameConverter x:Key="groupHeaderNameConverter"/>
            <converter:GroupHeaderSizeConverter x:Key="groupHeaderSizeConverter"/>
            <converter:GroupHeaderFontConverter x:Key="groupHeaderFontConverter"/>
            <converter:GroupingSelectionFootballConverter x:Key="groupingSelectionConverter"/>
            <DataTemplate x:Name="PlayerItemTemplate"  x:Key="PlayerItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="Center">
                <Grid x:Name="grid"
                      Padding="1"
                      RowSpacing="1"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">    
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1"/>
                    </Grid.RowDefinitions>
                        <StackLayout Grid.Row="0" Grid.Column="0"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="10,5,0,5">
                                <Label x:Name="PlayerNameLabel"
                                   FontSize="Medium"
                                       Text="{Binding PlayerName}"
                                   TextColor="{DynamicResource TextPrimaryColor}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="1"
                                 VerticalOptions="Center"
                                     HorizontalOptions="EndAndExpand"
                                     Padding="0,5,10,5">
                            <Label x:Name="TeamNameLabel"
                                   FontSize="Large"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   FontAttributes="Bold"
                                   VerticalTextAlignment="Center"
                                   HorizontalOptions="EndAndExpand"
                                        Text="{Binding Goals}"/>
                        </StackLayout>
                    <BoxView Grid.Row="1" HeightRequest="1" Grid.ColumnSpan="2" BackgroundColor="LightGray" Opacity=".3" HorizontalOptions="FillAndExpand"/>
                        </Grid>
                    </StackLayout>
            </DataTemplate>
            <DataTemplate x:Name="TeamItemTemplate"  x:Key="TeamItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="Center">
                    
                <Grid x:Name="grid"
                      Padding="1"
                      RowSpacing="1"
                      ColumnSpacing="5"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">    
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1"/>
                    </Grid.RowDefinitions>
                    <StackLayout Grid.Row="0" Grid.Column="0"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="10,5,0,5">
                        <Frame HeightRequest="40" WidthRequest="40" CornerRadius="20" Padding="0" HorizontalOptions="Center" VerticalOptions="Center" HasShadow="False" IsClippedToBounds="True">
                        <ff:CachedImage Source="{Binding TeamLogo, Converter={StaticResource imageConverter}}"
                                                        ErrorPlaceholder="ontrack.png"
                                        LoadingPlaceholder="ontrack.png"
                                                        CacheDuration="50"
                                                        RetryCount="3"
                                                        RetryDelay="600"
                                        Aspect="AspectFit"
                                        HeightRequest="40"
                                                  WidthRequest="40"
                                                        DownsampleToViewSize="True">  
                                        </ff:CachedImage>
                            </Frame>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="1"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="0,5">
                                <Label x:Name="PlayerNameLabel"
                                   FontSize="Medium"
                                       Text="{Binding TeamName}"
                                   TextColor="{DynamicResource TextPrimaryColor}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="EndAndExpand"
                                     Padding="0,5,10,5">
                            <Label x:Name="TeamNameLabel"
                                   FontSize="Large"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   FontAttributes="Bold"
                                   VerticalTextAlignment="Center"
                                   HorizontalOptions="EndAndExpand"
                                        Text="{Binding Goals}"/>
                        </StackLayout>
                    <BoxView Grid.Row="1" HeightRequest="1" Grid.ColumnSpan="3" BackgroundColor="LightGray" Opacity=".3" HorizontalOptions="FillAndExpand"/>
                        </Grid>
                    </StackLayout>
            </DataTemplate>
            <DataTemplate x:Name="LeagueHeaderItemTemplate"  x:Key="LeagueHeaderItemTemplate">
              <StackLayout Padding="5,15,5,0">
                <Frame CornerRadius="5" Padding="0" BackgroundColor="Transparent">
                    <Frame IsClippedToBounds="True" CornerRadius="5" Padding="0"  BackgroundColor="{DynamicResource GroupHeaderBackgroundColor}">
                        <Grid VerticalOptions="FillAndExpand" Padding="0,10">
                            <StackLayout  Grid.Column="0" Padding="10,0" VerticalOptions="Center" HorizontalOptions="Start">
                            <Label x:Name="leagueLabel" Text="{Binding .}"
                                    FontSize="Medium"
                                    FontAttributes="Bold"
                                    TextColor="White"/>
                            </StackLayout>
                        </Grid>
                    </Frame>
                </Frame>
                </StackLayout>
            </DataTemplate>
