<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:tabView="clr-namespace:Syncfusion.XForms.TabView;assembly=Syncfusion.SfTabView.XForms"
             xmlns:data="clr-namespace:Syncfusion.DataSource;assembly=Syncfusion.DataSource.Portable"
             xmlns:converter="clr-namespace:TruSport.Converters"
             xmlns:ff="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"  
             xmlns:ffSvg="clr-namespace:FFImageLoading.Svg.Forms;assembly=FFImageLoading.Svg.Forms"  
             xmlns:ffTransformations="clr-namespace:FFImageLoading.Transformations;assembly=FFImageLoading.Transformations"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             xmlns:controls="clr-namespace:ImageCircle.Forms.Plugin.Abstractions;assembly=ImageCircle.Forms.Plugin"
             xmlns:pullToRefresh="clr-namespace:Syncfusion.SfPullToRefresh.XForms;assembly=Syncfusion.SfPullToRefresh.XForms"
             xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             xmlns:extension="clr-namespace:TruSport.Extensions" xmlns:templates="clr-namespace:TruSport.Templates"
             x:Class="TruSport.Views.Football.CompetitionDetailsPage"
             NavigationPage.HasBackButton="False"
             NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:IsPastFixtureConverter x:Key="isPastFixtureConverter"/>
            <converter:IsUpcomingFixtureConverter x:Key="isUpcomingFixtureConverter"/>
            <converter:ImageConverter x:Key="imageConverter"/>
            <converter:InverseBooleanConverter x:Key="inverseBooleanConverter"/>
            <converter:SelectedTeamConverter x:Key="selectedTeamConverter"/>
            <converter:SelectedTeamBackgroundConverter x:Key="selectedTeamBackgroundConverter"/>
            <converter:SelectedTeamTextConverter x:Key="selectedTeamTextConverter"/>
            <converter:TableIndexToColorConverter x:Key="tableIndexConverter"/>
            <converter:GameTimeConverter x:Key="gameTimeConverter"/>
            <converter:TimeConverter x:Key="timeConverter"/>
            <converter:GroupHeaderNameConverter x:Key="groupHeaderNameConverter"/>
            <converter:GroupHeaderSizeConverter x:Key="groupHeaderSizeConverter"/>
            <converter:GroupHeaderFontConverter x:Key="groupHeaderFontConverter"/>
            <converter:GroupingSelectionFootballConverter x:Key="groupingSelectionConverter"/>
            <converter:GroupingLeagueDateSelectionFootballConverter x:Key="groupingLeagueDateSelectionConverter"/>
            <converter:ShowScoreConverter x:Key="showScoreConverter"/>
            <converter:TeamNameConverter x:Key="teamNameConverter"/>
            <converter:GroupingCompetitionFootballConverter x:Key="groupingCompetitionConverter"/>
            <OnPlatform x:TypeArguments="x:String" x:Key="fontFamily" iOS="icomoon" Android="icomoon.ttf#icomoon" />
            <OnPlatform x:TypeArguments="x:String" x:Key="fontAwesomeFamily" Android="fa-regular-400.ttf#Font Awesome 5 Pro Regular" iOS="Font Awesome 5 Pro" />
            <DataTemplate x:Key="cricketFixtureTemplate">
                <templates:CricketFixtureList />
            </DataTemplate>
            <DataTemplate x:Key="cricketScoreFixtureTemplate">
                <templates:CricketScoreFixtureList />
            </DataTemplate>
            <DataTemplate x:Key="footballFixtureTemplate">
                <templates:FixtureList />
            </DataTemplate>
            <DataTemplate x:Key="footballScoreFixtureTemplate">
                <templates:ScoreFixtureList />
            </DataTemplate>
            <templates:FootballFixtureDataTemplateSelector x:Key="sportFixtureDataTemplateSelector"
                                                        FootballFixtureTemplate="{StaticResource footballFixtureTemplate}"
                                                        FootballScoreFixtureTemplate="{StaticResource footballScoreFixtureTemplate}"
                                                        />
            <DataTemplate x:Name="TableItemTemplate"  x:Key="TableItemTemplate">
                
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="Center">
                    <StackLayout Padding="0"
                                 HorizontalOptions="FillAndExpand"
                                 VerticalOptions="FillAndExpand">
                    
                <Grid x:Name="grid"
                      Padding="1"
                      RowSpacing="1"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">    
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                                <RowDefinition Height="1" />
                    </Grid.RowDefinitions>
                       
                        <StackLayout Grid.Row="0" Grid.Column="0"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="0">
                                <Label x:Name="PositionLabel"
                                       HorizontalTextAlignment="Center"
                                   FontSize="13"
                                       Text="{Binding Position}"
                                   TextColor="{DynamicResource TextPrimaryColor}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="1"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label x:Name="TeamNameLabel"
                                   FontSize="13"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   VerticalTextAlignment="Center"
                                        Text="{Binding Name}"/>
                        </StackLayout>
                           <StackLayout Grid.Row="0" Grid.Column="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label
                                   FontSize="13"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding Wins}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="3"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label x:Name="LossLabel"
                                   FontSize="13"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding Loss}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="4"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label x:Name="DrawLabel"
                                   FontSize="13"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding Draws}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="5"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                     >
                            <Label x:Name="PointsLabel"
                                   FontSize="13"
                                   TextColor="{DynamicResource TextPrimaryColor}" 
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding Points}"/>
                        </StackLayout>
                            <BoxView Grid.Row="1" Grid.ColumnSpan="6"
                                         BackgroundColor="{DynamicResource controlHeaderBackgroundColor}" Opacity="0.2"
                                         HeightRequest="1"/>
                        </Grid>
                        </StackLayout>
                    </StackLayout>
            </DataTemplate>
            <DataTemplate x:Name="FixtureItemTemplate"  x:Key="FixtureItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="FillAndExpand">
                <Grid x:Name="grid" Padding="0,10,0,0"
                      RowSpacing="5"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">    
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                            <RowDefinition Height="20" />
                            <RowDefinition Height="50" />
                        <RowDefinition Height="1" />
                    </Grid.RowDefinitions>
                        <StackLayout Grid.Row="0" Grid.Column="0"  Grid.ColumnSpan="3" Spacing="5" Padding="5,2"
                                 VerticalOptions="EndAndExpand"
                                     HorizontalOptions="StartAndExpand"
                                     Orientation="Horizontal">
                            <StackLayout Padding="2">
                                <Label x:Name="FieldIcon"
                                   FontSize="Small"
                                       Text="&#xe901;"
                                       VerticalOptions="Center"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                    FontFamily="{StaticResource fontFamily}"/>
                                </StackLayout>
                            <StackLayout>
                                <Label x:Name="FieldName"
                                   FontSize="Small"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                    Text="{Binding Field.Name}"/>
                                </StackLayout>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="EndAndExpand"
                                     Orientation="Horizontal"
                                 Padding="5,2">
                                <Label x:Name="TimeIcon"
                                   FontSize="Small"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                        Text="&#xe904;"
                                       FontFamily="{StaticResource fontFamily}"/>
                            <Label x:Name="TimeLabel"
                                   FontSize="Small"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   VerticalTextAlignment="End"
                                        Text="{Binding Time, Converter={StaticResource timeConverter}}"/>
                        </StackLayout>
                    <StackLayout Grid.Row="1" Grid.Column="0" Padding="5,0" HorizontalOptions="Center" VerticalOptions="Center">
                            <!--<controls:CircleImage 
                                                    x:Name="HomeTeamLogo"
                                                    Source="{Binding HomeTeam.TeamLogo, Converter={StaticResource imageConverter}}"
                                                    FillColor="White"
                                                  HeightRequest="30"
                                                  WidthRequest="30"
                                                  
                                                  Aspect="AspectFit" />-->
                        <Frame HeightRequest="40" WidthRequest="40" CornerRadius="20" Padding="0" HorizontalOptions="Center" VerticalOptions="Center" HasShadow="False" IsClippedToBounds="True">
                        <ff:CachedImage Source="{Binding HomeTeam.TeamLogo, Converter={StaticResource imageConverter}}"
                                                        ErrorPlaceholder="ontrack.png"
                                        LoadingPlaceholder="ontrack.png"
                                                        CacheDuration="50"
                                                        RetryCount="3"
                                                        RetryDelay="600"
                                        Aspect="AspectFit"
                                        HeightRequest="30"
                                                  WidthRequest="30"
                                                        DownsampleToViewSize="True">  
                                            <!--<ff:CachedImage.Transformations>  
                                                <ffTransformations:CircleTransformation />  
                                            </ff:CachedImage.Transformations>-->  
                                        </ff:CachedImage>
                            </Frame>
                    </StackLayout>
                    <StackLayout Grid.Row="1" Grid.Column="4" Padding="5,0" HorizontalOptions="Center" VerticalOptions="Center">
                            <!--<controls:CircleImage 
                                                  x:Name="AwayTeamLogo"
                                                    Source="{Binding AwayTeam.TeamLogo, Converter={StaticResource imageConverter}}"
                                                    FillColor="White"
                                                  HeightRequest="30"
                                                  WidthRequest="30"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                                  Aspect="AspectFit"/>-->
                        <Frame HeightRequest="40" WidthRequest="40" CornerRadius="20" Padding="0" HorizontalOptions="Center" VerticalOptions="Center" HasShadow="False" IsClippedToBounds="True">
                        <ff:CachedImage Source="{Binding AwayTeam.TeamLogo, Converter={StaticResource imageConverter}}"
                                                        ErrorPlaceholder="ontrack.png"
                                        LoadingPlaceholder="ontrack.png"
                                                        CacheDuration="50"
                                                        RetryCount="3"
                                                        RetryDelay="600"
                                        Aspect="AspectFit"
                                        HeightRequest="30"
                                                  WidthRequest="30"
                                                        DownsampleToViewSize="True">  
                                            <!--<ff:CachedImage.Transformations>  
                                                <ffTransformations:CircleTransformation />  
                                            </ff:CachedImage.Transformations>-->  
                                        </ff:CachedImage>
                            </Frame>
                    </StackLayout>
                            <StackLayout IsVisible="{Binding Date, Converter={StaticResource isPastFixtureConverter}}" Grid.Row="1" Grid.Column="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                         Orientation="Vertical"
                                 Padding="5,2"
                                 Spacing="5">
                            <StackLayout IsVisible="{Binding Match.IsPenalties}" Orientation="Horizontal" HorizontalOptions="Center" >
                            <Label x:Name="HomeTeamPenaltyLabel"
                                   FontSize="Micro"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                        Text="{Binding Match.HomeTeamPenalty, StringFormat='({0}'}"/>
                            <Label 
                                   
                                   FontSize="Micro"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                        Text="-"/>
                            <Label x:Name="AwayTeamPenaltyLabel"
                                   FontSize="Micro"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   FontAttributes="Bold"
                                        Text="{Binding Match.AwayTeamPenalty, StringFormat='{0})'}"/>
                                
                        </StackLayout>
                     <StackLayout  Orientation="Horizontal"  HorizontalOptions="Center" >
                            <Label x:Name="HomeTeamScoreLabel"
                                   FontSize="Medium"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                        Text="{Binding Match.HomeTeamScore}"/>
                            <Label 
                                   x:Name="Versus"
                                   FontSize="Small"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                        Text="{Binding Match.HomeTeamScore, Converter={StaticResource showScoreConverter}}"/>
                            <Label x:Name="AwayTeamScoreLabel"
                                   FontSize="Medium"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   FontAttributes="Bold"
                                        Text="{Binding Match.AwayTeamScore}"/>
                                
                        </StackLayout>
                    </StackLayout>
                    <StackLayout IsVisible="{Binding Date, Converter={StaticResource isUpcomingFixtureConverter}}"  Grid.Row="1" Grid.Column="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                         Orientation="Horizontal"
                                 Padding="5,2"
                                 Spacing="0">
                            <Label 
                                   x:Name="Vers"
                                   FontSize="Medium"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                        Text="V"/>
                                
                        </StackLayout>
                            <StackLayout Grid.Row="1" Grid.Column="1"
                                 VerticalOptions="Center"
                                     HorizontalOptions="StartAndExpand"
                                 Padding="5,2"
                                 Spacing="0">
                                <Label x:Name="HomeTeamAlias" Text="{Binding HomeTeam.Alias}" IsVisible="false"/>
                            <Label x:Name="HomeTeamNameLabel"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                        Text="{Binding HomeTeam.Name, Converter={StaticResource teamNameConverter}, ConverterParameter={x:Reference HomeTeamAlias}}"/>
                        </StackLayout>
                            <StackLayout Grid.Row="1" Grid.Column="3"
                                 VerticalOptions="Center"
                                     HorizontalOptions="EndAndExpand"
                                 Padding="5,2"
                                 Spacing="0">
                                <Label x:Name="AwayTeamAlias" Text="{Binding AwayTeam.Alias}" IsVisible="false"/>
                            <Label x:Name="AwayTeamNameLabel"
                                   FontSize="12"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   FontAttributes="Bold"
                                        Text="{Binding AwayTeam.Name, Converter={StaticResource teamNameConverter}, ConverterParameter={x:Reference AwayTeamAlias}}"/>
                        </StackLayout>
                    <BoxView HeightRequest="1" BackgroundColor="White" Grid.ColumnSpan="5" Grid.Row="2" Opacity="0.3"/>
                        </Grid>
                    </StackLayout>
            </DataTemplate>
            <!--<DataTemplate x:Name="FixtureItemTemplate"  x:Key="FixtureItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="FillAndExpand"
                             Padding="10,5">
                    <Frame HasShadow="false"
                           CornerRadius="10"
                           IsClippedToBounds="true"
                           Padding="0"
                           BackgroundColor="#ECEFF1">
                <Grid x:Name="grid"
                      Padding="0"
                      RowSpacing="5"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">    
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                            <RowDefinition Height="25" />
                            <RowDefinition Height="25" />
                            <RowDefinition Height="25" />
                    </Grid.RowDefinitions>
                        <StackLayout Grid.Column="0" Grid.RowSpan="2" Grid.Row="1"
                                 VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                 Padding="5,2">
                                <Label x:Name="TimeIcon"
                                   FontSize="20"
                                   TextColor="Black"
                                       HorizontalTextAlignment="Center"
                                        Text="&#xe904;"
                                       FontFamily="{StaticResource fontFamily}"/>
                            <Label x:Name="TimeLabel"
                                   FontSize="10"
                                   TextColor="Black"
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding Time,
                                                StringFormat='{0:h:mm tt}'}"/>
                        </StackLayout>
                            
                            <StackLayout Grid.Row="1" Grid.Column="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                 Padding="5,2"
                                 Spacing="0">
                            <Label x:Name="HomeTeamScoreLabel"
                                   FontSize="15"
                                   TextColor="{StaticResource primaryDarkBlue}"
                                   FontAttributes="Bold"
                                        Text="{Binding HomeTeamScore}"/>
                        </StackLayout>
                            <StackLayout Grid.Row="2" Grid.Column="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                 Padding="5,2"
                                 Spacing="0">
                            <Label x:Name="AwayTeamScoreLabel"
                                   FontSize="15"
                                   TextColor="{StaticResource primaryDarkBlue}"
                                   FontAttributes="Bold"
                                        Text="{Binding AwayTeamScore}"/>
                                
                        </StackLayout>
                            <StackLayout Grid.Row="1" Grid.Column="1"
                                 VerticalOptions="FillAndExpand"
                                     HorizontalOptions="Start"
                                 Padding="5,2"
                                 Spacing="0">
                            <Label x:Name="HomeTeamNameLabel"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="Black"
                                        Text="{Binding HomeTeamName}"/>
                        </StackLayout>
                            <StackLayout Grid.Row="2" Grid.Column="1"
                                 VerticalOptions="FillAndExpand"
                                     HorizontalOptions="Start"
                                 Padding="5,2"
                                 Spacing="0">
                            <Label x:Name="AwayTeamNameLabel"
                                   FontSize="14"
                                   TextColor="Black"
                                   FontAttributes="Bold"
                                        Text="{Binding AwayTeamName}"/>
                        </StackLayout>
                            <StackLayout Grid.Row="0" Grid.ColumnSpan="3"
                                         BackgroundColor="{StaticResource primaryDarkBlue}"
                                 VerticalOptions="FillAndExpand"
                                     HorizontalOptions="FillAndExpand"
                                         Orientation="Horizontal"
                                 Padding="5,2"
                                 Spacing="0">
                            <Label x:Name="MatchType"
                                   FontSize="14"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   HorizontalOptions="StartAndExpand"
                                   FontAttributes="Bold"
                                        Text="{Binding LeagueName}"/>
                                <Label x:Name="MatchDate"
                                   FontSize="14"
                                       HorizontalOptions="EndAndExpand"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   FontAttributes="Bold"
                                        Text="{Binding Date,
                                                StringFormat='{0:MMM dd yyyy}'}"/>
                        </StackLayout>
                        </Grid>
                        </Frame>
                    </StackLayout>
            </DataTemplate>-->
        </ResourceDictionary>
    </ContentPage.Resources>
    <!--<NavigationPage.TitleView>
        <StackLayout Orientation="Horizontal"
                     HorizontalOptions="FillAndExpand"
                     Padding="0,0,0,0">
            <StackLayout.Padding>
               <OnPlatform x:TypeArguments="Thickness">
                 <On Platform="Android" Value="0, 0, 0, 0"/>
                 <On Platform="iOS" Value="0, 0, 0, 0"/>
                </OnPlatform>
              </StackLayout.Padding>
            <Grid HorizontalOptions="FillAndExpand">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                 <StackLayout Grid.Column="1" Padding="0,0,0,0" VerticalOptions="CenterAndExpand">
                        <StackLayout.HorizontalOptions>
                            <OnPlatform x:TypeArguments="LayoutOptions">
                                <On Platform="Android" Value="StartAndExpand"/>
                                <On Platform="iOS" Value="CenterAndExpand"/>
                            </OnPlatform>
                        </StackLayout.HorizontalOptions>
                         <Label x:Name="TitleLabel" Text="{Binding Title}" FontSize="14" HorizontalTextAlignment="Center" TextColor="White" FontAttributes="Bold" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand"/>
                    </StackLayout>
                <Button x:Name="BackButton" Text="" TextColor="{DynamicResource navTextColor}" FontSize="25" FontFamily="{StaticResource fontAwesomeSolidFamily}" Clicked="BackButton_Clicked"/>
                </Grid>
        </StackLayout>
    </NavigationPage.TitleView>-->
    <ContentPage.Content>
        <Grid HorizontalOptions="FillAndExpand" RowSpacing="0" VerticalOptions="FillAndExpand" BackgroundColor="{DynamicResource backgroundColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackLayout Orientation="Horizontal"
                     HorizontalOptions="FillAndExpand"
                         VerticalOptions="Start"
                     BackgroundColor="{DynamicResource navBackgroundColor}">
            <StackLayout.Padding>
               <OnPlatform x:TypeArguments="Thickness">
                 <On Platform="Android" Value="0, 0, 0, 0"/>
                 <On Platform="iOS" Value="0, 50, 0, 0"/>
                </OnPlatform>
              </StackLayout.Padding>
            <Grid HorizontalOptions="FillAndExpand" HeightRequest="50">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                 <StackLayout Grid.ColumnSpan="3" Padding="0,0,0,0" VerticalOptions="CenterAndExpand" HeightRequest="50">
                        <StackLayout.HorizontalOptions>
                            <OnPlatform x:TypeArguments="LayoutOptions">
                                <On Platform="Android" Value="CenterAndExpand"/>
                                <On Platform="iOS" Value="CenterAndExpand"/>
                            </OnPlatform>
                        </StackLayout.HorizontalOptions>
                         <Label x:Name="TitleLabel" Text="{Binding Title}" FontSize="14" HorizontalTextAlignment="Center" TextColor="White" FontAttributes="Bold" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand"/>
                    </StackLayout>
                <Button x:Name="BackButton" Text="" TextColor="{DynamicResource navTextColor}" BackgroundColor="Transparent" FontSize="25" FontFamily="{StaticResource fontAwesomeSolidFamily}" Clicked="BackButton_Clicked"/>
                </Grid>
        </StackLayout>

     <tabView:SfTabView Grid.Row="1"
                        VisibleHeaderCount="2"
                                 TabHeaderBackgroundColor="{DynamicResource tabHeaderColor}"
                        BackgroundColor="Transparent"
                                 DisplayMode="Text"
                           SelectedIndex="0"
                                TabHeight="50" TabItemTapped="SfTabView_TabItemTapped">
                        <tabView:SfTabView.SelectionIndicatorSettings>
                <tabView:SelectionIndicatorSettings Color="{DynamicResource tabIndicatorColor}" 
                                                              Position="Bottom" 
                                                              StrokeThickness="2"/>
                </tabView:SfTabView.SelectionIndicatorSettings>
                        
                        <tabView:SfTabItem Title="Fixtures" TitleFontColor="Gray" SelectionColor="{DynamicResource TextPrimaryColor}">
                        <tabView:SfTabItem.Content>
                        <Grid BackgroundColor="{DynamicResource backgroundColor}" Padding="0,0,0,0"
                              HorizontalOptions="FillAndExpand"
                              VerticalOptions="FillAndExpand" RowSpacing="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <listView:SfListView x:Name="FixtureList"
                                                ItemsSource="{Binding FixtureCollection}"
                                                     LoadMoreOption="Auto"
                                                     LoadMoreCommand="{Binding LoadMoreItemsCommand}"
                                                     LoadMoreCommandParameter="{Binding Source={x:Reference Name=FixtureList}}"
                                                    HorizontalOptions="FillAndExpand"
                                                    VerticalOptions="FillAndExpand"
                                                   SelectionMode="Single"
                                                   ItemSpacing="0"
                                                     SelectionChanged="OnFixtureSelected"
                                                    SelectionBackgroundColor="{DynamicResource listSelectedBackgroundColor}"
                                                 AutoFitMode="DynamicHeight">
                                <listView:SfListView.ItemTemplate>
                                    <DataTemplate>
                                        <templates:FixtureList />
                                    </DataTemplate>
                                </listView:SfListView.ItemTemplate>
                                    <listView:SfListView.HeaderTemplate>
                                    <DataTemplate>
                                      <ViewCell>
                                        <Grid Padding="5">
                                            <Button BackgroundColor="{StaticResource controlHeaderBackgroundColor}" Text="Previous Fixtures" Padding="10,0" CornerRadius="5" TextColor="{DynamicResource frameBackgroundColor}" Clicked="LoadMoreClicked" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" IsEnabled="{Binding IsLoadMoreVisible}"/>
                                          </Grid>
                                      </ViewCell>
                                    </DataTemplate>
                                  </listView:SfListView.HeaderTemplate>
                                    <listView:SfListView.DataSource>
                                  <data:DataSource>
                                    <data:DataSource.SortDescriptors>
                                      <data:SortDescriptor PropertyName="FixtureTime" Direction="Ascending"/>
                                    </data:DataSource.SortDescriptors>
                                  </data:DataSource>
                                </listView:SfListView.DataSource>
                                    <listView:SfListView.GroupHeaderTemplate>
                                  <DataTemplate>
                                      <ViewCell>
                                        <ViewCell.View>
                                            <StackLayout Padding="8,25,8,0">
<Frame CornerRadius="10" Padding="0" BackgroundColor="Transparent">
<Frame IsClippedToBounds="True" CornerRadius="10" Padding="0"  BackgroundColor="{DynamicResource GroupHeaderBackgroundColor}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <BoxView Grid.ColumnSpan="2"/>
                                                <StackLayout  Grid.Column="0" Padding="10,0" VerticalOptions="Center" HorizontalOptions="Start">
                                                <Label x:Name="leagueLabel" Text="{Binding ., Converter={StaticResource groupingCompetitionConverter}, ConverterParameter={x:Reference leagueLabel}}"
                                                     FontSize="{Binding Key, 
                                                            Converter={StaticResource groupHeaderSizeConverter}}"
                                                     FontAttributes="Bold"
                                                     TextColor="White"/>
                                                </StackLayout>
                                                <StackLayout Grid.Column="1" Padding="10,0" VerticalOptions="Center" HorizontalOptions="EndAndExpand">
                                                <Label Text="{Binding ., Converter={StaticResource groupingCompetitionConverter}, ConverterParameter={x:Reference FixtureList}}"
                                                     FontSize="{Binding Key, 
                                                            Converter={StaticResource groupHeaderSizeConverter}}"
                                                     FontAttributes="Bold"
                                                     TextColor="White"/>
                                                    </StackLayout>
                                          </Grid>
    </Frame>
</Frame>
                                            </StackLayout>
    </ViewCell.View>
                                      </ViewCell>
                                  </DataTemplate>
                                </listView:SfListView.GroupHeaderTemplate>
                                </listView:SfListView>
                        </Grid>
                        </tabView:SfTabItem.Content>
                    </tabView:SfTabItem>
