<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:tabView="clr-namespace:Syncfusion.XForms.TabView;assembly=Syncfusion.SfTabView.XForms"
             xmlns:data="clr-namespace:Syncfusion.DataSource;assembly=Syncfusion.DataSource.Portable"
             xmlns:converter="clr-namespace:TruSport.Converters"
             xmlns:ff="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"  
             xmlns:ffSvg="clr-namespace:FFImageLoading.Svg.Forms;assembly=FFImageLoading.Svg.Forms"  
             xmlns:ffTransformations="clr-namespace:FFImageLoading.Transformations;assembly=FFImageLoading.Transformations"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             xmlns:controls="clr-namespace:ImageCircle.Forms.Plugin.Abstractions;assembly=ImageCircle.Forms.Plugin"
             xmlns:pullToRefresh="clr-namespace:Syncfusion.SfPullToRefresh.XForms;assembly=Syncfusion.SfPullToRefresh.XForms"
             xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             xmlns:extension="clr-namespace:TruSport.Extensions"
             x:Class="TruSport.Views.Football.CompetitionDetailsPage"
             >
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:IsPastFixtureConverter x:Key="isPastFixtureConverter"/>
            <converter:IsUpcomingFixtureConverter x:Key="isUpcomingFixtureConverter"/>
            <converter:ImageConverter x:Key="imageConverter"/>
            <converter:InverseBooleanConverter x:Key="inverseBooleanConverter"/>
            <converter:SelectedTeamConverter x:Key="selectedTeamConverter"/>
            <converter:SelectedTeamBackgroundConverter x:Key="selectedTeamBackgroundConverter"/>
            <converter:SelectedTeamTextConverter x:Key="selectedTeamTextConverter"/>
            <converter:TableIndexToColorConverter x:Key="tableIndexConverter"/>
            <converter:GameTimeConverter x:Key="gameTimeConverter"/>
            <converter:TimeConverter x:Key="timeConverter"/>
            <converter:GroupHeaderNameConverter x:Key="groupHeaderNameConverter"/>
            <converter:GroupHeaderSizeConverter x:Key="groupHeaderSizeConverter"/>
            <converter:GroupHeaderFontConverter x:Key="groupHeaderFontConverter"/>
            <converter:GroupingSelectionConverter x:Key="groupingSelectionConverter"/>
            <converter:GroupingLeagueDateSelectionConverter x:Key="groupingLeagueDateSelectionConverter"/>
            <converter:ShowScoreConverter x:Key="showScoreConverter"/>
            <converter:TeamNameConverter x:Key="teamNameConverter"/>
            <OnPlatform x:TypeArguments="x:String" x:Key="fontFamily" iOS="icomoon" Android="icomoon.ttf#icomoon" />
            <OnPlatform x:TypeArguments="x:String" x:Key="fontAwesomeFamily" Android="fa-regular-400.ttf#Font Awesome 5 Pro Regular" iOS="Font Awesome 5 Pro" />
            <DataTemplate x:Name="TableItemTemplate"  x:Key="TableItemTemplate">
                
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="Center">
                    <StackLayout Padding="0"
                                 HorizontalOptions="FillAndExpand"
                                 VerticalOptions="FillAndExpand">
                    
                <Grid x:Name="grid"
                      Padding="1"
                      RowSpacing="1"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">    
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                                <RowDefinition Height="1" />
                    </Grid.RowDefinitions>
                       
                        <StackLayout Grid.Row="0" Grid.Column="0"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="0">
                                <Label x:Name="PositionLabel"
                                       HorizontalTextAlignment="Center"
                                   FontSize="13"
                                       Text="{Binding Position}"
                                   TextColor="White"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="1"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label x:Name="TeamNameLabel"
                                   FontSize="13"
                                   TextColor="White"
                                   VerticalTextAlignment="Center"
                                        Text="{Binding Name}"/>
                        </StackLayout>
                           <StackLayout Grid.Row="0" Grid.Column="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label
                                   FontSize="13"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding Wins}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="3"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label x:Name="LossLabel"
                                   FontSize="13"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding Loss}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="4"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label x:Name="DrawLabel"
                                   FontSize="13"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding Draws}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="5"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                     >
                            <Label x:Name="PointsLabel"
                                   FontSize="13"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding Points}"/>
                        </StackLayout>
                            <BoxView Grid.Row="1" Grid.ColumnSpan="6"
                                         BackgroundColor="White" Opacity="0.2"
                                         HeightRequest="1"/>
                        </Grid>
                        </StackLayout>
                    </StackLayout>
            </DataTemplate>
            <DataTemplate x:Name="FixtureItemTemplate"  x:Key="FixtureItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="FillAndExpand">
                <Grid x:Name="grid" Padding="0,10,0,0"
                      RowSpacing="5"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">    
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                            <RowDefinition Height="20" />
                            <RowDefinition Height="50" />
                        <RowDefinition Height="1" />
                    </Grid.RowDefinitions>
                        <StackLayout Grid.Row="0" Grid.Column="0"  Grid.ColumnSpan="3" Spacing="5" Padding="5,2"
                                 VerticalOptions="EndAndExpand"
                                     HorizontalOptions="StartAndExpand"
                                     Orientation="Horizontal">
                            <StackLayout Padding="2">
                                <Label x:Name="FieldIcon"
                                   FontSize="Small"
                                       Text="&#xe901;"
                                       VerticalOptions="Center"
                                   TextColor="White"
                                    FontFamily="{StaticResource fontFamily}"/>
                                </StackLayout>
                            <StackLayout>
                                <Label x:Name="FieldName"
                                   FontSize="Small"
                                   TextColor="White"
                                    Text="{Binding Field.Name}"/>
                                </StackLayout>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="EndAndExpand"
                                     Orientation="Horizontal"
                                 Padding="5,2">
                                <Label x:Name="TimeIcon"
                                   FontSize="Small"
                                   TextColor="White"
                                        Text="&#xe904;"
                                       FontFamily="{StaticResource fontFamily}"/>
                            <Label x:Name="TimeLabel"
                                   FontSize="Small"
                                   TextColor="White"
                                   VerticalTextAlignment="End"
                                        Text="{Binding Time, Converter={StaticResource timeConverter}}"/>
                        </StackLayout>
                    <StackLayout Grid.Row="1" Grid.Column="0" Padding="5,0" HorizontalOptions="Center" VerticalOptions="Center">
                            <!--<controls:CircleImage 
                                                    x:Name="HomeTeamLogo"
                                                    Source="{Binding HomeTeam.TeamLogo, Converter={StaticResource imageConverter}}"
                                                    FillColor="White"
                                                  HeightRequest="30"
                                                  WidthRequest="30"
                                                  
                                                  Aspect="AspectFit" />-->
                        <Frame HeightRequest="40" WidthRequest="40" CornerRadius="20" Padding="0">
                        <ff:CachedImage Source="{Binding HomeTeam.TeamLogo, Converter={StaticResource imageConverter}}"
                                                        ErrorPlaceholder="ontrack.png"
                                        LoadingPlaceholder="ontrack.png"
                                                        CacheDuration="50"
                                                        RetryCount="3"
                                                        RetryDelay="600"
                                        Aspect="AspectFit"
                                        HeightRequest="30"
                                                  WidthRequest="30"
                                                        DownsampleToViewSize="True">  
                                            <!--<ff:CachedImage.Transformations>  
                                                <ffTransformations:CircleTransformation />  
                                            </ff:CachedImage.Transformations>-->  
                                        </ff:CachedImage>
                            </Frame>
                    </StackLayout>
                    <StackLayout Grid.Row="1" Grid.Column="4" Padding="5,0" HorizontalOptions="Center" VerticalOptions="Center">
                            <!--<controls:CircleImage 
                                                  x:Name="AwayTeamLogo"
                                                    Source="{Binding AwayTeam.TeamLogo, Converter={StaticResource imageConverter}}"
                                                    FillColor="White"
                                                  HeightRequest="30"
                                                  WidthRequest="30"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                                  Aspect="AspectFit"/>-->
                        <Frame HeightRequest="40" WidthRequest="40" CornerRadius="20" Padding="0">
                        <ff:CachedImage Source="{Binding AwayTeam.TeamLogo, Converter={StaticResource imageConverter}}"
                                                        ErrorPlaceholder="ontrack.png"
                                        LoadingPlaceholder="ontrack.png"
                                                        CacheDuration="50"
                                                        RetryCount="3"
                                                        RetryDelay="600"
                                        Aspect="AspectFit"
                                        HeightRequest="30"
                                                  WidthRequest="30"
                                                        DownsampleToViewSize="True">  
                                            <!--<ff:CachedImage.Transformations>  
                                                <ffTransformations:CircleTransformation />  
                                            </ff:CachedImage.Transformations>-->  
                                        </ff:CachedImage>
                            </Frame>
                    </StackLayout>
                            <StackLayout IsVisible="{Binding Date, Converter={StaticResource isPastFixtureConverter}}" Grid.Row="1" Grid.Column="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                         Orientation="Vertical"
                                 Padding="5,2"
                                 Spacing="5">
                            <StackLayout IsVisible="{Binding Match.IsPenalties}" Orientation="Horizontal" HorizontalOptions="Center" >
                            <Label x:Name="HomeTeamPenaltyLabel"
                                   FontSize="Micro"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                        Text="{Binding Match.HomeTeamPenalty, StringFormat='({0}'}"/>
                            <Label 
                                   
                                   FontSize="Micro"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                   TextColor="White"
                                        Text="-"/>
                            <Label x:Name="AwayTeamPenaltyLabel"
                                   FontSize="Micro"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                        Text="{Binding Match.AwayTeamPenalty, StringFormat='{0})'}"/>
                                
                        </StackLayout>
                     <StackLayout  Orientation="Horizontal"  HorizontalOptions="Center" >
                            <Label x:Name="HomeTeamScoreLabel"
                                   FontSize="Medium"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                        Text="{Binding Match.HomeTeamScore}"/>
                            <Label 
                                   x:Name="Versus"
                                   FontSize="Small"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                   TextColor="White"
                                        Text="{Binding Match.HomeTeamScore, Converter={StaticResource showScoreConverter}}"/>
                            <Label x:Name="AwayTeamScoreLabel"
                                   FontSize="Medium"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                        Text="{Binding Match.AwayTeamScore}"/>
                                
                        </StackLayout>
                    </StackLayout>
                    <StackLayout IsVisible="{Binding Date, Converter={StaticResource isUpcomingFixtureConverter}}"  Grid.Row="1" Grid.Column="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                         Orientation="Horizontal"
                                 Padding="5,2"
                                 Spacing="0">
                            <Label 
                                   x:Name="Vers"
                                   FontSize="Medium"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                   TextColor="White"
                                        Text="V"/>
                                
                        </StackLayout>
                            <StackLayout Grid.Row="1" Grid.Column="1"
                                 VerticalOptions="Center"
                                     HorizontalOptions="StartAndExpand"
                                 Padding="5,2"
                                 Spacing="0">
                                <Label x:Name="HomeTeamAlias" Text="{Binding HomeTeam.Alias}" IsVisible="false"/>
                            <Label x:Name="HomeTeamNameLabel"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                        Text="{Binding HomeTeam.Name, Converter={StaticResource teamNameConverter}, ConverterParameter={x:Reference HomeTeamAlias}}"/>
                        </StackLayout>
                            <StackLayout Grid.Row="1" Grid.Column="3"
                                 VerticalOptions="Center"
                                     HorizontalOptions="EndAndExpand"
                                 Padding="5,2"
                                 Spacing="0">
                                <Label x:Name="AwayTeamAlias" Text="{Binding AwayTeam.Alias}" IsVisible="false"/>
                            <Label x:Name="AwayTeamNameLabel"
                                   FontSize="12"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                        Text="{Binding AwayTeam.Name, Converter={StaticResource teamNameConverter}, ConverterParameter={x:Reference AwayTeamAlias}}"/>
                        </StackLayout>
                    <BoxView HeightRequest="1" BackgroundColor="White" Grid.ColumnSpan="5" Grid.Row="2" Opacity="0.3"/>
                        </Grid>
                    </StackLayout>
            </DataTemplate>
            <!--<DataTemplate x:Name="FixtureItemTemplate"  x:Key="FixtureItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="FillAndExpand"
                             Padding="10,5">
                    <Frame HasShadow="false"
                           CornerRadius="10"
                           IsClippedToBounds="true"
                           Padding="0"
                           BackgroundColor="#ECEFF1">
                <Grid x:Name="grid"
                      Padding="0"
                      RowSpacing="5"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">    
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                            <RowDefinition Height="25" />
                            <RowDefinition Height="25" />
                            <RowDefinition Height="25" />
                    </Grid.RowDefinitions>
                        <StackLayout Grid.Column="0" Grid.RowSpan="2" Grid.Row="1"
                                 VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                 Padding="5,2">
                                <Label x:Name="TimeIcon"
                                   FontSize="20"
                                   TextColor="Black"
                                       HorizontalTextAlignment="Center"
                                        Text="&#xe904;"
                                       FontFamily="{StaticResource fontFamily}"/>
                            <Label x:Name="TimeLabel"
                                   FontSize="10"
                                   TextColor="Black"
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding Time,
                                                StringFormat='{0:h:mm tt}'}"/>
                        </StackLayout>
                            
                            <StackLayout Grid.Row="1" Grid.Column="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                 Padding="5,2"
                                 Spacing="0">
                            <Label x:Name="HomeTeamScoreLabel"
                                   FontSize="15"
                                   TextColor="{StaticResource primaryDarkBlue}"
                                   FontAttributes="Bold"
                                        Text="{Binding HomeTeamScore}"/>
                        </StackLayout>
                            <StackLayout Grid.Row="2" Grid.Column="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                 Padding="5,2"
                                 Spacing="0">
                            <Label x:Name="AwayTeamScoreLabel"
                                   FontSize="15"
                                   TextColor="{StaticResource primaryDarkBlue}"
                                   FontAttributes="Bold"
                                        Text="{Binding AwayTeamScore}"/>
                                
                        </StackLayout>
                            <StackLayout Grid.Row="1" Grid.Column="1"
                                 VerticalOptions="FillAndExpand"
                                     HorizontalOptions="Start"
                                 Padding="5,2"
                                 Spacing="0">
                            <Label x:Name="HomeTeamNameLabel"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="Black"
                                        Text="{Binding HomeTeamName}"/>
                        </StackLayout>
                            <StackLayout Grid.Row="2" Grid.Column="1"
                                 VerticalOptions="FillAndExpand"
                                     HorizontalOptions="Start"
                                 Padding="5,2"
                                 Spacing="0">
                            <Label x:Name="AwayTeamNameLabel"
                                   FontSize="14"
                                   TextColor="Black"
                                   FontAttributes="Bold"
                                        Text="{Binding AwayTeamName}"/>
                        </StackLayout>
                            <StackLayout Grid.Row="0" Grid.ColumnSpan="3"
                                         BackgroundColor="{StaticResource primaryDarkBlue}"
                                 VerticalOptions="FillAndExpand"
                                     HorizontalOptions="FillAndExpand"
                                         Orientation="Horizontal"
                                 Padding="5,2"
                                 Spacing="0">
                            <Label x:Name="MatchType"
                                   FontSize="14"
                                   TextColor="White"
                                   HorizontalOptions="StartAndExpand"
                                   FontAttributes="Bold"
                                        Text="{Binding LeagueName}"/>
                                <Label x:Name="MatchDate"
                                   FontSize="14"
                                       HorizontalOptions="EndAndExpand"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                        Text="{Binding Date,
                                                StringFormat='{0:MMM dd yyyy}'}"/>
                        </StackLayout>
                        </Grid>
                        </Frame>
                    </StackLayout>
            </DataTemplate>-->
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid HorizontalOptions="FillAndExpand" RowSpacing="0" VerticalOptions="FillAndExpand" BackgroundColor="{StaticResource primaryDarkBlueTwo}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!--<BoxView HeightRequest="1" Opacity=".3" HorizontalOptions="FillAndExpand" BackgroundColor="White"/>-->
        <tabView:SfTabView Grid.Row="0" IsVisible="{Binding IsTableExist}"
                        VisibleHeaderCount="2"
                                 BackgroundColor="{StaticResource primaryDarkBlueTwo}"
                                 DisplayMode="Text"
                           SelectedIndex="0"
                           SelectionChanged="TabViewChanged"
                                TabHeight="50">
                        <tabView:SfTabView.SelectionIndicatorSettings>
                <tabView:SelectionIndicatorSettings Color="Transparent" 
                                                              Position="Fill" 
                                                              StrokeThickness="3"/>
                </tabView:SfTabView.SelectionIndicatorSettings>
                        
                        <tabView:SfTabItem SelectionColor="White">
                        <tabView:SfTabItem.HeaderContent>
                        <StackLayout VerticalOptions="Center"
                                     HorizontalOptions="CenterAndExpand"
                                     Orientation="Horizontal">
                        <Label x:Name="FixtureLabel" HorizontalTextAlignment="Center" 
                               VerticalTextAlignment="Center" 
                               HorizontalOptions="CenterAndExpand"
                               HeightRequest="50"
                               
                               FontAttributes="Bold"
                               Text="Fixtures"
                               TextColor="White">
                            <Label.FontSize>
                                    <OnPlatform x:TypeArguments="x:Double">  
                        <OnPlatform.Android> 
                            <OnIdiom x:TypeArguments="x:Double" Phone="14"  Tablet="17" /> 
                        </OnPlatform.Android> 
                        <OnPlatform.iOS> 
                            <OnIdiom x:TypeArguments="x:Double"  Phone="13"  Tablet="16" /> 
                        </OnPlatform.iOS> 
                    </OnPlatform> 
                                </Label.FontSize>
                        </Label>
                    </StackLayout>
                        </tabView:SfTabItem.HeaderContent>
                        <tabView:SfTabItem.Content>
                        <Grid BackgroundColor="{StaticResource primaryDarkBlueTwo}" Padding="0,0,0,0"
                              HorizontalOptions="FillAndExpand"
                              VerticalOptions="FillAndExpand" RowSpacing="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="3" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <BoxView HeightRequest="3" HorizontalOptions="FillAndExpand" BackgroundColor="{StaticResource primaryPink}"/>
                        <pullToRefresh:SfPullToRefresh Grid.Row="1" x:Name="pullToRefresh" Refreshing="PullToRefreshFixtures_Refreshing"
                               ProgressBackgroundColor="White" ProgressStrokeColor="{StaticResource primaryDarkBlueTwo}" RefreshContentHeight="50" 
                               RefreshContentWidth="50" TransitionMode="Push" IsRefreshing="False">
                            <pullToRefresh:SfPullToRefresh.PullableContent>
                            <!--<listView:SfListView x:Name="FixtureList"
                                                ItemsSource="{Binding FixtureCollection}"
                                                    HorizontalOptions="FillAndExpand"
                                                    VerticalOptions="FillAndExpand"
                                                    BackgroundColor="{StaticResource primaryDarkBlueTwo}"
                                                    ItemTemplate="{StaticResource FixtureItemTemplate}"
                                                   SelectionMode="Single"
                                                   ItemSpacing="0"
                                                    SelectionBackgroundColor="{StaticResource primaryBarBlue}"
                                                 ItemSize="100">
                                    <listView:SfListView.DataSource>
                                  <data:DataSource>
                                    <data:DataSource.SortDescriptors>
                                      <data:SortDescriptor PropertyName="Date" Direction="Descending"/>
                                    </data:DataSource.SortDescriptors>
                                  </data:DataSource>
                                </listView:SfListView.DataSource>
                                    <listView:SfListView.GroupHeaderTemplate>
                                  <DataTemplate>
                                      <ViewCell>
                                        <ViewCell.View>
                                          <Grid Padding="10,0">
                                                <Label Grid.Row="0" Text="{Binding Key, 
                                                            Converter={StaticResource groupHeaderNameConverter}}"
                                                     FontSize="Medium"
                                                     FontAttributes="Bold"
                                                    VerticalOptions="Center" HorizontalOptions="Start"
                                                     TextColor="White"/>
                                          </Grid>
                                        </ViewCell.View>
                                      </ViewCell>
                                  </DataTemplate>
                                </listView:SfListView.GroupHeaderTemplate>
                                </listView:SfListView>-->
                                <listView:SfListView x:Name="FixtureList"
                                                ItemsSource="{Binding FixtureCollection}"
                                                     LoadMoreOption="Auto"
                                                     LoadMoreCommand="{Binding LoadMoreItemsCommand}"
                                                     LoadMoreCommandParameter="{Binding Source={x:Reference Name=FixtureList}}"
                                                    HorizontalOptions="FillAndExpand"
                                                    VerticalOptions="FillAndExpand"
                                                    BackgroundColor="{StaticResource primaryDarkBlueTwo}"
                                                    ItemTemplate="{StaticResource FixtureItemTemplate}"
                                                   SelectionMode="Single"
                                                   ItemSpacing="0"
                                                     SelectionChanged="OnFixtureSelected"
                                                    SelectionBackgroundColor="{StaticResource primaryPink}"
                                                 ItemSize="92">
                                    <listView:SfListView.HeaderTemplate>
                                    <DataTemplate>
                                      <ViewCell>
                                        <Grid IsVisible="{Binding IsLoadMoreVisible}">
                                          <Grid Padding="5">
                                            <Button BackgroundColor="{StaticResource primaryBarBlue}" Text="Previous Fixtures" Padding="10,0" CornerRadius="5" TextColor="White" Clicked="LoadMoreClicked" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"/>
                                          </Grid>
                                          <!--<listView:LoadMoreIndicator Color="White" IsRunning="True" IsVisible="{Binding IsActivityVisible}"/>-->
                                        </Grid>
                                      </ViewCell>
                                    </DataTemplate>
                                  </listView:SfListView.HeaderTemplate>
                                    <listView:SfListView.DataSource>
                                  <data:DataSource>
                                    <data:DataSource.SortDescriptors>
                                      <data:SortDescriptor PropertyName="Date" Direction="Ascending"/>
                                    </data:DataSource.SortDescriptors>
                                    <data:DataSource.GroupDescriptors>
                                      <!--<data:GroupDescriptor PropertyName="MatchType.Name"/>-->
                                        <data:GroupDescriptor PropertyName="Date"/>
                                    </data:DataSource.GroupDescriptors>
                                  </data:DataSource>
                                </listView:SfListView.DataSource>
                                    <listView:SfListView.GroupHeaderTemplate>
                                  <DataTemplate>
                                      <ViewCell>
                                        <ViewCell.View>
                                          <Grid>
                                              <Grid.ColumnDefinitions>
                                                  <ColumnDefinition Width="*"/>
                                                  <ColumnDefinition Width="*"/>
                                              </Grid.ColumnDefinitions>
                                              <BoxView BackgroundColor="{StaticResource primaryPink}" Grid.ColumnSpan="2" Opacity=".5"/>
                                              <StackLayout Padding="10,0" Grid.Column="0"  VerticalOptions="Center" HorizontalOptions="Start">
                                                <Label x:Name="matchTypeLabel" Text="{Binding ., 
                                                            Converter={StaticResource groupingLeagueDateSelectionConverter}, ConverterParameter={x:Reference matchTypeLabel}}"
                                                     FontSize="14"
                                                     FontAttributes="Bold"
                                                    VerticalOptions="Center" HorizontalOptions="Start"
                                                     TextColor="White"/>
                                                  </StackLayout>
                                              <StackLayout Grid.Column="1" Padding="10,0" VerticalOptions="Center" HorizontalOptions="EndAndExpand">
                                              <Label Text="{Binding ., Converter={StaticResource groupingLeagueDateSelectionConverter}, ConverterParameter={x:Reference FixtureList}}"
                                                     FontSize="14"
                                                     FontAttributes="Bold"
                                                    VerticalOptions="Center" HorizontalOptions="EndAndExpand"
                                                     TextColor="White"/>
                                                  </StackLayout>
                                          </Grid>
                                        </ViewCell.View>
                                      </ViewCell>
                                  </DataTemplate>
                                </listView:SfListView.GroupHeaderTemplate>
                                </listView:SfListView>
                            </pullToRefresh:SfPullToRefresh.PullableContent>
 </pullToRefresh:SfPullToRefresh>
                        </Grid>
                        </tabView:SfTabItem.Content>
                    </tabView:SfTabItem>
                <tabView:SfTabItem SelectionColor="White">
                            <tabView:SfTabItem.HeaderContent>
                        <StackLayout VerticalOptions="Center"
                                     HorizontalOptions="CenterAndExpand"
                                     Orientation="Horizontal">
                        <Label  x:Name="TableLabel" HorizontalTextAlignment="Center" 
                               VerticalTextAlignment="Center" 
                               HorizontalOptions="CenterAndExpand"
                               HeightRequest="50"
                               
                               FontAttributes="Bold"
                               Text="Table"
                               TextColor="Gray">
                            <Label.FontSize>
                                    <OnPlatform x:TypeArguments="x:Double">  
                        <OnPlatform.Android> 
                            <OnIdiom x:TypeArguments="x:Double" Phone="14"  Tablet="17" /> 
                        </OnPlatform.Android> 
                        <OnPlatform.iOS> 
                            <OnIdiom x:TypeArguments="x:Double"  Phone="13"  Tablet="16" /> 
                        </OnPlatform.iOS> 
                    </OnPlatform> 
                                </Label.FontSize>
                        </Label>
                    </StackLayout>
                        </tabView:SfTabItem.HeaderContent>
                            <tabView:SfTabItem.Content>
                                <Grid HorizontalOptions="FillAndExpand" Padding="0,0,0,0"
                              VerticalOptions="FillAndExpand"
                              BackgroundColor="{StaticResource primaryDarkBlueTwo}"
