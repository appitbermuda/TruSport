<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:tabView="clr-namespace:Syncfusion.XForms.TabView;assembly=Syncfusion.SfTabView.XForms"
             xmlns:controls="clr-namespace:ImageCircle.Forms.Plugin.Abstractions;assembly=ImageCircle.Forms.Plugin"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             xmlns:ff="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"  
             xmlns:ffSvg="clr-namespace:FFImageLoading.Svg.Forms;assembly=FFImageLoading.Svg.Forms"  
             xmlns:ffTransformations="clr-namespace:FFImageLoading.Transformations;assembly=FFImageLoading.Transformations"
             xmlns:data="clr-namespace:Syncfusion.DataSource;assembly=Syncfusion.DataSource.Portable"
             xmlns:local="clr-namespace:TruSport.ViewModels"
             xmlns:model="clr-namespace:TruSport.Model"
             xmlns:converter="clr-namespace:TruSport.Converters"
             xmlns:extension="clr-namespace:TruSport.Extensions"
             x:Class="TruSport.Views.Football.FavouritePage"
             Title="Favourites"
             Icon="FootballFavourites24.png">
    <ContentPage.BindingContext>
        <local:FavouritePageViewModel x:Name="viewModel"/>
    </ContentPage.BindingContext>
    <ContentPage.ToolbarItems>
<!--        <ToolbarItem x:Name="AdminToolbarItem" Icon="Admin32.png" Activated="AdminClicked" Order="Primary" Priority="1" />-->
<!--        <ToolbarItem x:Name="DeleteToolbarItem" Icon="DeleteWhite.png" Activated="DeleteClicked" Order="Primary" Priority="1" />-->
    </ContentPage.ToolbarItems>
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:ImageConverter x:Key="imageConverter"/>
            <converter:InverseBooleanConverter x:Key="inverseBooleanConverter"/>
            <converter:TeamNameConverter x:Key="teamNameConverter" />
        <converter:GroupHeaderNameConverter x:Key="groupHeaderNameConverter"/>
            <converter:GroupHeaderSizeConverter x:Key="groupHeaderSizeConverter"/>
            <converter:GroupHeaderFontConverter x:Key="groupHeaderFontConverter"/>
            <converter:GroupingSelectionConverter x:Key="groupingSelectionConverter"/>
            <converter:GroupingTeamConverter x:Key="groupingTeamConverter"/>
            <converter:FavouriteValueConverter x:Key="favouriteValueConverter"/>
            <converter:TimeConverter x:Key="timeConverter"/>
            <converter:ShowScoreConverter x:Key="showScoreConverter"/>
            <OnPlatform x:TypeArguments="x:String" x:Key="fontFamily" iOS="icomoon" Android="icomoon.ttf#icomoon" />
            <DataTemplate x:Name="PastItemTemplate"  x:Key="PastItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="FillAndExpand">
                <Grid x:Name="grid" Padding="0,10,0,0"
                      RowSpacing="5"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">    
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                            <RowDefinition Height="20" />
                            <RowDefinition Height="50" />
                        <RowDefinition Height="1" />
                    </Grid.RowDefinitions>
                        <StackLayout Grid.Row="0" Grid.Column="0"  Grid.ColumnSpan="3" Spacing="5" Padding="5,2"
                                 VerticalOptions="EndAndExpand"
                                     HorizontalOptions="StartAndExpand"
                                     Orientation="Horizontal">
                            <StackLayout Padding="2">
                                <Label x:Name="FieldIcon"
                                   FontSize="Small"
                                       Text="&#xe901;"
                                       VerticalOptions="Center"
                                   TextColor="White"
                                    FontFamily="{StaticResource fontFamily}"/>
                                </StackLayout>
                            <StackLayout>
                                <Label x:Name="FieldName"
                                   FontSize="Small"
                                   TextColor="White"
                                    Text="{Binding Field.Name}"/>
                                </StackLayout>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="EndAndExpand"
                                     Orientation="Horizontal"
                                 Padding="5,2">
                                <Label x:Name="TimeIcon"
                                   FontSize="Small"
                                   TextColor="White"
                                        Text="&#xe904;"
                                       FontFamily="{StaticResource fontFamily}"/>
                            
                        <!--<Label x:Name="IsPostponedLabel" Text="{Binding IsPostponed}" IsVisible="false"/>-->
                            <Label x:Name="TimeLabel"
                                   FontSize="Small"
                                   TextColor="White"
                                   IsVisible="{Binding IsPostponed, Converter={StaticResource inverseBooleanConverter}}"
                                   VerticalTextAlignment="End"
                                        Text="{Binding Time, Converter={StaticResource timeConverter}}"/>
                            <Label x:Name="PostponedLabel"
                                   IsVisible="{Binding IsPostponed}"
                                   FontSize="Small"
                                   TextColor="White"
                                   VerticalTextAlignment="End"
                                        Text="Postp."/>
                        </StackLayout>
                    <StackLayout Grid.Row="1" Grid.Column="0" Padding="5,0" HorizontalOptions="Center" VerticalOptions="Center">
                            <!--<controls:CircleImage 
                                                    x:Name="HomeTeamLogo"
                                                    Source="{Binding HomeTeam.TeamLogo, Converter={StaticResource imageConverter}}"
                                                    FillColor="White"
                                                  HeightRequest="30"
                                                  WidthRequest="30"
                                                  
                                                  Aspect="AspectFit" />-->
                        <Frame HeightRequest="40" WidthRequest="40" CornerRadius="20" Padding="0">
                        <ff:CachedImage Source="{Binding HomeTeam.TeamLogo, Converter={StaticResource imageConverter}}"
                                                        ErrorPlaceholder="ontrack.png"
                                        LoadingPlaceholder="ontrack.png"
                                                        CacheDuration="50"
                                                        RetryCount="3"
                                                        RetryDelay="600"
                                        Aspect="AspectFit"
                                        HeightRequest="30"
                                                  WidthRequest="30"
                                                        DownsampleToViewSize="True">  
                                            <!--<ff:CachedImage.Transformations>  
                                                <ffTransformations:CircleTransformation />  
                                            </ff:CachedImage.Transformations>-->  
                                        </ff:CachedImage>
                            </Frame>
                    </StackLayout>
                    <StackLayout Grid.Row="1" Grid.Column="4" Padding="5,0" HorizontalOptions="Center" VerticalOptions="Center">
                            <!--<controls:CircleImage 
                                                  x:Name="AwayTeamLogo"
                                                    Source="{Binding AwayTeam.TeamLogo, Converter={StaticResource imageConverter}}"
                                                    FillColor="White"
                                                  HeightRequest="30"
                                                  WidthRequest="30"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                                  Aspect="AspectFit"/>-->
                        <Frame HeightRequest="40" WidthRequest="40" CornerRadius="20" Padding="0" BackgroundColor="White">
                        <ff:CachedImage Source="{Binding AwayTeam.TeamLogo, Converter={StaticResource imageConverter}}"
                                                        ErrorPlaceholder="ontrack.png"
                                        LoadingPlaceholder="ontrack.png"
                                                        CacheDuration="50"
                                                        RetryCount="3"
                                                        RetryDelay="600"
                                        Aspect="AspectFit"
                                        HeightRequest="30"
                                                  WidthRequest="30"
                                                        DownsampleToViewSize="True">  
                                            <!--<ff:CachedImage.Transformations>  
                                                <ffTransformations:CircleTransformation />  
                                            </ff:CachedImage.Transformations>-->  
                                        </ff:CachedImage>
                            </Frame>
                    </StackLayout>
                    <StackLayout Grid.Row="1" Grid.Column="2" VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                         Orientation="Vertical"
                                 Padding="5,2"
                                 Spacing="5">
                            <StackLayout IsVisible="{Binding Match.IsPenalties}" Orientation="Horizontal" HorizontalOptions="Center" >
                            <Label x:Name="HomeTeamPenaltyLabel"
                                   FontSize="Micro"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                        Text="{Binding Match.HomeTeamPenalty, StringFormat='({0}'}"/>
                            <Label 
                                   
                                   FontSize="Micro"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                   TextColor="White"
                                        Text="-"/>
                            <Label x:Name="AwayTeamPenaltyLabel"
                                   FontSize="Micro"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                        Text="{Binding Match.AwayTeamPenalty, StringFormat='{0})'}"/>
                                
                        </StackLayout>
                     <StackLayout  Orientation="Horizontal"  HorizontalOptions="Center" >
                            <Label x:Name="HomeTeamScoreLabel"
                                   FontSize="Medium"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                        Text="{Binding Match.HomeTeamScore}"/>
                            <Label 
                                   x:Name="Versus"
                                   FontSize="Small"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                   TextColor="White"
                                        Text="{Binding Match.HomeTeamScore, Converter={StaticResource showScoreConverter}}"/>
                            <Label x:Name="AwayTeamScoreLabel"
                                   FontSize="Medium"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                        Text="{Binding Match.AwayTeamScore}"/>
                                
                        </StackLayout>
                    </StackLayout>
                            <StackLayout Grid.Row="1" Grid.Column="1"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="5,2"
                                 Spacing="0">
                                <Label x:Name="HomeTeamAlias" Text="{Binding HomeTeam.Alias}" IsVisible="false"/>
                            <Label x:Name="HomeTeamNameLabel"
                                   
                                   HorizontalOptions="EndAndExpand"
                                   HorizontalTextAlignment="End"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                        Text="{Binding HomeTeam.Name, Converter={StaticResource teamNameConverter}, ConverterParameter={x:Reference HomeTeamAlias}}">
                                <Label.FontSize>
                                    <OnPlatform x:TypeArguments="x:Double">  
                        <OnPlatform.Android> 
                            <OnIdiom x:TypeArguments="x:Double" Phone="10"  Tablet="17" /> 
                        </OnPlatform.Android> 
                        <OnPlatform.iOS> 
                            <OnIdiom x:TypeArguments="x:Double"  Phone="11"  Tablet="16" /> 
                        </OnPlatform.iOS> 
                    </OnPlatform> 
                                </Label.FontSize>
                            </Label>
                        </StackLayout>
                            <StackLayout Grid.Row="1" Grid.Column="3"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="5,2"
                                 Spacing="0">
                                <Label x:Name="AwayTeamAlias" Text="{Binding AwayTeam.Alias}" IsVisible="false"/>
                            <Label x:Name="AwayTeamNameLabel"
                                   
                                   HorizontalOptions="StartAndExpand"
                                   HorizontalTextAlignment="Start"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                        Text="{Binding AwayTeam.Name, Converter={StaticResource teamNameConverter}, ConverterParameter={x:Reference AwayTeamAlias}}">
                                <Label.FontSize>
                                    <OnPlatform x:TypeArguments="x:Double">  
                        <OnPlatform.Android> 
                            <OnIdiom x:TypeArguments="x:Double" Phone="10"  Tablet="17" /> 
                        </OnPlatform.Android> 
                        <OnPlatform.iOS> 
                            <OnIdiom x:TypeArguments="x:Double"  Phone="11"  Tablet="16" /> 
                        </OnPlatform.iOS> 
                    </OnPlatform> 
                                </Label.FontSize>
                            </Label>
                        </StackLayout>
                    <StackLayout Grid.RowSpan="2"  Grid.Column="5" VerticalOptions="Center" Padding="0" Spacing="0">
                        <Button x:Name="DeleteButton" BackgroundColor="Transparent" Padding="0" VerticalOptions="Center" FontSize="Small" Text="" FontFamily="{StaticResource fontAwesomeSolidFamily}" TextColor="DarkRed" Command="{Binding Path=BindingContext.DeleteFixtureFavouriteCommand, Source={x:Reference FavouriteFixtureList}}" CommandParameter="{Binding .}"/>
                    </StackLayout>
                    <BoxView HeightRequest="1" BackgroundColor="White" Grid.ColumnSpan="6" Grid.Row="2" Opacity="0.3"/>
                        </Grid>
                    </StackLayout>
            </DataTemplate>
            <DataTemplate x:Name="FixtureItemTemplate"  x:Key="FixtureItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="FillAndExpand"
                             Padding="5">
                    <Frame HasShadow="false"
                           CornerRadius="5"
                           IsClippedToBounds="true"
                           Padding="0"
                           BackgroundColor="#ECEFF1">
                <Grid x:Name="grid"
                      Padding="0"
                      RowSpacing="5"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">    
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                            <RowDefinition Height="25" />
                            <RowDefinition Height="25" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="25" />
                    </Grid.RowDefinitions>
                        <!--<StackLayout Grid.Row="0" Grid.Column="0"  Grid.ColumnSpan="5"
                                 VerticalOptions="EndAndExpand"
                                     HorizontalOptions="CenterAndExpand"
                                     Orientation="Horizontal"
                                 Padding="0">
                                <Label x:Name="FieldIcon"
                                   FontSize="20"
                                       Text="&#xe901;"
                                       VerticalOptions="Center"
                                   TextColor="Black"
                                    FontFamily="{StaticResource fontFamily}"/>
                                <Label x:Name="FieldName"
                                   FontSize="16"
                                   TextColor="Black"
                                    Text="{Binding FieldName}"/>
                        </StackLayout>-->
                        <StackLayout Grid.Column="0" Grid.RowSpan="2" Grid.Row="0"
                                 VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                 Padding="5,2">
                                <Label x:Name="TimeIcon"
                                   FontSize="20"
                                   TextColor="Black"
                                       HorizontalTextAlignment="Center"
                                        Text="&#xe904;"
                                       FontFamily="{StaticResource fontFamily}"/>
                            <Label x:Name="TimeLabel"
                                   FontSize="10"
                                   TextColor="Black"
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding Time, Converter={StaticResource timeConverter}}"/>
                        </StackLayout>
                            <!--<controls:CircleImage Grid.Row="2" Grid.Column="0"
                                                    x:Name="HomeTeamLogo"
                                                    Source="{Binding HomeTeamLogo}"
                                                    FillColor="White"
                                                  HeightRequest="100"
                                                  WidthRequest="100"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                                  Aspect="AspectFit"/>
                            <controls:CircleImage Grid.Row="2" Grid.Column="4" 
                                                  x:Name="AwayTeamLogo"
                                                    Source="{Binding AwayTeamLogo}"
                                                    FillColor="White"
                                                  HeightRequest="100"
                                                  WidthRequest="100"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                                  Aspect="AspectFit"/>-->
                            <!--<Label Grid.Row="2" Grid.Column="2"
                                   x:Name="Versus"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                   TextColor="Black"
                                        Text="-"/>-->
                            <StackLayout Grid.Row="0" Grid.Column="2"
                                 VerticalOptions="CenterAndExpand"
                                     HorizontalOptions="Center"
                                 Padding="5,2"
                                 Spacing="0">
                            <Label x:Name="HomeTeamScoreLabel"
                                   FontSize="15"
                                   TextColor="{StaticResource primaryDarkBlue}"
                                   FontAttributes="Bold"
                                        Text="{Binding Match.HomeTeamScore}"/>
                        </StackLayout>
                            <StackLayout Grid.Row="1" Grid.Column="2"
                                 VerticalOptions="CenterAndExpand"
                                     HorizontalOptions="Center"
                                 Padding="5,2"
                                 Spacing="0">
                            <Label x:Name="AwayTeamScoreLabel"
                                   FontSize="15"
                                   TextColor="{StaticResource primaryDarkBlue}"
                                   FontAttributes="Bold"
                                        Text="{Binding Match.AwayTeamScore}"/>
                                
                        </StackLayout>
                            <StackLayout Grid.Row="0" Grid.Column="1"
                                 VerticalOptions="CenterAndExpand"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="5,2"
                                 Spacing="0">
                                <Label x:Name="HomeTeamAlias" Text="{Binding HomeTeam.Alias}" IsVisible="false"/>
                            <Label x:Name="HomeTeamNameLabel"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   HorizontalOptions="EndAndExpand"
                                   HorizontalTextAlignment="End"
                                   TextColor="Black"
                                        Text="{Binding HomeTeam.Name, Converter={StaticResource teamNameConverter}, ConverterParameter={x:Reference HomeTeamAlias}}"/>
                        </StackLayout>
                            <StackLayout Grid.Row="1" Grid.Column="1"
                                 VerticalOptions="CenterAndExpand"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="5,2"
                                 Spacing="0">
                                <Label x:Name="AwayTeamAlias" Text="{Binding AwayTeam.Alias}" IsVisible="false"/>
                            <Label x:Name="AwayTeamNameLabel"
                                   HorizontalOptions="StartAndExpand"
                                   HorizontalTextAlignment="Start"
                                   FontSize="14"
                                   TextColor="Black"
                                   FontAttributes="Bold"
                                        Text="{Binding AwayTeam.Name, Converter={StaticResource teamNameConverter}, ConverterParameter={x:Reference AwayTeamAlias}}"/>
                        </StackLayout>
                    <StackLayout  Grid.Column="3" VerticalOptions="Center" Padding="0" Spacing="0">
                        <Button x:Name="DeleteButton" BackgroundColor="Transparent" Padding="0" VerticalOptions="Center" FontSize="Small" Text="" FontFamily="{StaticResource fontAwesomeSolidFamily}" TextColor="DarkRed" Command="{Binding Path=BindingContext.DeleteFixtureFavouriteCommand, Source={x:Reference TeamsList}}" CommandParameter="{Binding .}"/>
                    </StackLayout>
                    <BoxView Grid.Row="2" Grid.ColumnSpan="4" HeightRequest="1" HorizontalOptions="FillAndExpand" BackgroundColor="{StaticResource primaryPink}"/>
                            <StackLayout Grid.Row="3" Grid.ColumnSpan="4"
                                 VerticalOptions="FillAndExpand"
                                     HorizontalOptions="CenterAndExpand"
                                         Orientation="Horizontal"
                                 Padding="5,2"
                                 Spacing="10">
                            <Label x:Name="FieldIcon"
                                   FontSize="14"
                                   TextColor="Black"
                                   HorizontalOptions="Start"
                                        Text="&#xe901;"
                                   FontFamily="{StaticResource fontFamily}"/>
                                <Label x:Name="FieldName"
                                   FontSize="14"
                                       HorizontalOptions="StartAndExpand"
                                   TextColor="Black"
                                        Text="{Binding Field.Name}"/>
                        </StackLayout>
                        </Grid>
                        </Frame>
                    </StackLayout>
            </DataTemplate>
            <DataTemplate x:Name="TeamItemTemplate"  x:Key="TeamItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="FillAndExpand"
                             Padding="0">
                <Grid x:Name="grid"
                      RowSpacing="0"
                      BackgroundColor="{StaticResource primaryDarkBlueTwo}"
                      VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" ColumnSpacing="10">    
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="1" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>
                     <!--<ContentView BackgroundColor="Black" Opacity=".5" Grid.RowSpan="2"/>-->
                    <StackLayout Grid.Column="0" Padding="0" VerticalOptions="Center">
                        <!--<controls:CircleImage Aspect="AspectFit" Source="{Binding TeamLogo, Converter={StaticResource imageConverter}}" VerticalOptions="Center" HorizontalOptions="Center" HeightRequest="40" WidthRequest="40" FillColor="White"/>-->
                        <Frame HeightRequest="40" WidthRequest="40" CornerRadius="20" Padding="0" VerticalOptions="Center" HorizontalOptions="Center">
                        <ff:CachedImage Source="{Binding TeamLogo, Converter={StaticResource imageConverter}}"
                                                        ErrorPlaceholder="ontrack.png"
                                        LoadingPlaceholder="ontrack.png"
                                                        CacheDuration="50"
                                                        RetryCount="3"
                                                        RetryDelay="600"
                                        Aspect="AspectFit"
                                        HeightRequest="30"
                                                  WidthRequest="30"
                                                        DownsampleToViewSize="True">  
                                            <!--<ff:CachedImage.Transformations>  
                                                <ffTransformations:CircleTransformation />  
                                            </ff:CachedImage.Transformations>-->  
                                        </ff:CachedImage>
                            </Frame>
                    </StackLayout>
                    <StackLayout  Grid.Column="1" VerticalOptions="Center" Padding="0" Spacing="0">
                        <Label x:Name="TeamName" VerticalOptions="Center" FontSize="Small" Text="{Binding Name}" LineBreakMode="WordWrap" HorizontalTextAlignment="Start" TextColor="White"/>
                    </StackLayout>
                    <StackLayout  Grid.Column="2" VerticalOptions="Center" Padding="0" Spacing="0">
                        <Button x:Name="DeleteButton" BackgroundColor="Transparent" Padding="0" VerticalOptions="Center" FontSize="Small" Text="" FontFamily="{StaticResource fontAwesomeSolidFamily}" TextColor="DarkRed" Command="{Binding Path=BindingContext.DeleteTeamFavouriteCommand, Source={x:Reference TeamsList}}" CommandParameter="{Binding .}"/>
                    </StackLayout>
                    <BoxView Grid.Row="1" Grid.ColumnSpan="3" HeightRequest="1" Opacity=".3" BackgroundColor="White" HorizontalOptions="FillAndExpand"/>
                        </Grid>
                    </StackLayout>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <StackLayout Spacing="0"
                     Padding="0"
                     HorizontalOptions="FillAndExpand"
                     VerticalOptions="FillAndExpand">
        <Grid x:Name="PageGrid"
              RowSpacing="0"
              BackgroundColor="{StaticResource primaryDarkBlueTwo}"
              HorizontalOptions="FillAndExpand"
              VerticalOptions="FillAndExpand">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <!--<BoxView HeightRequest="1" Opacity=".3"  BackgroundColor="White" HorizontalOptions="FillAndExpand"/>-->
            <tabView:SfTabView Grid.Row="0" IsVisible="{Binding NoConnectivity, Converter={StaticResource inverseBooleanConverter}}"  VisibleHeaderCount="2"
                                 BackgroundColor="{StaticResource primaryDarkBlueTwo}"
                                 DisplayMode="Text"
                               SelectedIndex="0"
                               SelectionChanged="Handle_SelectionChanged"
                                TabHeight="50">
                <tabView:SfTabView.SelectionIndicatorSettings>
                <!--<tabView:SelectionIndicatorSettings Color="{StaticResource primaryDarkBlueOne}" 
                                                              Position="Fill" 
                                                              StrokeThickness="5"/>-->
                        <tabView:SelectionIndicatorSettings Color="White" 
                                                              Position="Bottom" 
                                                          StrokeThickness="0"/>
                </tabView:SfTabView.SelectionIndicatorSettings>
                    <tabView:SfTabItem SelectionColor="White">
                        <tabView:SfTabItem.HeaderContent>
                        <StackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Padding="0,15"
                                     Spacing="2">
                        <Label x:Name="TeamLabel" HorizontalTextAlignment="Center" 
                               VerticalTextAlignment="End"
                               VerticalOptions="Center"
                               HorizontalOptions="CenterAndExpand"
                               
                               FontAttributes="Bold"
                               Text="Teams"
                               TextDecorations="None"
                               TextColor="White">
                            <Label.FontSize>
                                    <OnPlatform x:TypeArguments="x:Double">  
                        <OnPlatform.Android> 
                            <OnIdiom x:TypeArguments="x:Double" Phone="14"  Tablet="17" /> 
                        </OnPlatform.Android> 
                        <OnPlatform.iOS> 
                            <OnIdiom x:TypeArguments="x:Double"  Phone="13"  Tablet="16" /> 
                        </OnPlatform.iOS> 
                    </OnPlatform> 
                                </Label.FontSize>
                        </Label>
                        <!--<BoxView x:Name="TeamSelected" BackgroundColor="White" 
                                 IsVisible="true"
                                 HorizontalOptions="CenterAndExpand" 
                                 VerticalOptions="Center"
                                 HeightRequest="3"/>-->
                    </StackLayout>
                        </tabView:SfTabItem.HeaderContent>
                        <tabView:SfTabItem.Content>
                        <Grid BackgroundColor="{StaticResource primaryDarkBlueTwo}" Padding="0,0,0,0" RowSpacing="0"
                              HorizontalOptions="FillAndExpand"
                              VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="3" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <BoxView HeightRequest="3" HorizontalOptions="FillAndExpand" BackgroundColor="{StaticResource primaryPink}"/>
                            <!--<listView:SfListView Grid.Row="1" x:Name="FavouriteTeamList"
                                                ItemsSource="{Binding FavouriteTeamCollection}"
                                                    HorizontalOptions="FillAndExpand"
                                                    VerticalOptions="FillAndExpand"
                                                    ItemTemplate="{StaticResource TeamItemTemplate}"
                                                   SelectionMode="Single"
                                                   ItemSpacing="0"
                                                    SelectionBackgroundColor="{StaticResource primaryBarBlue}"
                                                 ItemSize="40"
                                />-->
                            <listView:SfListView Grid.Row="1"  x:Name="TeamsList"
                                ItemsSource="{Binding FavouriteTeamCollection}"
                                    ItemTemplate="{StaticResource TeamItemTemplate}"
                                   SelectionMode="Single"
                                                      HorizontalOptions="FillAndExpand"
                                    VerticalOptions="FillAndExpand"

                                   ItemSpacing="0"
                                    SelectionBackgroundColor="{StaticResource primaryPink}"
                                 ItemSize="50"
                                                     IsStickyGroupHeader="True"
                                                     GroupHeaderSize="30"
                                                 SelectionChanged="TeamSelected"
                                                 
                                >
                                    <listView:SfListView.DataSource>
                                    <data:DataSource>
                                    <data:DataSource.GroupDescriptors>
                                                <data:GroupDescriptor PropertyName="League.Name"/>
                                    </data:DataSource.GroupDescriptors>
                                    <data:DataSource.SortDescriptors>
                                      <data:SortDescriptor PropertyName="League.Name" Direction="Descending"/>
                                    </data:DataSource.SortDescriptors>
                                  </data:DataSource>
                                </listView:SfListView.DataSource>
                                    <listView:SfListView.GroupHeaderTemplate>
                                  <DataTemplate>
                                      <ViewCell>
                                        <ViewCell.View>
                                          <Grid HeightRequest="50" >
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <!--<ColumnDefinition Width="*"/>-->
                                                </Grid.ColumnDefinitions>
                                               <BoxView BackgroundColor="{StaticResource primaryPink}" Opacity=".5"/>
                                              <StackLayout Padding="10,0" VerticalOptions="Center" HorizontalOptions="Start">
                                                <Label x:Name="leagueLabel" Text="{Binding ., Converter={StaticResource groupingTeamConverter}, ConverterParameter={x:Reference TeamsList}}"
                                                     FontSize="{Binding Key, 
                                                            Converter={StaticResource groupHeaderSizeConverter}}"
                                                     FontAttributes="Bold"
                                                    VerticalOptions="Center" HorizontalOptions="Start"
                                                     TextColor="White"/>
                                                  </StackLayout>
                                                <!--<Label Grid.Column="1" Text="{Binding ., Converter={StaticResource groupingSelectionConverter}, ConverterParameter={x:Reference PastFixtureList}}"
                                                     FontSize="{Binding Key, 
                                                            Converter={StaticResource groupHeaderSizeConverter}}"
                                                     FontAttributes="Bold"
                                                    VerticalOptions="Center" HorizontalOptions="EndAndExpand"
                                                     TextColor="White"/>-->
                                          </Grid>
                                        </ViewCell.View>
                                      </ViewCell>
                                  </DataTemplate>
                                </listView:SfListView.GroupHeaderTemplate>
                                    </listView:SfListView>
                            <ContentView Grid.Row="1" BackgroundColor="White" IsVisible="{Binding NoTeamFavourites}"/>
                <Grid Grid.Row="1" IsVisible="{Binding NoTeamFavourites}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Image Grid.Row="0"
                       Source="ontrack.png"
                       Aspect="AspectFit"
                           HeightRequest="100"
                           WidthRequest="100"
                       VerticalOptions="End"
                       HorizontalOptions="Center"
                       />
                    <StackLayout Grid.Row="1"
                                 Padding="20,0">
                        <Label Text="There are no teams in Favourites."
                               TextColor="{StaticResource primaryDarkBlueTwo}"
                               FontAttributes="Bold"
                               FontSize="Small"
                               HorizontalTextAlignment="Center"
                               />
                    </StackLayout>
                    
                </Grid>
                        </Grid>
                        </tabView:SfTabItem.Content>
                    </tabView:SfTabItem>
                     <tabView:SfTabItem SelectionColor="White">
                        <tabView:SfTabItem.HeaderContent>
                        <StackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Padding="0,15"
                                     Spacing="2">
                        <Label x:Name="FixtureLabel" HorizontalTextAlignment="Center" 
                               VerticalTextAlignment="End"
                               VerticalOptions="Center"
                               HorizontalOptions="CenterAndExpand"
                               
                               FontAttributes="Bold"
                               Text="Fixtures"
                               TextDecorations="None"
                               TextColor="Gray">
                            <Label.FontSize>
                                    <OnPlatform x:TypeArguments="x:Double">  
                        <OnPlatform.Android> 
                            <OnIdiom x:TypeArguments="x:Double" Phone="14"  Tablet="17" /> 
                        </OnPlatform.Android> 
                        <OnPlatform.iOS> 
                            <OnIdiom x:TypeArguments="x:Double"  Phone="13"  Tablet="16" /> 
                        </OnPlatform.iOS> 
                    </OnPlatform> 
                                </Label.FontSize>
                        </Label>
                        <!--<BoxView x:Name="FixtureSelected" BackgroundColor="White" 
                                 IsVisible="false"
                                 HorizontalOptions="CenterAndExpand" 
                                 VerticalOptions="Center"
                                 HeightRequest="3"/>-->
                    </StackLayout>
                        </tabView:SfTabItem.HeaderContent>
                        <tabView:SfTabItem.Content>
                            <Grid BackgroundColor="{StaticResource primaryDarkBlueTwo}" Padding="0,0,0,0" RowSpacing="0" 
                              HorizontalOptions="FillAndExpand"
                              VerticalOptions="FillAndExpand">
                                <Grid.RowDefinitions>
                                <RowDefinition Height="3" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <BoxView HeightRequest="3" HorizontalOptions="FillAndExpand" BackgroundColor="{StaticResource primaryPink}"/>
                                <listView:SfListView Grid.Row="1" x:Name="FavouriteFixtureList"
                                ItemsSource="{Binding FavouriteFixturesCollection}"
                                    ItemTemplate="{StaticResource PastItemTemplate}"
                                   SelectionMode="SingleDeselect"
                                    HorizontalOptions="FillAndExpand"
                                    VerticalOptions="FillAndExpand"
                                   ItemSpacing="0"
                                    SelectionBackgroundColor="{StaticResource primaryBarBlue}"
                                 ItemSize="100"
                                                     HeaderSize="30"
                                                     SelectionChanged="FixtureSelected"
                                >
                                    <listView:SfListView.DataSource>
                                  <data:DataSource>
                                    <data:DataSource.GroupDescriptors>
                                                <data:GroupDescriptor PropertyName="League.Name"/>
                                    </data:DataSource.GroupDescriptors>
                                    <data:DataSource.SortDescriptors>
                                      <data:SortDescriptor PropertyName="Date" Direction="Descending"/>
                                    </data:DataSource.SortDescriptors>
                                  </data:DataSource>
                                </listView:SfListView.DataSource>
                                    <listView:SfListView.GroupHeaderTemplate>
                                  <DataTemplate>
                                      <ViewCell>
                                        <ViewCell.View>
                                          <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>
                                              <BoxView BackgroundColor="{StaticResource primaryPink}" Grid.ColumnSpan="2" Opacity=".5"/>
                                              <StackLayout  Grid.Column="0" Padding="10,0" VerticalOptions="Center" HorizontalOptions="Start">
                                                <Label x:Name="leagueLabel" Text="{Binding ., Converter={StaticResource groupingSelectionConverter}, ConverterParameter={x:Reference leagueLabel}}"
                                                     FontSize="{Binding Key, 
                                                            Converter={StaticResource groupHeaderSizeConverter}}"
                                                     FontAttributes="Bold"
                                                    VerticalOptions="Center" HorizontalOptions="Start"
                                                     TextColor="White"/>
                                                  </StackLayout>
                                              <StackLayout  Grid.Column="1" Padding="10,0" VerticalOptions="Center" HorizontalOptions="EndAndExpand">
                                                <Label Text="{Binding ., Converter={StaticResource groupingSelectionConverter}, ConverterParameter={x:Reference FavouriteFixtureList}}"
                                                     FontSize="{Binding Key, 
                                                            Converter={StaticResource groupHeaderSizeConverter}}"
                                                     FontAttributes="Bold"
                                                    VerticalOptions="Center" HorizontalOptions="EndAndExpand"
                                                     TextColor="White"/>
                                                  </StackLayout>
                                          </Grid>
                                        </ViewCell.View>
                                      </ViewCell>
                                  </DataTemplate>
                                </listView:SfListView.GroupHeaderTemplate>
                                </listView:SfListView>
                            <ContentView Grid.Row="1" BackgroundColor="White" IsVisible="{Binding NoFixtureFavourites}"/>
                <Grid Grid.Row="1" IsVisible="{Binding NoFixtureFavourites}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Image Grid.Row="0"
                       Source="ontrack.png"
                       Aspect="AspectFit"
                           HeightRequest="100"
                           WidthRequest="100"
                       VerticalOptions="End"
                       HorizontalOptions="Center"
                       />
                    <StackLayout Grid.Row="1"
                                 Padding="20,0">
                        <Label Text="There are no fixtures in Favourites."
                               TextColor="{StaticResource primaryDarkBlue}"
                               FontAttributes="Bold"
                               FontSize="Small"
                               HorizontalTextAlignment="Center"
                               />
                    </StackLayout>
                    
                </Grid>
                            </Grid>
                        </tabView:SfTabItem.Content>
                    </tabView:SfTabItem>
            </tabView:SfTabView>
            <StackLayout Padding="10"  IsVisible="{Binding NoConnectivity}">
                <Label Text="There are no favourites available" FontSize="Caption" TextColor="White" HorizontalOptions="Center" HorizontalTextAlignment="Center"  IsVisible="{Binding NoConnectivity}"/>
            </StackLayout>
            <StackLayout Grid.Row="1" Padding="0,0,0,0" HeightRequest="45" WidthRequest="200" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand">
                        <Image Source="ontrack_wordmark_reversed" VerticalOptions="CenterAndExpand" Aspect="AspectFit"/>
                    </StackLayout>
                <model:AdMobView Grid.Row="1"  VerticalOptions="EndAndExpand" MinimumHeightRequest="50" Size="Standardbanner"/>
                <!--<syncfusion:SfBusyIndicator Grid.RowSpan="3"
                    x:Name="BusyIndicator"
                                  BackgroundColor="Transparent"
                                  TextColor="{StaticResource primaryPink}"
                                  VerticalOptions="FillAndExpand"
                                  HorizontalOptions="FillAndExpand"
                                  AnimationType="SingleCircle"  
                                  ViewBoxWidth="50"
                                            ViewBoxHeight="50"
                                  IsVisible="{Binding IsActivityIndicatorVisible}"
                                  Duration="3" />-->
            <ContentView Grid.Row="0" BackgroundColor="{StaticResource primaryDarkBlueTwo}" IsVisible="{Binding IsActivityIndicatorVisible}"/>
            <!--<extension:CustomLoader x:Name="loader" Grid.Row="0"
                                        Source="ontrackindicator.png"
                                        RotationLength="2000"
                                    WidthRequest="100"
                                        VerticalOptions="Center" 
                                        HorizontalOptions="Center"
                                        
                                        IsRunning="{Binding IsActivityIndicatorVisible}"
                                        IsVisible="{Binding IsActivityIndicatorVisible}"/>-->
            <extension:CustomBusyIndicator IsVisible="{Binding IsActivityIndicatorVisible}"/>
        </Grid>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
