<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns:tabView="clr-namespace:Syncfusion.XForms.TabView;assembly=Syncfusion.SfTabView.XForms"
             xmlns:controls="clr-namespace:ImageCircle.Forms.Plugin.Abstractions;assembly=ImageCircle.Forms.Plugin"
             xmlns:data="clr-namespace:Syncfusion.DataSource;assembly=Syncfusion.DataSource.Portable"
             xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             xmlns:ff="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"  
             xmlns:ffSvg="clr-namespace:FFImageLoading.Svg.Forms;assembly=FFImageLoading.Svg.Forms"  
             xmlns:ffTransformations="clr-namespace:FFImageLoading.Transformations;assembly=FFImageLoading.Transformations"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             xmlns:local="clr-namespace:TruSport.ViewModels"
             xmlns:model="clr-namespace:TruSport.Model"
             xmlns:converter="clr-namespace:TruSport.Converters"
             xmlns:extension="clr-namespace:TruSport.Extensions"
             x:Class="TruSport.Views.Football.TeamProfilePage"
             >
    <!--<ContentPage.BindingContext>
        <local:TeamProfilePageViewModel x:Name="viewModel"/>
    </ContentPage.BindingContext>-->
    <ContentPage.ToolbarItems>
<!--        <ToolbarItem x:Name="AdminToolbarItem" Icon="Admin32.png" Activated="AdminClicked" Order="Primary" Priority="1" />-->
        <!--<ToolbarItem x:Name="FavouriteToolbarItem" Icon="DeleteWhite.png" Activated="DeleteClicked" Order="Primary" Priority="1" />-->
    </ContentPage.ToolbarItems>
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:SeasonFixtureDateConverter x:Key="seasonFixtureDateConverter"/>
            <converter:IsPastFixtureConverter x:Key="isPastFixtureConverter"/>
            <converter:IsUpcomingFixtureConverter x:Key="isUpcomingFixtureConverter"/>
            <converter:ImageConverter x:Key="imageConverter"/>
            <converter:SelectedTeamConverter x:Key="selectedTeamConverter"/>
            <converter:SelectedTeamPenaltyConverter x:Key="selectedTeamPenaltyConverter"/>
            <converter:SelectedTeamBackgroundConverter x:Key="selectedTeamBackgroundConverter"/>
            <converter:SelectedTeamTextConverter x:Key="selectedTeamTextConverter"/>
            <converter:TableIndexToColorConverter x:Key="tableIndexConverter"/>
            <converter:GameTimeConverter x:Key="gameTimeConverter"/>
            <converter:TimeConverter x:Key="timeConverter"/>
            <converter:GroupHeaderNameConverter x:Key="groupHeaderNameConverter"/>
            <converter:GroupHeaderSizeConverter x:Key="groupHeaderSizeConverter"/>
            <converter:GroupHeaderFontConverter x:Key="groupHeaderFontConverter"/>
            <converter:GroupingTransferSelectionConverter x:Key="groupingTransferSelectionConverter"/>
            <converter:GroupingSelectionConverter x:Key="groupingSelectionConverter"/>
            <converter:SelectedTeamResultConverter x:Key="selectedTeamResultConverter"/>
            <converter:SelectedTeamProfileConverter x:Key="selectedTeamProfileConverter"/>
            <converter:FavouriteFontConverter x:Key="favouriteFontConverter"/>
            <converter:FavouriteConverter x:Key="favouriteConverter"/>
            <converter:TeamNameConverter x:Key="teamNameConverter" />
            <converter:ShowScoreConverter x:Key="showScoreConverter" />
            <OnPlatform x:TypeArguments="x:String" x:Key="fontFamily" iOS="icomoon" Android="icomoon.ttf#icomoon" />
            <OnPlatform x:TypeArguments="x:String" x:Key="fontAwesomeFamily" Android="fa-regular-400.ttf#Font Awesome 5 Pro Regular" iOS="Font Awesome 5 Pro" />
            <converter:InverseBooleanConverter x:Key="inverseBooleanConverter"/>
            <DataTemplate x:Name="TransferItemTemplate"  x:Key="TransferItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="FillAndExpand">
                <Grid x:Name="grid"
                      Padding="1"
                      RowSpacing="5"
                      ColumnSpacing="10"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">    
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1"/>
                    </Grid.RowDefinitions>
                        <StackLayout Grid.Row="0" Grid.ColumnSpan="3"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="10,5,5,5">
                            <Label 
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   Text="{Binding PlayerName}">
                                    <Label.FontSize>
                                        <OnPlatform x:TypeArguments="x:Double">
                                            <On Platform="iOS" Value="18"/>
                                            <On Platform="Android" Value="16"/>
                                        </OnPlatform>
                                    </Label.FontSize>
                            </Label>
                            </StackLayout>
                            <StackLayout Grid.Row="1" Grid.Column="0"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="10,5">
                            <Label FontSize="Small"
                                   TextColor="White"
                                   Text="{Binding PreviousTeam}"/>
                        </StackLayout>
                    <StackLayout Grid.Row="1" Grid.Column="1"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="10,5">
                            <Label FontSize="Medium"
                                   TextColor="White"
                                   Text=""
                                   FontFamily="{StaticResource fontAwesomeSolidFamily}"/>
                        </StackLayout>
                    <StackLayout Grid.Row="1" Grid.Column="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="10,5">
                            <Label FontSize="Small"
                                   TextColor="White"
                                   Text="{Binding NewTeam}"/>
                        </StackLayout>
                    <BoxView BackgroundColor="White" Opacity=".5" HorizontalOptions="FillAndExpand" HeightRequest="1" Grid.ColumnSpan="3" Grid.Row="2"/>
                        </Grid>
                    </StackLayout>
            </DataTemplate>
            <DataTemplate x:Name="PlayerItemTemplate"  x:Key="PlayerItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="Center"
                             Padding="0,0">
                <Grid x:Name="grid"
                      Padding="0,0"
                      RowSpacing="1"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">    
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="1" />
                    </Grid.RowDefinitions>
                    <StackLayout Grid.Row="0" Grid.Column="0"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label x:Name="JerseyNumberLabel"
                                   FontSize="12"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                        Text="{Binding JerseyNumber}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="1"
                                     Spacing="5"
                                     Orientation="Horizontal"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="0">
                                <Label x:Name="FirstNameLabel"
                                   FontSize="12"
                                       FontAttributes="Bold"
                                       Text="{Binding Player.FirstName}"
                                   TextColor="White"/>
                            <Label x:Name="LastNameLabel"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                       Text="{Binding Player.LastName}"
                                   TextColor="White"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label x:Name="GamesPlayedLabel"
                                   FontSize="12"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding GamesPlayed}"/>
                        </StackLayout>
                           <StackLayout Grid.Row="0" Grid.Column="3"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label x:Name="GoalsLabel"
                                   FontSize="12"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding Goals}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="4"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label x:Name="YellowCardsLabel"
                                   FontSize="12"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding YellowCards}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="5"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label x:Name="RedCardsLabel"
                                   FontSize="12"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding RedCards}"/>
                        </StackLayout>
                        <BoxView Grid.Row="1" Grid.ColumnSpan="6"
                                         BackgroundColor="White" Opacity="0.2"
                                         HeightRequest="1"/>
                        </Grid>
                        
                    </StackLayout>
            </DataTemplate>
            <DataTemplate x:Name="CoachItemTemplate"  x:Key="CoachItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="FillAndExpand">
                <Grid x:Name="grid"
                      Padding="10,0"
                      RowSpacing="1"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">    
                        <StackLayout Spacing="5"
                                     Orientation="Horizontal"
                                 VerticalOptions="FillAndExpand"
                                     HorizontalOptions="StartAndExpand"
                                 Padding="0">
                                <Label x:Name="FirstNameLabel"
                                   FontSize="12"
                                       FontAttributes="Bold"
                                       Text="{Binding FirstName}"
                                   TextColor="White"/>
                            <Label x:Name="LastNameLabel"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                       Text="{Binding LastName}"
                                   TextColor="White"/>
                        </StackLayout>
                        </Grid>
                    </StackLayout>
            </DataTemplate>
            <DataTemplate x:Name="TableItemTemplate"  x:Key="TableItemTemplate">
                
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="Center">
                    <StackLayout 
                                 HorizontalOptions="FillAndExpand"
                                 VerticalOptions="FillAndExpand">
                    
                <Grid x:Name="grid"
                      Padding="0"
                      RowSpacing="1"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">    
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                                <RowDefinition Height="1" />
                    </Grid.RowDefinitions>
                       <BoxView BackgroundColor="{Binding IsSelectedTeam,
                                                Converter={StaticResource selectedTeamBackgroundConverter}}" Opacity=".5" Grid.ColumnSpan="10"/>
                        <StackLayout Grid.Row="0" Grid.Column="0"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="0">
                                <Label x:Name="PositionLabel"
                                       HorizontalTextAlignment="Center"
                                   FontSize="12"
                                       FontAttributes="{Binding IsSelectedTeam,
                                                Converter={StaticResource selectedTeamConverter}}"
                                       Text="{Binding Position}"
                                   TextColor="{Binding IsSelectedTeam,
                                                Converter={StaticResource selectedTeamTextConverter}}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="1"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label x:Name="TeamNameLabel"
                                   FontSize="12"
                                   TextColor="{Binding IsSelectedTeam,
                                                Converter={StaticResource selectedTeamTextConverter}}"
                                   FontAttributes="{Binding IsSelectedTeam,
                                                Converter={StaticResource selectedTeamConverter}}"
                                   VerticalTextAlignment="Center"
                                        Text="{Binding Name}"/>
                        </StackLayout>
                           <StackLayout Grid.Row="0" Grid.Column="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label
                                   FontSize="12"
                                   TextColor="{Binding IsSelectedTeam,
                                                Converter={StaticResource selectedTeamTextConverter}}"
                                FontAttributes="{Binding IsSelectedTeam,
                                                Converter={StaticResource selectedTeamConverter}}"
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding Played}"/>
                        </StackLayout>
                    <StackLayout Grid.Row="0" Grid.Column="3"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label x:Name="WinLabel"
                                   FontSize="12"
                                   TextColor="{Binding IsSelectedTeam,
                                                Converter={StaticResource selectedTeamTextConverter}}"
                                   FontAttributes="{Binding IsSelectedTeam,
                                                Converter={StaticResource selectedTeamConverter}}"
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding Wins}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="4"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label x:Name="LossLabel"
                                   FontSize="12"
                                   TextColor="{Binding IsSelectedTeam,
                                                Converter={StaticResource selectedTeamTextConverter}}"
                                   FontAttributes="{Binding IsSelectedTeam,
                                                Converter={StaticResource selectedTeamConverter}}"
                                   
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding Loss}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="5"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label x:Name="DrawLabel"
                                   FontSize="12"
                                   TextColor="{Binding IsSelectedTeam,
                                                Converter={StaticResource selectedTeamTextConverter}}"
                                   FontAttributes="{Binding IsSelectedTeam,
                                                Converter={StaticResource selectedTeamConverter}}"
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding Draws}"/>
                        </StackLayout>
                    <StackLayout Grid.Row="0" Grid.Column="6"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label x:Name="GoalsForLabel"
                                   FontSize="12"
                                   TextColor="{Binding IsSelectedTeam,
                                                Converter={StaticResource selectedTeamTextConverter}}"
                                   FontAttributes="{Binding IsSelectedTeam,
                                                Converter={StaticResource selectedTeamConverter}}"
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding GoalsFor}"/>
                        </StackLayout>
                    <StackLayout Grid.Row="0" Grid.Column="7"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label x:Name="GoalsAgainstLabel"
                                   FontSize="12"
                                   TextColor="{Binding IsSelectedTeam,
                                                Converter={StaticResource selectedTeamTextConverter}}"
                                   FontAttributes="{Binding IsSelectedTeam,
                                                Converter={StaticResource selectedTeamConverter}}"
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding GoalsAgainst}"/>
                        </StackLayout>
                    
                    <StackLayout Grid.Row="0" Grid.Column="8"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label x:Name="GoalDifferenceLabel"
                                   FontSize="12"
                                   TextColor="{Binding IsSelectedTeam,
                                                Converter={StaticResource selectedTeamTextConverter}}"
                                   FontAttributes="{Binding IsSelectedTeam,
                                                Converter={StaticResource selectedTeamConverter}}"
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding GoalDiff}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="9"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                     >
                            <Label x:Name="PointsLabel"
                                   FontSize="12"
                                   TextColor="{Binding IsSelectedTeam,
                                                Converter={StaticResource selectedTeamTextConverter}}"
                                   FontAttributes="{Binding IsSelectedTeam,
                                                Converter={StaticResource selectedTeamConverter}}"
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding Points}"/>
                        </StackLayout>
                            <BoxView Grid.Row="1" Grid.ColumnSpan="10"
                                         BackgroundColor="White" Opacity="0.2"
                                         HeightRequest="1"/>
                        </Grid>
                        </StackLayout>
                    </StackLayout>
            </DataTemplate>
            <DataTemplate x:Name="FixtureItemTemplate"  x:Key="FixtureItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="FillAndExpand">
                <Grid x:Name="grid" Padding="0,10,0,0"
                      RowSpacing="5"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">    
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                            <RowDefinition Height="20" />
                            <RowDefinition Height="50" />
                        <RowDefinition Height="1" />
                    </Grid.RowDefinitions>
                        <StackLayout Grid.Row="0" Grid.Column="0"  Grid.ColumnSpan="3" Spacing="5" Padding="5,2"
                                 VerticalOptions="EndAndExpand"
                                     HorizontalOptions="StartAndExpand"
                                     Orientation="Horizontal">
                            <StackLayout Padding="2">
                                <Label x:Name="FieldIcon"
                                   FontSize="Small"
                                       Text="&#xe901;"
                                       VerticalOptions="Center"
                                   TextColor="White"
                                    FontFamily="{StaticResource fontFamily}"/>
                                </StackLayout>
                            <StackLayout>
                                <Label x:Name="FieldName"
                                   FontSize="Small"
                                   TextColor="White"
                                    Text="{Binding Field.Name}"/>
                                </StackLayout>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="EndAndExpand"
                                     Orientation="Horizontal"
                                 Padding="5,2">
                                <Label x:Name="TimeIcon"
                                   FontSize="Small"
                                   TextColor="White"
                                        Text="&#xe904;"
                                       FontFamily="{StaticResource fontFamily}"/>
                            <Label x:Name="TimeLabel"
                                   FontSize="Small"
                                   TextColor="White"
                                   VerticalTextAlignment="End"
                                        Text="{Binding Time, Converter={StaticResource timeConverter}}"/>
                        </StackLayout>
                    <StackLayout Grid.Row="1" Grid.Column="0" Padding="5,0" HorizontalOptions="Center" VerticalOptions="Center">
                            <!--<controls:CircleImage 
                                                    x:Name="HomeTeamLogo"
                                                    Source="{Binding HomeTeam.TeamLogo, Converter={StaticResource imageConverter}}"
                                                    FillColor="White"
                                                  HeightRequest="30"
                                                  WidthRequest="30"
                                                  
                                                  Aspect="AspectFit" />-->
                        <Frame HeightRequest="40" WidthRequest="40" CornerRadius="20" Padding="0">
                        <ff:CachedImage Source="{Binding HomeTeam.TeamLogo, Converter={StaticResource imageConverter}}"
                                                        ErrorPlaceholder="ontrack.png"
                                                        CacheDuration="50"
                                                        RetryCount="3"
                                                        RetryDelay="600"
                                        Aspect="AspectFit"
                                        HeightRequest="30"
                                                  WidthRequest="30"
                                                        DownsampleToViewSize="True">  
                                            <!--<ff:CachedImage.Transformations>  
                                                <ffTransformations:CircleTransformation />  
                                            </ff:CachedImage.Transformations>-->  
                                        </ff:CachedImage>
                            </Frame>
                    </StackLayout>
                    <StackLayout Grid.Row="1" Grid.Column="4" Padding="5,0" HorizontalOptions="Center" VerticalOptions="Center">
                            <!--<controls:CircleImage 
                                                  x:Name="AwayTeamLogo"
                                                    Source="{Binding AwayTeam.TeamLogo, Converter={StaticResource imageConverter}}"
                                                    FillColor="White"
                                                  HeightRequest="30"
                                                  WidthRequest="30"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                                  Aspect="AspectFit"/>-->
                        <Frame HeightRequest="40" WidthRequest="40" CornerRadius="20" Padding="0">
                        <ff:CachedImage Source="{Binding AwayTeam.TeamLogo, Converter={StaticResource imageConverter}}"
                                                        ErrorPlaceholder="ontrack.png"
                                        LoadingPlaceholder="ontrack.png"
                                                        CacheDuration="50"
                                                        RetryCount="3"
                                                        RetryDelay="600"
                                        Aspect="AspectFit"
                                        HeightRequest="30"
                                                  WidthRequest="30"
                                                        DownsampleToViewSize="True">  
                                            <!--<ff:CachedImage.Transformations>  
                                                <ffTransformations:CircleTransformation />  
                                            </ff:CachedImage.Transformations>-->  
                                        </ff:CachedImage>
                            </Frame>
                    </StackLayout>
                            <StackLayout IsVisible="{Binding Date, Converter={StaticResource isPastFixtureConverter}}" Grid.Row="1" Grid.Column="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                         Orientation="Vertical"
                                 Padding="5,2"
                                 Spacing="5">
                            <StackLayout IsVisible="{Binding Match.IsPenalties}" Orientation="Horizontal" HorizontalOptions="Center" >
                            <Label x:Name="HomeTeamPenaltyLabel"
                                   FontSize="Micro"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                        Text="{Binding Match.HomeTeamPenalty, StringFormat='({0}'}"/>
                            <Label 
                                   
                                   FontSize="Micro"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                   TextColor="White"
                                        Text="-"/>
                            <Label x:Name="AwayTeamPenaltyLabel"
                                   FontSize="Micro"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                        Text="{Binding Match.AwayTeamPenalty, StringFormat='{0})'}"/>
                                
                        </StackLayout>
                     <StackLayout  Orientation="Horizontal"  HorizontalOptions="Center" >
                            <Label x:Name="HomeTeamScoreLabel"
                                   FontSize="Medium"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                        Text="{Binding Match.HomeTeamScore}"/>
                            <Label 
                                   x:Name="Versus"
                                   FontSize="Small"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                   TextColor="White"
                                        Text="{Binding Match.HomeTeamScore, Converter={StaticResource showScoreConverter}}"/>
                            <Label x:Name="AwayTeamScoreLabel"
                                   FontSize="Medium"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                        Text="{Binding Match.AwayTeamScore}"/>
                                
                        </StackLayout>
                    </StackLayout>
                    <StackLayout IsVisible="{Binding Date, Converter={StaticResource isUpcomingFixtureConverter}}"  Grid.Row="1" Grid.Column="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                         Orientation="Horizontal"
                                 Padding="5,2"
                                 Spacing="0">
                            <Label 
                                   x:Name="Vers"
                                   FontSize="Medium"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                   TextColor="White"
                                        Text="V"/>
                                
                        </StackLayout>
                            <StackLayout Grid.Row="1" Grid.Column="1"
                                 VerticalOptions="Center"
                                     HorizontalOptions="StartAndExpand"
                                 Padding="5,2"
                                 Spacing="0">
                                <Label x:Name="HomeTeamAlias" Text="{Binding HomeTeam.Alias}" IsVisible="false"/>
                            <Label x:Name="HomeTeamNameLabel"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                        Text="{Binding HomeTeam.Name, Converter={StaticResource teamNameConverter}, ConverterParameter={x:Reference HomeTeamAlias}}"/>
                        </StackLayout>
                            <StackLayout Grid.Row="1" Grid.Column="3"
                                 VerticalOptions="Center"
                                     HorizontalOptions="EndAndExpand"
                                 Padding="5,2"
                                 Spacing="0">
                                <Label x:Name="AwayTeamAlias" Text="{Binding AwayTeam.Alias}" IsVisible="false"/>
                            <Label x:Name="AwayTeamNameLabel"
                                   FontSize="12"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                        Text="{Binding AwayTeam.Name, Converter={StaticResource teamNameConverter}, ConverterParameter={x:Reference AwayTeamAlias}}"/>
                        </StackLayout>
                    <BoxView HeightRequest="1" BackgroundColor="White" Grid.ColumnSpan="5" Grid.Row="2" Opacity="0.3"/>
                        </Grid>
                    </StackLayout>
            </DataTemplate>
            <DataTemplate x:Name="FormItemTemplate"  x:Key="FormItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="FillAndExpand">
                <Grid x:Name="grid"
                      Padding="0"
                      RowSpacing="1"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">    
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                     <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                            <RowDefinition Height="25" />
                            <RowDefinition Height="25" />
                        <RowDefinition Height="1" />
                    </Grid.RowDefinitions>
                    <Label x:Name="SelectedTeamIDLabel" IsVisible="false"
                                        Text="{Binding SelectedTeamID}"/>
                        <StackLayout Grid.Column="0" Grid.Row="0"
                                 VerticalOptions="End"
                                     HorizontalOptions="Center"
                                 Padding="5,2">
                            <Label x:Name="SeasonLabel" Text="{Binding Season.Key}" IsVisible="false"/>
                            <Label x:Name="DateLabel"
                                   FontSize="10"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding Date, Converter={StaticResource seasonFixtureDateConverter}, ConverterParameter={x:Reference Name=SeasonLabel}}"/>
                        </StackLayout>
                    <StackLayout Grid.Column="0" Grid.Row="1"
                                 VerticalOptions="Start"
                                     HorizontalOptions="Center"
                                 Padding="5,2">
                            <Label x:Name="TTLabel"
                                   FontSize="10"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"
                                        Text="FT"/>
                        </StackLayout>
                            
                            <StackLayout Grid.Row="0" Grid.Column="1"
                                 VerticalOptions="FillAndExpand"
                                     HorizontalOptions="Start"
                                         Orientation="Horizontal"
                                 Padding="5,2"
                                 Spacing="5">
                                <Label x:Name="HomeTeamAlias" Text="{Binding HomeTeam.Alias}" IsVisible="false"/>
                                <Label x:Name="HomeTeamNameLabel"
                                   FontSize="14"
                                   FontAttributes="{Binding HomeTeamID, Converter={StaticResource selectedTeamProfileConverter}, ConverterParameter={x:Reference Name=SelectedTeamIDLabel}}"
                                   TextColor="White"
                                        Text="{Binding HomeTeam.Name, Converter={StaticResource teamNameConverter}, ConverterParameter={x:Reference HomeTeamAlias}}"/>
                                <StackLayout  IsVisible="{Binding Match.IsPenalties}">
