<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:extension="clr-namespace:TruSport.Extensions" xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms" xmlns:tabView="clr-namespace:Syncfusion.XForms.TabView;assembly=Syncfusion.SfTabView.XForms" xmlns:ff="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms" xmlns:converter="clr-namespace:TruSport.Converters"
    x:Class="TruSport.Views.Golf.TablePage"
             Title="{Binding League.Name}">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:ImageConverter x:Key="imageConverter"/>
            <converter:InverseBooleanConverter x:Key="inverseBooleanConverter"/>
            <OnPlatform x:TypeArguments="x:String" x:Key="fontFamily" iOS="icomoon" Android="icomoon.ttf#icomoon" />
            <DataTemplate x:Name="TableItemTemplate"  x:Key="TableItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="Center">
                    <StackLayout 
                                 HorizontalOptions="FillAndExpand"
                                 VerticalOptions="FillAndExpand">
                    
                <Grid x:Name="grid"
                      Padding="0"
                      RowSpacing="1"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">    
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                            <RowDefinition Height="45" />
                            <RowDefinition Height="1" />
                    </Grid.RowDefinitions>
                        <StackLayout Grid.Row="0" Grid.Column="0"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="0">
                                <Label x:Name="PositionLabel"
                                       HorizontalTextAlignment="Center"
                                   FontSize="12"
                                       Text="{Binding Position}"
                                   TextColor="{DynamicResource TextPrimaryColor}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="1"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand" Orientation="Horizontal">       
                            <Label x:Name="PlayerNameLabel"
                                   FontSize="12"
                                   FontAttributes="None"
                                   VerticalTextAlignment="Center"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                        Text="{Binding GolfPlayer.Player.Name}"/>
                            
                        </StackLayout>
                           <StackLayout Grid.Row="0" Grid.Column="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label
                                   FontSize="12"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding Points, StringFormat='{0:N0}'}"/>
                        </StackLayout>
                         <BoxView Grid.Row="1" Grid.ColumnSpan="3"
                                         BackgroundColor="{DynamicResource borderColor}"
                                         HeightRequest="1"/>
                        </Grid>
                    </StackLayout>
                    </StackLayout>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <StackLayout Spacing="0"
                     Padding="0"
                     HorizontalOptions="FillAndExpand"
                     VerticalOptions="FillAndExpand">
        <Grid x:Name="PageGrid"
              RowSpacing="0"
              BackgroundColor="{DynamicResource backgroundColor}"
              HorizontalOptions="FillAndExpand"
              VerticalOptions="FillAndExpand">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
            </Grid.RowDefinitions>            
                            <Grid HorizontalOptions="FillAndExpand" Padding="0,0,0,0"
                              VerticalOptions="FillAndExpand"
                              RowSpacing="0" BackgroundColor="{DynamicResource backgroundColor}">
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="100" />
                                        <RowDefinition Height="30" />
                                    <RowDefinition Height="2" />
                                        <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                                <StackLayout Grid.Row="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                    <Frame HeightRequest="90" WidthRequest="90" CornerRadius="45" Padding="0" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" HasShadow="False" IsClippedToBounds="True">
                        <ff:CachedImage Source="{Binding League.Image, Converter={StaticResource imageConverter}}"
                                        ErrorPlaceholder="ontracklogo.png"
                                        LoadingPlaceholder="ontracklogo.png"
                                        CacheDuration="50"
                                        RetryCount="3"
                                        RetryDelay="600"
                                        Aspect="AspectFit"
                                        HeightRequest="85"
                                        WidthRequest="85"
                                        DownsampleToViewSize="True">  
                                        </ff:CachedImage>
                            </Frame>
                                </StackLayout>
                                <StackLayout Grid.Row="1" HorizontalOptions="FillAndExpand"
                             VerticalOptions="Center"
                             Padding="0,0">
                        <Grid Grid.Row="1" 
                              x:Name="TableHeaderGrid1"
                              Padding="0,0"
                              RowSpacing="1"
                              ColumnSpacing="1"

                              VerticalOptions="FillAndExpand"
                              HorizontalOptions="FillAndExpand">    
                        <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                        <StackLayout Grid.Row="0" Grid.ColumnSpan="2" Padding="10,0,0,0"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label 
                                   FontSize="13"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   FontAttributes="Bold"
                                   VerticalTextAlignment="Center"
                                        Text="PLAYER"/>
                        </StackLayout>
                           <StackLayout Grid.Row="0" Grid.Column="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label 
                                   FontSize="13"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   FontAttributes="Bold"
                                   VerticalTextAlignment="Center"
                                HorizontalTextAlignment="Center"
                                        Text="Points"/>
                        </StackLayout>                            
                        </Grid>
                    </StackLayout>
                                <BoxView Grid.Row="2"
                                         BackgroundColor="{DynamicResource borderColor}"
                                         HeightRequest="2"/>
                             
                                <listView:SfListView Grid.Row="3" x:Name="LongtailGolfTourList"
                                ItemsSource="{Binding LongtailTourStandingsCollection}"
                                    ItemTemplate="{StaticResource TableItemTemplate}"
                                   SelectionMode="None"
                                    HorizontalOptions="FillAndExpand"
                                    VerticalOptions="FillAndExpand"
                                   ItemSpacing="0"
                                    SelectionBackgroundColor="White"
                                 AutoFitMode="DynamicHeight"
                                                      
                                />
                            
                        </Grid>                        
            <StackLayout Padding="10"  IsVisible="{Binding NoConnectivity}">
                <Label Text="There are no standings available" FontSize="Caption" TextColor="{DynamicResource TextPrimaryColor}" HorizontalOptions="Center" HorizontalTextAlignment="Center"  IsVisible="{Binding NoConnectivity}"/>
            </StackLayout>
            <StackLayout Grid.Row="1" Padding="0,0,0,0" HeightRequest="45" WidthRequest="200" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand">
                        <Image Source="ontrack_wordmark_reversed" VerticalOptions="CenterAndExpand" Aspect="AspectFit"/>
                    </StackLayout>
            <StackLayout Grid.Row="1" Padding="0,0,0,0" HeightRequest="50" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
                <StackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AdTappedCommand}"/>
                </StackLayout.GestureRecognizers>
                <Image Source="{Binding Ad.Image}" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Aspect="AspectFill"/>
            </StackLayout>
            <extension:CustomBusyIndicator IsVisible="{Binding IsActivityIndicatorVisible}"/>
        </Grid>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
