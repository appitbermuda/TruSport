<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:tabView="clr-namespace:Syncfusion.XForms.TabView;assembly=Syncfusion.SfTabView.XForms" xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms" xmlns:data="clr-namespace:Syncfusion.DataSource;assembly=Syncfusion.DataSource.Portable" xmlns:extension="clr-namespace:TruSport.Extensions" xmlns:converter="clr-namespace:TruSport.Converters" xmlns:templates="clr-namespace:TruSport.Templates"
    x:Class="TruSport.Views.Golf.CompetitionDetailsPage"
             NavigationPage.HasBackButton="False"
             NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:GroupHeaderNameConverter x:Key="groupHeaderNameConverter"/>
            <converter:GroupHeaderSizeConverter x:Key="groupHeaderSizeConverter"/>
            <converter:GroupHeaderFontConverter x:Key="groupHeaderFontConverter"/>
            <converter:GroupingSelectionGolfConverter x:Key="groupingSelectionConverter"/>
            <converter:GroupingLeagueDateSelectionBasketballConverter x:Key="groupingLeagueDateSelectionConverter"/>
            <converter:GroupingCompetitionGolfConverter x:Key="groupingCompetitionConverter"/>
            <OnPlatform x:TypeArguments="x:String" x:Key="fontFamily" iOS="icomoon" Android="icomoon.ttf#icomoon" />
            <OnPlatform x:TypeArguments="x:String" x:Key="fontAwesomeFamily" Android="fa-regular-400.ttf#Font Awesome 5 Pro Regular" iOS="Font Awesome 5 Pro" />            
            <DataTemplate x:Name="TableItemTemplate"  x:Key="TableItemTemplate">
                
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="Center">
                    <StackLayout Padding="0"
                                 HorizontalOptions="FillAndExpand"
                                 VerticalOptions="FillAndExpand">
                    
                <Grid x:Name="grid"
                      Padding="1"
                      RowSpacing="1"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">    
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                            <RowDefinition Height="45" />
                                <RowDefinition Height="1" />
                    </Grid.RowDefinitions>
                       
                        <StackLayout Grid.Row="0" Grid.Column="0"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="0">
                                <Label x:Name="PositionLabel"
                                       HorizontalTextAlignment="Center"
                                   FontSize="13"
                                       Text="{Binding Position}"
                                   TextColor="{DynamicResource TextPrimaryColor}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="1"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label x:Name="PlayerNameLabel"
                                   FontSize="12"
                                   FontAttributes="None"
                                   VerticalTextAlignment="Center"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                        Text="{Binding GolfPlayer.Player.Name}"/>
                        </StackLayout>
                           <StackLayout Grid.Row="0" Grid.Column="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label
                                   FontSize="13"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding Points, StringFormat='{0:N0}'}"/>
                        </StackLayout>                        
                            <BoxView Grid.Row="1" Grid.ColumnSpan="3"
                                         BackgroundColor="{DynamicResource controlHeaderBackgroundColor}" Opacity="0.2"
                                         HeightRequest="1"/>
                        </Grid>
                        </StackLayout>
                    </StackLayout>
            </DataTemplate>            
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid HorizontalOptions="FillAndExpand" RowSpacing="0" VerticalOptions="FillAndExpand" BackgroundColor="{DynamicResource backgroundColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackLayout Orientation="Horizontal"
                     HorizontalOptions="FillAndExpand"
                         VerticalOptions="Start"
                     BackgroundColor="{DynamicResource navBackgroundColor}">
            <StackLayout.Padding>
               <OnPlatform x:TypeArguments="Thickness">
                 <On Platform="Android" Value="0, 0, 0, 0"/>
                 <On Platform="iOS" Value="0, 50, 0, 0"/>
                </OnPlatform>
              </StackLayout.Padding>
            <Grid HorizontalOptions="FillAndExpand" HeightRequest="50">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                 <StackLayout Grid.ColumnSpan="3" Padding="0,0,0,0" VerticalOptions="CenterAndExpand" HeightRequest="50">
                        <StackLayout.HorizontalOptions>
                            <OnPlatform x:TypeArguments="LayoutOptions">
                                <On Platform="Android" Value="CenterAndExpand"/>
                                <On Platform="iOS" Value="CenterAndExpand"/>
                            </OnPlatform>
                        </StackLayout.HorizontalOptions>
                         <Label x:Name="TitleLabel" Text="{Binding Title}" FontSize="14" HorizontalTextAlignment="Center" TextColor="White" FontAttributes="Bold" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand"/>
                    </StackLayout>
                <Button x:Name="BackButton" Text="" TextColor="{DynamicResource navTextColor}" BackgroundColor="Transparent" FontSize="25" FontFamily="{StaticResource fontAwesomeSolidFamily}" Clicked="BackButton_Clicked"/>
                </Grid>
        </StackLayout>

     <tabView:SfTabView Grid.Row="1"
                        VisibleHeaderCount="2"
                                 TabHeaderBackgroundColor="{DynamicResource tabHeaderColor}"
                        BackgroundColor="Transparent"
                                 DisplayMode="Text"
                           SelectedIndex="0"
                                TabHeight="50" TabItemTapped="SfTabView_TabItemTapped">
                        <tabView:SfTabView.SelectionIndicatorSettings>
                <tabView:SelectionIndicatorSettings Color="{DynamicResource tabIndicatorColor}" 
                                                              Position="Bottom" 
                                                              StrokeThickness="2"/>
                </tabView:SfTabView.SelectionIndicatorSettings>
                        
                        <tabView:SfTabItem Title="Fixtures" TitleFontColor="Gray" SelectionColor="{DynamicResource TextPrimaryColor}">
                        <tabView:SfTabItem.Content>
                        <Grid BackgroundColor="{DynamicResource backgroundColor}" Padding="0,0,0,0"
                              HorizontalOptions="FillAndExpand"
                              VerticalOptions="FillAndExpand" RowSpacing="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <listView:SfListView x:Name="FixtureList"
                                                ItemsSource="{Binding FixtureCollection}"
                                                     LoadMoreOption="Auto"
                                                     LoadMoreCommand="{Binding LoadMoreItemsCommand}"
                                                     LoadMoreCommandParameter="{Binding Source={x:Reference Name=FixtureList}}"
                                                    HorizontalOptions="FillAndExpand"
                                                    VerticalOptions="FillAndExpand"
                                                   SelectionMode="Single"
                                                   ItemSpacing="0"
                                                     SelectionChanged="OnFixtureSelected"
                                                    SelectionBackgroundColor="Transparent"
                                                 AutoFitMode="DynamicHeight">
                                    <listView:SfListView.HeaderTemplate>
                                    <DataTemplate>
                                      <ViewCell>
                                        <Grid Padding="5">
                                            <Button BackgroundColor="{StaticResource buttonBackgroundColor}" Text="Previous Fixtures" Padding="10,0" CornerRadius="5" TextColor="{DynamicResource buttonTextColor}" Clicked="LoadMoreClicked" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" IsEnabled="{Binding IsLoadMoreVisible}"/>
                                          </Grid>
                                      </ViewCell>
                                    </DataTemplate>
                                  </listView:SfListView.HeaderTemplate>
                                    <listView:SfListView.DataSource>
                                  <data:DataSource>
                                    <data:DataSource.SortDescriptors>
                                      <data:SortDescriptor PropertyName="FixtureTime" Direction="Ascending"/>
                                    </data:DataSource.SortDescriptors>
                                  </data:DataSource>
                                </listView:SfListView.DataSource>
                                <listView:SfListView.ItemTemplate>
                                    <DataTemplate>
                                        <templates:GolfFixtureList/>
                                    </DataTemplate>
                                </listView:SfListView.ItemTemplate>
                                    <listView:SfListView.GroupHeaderTemplate>
                                  <DataTemplate>
                                      <ViewCell>
                                        <ViewCell.View>
                                            <StackLayout Padding="8,25,8,0">
<Frame CornerRadius="10" Padding="0" BackgroundColor="Transparent">
<Frame IsClippedToBounds="True" CornerRadius="10" Padding="0"  BackgroundColor="{DynamicResource GroupHeaderBackgroundColor}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <BoxView Grid.ColumnSpan="2"/>
                                                <!--<StackLayout  Grid.Column="0" Padding="10,0" VerticalOptions="Center" HorizontalOptions="Start">
                                                <Label x:Name="leagueLabel" Text="{Binding ., Converter={StaticResource groupingCompetitionConverter}, ConverterParameter={x:Reference leagueLabel}}"
                                                     FontSize="{Binding Key, 
                                                            Converter={StaticResource groupHeaderSizeConverter}}"
                                                     FontAttributes="Bold"
                                                     TextColor="White"/>
                                                </StackLayout>-->
                                                <StackLayout Grid.Column="1" Padding="10,0" VerticalOptions="Center" HorizontalOptions="EndAndExpand">
                                                <Label Text="{Binding ., Converter={StaticResource groupingCompetitionConverter}, ConverterParameter={x:Reference FixtureList}}"
                                                     FontSize="{Binding Key, 
                                                            Converter={StaticResource groupHeaderSizeConverter}}"
                                                     FontAttributes="Bold"
                                                     TextColor="White"/>
                                                    </StackLayout>
                                          </Grid>
    </Frame>
</Frame>
                                            </StackLayout>
    </ViewCell.View>
                                      </ViewCell>
                                  </DataTemplate>
                                </listView:SfListView.GroupHeaderTemplate>
                                </listView:SfListView>
                        </Grid>
                        </tabView:SfTabItem.Content>
                    </tabView:SfTabItem>
                <tabView:SfTabItem Title="Table" TitleFontColor="Gray" SelectionColor="{DynamicResource TextPrimaryColor}" IsVisible="{Binding IsTableExist}">
                            <tabView:SfTabItem.Content>
                                <Grid HorizontalOptions="FillAndExpand" Padding="0,0,0,0"
                              VerticalOptions="FillAndExpand"
                              BackgroundColor="{DynamicResource backgroundColor}"
                              RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30" />
                                        <RowDefinition Height="2" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                                    <StackLayout Grid.Row="0" HorizontalOptions="FillAndExpand"
                             VerticalOptions="Center"
                             Padding="0,0">
                            
                        <Grid
                              x:Name="TableHeaderGrid"
                              Padding="0,0"
                              RowSpacing="1"
                              ColumnSpacing="1"
                              
                              VerticalOptions="FillAndExpand"
                              HorizontalOptions="FillAndExpand">    
                        <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                        <StackLayout Grid.Row="0" Grid.Column="0"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="0">
                                <Label
                                   FontSize="13"
                                       Text="#"
                                       FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                   TextColor="{DynamicResource TextPrimaryColor}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="1"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 >
                            <Label
                                   FontSize="13"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   FontAttributes="Bold"
                                   VerticalTextAlignment="Center"
                                        Text="PLAYER"/>
                        </StackLayout>
                           <StackLayout Grid.Row="0" Grid.Column="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label
                                   FontSize="13"
                               TextColor="{DynamicResource TextPrimaryColor}"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                        Text="Points"/>
                        </StackLayout>
                        </Grid>
                    </StackLayout>
                            <BoxView Grid.Row="1" HeightRequest="2" HorizontalOptions="FillAndExpand" BackgroundColor="{DynamicResource controlHeaderBackgroundColor}"/>
                               <listView:SfListView Grid.Row="2" x:Name="TeamTableListView"
                                                ItemsSource="{Binding TableCollection}"
                                                    HorizontalOptions="FillAndExpand"
                                                    VerticalOptions="FillAndExpand"
                                                    ItemTemplate="{StaticResource TableItemTemplate}"
                                                   SelectionMode="None"
                                                   ItemSpacing="0"
                                                    SelectionBackgroundColor="Transparent"
                                                 ItemSize="40">
                            </listView:SfListView>
                            
                        </Grid>
                            </tabView:SfTabItem.Content>
                        </tabView:SfTabItem>
                    </tabView:SfTabView>
            <extension:CustomBusyIndicator Grid.Row="1" IsVisible="{Binding IsActivityIndicatorVisible}"/>
            </Grid>
    </ContentPage.Content>
</ContentPage>
