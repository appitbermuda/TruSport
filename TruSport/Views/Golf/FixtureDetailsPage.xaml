<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:extensions="clr-namespace:TruSport.Extensions" xmlns:converter="clr-namespace:TruSport.Converters" xmlns:ff="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms" xmlns:tabview="clr-namespace:Syncfusion.XForms.TabView;assembly=Syncfusion.SfTabView.XForms" xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
    x:Class="TruSport.Views.Golf.FixtureDetailsPage"
             BackgroundColor="{DynamicResource backgroundColor}"
             NavigationPage.HasBackButton="False"
             NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <converter:IsNullConverter x:Key="isNullConverter" />
        <converter:MatchSummaryConverter x:Key="matchSummaryConverter"/>
        <converter:InverseBooleanConverter x:Key="inverseBooleanConverter"/>
        <converter:SeasonFixtureDateConverter x:Key="seasonFixtureDateConverter"/>
        <converter:SelectedTeamConverter x:Key="selectedTeamConverter"/>
            <converter:SelectedTeamBackgroundConverter x:Key="selectedTeamBackgroundConverter"/>
        <converter:SelectedTableBackgroundConverter x:Key="selectedTableBackgroundConverter"/>
            <converter:SelectedTeamTextConverter x:Key="selectedTeamTextConverter"/>
        <converter:GameTimeConverter x:Key="gameTimeConverter"/>
        <converter:MatchTimeConverter x:Key="matchTimeConverter"/>
            <converter:TimeConverter x:Key="timeConverter"/>
        <converter:SelectedTeamResultConverter x:Key="selectedTeamResultConverter"/>
            <converter:SelectedTeamProfileConverter x:Key="selectedTeamProfileConverter"/>
            <converter:TeamNameConverter x:Key="teamNameConverter" />
        <converter:GroupHeaderNameConverter x:Key="groupHeaderNameConverter"/>
        <converter:GroupHeaderSizeConverter x:Key="groupHeaderSizeConverter"/>
        <converter:GroupHeaderFontConverter x:Key="groupHeaderFontConverter"/>
        <converter:GroupingSelectionFootballConverter x:Key="groupingSelectionConverter"/>
        <converter:FavouriteFontConverter x:Key="favouriteFontConverter"/>
        <converter:FavouriteConverter x:Key="favouriteConverter"/>
        <converter:SummaryMinuteConverter x:Key="summaryMinuteConverter"/>
        <converter:ImageConverter x:Key="imageConverter"/>
        <converter:ListCountConverter x:Key="listCountConverter" />
        <converter:OwnGoalConverter x:Key="ownGoalConverter"/>
        <DataTemplate x:Name="ScoreItemTemplate"  x:Key="ScoreItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="Center"
                             Padding="0,0">
                <Grid x:Name="grid"
                      Padding="0,0"
                      RowSpacing="1"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">    
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="1" />
                    </Grid.RowDefinitions>                    
                        <StackLayout Grid.Row="0" Grid.Column="0"
                                     Spacing="5"
                                     Orientation="Horizontal"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="10,0">
                                <Label x:Name="FirstNameLabel"
                                   FontSize="Small"
                                       Text="{Binding GolfRoster.GolfPlayerSeason.Player.Name}"
                                   TextColor="{DynamicResource TextPrimaryColor}"/>
                            <!--<Label x:Name="LastNameLabel"
                                   FontSize="Small"
                                   FontAttributes="Bold"
                                       Text="{Binding MatchRoster.Player.LastName}"
                                   TextColor="{DynamicResource TextPrimaryColor}"/>-->
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="1"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label x:Name="ScoreLabel"
                                   FontSize="Small"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding Score, StringFormat='{0:N0}'}"/>
                        </StackLayout>                           
                        <BoxView Grid.Row="1" Grid.ColumnSpan="2"
                                         BackgroundColor="{DynamicResource controlHeaderBackgroundColor}"
                                         HeightRequest="1"/>
                        </Grid>
                        
                    </StackLayout>
            </DataTemplate>
        <DataTemplate x:Name="TableItemTemplate"  x:Key="TableItemTemplate">
                
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="Center">
                    <StackLayout 
                                 HorizontalOptions="FillAndExpand"
                                 VerticalOptions="FillAndExpand">
                    
                <Grid x:Name="grid"
                      Padding="0"
                      RowSpacing="1"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">    
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                                <RowDefinition Height="1" />
                    </Grid.RowDefinitions>
                        <StackLayout Grid.Row="0" Grid.Column="0"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="0">
                                <Label x:Name="PositionLabel"
                                       HorizontalTextAlignment="Center"
                                   FontSize="12"
                                       Text="{Binding Position}"
                                   TextColor="{DynamicResource TextPrimaryColor}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="1"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label x:Name="TeamNameLabel"
                                   FontSize="12"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   VerticalTextAlignment="Center"
                                        Text="{Binding GolfPlayer.Player.Name}"/>
                        </StackLayout>
                           <StackLayout Grid.Row="0" Grid.Column="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label
                                   FontSize="12"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding Points, StringFormat='{0:N0}'}"/>
                        </StackLayout>
                            <BoxView Grid.Row="1" Grid.ColumnSpan="3"
                                         BackgroundColor="{DynamicResource controlHeaderBackgroundColor}" HeightRequest="1"/>
                        </Grid>
                        </StackLayout>
                    </StackLayout>
            </DataTemplate>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid HorizontalOptions="FillAndExpand" RowSpacing="0"
              VerticalOptions="FillAndExpand">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>

            <StackLayout Orientation="Horizontal"
                     HorizontalOptions="FillAndExpand"
                     BackgroundColor="{DynamicResource navBackgroundColor}">
            <StackLayout.Padding>
               <OnPlatform x:TypeArguments="Thickness">
                 <On Platform="Android" Value="0, 0, 0, 0"/>
                 <On Platform="iOS" Value="0, 50, 0, 0"/>
                </OnPlatform>
              </StackLayout.Padding>
            <Grid HorizontalOptions="FillAndExpand" HeightRequest="50">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                    <StackLayout Grid.Column="1" Padding="0,0,0,0" HeightRequest="30" WidthRequest="100" VerticalOptions="CenterAndExpand">
                        <StackLayout.HorizontalOptions>
                            <OnPlatform x:TypeArguments="LayoutOptions">
                                <On Platform="Android" Value="StartAndExpand"/>
                                <On Platform="iOS" Value="CenterAndExpand"/>
                            </OnPlatform>
                        </StackLayout.HorizontalOptions>
                        <Image Source="ontrack_wordmark_reversed" VerticalOptions="CenterAndExpand" Aspect="AspectFit"/>
                    </StackLayout>
                <!--<StackLayout Grid.Column="2"  Padding="0,0,0,0" HorizontalOptions="End">
                <Button x:Name="FavouriteButton"
                    HorizontalOptions="End"
                        TextColor="{DynamicResource navTextColor}"
                    Text="{Binding IsFavourite, Converter={StaticResource favouriteConverter}}"
                    Command="{Binding FavouriteCommand}"
                    FontFamily="{Binding IsFavourite, Converter={StaticResource favouriteFontConverter}}"
                    VerticalOptions="Center"
                        FontSize="Medium"
                        BackgroundColor="Transparent"
                        IsVisible="{Binding IsFavouriteVisible}"
                    />
                </StackLayout>-->
                <Button x:Name="BackButton" Text="" TextColor="{DynamicResource navTextColor}" BackgroundColor="Transparent" FontSize="25" FontFamily="{StaticResource fontAwesomeSolidFamily}" Clicked="BackButton_Clicked" />
            </Grid>
        </StackLayout>
        
        <Grid Grid.Row="1" HorizontalOptions="FillAndExpand" RowSpacing="0" VerticalOptions="FillAndExpand">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackLayout Grid.Row="0" Grid.Column="0" BackgroundColor="{DynamicResource tabHeaderColor}" VerticalOptions="FillAndExpand">
                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="10,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackLayout Grid.Row="0" Grid.Column="0">
                        <Frame HeightRequest="60" WidthRequest="60" CornerRadius="30" Padding="0" HorizontalOptions="Center" VerticalOptions="Center" HasShadow="False" IsClippedToBounds="True">
                        <ff:CachedImage Source="{Binding FixtureItem.League.Image, Converter={StaticResource imageConverter}}"
                                        ErrorPlaceholder="ontracklogo.png"
                                        LoadingPlaceholder="ontracklogo.png"
                                        CacheDuration="50"
                                        RetryCount="3"
                                        RetryDelay="600"
                                        Aspect="AspectFit"
                                        HeightRequest="50"
                                        WidthRequest="50"
                                        DownsampleToViewSize="True">  
                                        </ff:CachedImage>
                            </Frame>
                    </StackLayout>
                    <StackLayout Grid.Row="1" Grid.Column="0" Padding="0,0,0,0">
                        <Label Text="{Binding FixtureItem.League.Name}" VerticalOptions="StartAndExpand" HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" TextColor="{DynamicResource TextPrimaryColor}" FontSize="Small" />
                    </StackLayout>
                </Grid>
                <BoxView HeightRequest="1" HorizontalOptions="FillAndExpand" BackgroundColor="{DynamicResource backgroundColor}"/>
            </StackLayout>
            
           <StackLayout Grid.Row="1" VerticalOptions="FillAndExpand">
                <tabview:SfTabView VisibleHeaderCount="3" DisplayMode="Text"
                                   TabHeaderBackgroundColor="{DynamicResource tabHeaderColor}"
                                   TabHeight="50" EnableSwiping="False"
                                   >
                    <tabview:SfTabView.SelectionIndicatorSettings>
                        <tabview:SelectionIndicatorSettings Color="{DynamicResource tabIndicatorColor}" 
                                                              Position="Bottom" 
                                                          StrokeThickness="2"/>
                        </tabview:SfTabView.SelectionIndicatorSettings>
                    <tabview:SfTabItem Title="Match Summary" SelectionColor="{DynamicResource TextPrimaryColor}" TitleFontColor="Gray">
                        <tabview:SfTabItem.Content>
                            <ScrollView>
                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="Start" BackgroundColor="{DynamicResource backgroundColor}" >
                               <Grid.RowDefinitions>
                                   <RowDefinition Height="Auto" />
                                   <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>                                
                                <StackLayout Grid.Row="1" HorizontalOptions="FillAndExpand" Padding="10,15">
                                    <StackLayout>
                            <Frame Padding="10,0" HeightRequest="30" CornerRadius="15" HasShadow="False" BackgroundColor="{DynamicResource controlHeaderBackgroundColor}" VerticalOptions="CenterAndExpand" HorizontalOptions="Start">
                                <Label Text="Match Info" FontAttributes="Bold" TextColor="{DynamicResource TextPrimaryColor}" FontSize="Small" VerticalOptions="CenterAndExpand"/>
                            </Frame>
                        </StackLayout>
                               <Grid RowSpacing="15" VerticalOptions="Start">
                                <Grid.RowDefinitions>
                                   <RowDefinition Height="Auto" />
                                   <RowDefinition Height="Auto" />
                                   <RowDefinition Height="Auto" />
                                   <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackLayout Padding="10,0" Grid.Column="0">
                <Label Text="Tour" TextColor="Gray" FontSize="Micro"/>
            </StackLayout>
             <StackLayout Padding="10,0" Grid.Column="1" Orientation="Horizontal">
                <Label Text="{Binding FixtureItem.League.Name}" TextColor="{DynamicResource TextPrimaryColor}" FontSize="Small"/>
                 <!--<Label Text="{Binding FixtureItem.MatchType.Name, StringFormat='- {0}'}" TextColor="{DynamicResource TextPrimaryColor}" FontSize="Small"/>-->
            </StackLayout>
                    <StackLayout Padding="10,0" Grid.Row="1" Grid.Column="0">
                <Label Text="Date" TextColor="Gray"  FontSize="Micro" />
            </StackLayout>
            <StackLayout Padding="10,0" Grid.Row="1" Grid.Column="1" HorizontalOptions="FillAndExpand" Spacing="0">
                <Label Text="{Binding FixtureItem.Date, StringFormat='{0:dd MMM yyyy}'}" TextColor="{DynamicResource TextPrimaryColor}" FontSize="Small" />
               </StackLayout>
             <StackLayout Padding="10,0" Grid.Row="2" Grid.Column="0">
                <Label Text="Tee Off" TextColor="Gray"  FontSize="Micro" />
            </StackLayout>
            <StackLayout Padding="10,0" Grid.Row="2" Grid.Column="1" HorizontalOptions="FillAndExpand" Spacing="0">
                <Label Text="{Binding FixtureItem.FixtureTime, StringFormat='{0:h:mm tt}'}" TextColor="{DynamicResource TextPrimaryColor}" FontSize="Small" />
            </StackLayout>
                <StackLayout Padding="10,0" Grid.Row="3" Grid.Column="0">
                <Label Text="Course" TextColor="Gray"  FontSize="Micro"/>
            </StackLayout>
            <StackLayout Padding="10,0" Grid.Row="3" Grid.Column="1" HorizontalOptions="FillAndExpand" Spacing="0">
                <Label Text="{Binding FixtureItem.Field.Name}" TextColor="{DynamicResource TextPrimaryColor}" FontSize="Small"/>
                </StackLayout>
                    </Grid>
            </StackLayout>
                              </Grid>
                                </ScrollView>
                        </tabview:SfTabItem.Content>
                    </tabview:SfTabItem>
                    <tabview:SfTabItem Title="Scorecard" SelectionColor="{DynamicResource TextPrimaryColor}" TitleFontColor="Gray">
                        <tabview:SfTabItem.Content>
                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="{DynamicResource backgroundColor}">
                               <Grid.RowDefinitions>
                                   <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <listView:SfListView x:Name="ScorecardListView"
                                                ItemsSource="{Binding ScoreCollection}"
                                                     ItemTemplate="{StaticResource ScoreItemTemplate}"
                                                      HorizontalOptions="FillAndExpand"
                                                    VerticalOptions="FillAndExpand"
                                                   SelectionMode="None"
                                                   ItemSpacing="0"
                                                 AutoFitMode="DynamicHeight">
                                    <listView:SfListView.HeaderTemplate>
                                        <DataTemplate>
                                            <ViewCell>
                                                <ViewCell.View>
                                                    <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                    <Grid
                              x:Name="FirstDivTableHeaderGrid"
                              RowSpacing="1"
                              ColumnSpacing="1"                              
                              VerticalOptions="FillAndExpand"
                              HorizontalOptions="FillAndExpand">    
                        <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                    <RowDefinition Height="35" />
                                <RowDefinition Height="1" />
                            </Grid.RowDefinitions>
                            <BoxView Grid.Row="1" Grid.ColumnSpan="3" BackgroundColor="{DynamicResource controlHeaderBackgroundColor}" />
                        <StackLayout Grid.Row="0" Grid.ColumnSpan="2" Padding="10,0,0,0"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label 
                                   FontSize="13"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   FontAttributes="Bold"
                                   VerticalTextAlignment="Center"
                                        Text="PLAYER"/>
                        </StackLayout>
                           <StackLayout Grid.Row="0" Grid.Column="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label 
                                   FontSize="13"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   FontAttributes="Bold"
                                   VerticalTextAlignment="Center"
                                HorizontalTextAlignment="Center"
                                        Text="Score"/>
                        </StackLayout>
                        </Grid>
                                                        </StackLayout>
                                                </ViewCell.View>
                                            </ViewCell>
                                        </DataTemplate>
                                    </listView:SfListView.HeaderTemplate>
                                    </listView:SfListView>
                                </Grid>
                        </tabview:SfTabItem.Content>
                    </tabview:SfTabItem>
                    <tabview:SfTabItem Title="Table" SelectionColor="{DynamicResource TextPrimaryColor}"
                                       TitleFontColor="Gray">
                        <tabview:SfTabItem.Content>
                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="{DynamicResource backgroundColor}">
                               <Grid.RowDefinitions>
                                   <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <listView:SfListView Grid.Row="0" x:Name="TableListView"
                                                ItemsSource="{Binding TableCollection}"
                                                     ItemTemplate="{StaticResource TableItemTemplate}"
                                                      HorizontalOptions="FillAndExpand"
                                                    VerticalOptions="FillAndExpand"
                                                   SelectionMode="None"
                                                   ItemSpacing="0"
                                                 AutoFitMode="DynamicHeight">
                                    <listView:SfListView.HeaderTemplate>
                                        <DataTemplate>
                                            <ViewCell>
                                                <ViewCell.View>
                                                    <Grid Grid.Row="0" 
                              x:Name="FirstDivTableHeaderGrid"
                              RowSpacing="1"
                              ColumnSpacing="1"
                              
                              VerticalOptions="FillAndExpand"
                              HorizontalOptions="FillAndExpand">    
                        <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                    <RowDefinition Height="35" />
                                <RowDefinition Height="1" />
                            </Grid.RowDefinitions>
                            <BoxView Grid.Row="1" Grid.ColumnSpan="3" BackgroundColor="{DynamicResource controlHeaderBackgroundColor}" />
                        <StackLayout Grid.Row="0" Grid.ColumnSpan="2" Padding="10,0,0,0"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label 
                                   FontSize="13"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   FontAttributes="Bold"
                                   VerticalTextAlignment="Center"
                                        Text="PLAYER"/>
                        </StackLayout>
                           <StackLayout Grid.Row="0" Grid.Column="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label 
                                   FontSize="13"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   FontAttributes="Bold"
                                   VerticalTextAlignment="Center"
                                HorizontalTextAlignment="Center"
                                        Text="Points"/>
                        </StackLayout>
                        </Grid>
                                                </ViewCell.View>
                                            </ViewCell>
                                        </DataTemplate>
                                    </listView:SfListView.HeaderTemplate>
                                    </listView:SfListView>
                                </Grid>
                        </tabview:SfTabItem.Content>
                    </tabview:SfTabItem>
                </tabview:SfTabView>
            </StackLayout>
        </Grid>
            <StackLayout Grid.Row="2" Padding="0,0,0,0" HeightRequest="45" WidthRequest="200" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand">
                <Image Source="ontrack_wordmark_reversed" VerticalOptions="CenterAndExpand" Aspect="AspectFit"/>
            </StackLayout>
            <StackLayout Grid.Row="2" Padding="0,0,0,0" HeightRequest="50" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
                <StackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AdTappedCommand}"/>
                </StackLayout.GestureRecognizers>
                <Image Source="{Binding Ad.Image}" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Aspect="AspectFill"/>
            </StackLayout>
            <extensions:CustomBusyIndicator Grid.Row="1" IsVisible="{Binding IsActivityIndicatorVisible}"/>
            </Grid>
    </ContentPage.Content>
</ContentPage>
