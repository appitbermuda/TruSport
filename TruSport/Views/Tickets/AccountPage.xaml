<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             xmlns:model="clr-namespace:TruSport.Model" xmlns:extension="clr-namespace:TruSport.Extensions"
             xmlns:converters="clr-namespace:TruSport.Converters"
             xmlns:data="clr-namespace:Syncfusion.DataSource;assembly=Syncfusion.DataSource.Portable"
             x:Class="TruSport.Views.Tickets.AccountPage"
             Title="My Account">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBooleanConverter x:Key="inverseBooleanConverter"/>
            <converters:CardNumberConverter x:Key="cardNumberConverter"/>
            <converters:PhoneNumberConverter x:Key="phoneNumberConverter"/>
            <DataTemplate x:Name="CardItemTemplate" x:Key="CardItemTemplate">
                <StackLayout Padding="0"
                             HorizontalOptions="FillAndExpand"
                             VerticalOptions="FillAndExpand">
                    <StackLayout Grid.Row="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="5">
                        <Frame Padding="0" CornerRadius="5" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
                            <Frame Padding="0" CornerRadius="5" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" IsClippedToBounds="True" HasShadow="False">
                        <Grid VerticalOptions="FillAndExpand"
                              HorizontalOptions="FillAndExpand"
                              RowSpacing="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <StackLayout
                                         Padding="15,10"
                                         VerticalOptions="Center">
                                <Label Text="{Binding Last4}"
                                       FontSize="Medium"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                       LineBreakMode="WordWrap"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="Start">
                                </Label>
                                
                            </StackLayout>
                            <StackLayout Grid.Column="1"
                                         Padding="15,10"
                                         VerticalOptions="Center">
                                <Label Text="{Binding Expiry, StringFormat='Exp: {0}'}"
                                       FontSize="Small"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                       LineBreakMode="WordWrap"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="End"/>
                                
                            </StackLayout>
                        </Grid>
                    </Frame>
                        </Frame>
                </Grid>
                    </StackLayout>
                    </StackLayout>
            </DataTemplate>
            <DataTemplate x:Name="OrderItemTemplate" x:Key="OrderItemTemplate">
                <StackLayout Padding="0"
                             HorizontalOptions="FillAndExpand"
                             VerticalOptions="FillAndExpand">
                    <StackLayout Grid.Row="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="5">
                        <Frame Padding="0" CornerRadius="5" BackgroundColor="{DynamicResource controlElementBackgroundColor}"  VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
                            <Frame Padding="0" CornerRadius="5" BackgroundColor="{DynamicResource controlElementBackgroundColor}" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" IsClippedToBounds="True" HasShadow="False">
                        <Grid VerticalOptions="FillAndExpand"
                              HorizontalOptions="FillAndExpand"
                              RowSpacing="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackLayout Padding="15,10"
                                         VerticalOptions="Center">
                                <Label Text="Match Ticket"
                                       FontSize="8"
                                       TextColor="LightGray"
                                       LineBreakMode="WordWrap"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="Start"/>
                                <StackLayout>
                                <Label Text="{Binding Fixture}"
                                       FontSize="Micro"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                       LineBreakMode="WordWrap"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="Start">
                                </Label>
                                </StackLayout>
                            </StackLayout>
                            <StackLayout Grid.Row="0" Grid.Column="1"
                                         Padding="15,10"
                                         VerticalOptions="Center">
                                <Label Text="Date"
                                       FontSize="8"
                                       TextColor="LightGray"
                                       LineBreakMode="WordWrap"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="End"/>
                                <Label Text="{Binding OrderDetails[0].FixtureProduct.Fixture.FixtureTime, StringFormat='{0:MMM dd h:mm tt}'}"
                                       FontSize="Micro"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                       LineBreakMode="WordWrap"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="End">
                                </Label>
                                
                            </StackLayout>
                            <StackLayout Grid.Row="1" Grid.Column="0"
                                         Padding="15,10"
                                         VerticalOptions="Center">
                                <Label Text="Order #"
                                       FontSize="8"
                                       TextColor="LightGray"
                                       LineBreakMode="WordWrap"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="Start"/>
                                <Label Text="{Binding OrderNumber}"
                                       FontSize="Micro"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                       LineBreakMode="WordWrap"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="Start">
                                </Label>
                                
                            </StackLayout>
                            <StackLayout Grid.Row="1" Grid.Column="1"
                                         Padding="15,10"
                                         VerticalOptions="Center">
                                <Label Text="Trx Date"
                                       FontSize="8"
                                       TextColor="LightGray"
                                       LineBreakMode="WordWrap"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="End"/>
                                <Label Text="{Binding Date, StringFormat='{0:MMM dd, yyyy HH:mm tt}'}"
                                       FontSize="Micro"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                       LineBreakMode="WordWrap"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="End"/>
                                
                            </StackLayout>
                            <StackLayout Grid.Row="2"
                                         Padding="15,10"
                                         VerticalOptions="Center">
                                <Label Text="Authorisation"
                                       FontSize="8"
                                       TextColor="LightGray"
                                       LineBreakMode="WordWrap"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="Start"/>
                                <Label Text="{Binding Authorisation}"
                                       FontSize="Micro"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                       LineBreakMode="WordWrap"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="Start">
                                </Label>
                                
                            </StackLayout>
                            <StackLayout Grid.Row="2" Grid.Column="1"
                                         Padding="15,10"
                                         VerticalOptions="Center">
                                <Label Text="Total"
                                       FontSize="8"
                                       TextColor="LightGray"
                                       LineBreakMode="WordWrap"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="End"/>
                                <Label Text="{Binding Total, StringFormat='{0:C}'}"
                                       FontSize="Micro"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                       LineBreakMode="WordWrap"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="End"/>
                                
                            </StackLayout>
                        </Grid>
                    </Frame>
                        </Frame>
                </Grid>
                    </StackLayout>
                    </StackLayout>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <StackLayout BackgroundColor="{DynamicResource backgroundColor}">
            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
            <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                <Grid x:Name="ProfileGrid" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" RowSpacing="0" ColumnSpacing="0" Padding="10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1"/>
                </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackLayout Padding="0,30" Grid.ColumnSpan="2">
                        <Label Text="{Binding Customer.Name}" FontAttributes="Bold" FontSize="Large" HorizontalTextAlignment="Center" TextColor="{DynamicResource TextPrimaryColor}" VerticalOptions="CenterAndExpand"/>
                    </StackLayout>
                    <StackLayout Grid.Row="1" HeightRequest="50" Grid.Column="0" Orientation="Horizontal">
                        <Label Text="" FontFamily="{StaticResource fontAwesomeSolidFamily}" FontSize="Small" TextColor="LightGray" VerticalOptions="CenterAndExpand"/>
                    </StackLayout>
                    <StackLayout Grid.Row="1" HeightRequest="50" Grid.Column="1" Orientation="Horizontal">
                        <Label Text="{Binding Customer.Email}" FontSize="Small" TextColor="{DynamicResource TextPrimaryColor}" VerticalOptions="CenterAndExpand"/>
                    </StackLayout>
                    <BoxView Grid.Row="2" Grid.ColumnSpan="2" HeightRequest="1" BackgroundColor="WhiteSmoke"/>

                    <StackLayout Grid.Row="3" HeightRequest="50" Grid.Column="0" Orientation="Horizontal">
                        <Label Text="" FontFamily="{StaticResource fontAwesomeSolidFamily}" FontSize="Small" TextColor="LightGray" VerticalOptions="CenterAndExpand"/>
                    </StackLayout>
                    <StackLayout Grid.Row="3" HeightRequest="50" Grid.Column="1">
                        <Label Text="{Binding Customer.Phone, Converter={StaticResource phoneNumberConverter}}" FontSize="Small" TextColor="{DynamicResource TextPrimaryColor}" VerticalOptions="CenterAndExpand"/>
                    </StackLayout>
                    <BoxView Grid.Row="4" Grid.ColumnSpan="2" HeightRequest="1" BackgroundColor="WhiteSmoke"/>
            </Grid>
                </StackLayout>
            <StackLayout Grid.Row="1" Padding="50,20" VerticalOptions="EndAndExpand" BackgroundColor="{DynamicResource backgroundColor}">
                <Button Text="Sign Out" BackgroundColor="{DynamicResource buttonBackgroundColor}" TextColor="{DynamicResource buttonTextColor}" Padding="50,0" HeightRequest="50" CornerRadius="25" Command="{Binding SignOutCommand}"></Button>
            </StackLayout>                
            </Grid>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
