                                    ItemsSource="{Binding SportEventCollection}"
                                    ItemTemplate="{StaticResource MatchTicketItemTemplate}"
                                    SelectionMode="Single"
                                    SelectionChangedCommand="{Binding TicketSelectedCommand}"
                                    SelectionChangedCommandParameter="{x:Reference MatchTicketsList}"
                                    HorizontalOptions="FillAndExpand"
                                    VerticalOptions="FillAndExpand"
                                    ItemSpacing="5"
                                    Padding="1"
                                    SelectionBackgroundColor="{DynamicResource listSelectedBackgroundColor}"
                                    AutoFitMode="DynamicHeight"        
                                >
                <listView:SfListView.DataSource>
                                  <data:DataSource>
                                    <data:DataSource.SortDescriptors>
                                      <data:SortDescriptor PropertyName="Date" Direction="Ascending"/>
                                    </data:DataSource.SortDescriptors>
                                  </data:DataSource>
                                </listView:SfListView.DataSource>
            </listView:SfListView>
            </StackLayout>
