<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:converters="clr-namespace:TruSport.Converters" x:Class="TruSport.Views.Tickets.PurchaseTicketResultPage">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:PaymentResponseTextConverter x:Key="paymentResponseTextConverter" />
            <converters:PaymentResponseColorConverter x:Key="paymentResponseColorConverter" />
            <converters:PaymentResponseIconConverter x:Key="paymentResponseIconConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <StackLayout>
            <Grid VerticalOptions="FillAndExpand">
                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <!--<RowDefinition Height="Auto"/>-->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!--<StackLayout BackgroundColor="{DynamicResource navBackgroundColor}" >
                    <Label Text="PAYMENT" FontSize="Medium" FontAttributes="Bold" TextColor="{DynamicResource navTextColor}" FontFamily="{DynamicResource fontAwesomeSolidFamily}" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand"/>
                </StackLayout>-->
                 <StackLayout Padding="20,0">
                    <Button Text="" FontSize="30" TextColor="{DynamicResource buttonBackgroundColor}" FontFamily="{DynamicResource fontAwesomeSolidFamily}" VerticalOptions="CenterAndExpand" WidthRequest="40" HorizontalOptions="StartAndExpand" Command="{Binding BackCommand}"/>
                </StackLayout>
                <StackLayout Grid.Row="1" Padding="20,0" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand">
                    <StackLayout>
                        <Label HorizontalTextAlignment="Center" Text="{Binding Response.IsApproved, Converter={StaticResource paymentResponseIconConverter}}" FontFamily="{DynamicResource fontAwesomeSolidFamily}" FontSize="150" TextColor="{Binding Response.IsApproved, Converter={StaticResource paymentResponseColorConverter}}"/>
                    </StackLayout>
                    <StackLayout>
                        <Label HorizontalTextAlignment="Center" LineBreakMode="WordWrap" FontSize="20" Text="{Binding Response.Description}"  TextColor="{Binding Response.IsApproved, Converter={StaticResource paymentResponseColorConverter}}"/>
                        <!--<Label FontSize="30" Text="{Binding Response.IsApproved, Converter={StaticResource paymentResponseTextConverter}}"  TextColor="{Binding Response.IsApproved, Converter={StaticResource paymentResponseColorConverter}}"/>-->
                    </StackLayout>
                </StackLayout>
                <!--<StackLayout Grid.Row="2" Padding="20,20,20,0">
                    <StackLayout BindableLayout.ItemsSource="{Binding Response.Tickets}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid HorizontalOptions="FillAndExpand">
                                    <StackLayout HorizontalOptions="CenterAndExpand">
                                        <Label Text="Ticket" TextColor="{DynamicResource TextPrimaryColor}" FontSize="8" FontAttributes="Bold" HorizontalOptions="Start"/>
                                        <Label Text="{Binding .}" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" HorizontalTextAlignment="Center"/>
                                    </StackLayout>
                                        </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </StackLayout>
                </StackLayout>-->
            </Grid>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
