                                                            RetryCount="3"
                                                            RetryDelay="600"
                                             Aspect="AspectFit"
                                            HeightRequest="150"
                                                      WidthRequest="150"
                                                            DownsampleToViewSize="True">

                            </ff:CachedImage>
                                </Frame>                            
                        </StackLayout>
                        <StackLayout IsVisible="{Binding HomeTeam, Converter={StaticResource isNullConverter}}" Grid.Row="0" Grid.Column="0" Padding="5,0" Orientation="Horizontal" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand">
                        <StackLayout IsVisible="{Binding HomeTeam, Converter={StaticResource isNullConverter}}" Padding="5,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                <Frame HeightRequest="50" WidthRequest="50" CornerRadius="0" Padding="0" HorizontalOptions="Center" VerticalOptions="Center" HasShadow="False">
                            <ff:CachedImage Source="{Binding HomeTeamLogo, Converter={StaticResource imageConverter}}"
                                                            ErrorPlaceholder="ontracklogo.png"
                                            LoadingPlaceholder="ontracklogo.png"
                                                            CacheDuration="50"
                                                            RetryCount="3"
                                                            RetryDelay="600"
                                             Aspect="AspectFit"
                                            HeightRequest="60"
                                                      WidthRequest="60"
                                                            DownsampleToViewSize="True">

                            </ff:CachedImage>
                                </Frame>
                            <Label x:Name="HomeTeamNameLabel" HorizontalOptions="CenterAndExpand" HorizontalTextAlignment="Center" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimaryColor}" Text="{Binding HomeTeam}">
                                    <Label.FontSize>
                                        <OnPlatform x:TypeArguments="x:Double">  
                            <OnPlatform.Android> 
                                <OnIdiom x:TypeArguments="x:Double" Phone="10"  Tablet="17" /> 
                            </OnPlatform.Android> 
                            <OnPlatform.iOS> 
                                <OnIdiom x:TypeArguments="x:Double"  Phone="11"  Tablet="16" /> 
                            </OnPlatform.iOS> 
                        </OnPlatform> 
                                    </Label.FontSize>
                                </Label>
                        </StackLayout>
                        <StackLayout IsVisible="{Binding AwayTeam, Converter={StaticResource isNullConverter}}" Padding="5,0" HorizontalOptions="Center" VerticalOptions="Center">
                                 <Frame HeightRequest="50" WidthRequest="50" CornerRadius="0" Padding="0" HorizontalOptions="Center" VerticalOptions="Center" HasShadow="False">
                            <ff:CachedImage Source="{Binding AwayTeamLogo, Converter={StaticResource imageConverter}}"
                                                            ErrorPlaceholder="ontracklogo.png"
                                            LoadingPlaceholder="ontracklogo.png"
                                                            CacheDuration="50"
                                                            RetryCount="3"
                                                            RetryDelay="600"
                                             Aspect="AspectFit"
                                            HeightRequest="60"
                                                      WidthRequest="60"
                                                            DownsampleToViewSize="True">  
                                            </ff:CachedImage>
                                </Frame>
                            <Label x:Name="AwayTeamNameLabel" HorizontalOptions="CenterAndExpand" HorizontalTextAlignment="Center" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimaryColor}" Text="{Binding AwayTeam}">
                                    <Label.FontSize>
                                        <OnPlatform x:TypeArguments="x:Double">  
                            <OnPlatform.Android> 
                                <OnIdiom x:TypeArguments="x:Double" Phone="10"  Tablet="17" /> 
