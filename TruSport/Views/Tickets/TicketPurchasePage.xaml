                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <!--<RowDefinition Height="1" />-->
                    </Grid.RowDefinitions>
                       <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="*"/>
                           <!--<ColumnDefinition Width="Auto"/>
                           <ColumnDefinition Width="Auto"/>-->
                       </Grid.ColumnDefinitions>
                    <StackLayout VerticalOptions="CenterAndExpand"
                                     HorizontalOptions="CenterAndExpand">
                                <Label x:Name="TicketTypeLabel"
                                   FontSize="Small"
                                       FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   HorizontalOptions="CenterAndExpand"
                                   TextColor="{DynamicResource SelectedTextPrimaryColor}"
                                    Text="{Binding Product.Age}"/>
                        </StackLayout>
                       <StackLayout Grid.Row="1" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand">
                            <Label x:Name="PriceLabel"
                                   FontSize="Micro"
                                   HorizontalTextAlignment="Center"
                                   HorizontalOptions="CenterAndExpand"
                                   TextColor="{DynamicResource SelectedTextPrimaryColor}"
                                        Text="{Binding Product.Price, StringFormat='${0}'}"/>
                        </StackLayout>                       
                       <!--<BoxView Grid.Row="1" Grid.ColumnSpan="2" HeightRequest="1" HorizontalOptions="FillAndExpand" BackgroundColor="{DynamicResource borderColor}" />-->
                        </Grid>                        
                        </Frame>
            </StackLayout>
