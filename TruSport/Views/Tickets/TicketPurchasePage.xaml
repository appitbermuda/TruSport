<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:extension="clr-namespace:TruSport.Extensions" xmlns:textinputlayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms" xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms" xmlns:ff="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms" xmlns:converters="clr-namespace:TruSport.Converters" xmlns:numeric="clr-namespace:Syncfusion.SfNumericUpDown.XForms;assembly=Syncfusion.SfNumericUpDown.XForms"
    x:Class="TruSport.Views.Tickets.TicketPurchasePage">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:ListCountConverter x:Key="listCountConverter" />
            <converters:MemberTicketCountConverter x:Key="memberTicketCountConverter" />
            <DataTemplate x:Name="ContactTracingItemTemplate" x:Key="ContactTracingItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="FillAndExpand">
                   <Grid x:Name="grid" Padding="0,0,0,0"
                      RowSpacing="5"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="CenterAndExpand"
                      HorizontalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!--<RowDefinition Height="Auto" />-->
                        <!--<RowDefinition Height="1" />-->
                    </Grid.RowDefinitions>
                       <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="*"/>
                           <ColumnDefinition Width="Auto"/>
                           <ColumnDefinition Width="Auto"/>
                       </Grid.ColumnDefinitions>
                    <StackLayout VerticalOptions="CenterAndExpand"
                                     HorizontalOptions="StartAndExpand">
                                <Label x:Name="NameLabel"
                                   FontSize="Small"
                                       FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                    Text="{Binding Name}"/>
                        </StackLayout>
                       <StackLayout Grid.Column="1" VerticalOptions="CenterAndExpand" Padding="5,0,15,0">
                            <Label x:Name="PhoneLabel"
                                   FontSize="Micro"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                        Text="{Binding Phone}"/>
                        </StackLayout>
                       <StackLayout Grid.Column="2" VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand">
                            <Label x:Name="DeleteLabel"
                                   FontSize="20"
                                   TextColor="Red"
                                        Text=""
                                   FontFamily="{StaticResource fontAwesomeSolidFamily}"
                                   VerticalOptions="CenterAndExpand"/>
                        </StackLayout>
                       <!--<BoxView Grid.Row="1" Grid.ColumnSpan="2" HeightRequest="1" HorizontalOptions="FillAndExpand" BackgroundColor="{DynamicResource borderColor}" />-->
                        </Grid>
            </StackLayout>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>

        <StackLayout BackgroundColor="{DynamicResource backgroundColor}" Spacing="0">
            <Grid  BackgroundColor="{DynamicResource navBackgroundColor}" Padding="10,0" HeightRequest="90">
                <StackLayout VerticalOptions="FillAndExpand">
                    <Label Text="Purchase Ticket" FontSize="Small" FontAttributes="Bold" TextColor="{DynamicResource navTextColor}" FontFamily="{DynamicResource fontAwesomeSolidFamily}" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand"/>
                </StackLayout>
                 <StackLayout VerticalOptions="FillAndExpand">
                    <Button Text="" BackgroundColor="Transparent" FontSize="25" TextColor="{DynamicResource navTextColor}" FontFamily="{DynamicResource fontAwesomeSolidFamily}" VerticalOptions="CenterAndExpand" WidthRequest="30" HeightRequest="30" Padding="0" HorizontalOptions="StartAndExpand" Command="{Binding CloseClickedCommand}"/>
                </StackLayout>
            </Grid>
        <Grid VerticalOptions="FillAndExpand">
        <ScrollView VerticalOptions="FillAndExpand" Padding="0,0,0,50">
            <StackLayout Spacing="0">
                <Grid>
                    <StackLayout Spacing="0">
                <Grid>                    
                    <StackLayout HorizontalOptions="FillAndExpand"
                                 VerticalOptions="FillAndExpand" Padding="8,8,8,8" BackgroundColor="{DynamicResource frameBackgroundColor}">
                        <Frame Padding="0" CornerRadius="10" BackgroundColor="Transparent" HasShadow="False">
                            <Frame Padding="0" CornerRadius="10" IsClippedToBounds="True" BackgroundColor="Transparent" HasShadow="False">
                    <Grid x:Name="grid" Padding="0,0,0,0"
                          RowSpacing="5"
                          ColumnSpacing="1"
                          BackgroundColor="Transparent"
                          VerticalOptions="FillAndExpand"
                          HorizontalOptions="FillAndExpand">
                        <Grid.Resources>
                            <ResourceDictionary>
                                <converters:InverseBooleanConverter x:Key="inverseBooleanConverter"/>
                                <converters:ImageConverter x:Key="imageConverter"/>
                                <converters:TimeConverter x:Key="timeConverter"/>
                            </ResourceDictionary>
                        </Grid.Resources>
                    <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ContentView Grid.Row="0" Grid.ColumnSpan="5" BackgroundColor="{DynamicResource controlHeaderBackgroundColor}" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" />

                        <StackLayout Grid.Row="0" Grid.ColumnSpan="3" Spacing="5"
                                     VerticalOptions="CenterAndExpand"
                                         HorizontalOptions="StartAndExpand"
                                         Orientation="Horizontal">
                                <StackLayout Padding="2">
                                    <Label x:Name="FieldIcon"
                                       FontSize="Small"
                                           Text="&#xe901;"
                                           VerticalOptions="Center"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                        FontFamily="{StaticResource fontFamily}"/>
                                    </StackLayout>
                                <StackLayout>
                                    <Label x:Name="FieldName"
                                       FontSize="Small"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                        Text="{Binding SportEvent.Field.Name}"/>
                                    </StackLayout>
                            </StackLayout>
                            <StackLayout Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2"
                                     VerticalOptions="CenterAndExpand"
                                         HorizontalOptions="EndAndExpand"
                                         Orientation="Horizontal"
                                     Padding="5,10">
                                    <Label x:Name="TimeIcon"
                                       FontSize="Small"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                            Text="&#xe904;"
                                           FontFamily="{StaticResource fontFamily}"/>
                                <Label x:Name="TimeLabel"
                                       FontSize="Small"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                       VerticalTextAlignment="End"
                                            Text="{Binding SportEvent.EventTime, StringFormat='{0:MMM d - h:mm tt}'}"/>
                                
                            </StackLayout>

                        <StackLayout Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3">
                        <Label x:Name="TitleLabel"
                                   HorizontalOptions="CenterAndExpand"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   FontAttributes="Bold"
                                        Text="{Binding SportEvent.Title}">
                                <Label.FontSize>
                                    <OnPlatform x:TypeArguments="x:Double">  
                        <OnPlatform.Android> 
                            <OnIdiom x:TypeArguments="x:Double" Phone="14"  Tablet="21" /> 
                        </OnPlatform.Android> 
                        <OnPlatform.iOS> 
                            <OnIdiom x:TypeArguments="x:Double"  Phone="15"  Tablet="22" /> 
                        </OnPlatform.iOS> 
                    </OnPlatform> 
                                </Label.FontSize>
                            </Label>
                        <Label x:Name="DescriptionLabel"
                                   HorizontalOptions="CenterAndExpand"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   FontAttributes="Bold"
                                        Text="{Binding SportEvent.Description}">
                                <Label.FontSize>
                                    <OnPlatform x:TypeArguments="x:Double">  
                        <OnPlatform.Android> 
                            <OnIdiom x:TypeArguments="x:Double" Phone="12"  Tablet="19" /> 
                        </OnPlatform.Android> 
                        <OnPlatform.iOS> 
                            <OnIdiom x:TypeArguments="x:Double"  Phone="13"  Tablet="21" /> 
                        </OnPlatform.iOS> 
                    </OnPlatform> 
                                </Label.FontSize>
                            </Label>
                    </StackLayout>
                        
                        <StackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Padding="5,0" HorizontalOptions="Center" VerticalOptions="Center">
                                <Frame HeightRequest="70" WidthRequest="70" CornerRadius="35" Padding="0" HorizontalOptions="Center" VerticalOptions="Center" HasShadow="False">
                            <ff:CachedImage Source="{Binding SportEvent.HomeTeamLogo, Converter={StaticResource imageConverter}}"
                                                            ErrorPlaceholder="ontracklogo.png"
                                            LoadingPlaceholder="ontracklogo.png"
                                                            CacheDuration="50"
                                                            RetryCount="3"
                                                            RetryDelay="600"
                                             Aspect="AspectFit"
                                            HeightRequest="60"
                                                      WidthRequest="60"
                                                            DownsampleToViewSize="True">

                            </ff:CachedImage>
                                </Frame>
                            <Label x:Name="HomeTeamNameLabel" HorizontalOptions="CenterAndExpand" HorizontalTextAlignment="Center" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimaryColor}" Text="{Binding SportEvent.HomeTeam}">
                                    <Label.FontSize>
                                        <OnPlatform x:TypeArguments="x:Double">  
                            <OnPlatform.Android> 
                                <OnIdiom x:TypeArguments="x:Double" Phone="10"  Tablet="17" /> 
                            </OnPlatform.Android> 
                            <OnPlatform.iOS> 
                                <OnIdiom x:TypeArguments="x:Double"  Phone="11"  Tablet="16" /> 
                            </OnPlatform.iOS> 
                        </OnPlatform> 
                                    </Label.FontSize>
                                </Label>
                        </StackLayout>
                        <StackLayout Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" Padding="5,0" HorizontalOptions="Center" VerticalOptions="Center">
                                 <Frame HeightRequest="70" WidthRequest="70" CornerRadius="35" Padding="0" HorizontalOptions="Center" VerticalOptions="Center" HasShadow="False">
                            <ff:CachedImage Source="{Binding SportEvent.AwayTeamLogo, Converter={StaticResource imageConverter}}"
                                                            ErrorPlaceholder="ontracklogo.png"
                                            LoadingPlaceholder="ontracklogo.png"
                                                            CacheDuration="50"
                                                            RetryCount="3"
                                                            RetryDelay="600"
                                             Aspect="AspectFit"
                                            HeightRequest="60"
                                                      WidthRequest="60"
                                                            DownsampleToViewSize="True">  
                                            </ff:CachedImage>
                                </Frame>
                            <Label x:Name="AwayTeamNameLabel" HorizontalOptions="CenterAndExpand" HorizontalTextAlignment="Center" FontSize="Micro" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimaryColor}" Text="{Binding SportEvent.AwayTeam}">
                                    <Label.FontSize>
                                        <OnPlatform x:TypeArguments="x:Double">  
                            <OnPlatform.Android> 
                                <OnIdiom x:TypeArguments="x:Double" Phone="10"  Tablet="17" /> 
                            </OnPlatform.Android> 
                            <OnPlatform.iOS> 
                                <OnIdiom x:TypeArguments="x:Double"  Phone="11"  Tablet="16" /> 
                            </OnPlatform.iOS> 
                        </OnPlatform> 
                                    </Label.FontSize>
                                </Label>
                        </StackLayout>
                        <StackLayout Grid.Row="2" Grid.Column="2" VerticalOptions="Center"
                                         HorizontalOptions="Center"
                                             Orientation="Vertical"
                                     Padding="5,2"
                                     Spacing="5">
                     
                                <Label 
                                       x:Name="Versus"
                                       FontSize="Small"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                                      VerticalOptions="Center"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                            Text="V" />
                        </StackLayout>
                                <!--<StackLayout Grid.Row="0" Grid.Column="1"
                                     VerticalOptions="Center"
                                         HorizontalOptions="FillAndExpand"
                                     Padding="5,2"
                                     Spacing="0">
                                <Label x:Name="HomeTeamNameLabel"
                                       HorizontalOptions="EndAndExpand"
                                       HorizontalTextAlignment="End"
                                       FontSize="Micro"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                            Text="{Binding SportEvent.HomeTeam}">
                                    <Label.FontSize>
                                        <OnPlatform x:TypeArguments="x:Double">  
                            <OnPlatform.Android> 
                                <OnIdiom x:TypeArguments="x:Double" Phone="10"  Tablet="17" /> 
                            </OnPlatform.Android> 
                            <OnPlatform.iOS> 
                                <OnIdiom x:TypeArguments="x:Double"  Phone="11"  Tablet="16" /> 
                            </OnPlatform.iOS> 
                        </OnPlatform> 
                                    </Label.FontSize>
                                </Label>
                            </StackLayout>-->
                                <!--<StackLayout Grid.Row="0" Grid.Column="3"
                                     VerticalOptions="Center"
                                         HorizontalOptions="FillAndExpand"
                                     Padding="5,2"
                                     Spacing="0">
                                <Label x:Name="AwayTeamNameLabel"
                                       HorizontalOptions="StartAndExpand"
                                       HorizontalTextAlignment="Start"
                                       FontSize="Micro"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                       FontAttributes="Bold"
                                            Text="{Binding SportEvent.AwayTeam}">
                                    <Label.FontSize>
                                        <OnPlatform x:TypeArguments="x:Double">  
                            <OnPlatform.Android> 
                                <OnIdiom x:TypeArguments="x:Double" Phone="10"  Tablet="17" /> 
                            </OnPlatform.Android> 
                            <OnPlatform.iOS> 
                                <OnIdiom x:TypeArguments="x:Double"  Phone="11"  Tablet="16" /> 
                            </OnPlatform.iOS> 
                        </OnPlatform> 
                                    </Label.FontSize>
                                </Label>
                            </StackLayout>-->
                            </Grid>
                            </Frame>
                            </Frame>
                        </StackLayout>
                </Grid>

                <StackLayout Grid.ColumnSpan="2" HeightRequest="30" BackgroundColor="{DynamicResource controlHeaderBackgroundColor}" Padding="10,0">
                    <Label Text="Event Ticket" FontSize="Small" FontAttributes="Bold" VerticalOptions="CenterAndExpand" TextColor="{DynamicResource TextPrimaryColor}"/>
                </StackLayout>
                <Grid Padding="10,10,10,50">
                    <Grid.RowDefinitions>
                        <!--<RowDefinition Height="Auto"/>-->
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!--<StackLayout Grid.Row="0" Grid.ColumnSpan="2" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" Padding="0,0,0,20">
                        <Label Text="Event Ticket" TextColor="{DynamicResource TextPrimaryColor}" FontSize="25" FontAttributes="Bold" HorizontalOptions="CenterAndExpand"/>
                    </StackLayout>-->
                    <StackLayout Grid.Row="0" Grid.ColumnSpan="2" HorizontalOptions="StartAndExpand" Padding="0,0,0,75" IsVisible="{Binding EventTicketCollection, Converter={StaticResource listCountConverter}}">
                        <StackLayout BindableLayout.ItemsSource="{Binding EventTicketCollection}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <StackLayout>
                                        <Frame Padding="10" HasShadow="False" BorderColor="{DynamicResource buttonBackgroundColor}" BackgroundColor="Transparent">
                                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                    <StackLayout HorizontalOptions="StartAndExpand">
                                        <Label Text="{Binding Product.Age}" FontSize="Micro" TextColor="{DynamicResource TextPrimaryColor}" VerticalOptions="CenterAndExpand" HorizontalTextAlignment="Center"/>
                                    </StackLayout>
                                    <StackLayout Grid.Column="1" HorizontalOptions="StartAndExpand">
                                        <numeric:SfNumericUpDown Value="{Binding Quantity}" ValueChanged="SfNumericUpDown_ValueChanged"  BorderColor="Transparent" TextColor="{DynamicResource TextPrimaryColor}" FormatString="n0" StepValue="1" Minimum="0" Maximum="{Binding Product.MemberTicketCount, Converter={StaticResource memberTicketCountConverter}}" SpinButtonAlignment="Both" TextAlignment="Center" HeightRequest="30">
                                           <numeric:SfNumericUpDown.IncrementButtonSettings>
                                              <numeric:UpDownButtonSettings ButtonHeight="30" ButtonWidth="30">
                                                <numeric:UpDownButtonSettings.ButtonView>
                                                    <Grid HeightRequest="30" WidthRequest="30" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand">
                                                    <Label Text="" FontFamily="{StaticResource fontAwesomeSolidFamily}" TextColor="{DynamicResource buttonBackgroundColor}" FontSize="20" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand"/>
                                                    </Grid>
                                                    </numeric:UpDownButtonSettings.ButtonView>
                                                </numeric:UpDownButtonSettings>
                                          </numeric:SfNumericUpDown.IncrementButtonSettings>
                                          <numeric:SfNumericUpDown.DecrementButtonSettings>
                                              <numeric:UpDownButtonSettings ButtonHeight="30" ButtonWidth="30">
                                                <numeric:UpDownButtonSettings.ButtonView>
                                                    <Grid HeightRequest="30" WidthRequest="30" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand">
                                                    <Label Text="" FontFamily="{StaticResource fontAwesomeSolidFamily}" TextColor="{DynamicResource buttonBackgroundColor}" FontSize="20" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" VerticalOptions="CenterAndExpand"/>
                                                    </Grid>
                                                    </numeric:UpDownButtonSettings.ButtonView>
                                                </numeric:UpDownButtonSettings>
                                          </numeric:SfNumericUpDown.DecrementButtonSettings>
                                       </numeric:SfNumericUpDown>
                                        <!--<Entry Text="{Binding Quantity}" VerticalOptions="CenterAndExpand" HorizontalTextAlignment="Center" Keyboard="Numeric" Placeholder="1"/>-->
                                    </StackLayout>
                                    <StackLayout Grid.Column="2" HorizontalOptions="EndAndExpand" Margin="20,0,0,0">
                                        <Label Text="{Binding Product.Price, StringFormat='{0:C}'}" FontSize="Small" TextColor="{DynamicResource TextPrimaryColor}" FontAttributes="Bold" VerticalOptions="CenterAndExpand" HorizontalTextAlignment="Center"/>
                                    </StackLayout>
                                        </Grid>
                                        </Frame>
                                    </StackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </StackLayout>
                        <!--<StackLayout Padding="0,20,0,10">
                            <Button Text="UPDATE TOTAL" FontSize="Micro" HeightRequest="30" Padding="20,0" HorizontalOptions="Center" TextColor="{DynamicResource buttonTextColor}" BackgroundColor="{DynamicResource buttonBackgroundColor}" Command="{Binding UpdateQuantityCommand}"/>
                        </StackLayout>-->
                    </StackLayout>
                    <StackLayout Grid.Row="1" HorizontalOptions="StartAndExpand">
                        <Label Text="Subtotal" TextColor="{DynamicResource TextPrimaryColor}" FontSize="15" FontAttributes="Bold"/>
                    </StackLayout>
                    <StackLayout Grid.Row="1" Grid.Column="1" HorizontalOptions="EndAndExpand">
                        <Label Text="{Binding Subtotal, StringFormat='{0:C}'}" TextColor="{DynamicResource TextPrimaryColor}" FontSize="15" FontAttributes="Bold"/>
                    </StackLayout>
                    <StackLayout Grid.Row="2" HorizontalOptions="StartAndExpand">
                        <Label Text="Processing Fee" TextColor="{DynamicResource TextPrimaryColor}" FontSize="15" FontAttributes="Bold"/>
                    </StackLayout>
                    <StackLayout Grid.Row="2" Grid.Column="1" HorizontalOptions="EndAndExpand">
                        <Label Text="{Binding ProcessingFee, StringFormat='{0:C}'}" TextColor="{DynamicResource TextPrimaryColor}" FontSize="15" FontAttributes="Bold"/>
                    </StackLayout>
                    <BoxView Grid.ColumnSpan="2" HeightRequest="1" Grid.Row="3" BackgroundColor="{DynamicResource controlHeaderBackgroundColor}" />
                    <StackLayout Grid.Row="4" HorizontalOptions="StartAndExpand">
                        <Label Text="Total" TextColor="{DynamicResource TextPrimaryColor}" FontSize="18" FontAttributes="Bold"/>
                    </StackLayout>
                    <StackLayout Grid.Row="4" Grid.Column="1" HorizontalOptions="EndAndExpand">
                        <Label Text="{Binding Total, StringFormat='{0:C}'}" TextColor="{DynamicResource TextPrimaryColor}" FontSize="18" FontAttributes="Bold"/>
                    </StackLayout>
                </Grid>

                        <StackLayout HeightRequest="30" BackgroundColor="{DynamicResource controlHeaderBackgroundColor}" Padding="10,0">
                            <Label Text="Contact Tracing" FontSize="Small" FontAttributes="Bold" VerticalOptions="CenterAndExpand" TextColor="{DynamicResource TextPrimaryColor}"/>
                        </StackLayout>
                <Grid Padding="10" ColumnSpacing="20" Margin="0,0,0,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/> 
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackLayout Grid.ColumnSpan="2">
                        <Label Text="{Binding SportEvent.DefaultContactTraceTerm}" LineBreakMode="WordWrap" FontSize="9" />
                    </StackLayout>
                    <StackLayout Grid.Row="1" Grid.Column="0">
                        <textinputlayout:SfTextInputLayout IsHintAlwaysFloated="True" Hint="First Name" ContainerType="Outlined" UnfocusedColor="{DynamicResource unfocusedBackgroundColor}" FocusedColor="{DynamicResource buttonBackgroundColor}">
                            <Entry Text="{Binding FirstName}" Placeholder="First Name" TextColor="{DynamicResource TextPrimaryColor}"/>
                        </textinputlayout:SfTextInputLayout>
                    </StackLayout>
                    <StackLayout Grid.Row="1" Grid.Column="1">
                        <textinputlayout:SfTextInputLayout IsHintAlwaysFloated="True" Hint="Last Name" ContainerType="Outlined" UnfocusedColor="{DynamicResource unfocusedBackgroundColor}" FocusedColor="{DynamicResource buttonBackgroundColor}">
                            <Entry Text="{Binding LastName}" Placeholder="Last Name" TextColor="{DynamicResource TextPrimaryColor}"/>
                        </textinputlayout:SfTextInputLayout>
                    </StackLayout>
                    <StackLayout Grid.Row="2" Grid.ColumnSpan="2">
                        <textinputlayout:SfTextInputLayout IsHintAlwaysFloated="True" Hint="Phone" ContainerType="Outlined" UnfocusedColor="{DynamicResource unfocusedBackgroundColor}" FocusedColor="{DynamicResource buttonBackgroundColor}">
                            <Entry Text="{Binding Phone}" Placeholder="Phone" TextColor="{DynamicResource TextPrimaryColor}"/>
                        </textinputlayout:SfTextInputLayout>
                    </StackLayout>
                    <StackLayout Grid.Row="3" Grid.ColumnSpan="2">
                        <Button Text="Add" TextColor="{DynamicResource buttonTextColor}" BackgroundColor="{DynamicResource buttonBackgroundColor}" HeightRequest="30" CornerRadius="15" Padding="50,0" Command="{Binding AddContactTraceCommand}"/> 
                    </StackLayout>
                    <StackLayout Grid.Row="4" Grid.ColumnSpan="2" >
                        <BoxView HeightRequest="3" HorizontalOptions="FillAndExpand" BackgroundColor="{DynamicResource buttonBackgroundColor}"/>
                        <!--<Frame IsClippedToBounds="True" BorderColor="{DynamicResource controlElementBackgroundColor}" CornerRadius="10" HeightRequest="{Binding ContactTracingHeight}" Padding="5" BackgroundColor="Transparent" HasShadow="False">-->
                        <listView:SfListView x:Name="ContactTracingList"
                                    ItemsSource="{Binding ContactTraces}"
                                    ItemTemplate="{StaticResource ContactTracingItemTemplate}"
                                    SelectionMode="SingleDeselect"
                                    SelectionChangedCommand="{Binding ContactTracingSelectedCommand}"
                                    SelectionChangedCommandParameter="{x:Reference ContactTracingList}"
                                    HorizontalOptions="FillAndExpand"
                                    VerticalOptions="CenterAndExpand"
                                    ItemSpacing="5"
                                    Padding="1"
                                    SelectionBackgroundColor="{DynamicResource listSelectedBackgroundColor}"
                                    ItemSize="20"
                                    HeightRequest="{Binding ContactTracingHeight}"
                                />
                            <!--</Frame>-->
                    </StackLayout>
                </Grid>

                <StackLayout HeightRequest="30" BackgroundColor="{DynamicResource controlHeaderBackgroundColor}" Padding="10,0" IsVisible="{Binding ShowCardDetail}" >
                    <Label Text="Card Details" FontSize="Small" FontAttributes="Bold" VerticalOptions="CenterAndExpand" TextColor="{DynamicResource TextPrimaryColor}"/>
                </StackLayout>
                <Grid Padding="10" ColumnSpacing="20" IsVisible="{Binding ShowCardDetail}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackLayout Grid.ColumnSpan="2">
                        <textinputlayout:SfTextInputLayout IsHintAlwaysFloated="True" Hint="Name of Card" ContainerType="Outlined" UnfocusedColor="{DynamicResource unfocusedBackgroundColor}" FocusedColor="{DynamicResource buttonBackgroundColor}">
                            <Entry Text="{Binding CustomerName}" Placeholder="Name" TextColor="{DynamicResource TextPrimaryColor}"/>
                        </textinputlayout:SfTextInputLayout>
                    </StackLayout>
                    <StackLayout Grid.Row="1" Grid.ColumnSpan="2">
                        <textinputlayout:SfTextInputLayout IsHintAlwaysFloated="True" Hint="Card Number" ContainerType="Outlined" CharMaxLength="16" UnfocusedColor="{DynamicResource unfocusedBackgroundColor}" FocusedColor="{DynamicResource buttonBackgroundColor}">
                            <Entry Text="{Binding CreditCard.CardNumber}" MaxLength="16" Keyboard="Numeric" Placeholder="1111222233334444" TextColor="{DynamicResource TextPrimaryColor}"/>
                        </textinputlayout:SfTextInputLayout>
                    </StackLayout>
                    <StackLayout Grid.Row="2" Grid.Column="0">
                        <textinputlayout:SfTextInputLayout IsHintAlwaysFloated="True" Hint="Expiry (MMYY)" ContainerType="Outlined" CharMaxLength="4" UnfocusedColor="{DynamicResource unfocusedBackgroundColor}" FocusedColor="{DynamicResource buttonBackgroundColor}">
                            <Entry Text="{Binding CreditCard.Expiry}" MaxLength="4" Keyboard="Numeric" Placeholder="0125" TextColor="{DynamicResource TextPrimaryColor}"/>
                        </textinputlayout:SfTextInputLayout>
                    </StackLayout>
                    <StackLayout Grid.Row="2" Grid.Column="1">
                        <textinputlayout:SfTextInputLayout IsHintAlwaysFloated="True" Hint="CVV" ContainerType="Outlined" CharMaxLength="3" UnfocusedColor="{DynamicResource unfocusedBackgroundColor}" FocusedColor="{DynamicResource buttonBackgroundColor}">
                            <Entry Text="{Binding CreditCard.CVV}" MaxLength="3" Keyboard="Numeric" Placeholder="123" TextColor="{DynamicResource TextPrimaryColor}"/>
                        </textinputlayout:SfTextInputLayout>
                    </StackLayout>
                </Grid>
                        
                <StackLayout HeightRequest="30" BackgroundColor="{DynamicResource controlHeaderBackgroundColor}" Padding="10,0">
                    <Label Text="Important Information" FontSize="Small" FontAttributes="Bold" VerticalOptions="CenterAndExpand" TextColor="{DynamicResource TextPrimaryColor}"/>
                </StackLayout>
                <StackLayout Padding="10" Spacing="10">
                    <!--<Label Text="Due to your privacy and protection, OnTrack will not be storing your card information." FontSize="10" TextColor="{DynamicResource TextPrimaryColor}"/>-->

                    <Label Text="{Binding SportEvent.DefaultTicketTerm}" FontSize="10" TextColor="{DynamicResource TextPrimaryColor}"/>

                    <Label Text="{Binding SportEvent.Term}" TextColor="{DynamicResource TextPrimaryColor}" FontSize="10"/>

                    <StackLayout Orientation="Horizontal" Padding="0,50,0,0">
                        <StackLayout>
                            <CheckBox x:Name="AgreeCheckbox" HeightRequest="50" Color="{DynamicResource buttonBackgroundColor}" HorizontalOptions="CenterAndExpand" VerticalOptions="Start" />
                        </StackLayout>
                        <StackLayout VerticalOptions="CenterAndExpand" HorizontalOptions="Center">
                            <Label FontAttributes="Bold" FontSize="Small" HorizontalTextAlignment="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="I have read and agree to the current" TextColor="{DynamicResource TextPrimaryColor}" FontSize="Small" ></Span>
                                        <Span Text=" Terms of Use" TextColor="{DynamicResource buttonBackgroundColor}" FontAttributes="Bold" FontSize="Small" >
                                            <Span.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="Button_Clicked"/>
                                            </Span.GestureRecognizers>
                                        </Span>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <!--<Button Text="Terms of Use" TextColor="{DynamicResource buttonBackgroundColor}" FontAttributes="Bold" FontSize="Small" HorizontalOptions="Center" HeightRequest="15" Clicked="Button_Clicked"/>-->
                        </StackLayout>
                    </StackLayout>
                    
                </StackLayout>

                <StackLayout Padding="10">
                    <Button Text="{Binding Total, StringFormat='Purchase {0:C}'}" IsVisible="False" TextColor="{DynamicResource buttonTextColor}" BackgroundColor="{DynamicResource buttonBackgroundColor}" HeightRequest="50" HorizontalOptions="Center" Padding="50,0" CornerRadius="25" Command="{Binding PurchaseCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button"
                                         Binding="{Binding Source={x:Reference AgreeCheckbox}, Path=IsChecked}"
                                         Value="true">
                                <Setter Property="IsVisible"
                                        Value="true" />
                            </DataTrigger>
    </Button.Triggers>
                    </Button>
                </StackLayout>
                        </StackLayout>
                </Grid>
            </StackLayout>
        </ScrollView>
            <extension:CustomBusyIndicator IsVisible="{Binding IsBusy}"/>
            </Grid>
            </StackLayout>
    </ContentPage.Content>
</ContentPage>
