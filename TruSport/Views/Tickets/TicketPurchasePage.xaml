                            <OnPlatform.iOS> 
                                <OnIdiom x:TypeArguments="x:Double"  Phone="11"  Tablet="16" /> 
                            </OnPlatform.iOS> 
                        </OnPlatform> 
                                    </Label.FontSize>
                                </Label>
                        </StackLayout>
                        </StackLayout>

                            </Grid>
                        </StackLayout>
                                            <!--Event Tickets-->
                        <StackLayout Grid.Row="1" >
                            <StackLayout HorizontalOptions="StartAndExpand" Padding="0,0,0,50" IsVisible="{Binding EventTickets, Converter={StaticResource eventTicketIsStopConverter}}">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackLayout Grid.Row="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                <StackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="MatchSpotImageTapped" CommandParameter="{Binding EventTickets}"/>
                                                </StackLayout.GestureRecognizers>
                                <ff:CachedImage Source="{Binding EventTickets, Converter={StaticResource eventImageConverter}}"
                                                            ErrorPlaceholder="ontracklogo.png"
                                            LoadingPlaceholder="ontracklogo.png"
                                                            CacheDuration="50"
                                                            RetryCount="3"
                                                            RetryDelay="600" 
                                             Aspect="AspectFit"
                                             WidthRequest="{Binding ., Converter={StaticResource widthConverter}}"
                                             HorizontalOptions="FillAndExpand"
                                             VerticalOptions="FillAndExpand"
                                                            DownsampleToViewSize="True">  
                                </ff:CachedImage>
                            </StackLayout>
                                        <StackLayout Grid.Row="1" Padding="10,5,10,10">
