<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:extension="clr-namespace:TruSport.Extensions" xmlns:textinputlayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms" xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms" xmlns:numeric="clr-namespace:Syncfusion.SfNumericUpDown.XForms;assembly=Syncfusion.SfNumericUpDown.XForms" xmlns:ff="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms" xmlns:converters="clr-namespace:TruSport.Converters" xmlns:picker="http://schemas.syncfusion.com/xamarin"
    x:Class="TruSport.Views.Tickets.TicketPurchasePage"
    Title="Purchase Ticket">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:ListHeightConverter x:Key="listHeightConverter" />
            <converters:ListCountConverter x:Key="listCountConverter" />
            <converters:InverseBooleanConverter x:Key="inverseBooleanConverter" />
            <converters:EventTicketIsStopConverter x:Key="eventTicketIsStopConverter" />
            <converters:EventTicketIsStopInverseConverter x:Key="eventTicketIsStopInverseConverter" />
            <converters:MemberTicketCountConverter x:Key="memberTicketCountConverter" />
            <converters:EventArgsConverter x:Key="eventArgsConverter"/>
            <converters:HalfWidthConverter x:Key="halfWidthConverter"/>
            <converters:WidthConverter x:Key="widthConverter"/>
            <converters:ImageConverter x:Key="imageConverter"/>
            <converters:EventImageConverter x:Key="eventImageConverter"/>
            <DataTemplate x:Name="ContactTracingItemTemplate" x:Key="ContactTracingItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="FillAndExpand">
                   <Grid x:Name="grid" Padding="0,0,0,0"
                      RowSpacing="5"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="CenterAndExpand"
                      HorizontalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!--<RowDefinition Height="Auto" />-->
                        <!--<RowDefinition Height="1" />-->
                    </Grid.RowDefinitions>
                       <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="*"/>
                           <ColumnDefinition Width="Auto"/>
                           <ColumnDefinition Width="Auto"/>
                       </Grid.ColumnDefinitions>
                    <StackLayout VerticalOptions="CenterAndExpand"
                                     HorizontalOptions="StartAndExpand">
                                <Label x:Name="NameLabel"
                                   FontSize="Small"
                                       FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                    Text="{Binding Name}"/>
                        </StackLayout>
                       <StackLayout Grid.Column="1" VerticalOptions="CenterAndExpand" Padding="5,0,15,0">
                            <Label x:Name="PhoneLabel"
                                   FontSize="Micro"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                        Text="{Binding Phone}"/>
                        </StackLayout>
                       <StackLayout Grid.Column="2" VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand">
                            <Label x:Name="DeleteLabel"
                                   FontSize="20"
                                   TextColor="Red"
                                        Text=""
                                   FontFamily="{StaticResource fontAwesomeSolidFamily}"
                                   VerticalOptions="CenterAndExpand"/>
                        </StackLayout>
                       <!--<BoxView Grid.Row="1" Grid.ColumnSpan="2" HeightRequest="1" HorizontalOptions="FillAndExpand" BackgroundColor="{DynamicResource borderColor}" />-->
                        </Grid>
            </StackLayout>
            </DataTemplate>
            <DataTemplate x:Name="EventTicketSpotItemTemplate" x:Key="EventTicketSpotItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="FillAndExpand" WidthRequest="{Binding ., Converter={StaticResource halfWidthConverter}}" Padding="0,2.5">
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Path=BindingContext.EventTicketSpotSelectedCommand}" CommandParameter="{Binding .}"/>
                    </StackLayout.GestureRecognizers>
                    <Frame Padding="5" HasShadow="False" BorderColor="{DynamicResource buttonBackgroundColor}" BackgroundColor="Transparent">
                   <Grid x:Name="grid" Padding="0,0,0,0"
                      RowSpacing="5"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="CenterAndExpand"
                      HorizontalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <!--<RowDefinition Height="1" />-->
                    </Grid.RowDefinitions>
                       <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="*"/>
                           <!--<ColumnDefinition Width="Auto"/>
                           <ColumnDefinition Width="Auto"/>-->
                       </Grid.ColumnDefinitions>
                    <StackLayout VerticalOptions="CenterAndExpand"
                                     HorizontalOptions="CenterAndExpand">
                                <Label x:Name="TicketTypeLabel"
                                   FontSize="Small"
                                       FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   HorizontalOptions="CenterAndExpand"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                    Text="{Binding Product.Age}"/>
                        </StackLayout>
                       <StackLayout Grid.Row="1" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand">
                            <Label x:Name="PriceLabel"
                                   FontSize="Micro"
                                   HorizontalTextAlignment="Center"
                                   HorizontalOptions="CenterAndExpand"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                        Text="{Binding Product.Price, StringFormat='${0}'}"/>
                        </StackLayout>                       
                       <!--<BoxView Grid.Row="1" Grid.ColumnSpan="2" HeightRequest="1" HorizontalOptions="FillAndExpand" BackgroundColor="{DynamicResource borderColor}" />-->
                        </Grid>
                        </Frame>
            </StackLayout>
            </DataTemplate>
            <DataTemplate x:Name="SelectedEventTicketSpotItemTemplate" x:Key="SelectedEventTicketSpotItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="FillAndExpand" WidthRequest="50">
                    <Frame Padding="5" HasShadow="False" BorderColor="{DynamicResource buttonBackgroundColor}" BackgroundColor="{StaticResource selectedFrameBackgroundColor}">
