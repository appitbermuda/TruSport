                        </Grid>
                    </StackLayout>
                    <StackLayout HorizontalOptions="StartAndExpand" IsVisible="{Binding EventTickets, Converter={StaticResource eventTicketIsStopInverseConverter}}">
                        <StackLayout HorizontalOptions="StartAndExpand" Padding="0,0,0,75" IsVisible="{Binding EventTickets, Converter={StaticResource listCountConverter}}">
                            <StackLayout BindableLayout.ItemsSource="{Binding EventTickets}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <StackLayout>
                                            <Frame Padding="10" HasShadow="False" BorderColor="{DynamicResource buttonBackgroundColor}" BackgroundColor="Transparent">
                                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="80"/>
