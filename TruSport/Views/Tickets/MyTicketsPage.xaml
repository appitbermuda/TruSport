<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms" xmlns:extension="clr-namespace:TruSport.Extensions" xmlns:ff="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms" xmlns:converters="clr-namespace:TruSport.Converters" xmlns:forms="clr-namespace:ZXing.Net.Mobile.Forms;assembly=ZXing.Net.Mobile.Forms" xmlns:zxcm="clr-namespace:ZXing.Common;assembly=zxing.portable" xmlns:tabView="http://schemas.syncfusion.com/xamarin" xmlns:data="clr-namespace:Syncfusion.DataSource;assembly=Syncfusion.DataSource.Portable" xmlns:pullToRefresh="clr-namespace:Syncfusion.SfPullToRefresh.XForms;assembly=Syncfusion.SfPullToRefresh.XForms"
    x:Class="TruSport.Views.Tickets.MyTicketsPage"
    Title="My Tickets">
    <ContentPage.Resources>
        <converters:InverseBooleanConverter x:Key="inverseBooleanConverter" />            
        <converters:ListCountConverter x:Key="listCountConverter"/>
                                <converters:IsNullConverter x:Key="isNullConverter"/>
        <ResourceDictionary>
            <converters:GroupHeaderNameConverter x:Key="groupHeaderNameConverter"/>
            <converters:GroupHeaderSizeConverter x:Key="groupHeaderSizeConverter"/>
            <converters:GroupHeaderFontConverter x:Key="groupHeaderFontConverter"/>
            <converters:GroupingSelectionTicketConverter x:Key="groupingSelectionConverter"/>
            <DataTemplate x:Name="MatchTicketItemTemplate" x:Key="MatchTicketItemTemplate">
                            <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="FillAndExpand" Padding="8,8,8,8">
                    <Frame Padding="0" CornerRadius="10" BackgroundColor="Transparent">
                        <Frame Padding="0" CornerRadius="10" IsClippedToBounds="True" BackgroundColor="{DynamicResource frameBackgroundColor}">
                <Grid x:Name="grid" Padding="0,10,0,0"
                      RowSpacing="5"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">
                    <Grid.Resources>
                        <ResourceDictionary>
                            <converters:ImageConverter x:Key="imageConverter"/>
                            <converters:TimeConverter x:Key="timeConverter"/>
                            <converters:InverseBooleanConverter x:Key="inverseBooleanConverter" />
                                <converters:IsNullConverter x:Key="isNullConverter"/>
                        </ResourceDictionary>
                    </Grid.Resources>
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackLayout  IsVisible="{Binding EventTicket.SportEvent.EventLogo, Converter={StaticResource isNullConverter}}" Grid.Row="0" Grid.ColumnSpan="5">
                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackLayout Grid.Row="1" Padding="5,0" HorizontalOptions="Center" VerticalOptions="Center">
                                <Frame HeightRequest="160" WidthRequest="160" CornerRadius="80" Padding="0" HorizontalOptions="Center" VerticalOptions="Center" HasShadow="False">
                            <ff:CachedImage Source="{Binding EventTicket.SportEvent.EventLogo, Converter={StaticResource imageConverter}}"
                                                            ErrorPlaceholder="ontracklogo.png"
                                            LoadingPlaceholder="ontracklogo.png"
                                                            CacheDuration="50"
                                                            RetryCount="3"
                                                            RetryDelay="600"
                                             Aspect="AspectFit"
                                            HeightRequest="150"
                                                      WidthRequest="150"
                                                            DownsampleToViewSize="True">

                            </ff:CachedImage>
                                </Frame>                            
                        </StackLayout>
                                        <StackLayout Grid.Row="0">
                                            <StackLayout HorizontalOptions="CenterAndExpand">
                                                <Label x:Name="EventTitle"
                                       FontSize="18"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                        Text="{Binding EventTicket.SportEvent.Title}"
                                        HorizontalTextAlignment="Center"
                                        FontAttributes="Bold"/>
                                            </StackLayout>
                                            <StackLayout>
                                                <Label x:Name="EventDescription"
                                       FontSize="15"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                        Text="{Binding EventTicket.SportEvent.Description}"
                                        HorizontalTextAlignment="Center"
                                        />
                                            </StackLayout>
                                        </StackLayout>
                        </Grid>
                    </StackLayout>

                    <StackLayout IsVisible="{Binding EventTicket.SportEvent.HomeTeam, Converter={StaticResource isNullConverter}}" Grid.Row="0" Grid.ColumnSpan="5">
                        <Grid x:Name="MatchGrid" Padding="0,0,0,0"
                      RowSpacing="1"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">
                    <Grid.Resources>
                        <ResourceDictionary>
                            <converters:ImageConverter x:Key="imageConverter"/>
                            <converters:TimeConverter x:Key="timeConverter"/>
                            <converters:InverseBooleanConverter x:Key="inverseBooleanConverter" />
                        </ResourceDictionary>
                    </Grid.Resources>
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                                        <StackLayout Grid.Row="0" Grid.Column="0" Padding="5" HorizontalOptions="Center" VerticalOptions="Center">
                            <Frame HeightRequest="40" WidthRequest="40" CornerRadius="20" Padding="0" HorizontalOptions="Center" VerticalOptions="Center" HasShadow="False" IsClippedToBounds="True">
                        <ff:CachedImage Source="{Binding EventTicket.SportEvent.HomeTeamLogo, Converter={StaticResource imageConverter}}"
                                                        ErrorPlaceholder="ontracklogo.png"
                                        LoadingPlaceholder="ontracklogo.png"
                                                        CacheDuration="50"
                                                        RetryCount="3"
                                                        RetryDelay="600"
                                         Aspect="AspectFit"
                                        HeightRequest="30"
                                                  WidthRequest="30"
                                                        DownsampleToViewSize="True">

                        </ff:CachedImage>
                            </Frame>
                    </StackLayout>
                    <StackLayout Grid.Row="0" Grid.Column="4" Padding="5" HorizontalOptions="Center" VerticalOptions="Center">
                             <Frame HeightRequest="40" WidthRequest="40" CornerRadius="20" Padding="0" HorizontalOptions="Center" VerticalOptions="Center" HasShadow="False" IsClippedToBounds="True">
                        <ff:CachedImage Source="{Binding EventTicket.SportEvent.AwayTeamLogo, Converter={StaticResource imageConverter}}"
                                                        ErrorPlaceholder="ontracklogo.png"
                                        LoadingPlaceholder="ontracklogo.png"
                                                        CacheDuration="50"
                                                        RetryCount="3"
                                                        RetryDelay="600"
                                         Aspect="AspectFit"
                                        HeightRequest="30"
                                                  WidthRequest="30"
                                                        DownsampleToViewSize="True">  
                                        </ff:CachedImage>
                            </Frame>
                    </StackLayout>
                            <StackLayout Grid.Row="0" Grid.Column="2" VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                         Orientation="Vertical"
                                 Padding="5,2"
                                 Spacing="5">
                     
                            <Label 
                                   x:Name="Versus"
                                   FontSize="Small"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                        Text="V" />
                    </StackLayout>
                            <StackLayout Grid.Row="0" Grid.Column="1"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="5,2"
                                 Spacing="0">
                            <Label x:Name="HomeTeamNameLabel"
                                   HorizontalOptions="EndAndExpand"
                                   HorizontalTextAlignment="End"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                        Text="{Binding EventTicket.SportEvent.HomeTeam}">
                                <Label.FontSize>
                                    <OnPlatform x:TypeArguments="x:Double">  
                        <OnPlatform.Android> 
                            <OnIdiom x:TypeArguments="x:Double" Phone="10"  Tablet="17" /> 
                        </OnPlatform.Android> 
                        <OnPlatform.iOS> 
                            <OnIdiom x:TypeArguments="x:Double"  Phone="11"  Tablet="16" /> 
                        </OnPlatform.iOS> 
                    </OnPlatform> 
                                </Label.FontSize>
                            </Label>
                        </StackLayout>
                            <StackLayout Grid.Row="0" Grid.Column="3"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="5,2"
                                 Spacing="0">
                            <Label x:Name="AwayTeamNameLabel"
                                   HorizontalOptions="StartAndExpand"
                                   HorizontalTextAlignment="Start"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   FontAttributes="Bold"
                                        Text="{Binding EventTicket.SportEvent.AwayTeam}">
                                <Label.FontSize>
                                    <OnPlatform x:TypeArguments="x:Double">  
                        <OnPlatform.Android> 
                            <OnIdiom x:TypeArguments="x:Double" Phone="10"  Tablet="17" /> 
                        </OnPlatform.Android> 
                        <OnPlatform.iOS> 
                            <OnIdiom x:TypeArguments="x:Double"  Phone="11"  Tablet="16" /> 
                        </OnPlatform.iOS> 
                    </OnPlatform> 
                                </Label.FontSize>
                            </Label>
                        </StackLayout>
                                        </Grid>
                                </StackLayout>
                    
                    <StackLayout Grid.Row="1" Grid.ColumnSpan="5" Spacing="5" Padding="5,10,5,0"
                                     VerticalOptions="EndAndExpand"
                                         HorizontalOptions="CenterAndExpand"
                                         Orientation="Horizontal">
                                <StackLayout Padding="2">
                                    <Label x:Name="FieldIcon"
                                       FontSize="15"
                                           Text="&#xe901;"
                                           VerticalOptions="Center"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                        FontFamily="{StaticResource fontFamily}"/>
                                    </StackLayout>
                                <StackLayout>
                                    <Label x:Name="FieldName"
                                       FontSize="15"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                        Text="{Binding EventTicket.SportEvent.Field.Name}"/>
                                    </StackLayout>
                            </StackLayout>
                            <StackLayout Grid.Row="2" Grid.ColumnSpan="5"
                                     VerticalOptions="Center"
                                         HorizontalOptions="CenterAndExpand"
                                         Orientation="Horizontal"
                                     Padding="5,0,5,10">
                                    <Label x:Name="TimeIcon"
                                       FontSize="17"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                            Text="&#xe904;"
                                           FontFamily="{StaticResource fontFamily}"/>
                                <Label x:Name="TimeLabel"
                                       FontSize="17"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                       VerticalTextAlignment="End"
                                           FontAttributes="Bold"
                                            Text="{Binding EventTicket.SportEvent.EventTime, StringFormat='{0:MMM dd - hh:mm tt}'}"/>
                                </StackLayout>
                    <StackLayout Grid.Row="3" Grid.ColumnSpan="5"
                                     VerticalOptions="Center"
                                         HorizontalOptions="CenterAndExpand"
                                     Padding="5,10">
                                <Label x:Name="AgeLabel"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                       VerticalTextAlignment="End"
                                            Text="{Binding EventTicket.Product.Age, StringFormat='{0} Ticket'}" FontAttributes="Bold" FontSize="25"/>
                                <Label x:Name="MemberLabel" IsVisible="{Binding IsMemberTicket}"
                                       TextColor="{DynamicResource buttonBackgroundColor}"
                                       VerticalTextAlignment="End"
                                       HorizontalTextAlignment="Center"
                                            Text="Member" FontAttributes="Bold" FontSize="15"/>
                                </StackLayout>
                    <BoxView HeightRequest="1" BackgroundColor="{DynamicResource frameBackgroundColor}" Grid.ColumnSpan="5" Grid.Row="4" Opacity="0.3"/>
                    <StackLayout Grid.Row="5" Grid.ColumnSpan="5" IsVisible="{Binding Validated, Converter={StaticResource inverseBooleanConverter}}">
                        <Frame Padding="0" CornerRadius="5" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
                            <Frame Padding="0" CornerRadius="5" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" IsClippedToBounds="True" HasShadow="False">
                        <StackLayout>
                            <forms:ZXingBarcodeImageView
                                x:Name="QRCode"
                                Aspect="AspectFit"
                                BarcodeFormat="QR_CODE"
                                WidthRequest="300"
                                HeightRequest="300"
                                Margin="10"
                                HorizontalOptions="CenterAndExpand"
                                VerticalOptions="CenterAndExpand"
                                BarcodeValue="{Binding CustomerTicketObject}">
                                <forms:ZXingBarcodeImageView.BarcodeOptions>
                                    <zxcm:EncodingOptions Width="300" Height="300" />
                                </forms:ZXingBarcodeImageView.BarcodeOptions>
                            </forms:ZXingBarcodeImageView>
                        </StackLayout>
                    </Frame>
                        </Frame>
                                </StackLayout>
                        </Grid>
                        </Frame>
                        </Frame>
                    </StackLayout>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <StackLayout Background="{DynamicResource backgroundColor}">
            <Grid HorizontalOptions="FillAndExpand" RowSpacing="0" VerticalOptions="FillAndExpand" BackgroundColor="{DynamicResource backgroundColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

                <StackLayout IsVisible="{Binding TransferRequestCollection, Converter={StaticResource listCountConverter}}">
            <StackLayout x:Name="TransferRequestList" BindableLayout.ItemsSource="{Binding TransferRequestCollection}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid HorizontalOptions="FillAndExpand">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="60"/>
                                            <RowDefinition Height="1"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                    <StackLayout HorizontalOptions="CenterAndExpand" Grid.ColumnSpan="2">
                                        <Grid>
                    <StackLayout HorizontalOptions="FillAndExpand"
                                 VerticalOptions="FillAndExpand" Padding="8,8,8,8" BackgroundColor="{DynamicResource frameBackgroundColor}">
                        <Frame Padding="0" CornerRadius="10" BackgroundColor="Transparent" HasShadow="False">
                            <Frame Padding="0" CornerRadius="10" IsClippedToBounds="True" BackgroundColor="Transparent" HasShadow="False">
                    <Grid x:Name="grid" Padding="0,0,0,0"
                          RowSpacing="5"
                          ColumnSpacing="1"
                          BackgroundColor="Transparent"
                          VerticalOptions="FillAndExpand"
                          HorizontalOptions="FillAndExpand">
                        <Grid.Resources>
                            <ResourceDictionary>
                                <converters:InverseBooleanConverter x:Key="inverseBooleanConverter"/>
                                <converters:ImageConverter x:Key="imageConverter"/>
                                <converters:TimeConverter x:Key="timeConverter"/>
                            </ResourceDictionary>
                        </Grid.Resources>
                    <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackLayout Grid.Row="1" Grid.ColumnSpan="5" Spacing="5" Padding="5,10"
                                     VerticalOptions="EndAndExpand"
                                         HorizontalOptions="CenterAndExpand"
                                         Orientation="Horizontal">
                                <StackLayout Padding="2">
                                    <Label x:Name="FieldIcon"
                                       FontSize="Small"
                                           Text="&#xe901;"
                                           VerticalOptions="Center"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                        FontFamily="{StaticResource fontFamily}"/>
                                    </StackLayout>
                                <StackLayout>
                                    <Label x:Name="FieldName"
                                       FontSize="Small"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                        Text="{Binding CustomerTicket.EventTicket.SportEvent.Field.Name}"/>
                                    </StackLayout>
                            </StackLayout>
                            <StackLayout Grid.Row="2" Grid.ColumnSpan="5"
                                     VerticalOptions="Center"
                                         HorizontalOptions="CenterAndExpand"
                                         Orientation="Horizontal"
                                     Padding="5,10">
                                    <Label x:Name="TimeIcon"
                                       FontSize="Small"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                            Text="&#xe904;"
                                           FontFamily="{StaticResource fontFamily}"/>
                                <Label x:Name="TimeLabel"
                                       FontSize="Small"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                       VerticalTextAlignment="End"
                                            Text="{Binding CustomerTicket.EventTicket.SportEvent.EventTime, StringFormat='{0:MMM dd - h:mm tt}'}"/>
                                
                            </StackLayout>
                        <StackLayout Grid.Row="3" Grid.ColumnSpan="5">
                            <Label Text="{Binding CustomerTicket.EventTicket.Product.Age, StringFormat='1 {0}'}" HorizontalOptions="Center" FontSize="Medium" FontAttributes="Bold"/>
                        </StackLayout>

                        <StackLayout IsVisible="{Binding CustomerTicket.EventTicket.SportEvent.EventLogo, Converter={StaticResource isNullConverter}}" Grid.Row="0" Grid.ColumnSpan="5" Padding="5,0" HorizontalOptions="Center" VerticalOptions="Center">
                                <Frame HeightRequest="160" WidthRequest="160" CornerRadius="80" Padding="0" HorizontalOptions="Center" VerticalOptions="Center" HasShadow="False">
                            <ff:CachedImage Source="{Binding CustomerTicket.EventTicket.SportEvent.EventLogo, Converter={StaticResource imageConverter}}"
                                                            ErrorPlaceholder="ontracklogo.png"
                                            LoadingPlaceholder="ontracklogo.png"
                                                            CacheDuration="50"
                                                            RetryCount="3"
                                                            RetryDelay="600"
                                             Aspect="AspectFit"
                                            HeightRequest="150"
                                                      WidthRequest="150"
                                                            DownsampleToViewSize="True">

                            </ff:CachedImage>
                                </Frame>                            
                        </StackLayout>

                        <StackLayout IsVisible="{Binding CustomerTicket.EventTicket.SportEvent.HomeTeam, Converter={StaticResource isNullConverter}}" Grid.Row="0" Grid.Column="0" Padding="5,0" HorizontalOptions="Center" VerticalOptions="Center">
                                <Frame HeightRequest="40" WidthRequest="40" CornerRadius="20" Padding="0" HorizontalOptions="Center" VerticalOptions="Center" HasShadow="False">
                            <ff:CachedImage Source="{Binding CustomerTicket.EventTicket.SportEvent.HomeTeamLogo, Converter={StaticResource imageConverter}}"
                                                            ErrorPlaceholder="ontracklogo.png"
                                            LoadingPlaceholder="ontracklogo.png"
                                                            CacheDuration="50"
                                                            RetryCount="3"
                                                            RetryDelay="600"
                                             Aspect="AspectFit"
                                            HeightRequest="30"
                                                      WidthRequest="30"
                                                            DownsampleToViewSize="True">

                            </ff:CachedImage>
                                </Frame>
                        </StackLayout>
                        <StackLayout IsVisible="{Binding CustomerTicket.EventTicket.SportEvent.HomeTeam, Converter={StaticResource isNullConverter}}" Grid.Row="0" Grid.Column="4" Padding="5,0" HorizontalOptions="Center" VerticalOptions="Center">
                                 <Frame HeightRequest="40" WidthRequest="40" CornerRadius="20" Padding="0" HorizontalOptions="Center" VerticalOptions="Center" HasShadow="False">
                            <ff:CachedImage Source="{Binding CustomerTicket.EventTicket.SportEvent.AwayTeamLogo, Converter={StaticResource imageConverter}}"
                                                            ErrorPlaceholder="ontracklogo.png"
                                            LoadingPlaceholder="ontracklogo.png"
                                                            CacheDuration="50"
                                                            RetryCount="3"
                                                            RetryDelay="600"
                                             Aspect="AspectFit"
                                            HeightRequest="30"
                                                      WidthRequest="30"
                                                            DownsampleToViewSize="True">  
                                            </ff:CachedImage>
                                </Frame>
                        </StackLayout>
                        <StackLayout IsVisible="{Binding CustomerTicket.EventTicket.SportEvent.HomeTeam, Converter={StaticResource isNullConverter}}" Grid.Row="0" Grid.Column="2" VerticalOptions="Center"
                                         HorizontalOptions="Center"
                                             Orientation="Vertical"
                                     Padding="5,2"
                                     Spacing="5">
                     
                                <Label 
                                       x:Name="Versus"
                                       FontSize="Small"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                                      VerticalOptions="Center"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                            Text="V" />
                        </StackLayout>
                                <StackLayout IsVisible="{Binding CustomerTicket.EventTicket.SportEvent.HomeTeam, Converter={StaticResource isNullConverter}}" Grid.Row="0" Grid.Column="1"
                                     VerticalOptions="Center"
                                         HorizontalOptions="FillAndExpand"
                                     Padding="5,2"
                                     Spacing="0">
                                <Label x:Name="HomeTeamNameLabel"
                                       HorizontalOptions="EndAndExpand"
                                       HorizontalTextAlignment="End"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                            Text="{Binding CustomerTicket.EventTicket.SportEvent.HomeTeam}">
                                    <Label.FontSize>
                                        <OnPlatform x:TypeArguments="x:Double">  
                            <OnPlatform.Android> 
                                <OnIdiom x:TypeArguments="x:Double" Phone="10"  Tablet="17" /> 
                            </OnPlatform.Android> 
                            <OnPlatform.iOS> 
                                <OnIdiom x:TypeArguments="x:Double"  Phone="11"  Tablet="16" /> 
                            </OnPlatform.iOS> 
                        </OnPlatform> 
                                    </Label.FontSize>
                                </Label>
                            </StackLayout>
                                <StackLayout IsVisible="{Binding CustomerTicket.EventTicket.SportEvent.HomeTeam, Converter={StaticResource isNullConverter}}" Grid.Row="0" Grid.Column="3"
                                     VerticalOptions="Center"
                                         HorizontalOptions="FillAndExpand"
                                     Padding="5,2"
                                     Spacing="0">
                                <Label x:Name="AwayTeamNameLabel"
                                       HorizontalOptions="StartAndExpand"
                                       HorizontalTextAlignment="Start"                                       
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                       FontAttributes="Bold"
                                            Text="{Binding CustomerTicket.EventTicket.SportEvent.AwayTeam}">
                                    <Label.FontSize>
                                        <OnPlatform x:TypeArguments="x:Double">  
                            <OnPlatform.Android> 
                                <OnIdiom x:TypeArguments="x:Double" Phone="10"  Tablet="17" /> 
                            </OnPlatform.Android> 
                            <OnPlatform.iOS> 
                                <OnIdiom x:TypeArguments="x:Double"  Phone="11"  Tablet="16" /> 
                            </OnPlatform.iOS> 
                        </OnPlatform> 
                                    </Label.FontSize>
                                </Label>
                            </StackLayout>
                            </Grid>
                            </Frame>
                            </Frame>
                        </StackLayout>
                </Grid>
                                    </StackLayout>
                                    <StackLayout Grid.Column="0" Grid.Row="1" VerticalOptions="FillAndExpand" HorizontalOptions="CenterAndExpand">
                                        <Button Text="Accept" BackgroundColor="DarkGreen" TextColor="White" HeightRequest="50" HorizontalOptions="Center" Padding="50,0" CornerRadius="25" Command="{Binding Path=BindingContext.AcceptTransferCommand, Source={x:Reference TransferRequestList}}" CommandParameter="{Binding .}" />
                                    </StackLayout>
                                    <StackLayout Grid.Column="1" Grid.Row="1" HorizontalOptions="CenterAndExpand">
                                        <Button Text="Reject" BackgroundColor="DarkRed" TextColor="White" HeightRequest="50" HorizontalOptions="Center" Padding="50,0" CornerRadius="25" Command="{Binding Path=BindingContext.RejectTransferCommand, Source={x:Reference TransferRequestList}}" CommandParameter="{Binding .}" />
                                    </StackLayout>
                                        <BoxView HeightRequest="1" HorizontalOptions="FillAndExpand" Grid.Row="2" Grid.ColumnSpan="2" BackgroundColor="{DynamicResource controlHeaderBackgroundColor}"/>
                                        </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </StackLayout>
                </StackLayout>
                <tabView:SfTabView Grid.Row="1" VerticalOptions="FillAndExpand" VisibleHeaderCount="2"
                                 TabHeaderBackgroundColor="{StaticResource tabHeaderColor}"
                               BackgroundColor="Transparent"
                                 DisplayMode="Text"
                               ContentTransitionDuration="200"
                               TabHeaderPosition="Top"
                                TabHeight="50">
                    <tabView:SfTabView.SelectionIndicatorSettings>
                <tabView:SelectionIndicatorSettings Color="{DynamicResource tabIndicatorColor}" 
                                                              Position="Bottom" 
                                                              StrokeThickness="2"/>
                </tabView:SfTabView.SelectionIndicatorSettings>
                    <tabView:SfTabItem Title="Active Tickets" TitleFontColor="Gray" SelectionColor="{DynamicResource TextPrimaryColor}">
                        <tabView:SfTabItem.Content>
                        <Grid BackgroundColor="Transparent" Padding="0,0,0,0" RowSpacing="0"
                              HorizontalOptions="FillAndExpand"
                              VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <pullToRefresh:SfPullToRefresh Grid.Row="1" x:Name="pullToRefreshCurrent" Refreshing="pullToRefreshCurrent_Refreshing"
                               ProgressBackgroundColor="{DynamicResource TextPrimaryColor}" ProgressStrokeColor="{StaticResource primaryDarkBlueTwo}" RefreshContentHeight="50" 
                               RefreshContentWidth="50" TransitionMode="Push" IsRefreshing="False">
  <pullToRefresh:SfPullToRefresh.PullableContent>
                            <listView:SfListView x:Name="ActiveTicketsList" Grid.Row="1"
                                    ItemsSource="{Binding ActiveCustomerTicketCollection}"
                                    ItemTemplate="{StaticResource MatchTicketItemTemplate}"
                                 SelectionMode="Single"
                                    TapCommand="{Binding TicketSelectedCommand}"
                                    HorizontalOptions="FillAndExpand"
                                    VerticalOptions="FillAndExpand"
                                    ItemSpacing="5"
                                    AllowGroupExpandCollapse="True"
                                 Padding="1"
                                    SelectionBackgroundColor="Transparent"
                                    AutoFitMode="DynamicHeight"                                   
                                >
                                    <listView:SfListView.DataSource>
                                  <data:DataSource>
                                    <data:DataSource.SortDescriptors>
                                      <data:SortDescriptor PropertyName="EventTicket.SportEvent.Date" Direction="Descending"/>
                                    </data:DataSource.SortDescriptors>
                                  </data:DataSource>
                                </listView:SfListView.DataSource>
                                    <listView:SfListView.GroupHeaderTemplate>
                                  <DataTemplate>
                                      <ViewCell>
                                        <ViewCell.View>
                                            <StackLayout Padding="8,25,8,0">
<Frame CornerRadius="10" Padding="0" BackgroundColor="Transparent">
<Frame IsClippedToBounds="True" CornerRadius="10" Padding="0"  BackgroundColor="{DynamicResource GroupHeaderBackgroundColor}">
                                            <Grid>
                                                <!--<Grid.GestureRecognizers>
                                                  <TapGestureRecognizer Command="{Binding Path=BindingContext.LeagueSelectedCommand, Source={x:Reference PastFixtureList}}" CommandParameter="{Binding .}"/>
                                              </Grid.GestureRecognizers>-->
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <!--<ColumnDefinition Width="Auto"/>-->
