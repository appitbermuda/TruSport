<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             xmlns:extensions="clr-namespace:TruSport.Extensions"
             xmlns:converter="clr-namespace:TruSport.Converters"
             xmlns:syncfusion="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:data="clr-namespace:Syncfusion.DataSource;assembly=Syncfusion.DataSource.Portable"
             x:Class="TruSport.Views.MatchConfigurations.EditMatchRosterPage"
             Title="{Binding TeamName}">
    <!--<ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding SaveCommand}" Text="Save"/>
    </ContentPage.ToolbarItems>-->
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:GroupHeaderNameConverter x:Key="groupHeaderNameConverter"/>
            <converter:GroupHeaderSizeConverter x:Key="groupHeaderSizeConverter"/>
            <converter:GroupHeaderFontConverter x:Key="groupHeaderFontConverter"/>
            <converter:GroupingStarterConverter x:Key="groupingSelectionConverter"/>
            <converter:StarterTextConverter x:Key="starterTextConverter"/>
            <converter:StarterBackgroundConverter x:Key="starterBackgroundConverter"/>
            <converter:EventArgsConverter x:Key="eventArgsConverter"/>
            <DataTemplate x:Name="PlayerItemTemplate"  x:Key="PlayerItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="Center"
                             Padding="0,0"
                             >
                <Grid x:Name="grid"
                      Padding="0,0"
                      RowSpacing="1"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">    
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="1" />
                    </Grid.RowDefinitions>
                    <!--<StackLayout Grid.Row="0" Grid.Column="0"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label x:Name="JerseyNumberLabel"
                                   FontSize="Small"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"
                                   HorizontalOptions="CenterAndExpand"
                                        Text="{Binding Number}"/>
                        </StackLayout>-->
                        <StackLayout Grid.Row="0" Grid.Column="0"
                                     Spacing="5"
                                     Orientation="Horizontal"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="10,0">
                                <Label x:Name="FirstNameLabel"
                                   FontSize="Small"
                                       FontAttributes="Bold"
                                       Text="{Binding Name}"
                                   TextColor="White"/>
                            <!--<Label x:Name="LastNameLabel"
                                   FontSize="Small"
                                   FontAttributes="Bold"
                                       Text="{Binding LastName}"
                                   TextColor="White"/>-->
                        </StackLayout>
                        
                        <BoxView Grid.Row="1" Grid.ColumnSpan="2"
                                         BackgroundColor="White" Opacity="0.2"
                                         HeightRequest="1"/>
                        </Grid>
                        
                    </StackLayout>
            </DataTemplate>
            <DataTemplate x:Name="MatchRosterItemTemplate"  x:Key="MatchRosterItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="Center"
                             Padding="0,0"
                             >
                <Grid x:Name="grid"
                      Padding="0,0"
                      RowSpacing="1"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">    
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="1" />
                    </Grid.RowDefinitions>
                    <StackLayout Grid.Row="0" Grid.Column="0"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label x:Name="JerseyNumberLabel"
                                   FontSize="Small"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"
                                   HorizontalOptions="CenterAndExpand"
                                        Text="{Binding JerseyNumber}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="1"
                                     Spacing="5"
                                     Orientation="Horizontal"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="0">
                                <Label x:Name="FirstNameLabel"
                                   FontSize="Small"
                                       FontAttributes="Bold"
                                       Text="{Binding Name}"
                                   TextColor="White"/>
                            <!--<Label x:Name="LastNameLabel"
                                   FontSize="Small"
                                   FontAttributes="Bold"
                                       Text="{Binding LastName}"
                                   TextColor="White"/>-->
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="2" HorizontalOptions="EndAndExpand" Spacing="0" Padding="2">
                            <!--<Label Text="Starter" TextColor="White" HorizontalTextAlignment="Center" HorizontalOptions="CenterAndExpand"/>-->
                            <Button Text="{Binding IsStarter, Converter={StaticResource starterTextConverter}}" Padding="0" FontSize="Micro" TextColor="White" HeightRequest="30" WidthRequest="60" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" CornerRadius="5" Command="{Binding Path=BindingContext.SelectedStarterCommand, Source={x:Reference RosterItemListView}}" CommandParameter="{Binding .}" BackgroundColor="{Binding IsStarter, Converter={StaticResource starterBackgroundConverter}}" />
                            <!--<syncfusion:SfSwitch IsOn="{Binding IsStarter}" VisualType="Material" HorizontalOptions="CenterAndExpand" StateChanged="StarterChanged">
                                <syncfusion:SfSwitch.Behaviors>
        <extensions:SfSwitchEventToCommandBehavior EventName="StateChanged"
                                                Command="{Binding SelectedStarterCommand}"
                                                  Converter="{StaticResource eventArgsConverter}">
        </extensions:SfSwitchEventToCommandBehavior>
    </syncfusion:SfSwitch.Behaviors>
                            </syncfusion:SfSwitch>-->
                            <!--<Switch Grid.Row="0" Grid.Column="2" IsToggled="{Binding IsStarter}">
                                <Switch.Behaviors>
        <extensions:SwitchEventToCommandBehavior EventName="Toggled"
            Command="{Binding SelectedStarterCommand}"
                                                  Converter="{StaticResource eventArgsConverter}">
        </extensions:SwitchEventToCommandBehavior>
    </Switch.Behaviors>
                            </Switch>-->
                        </StackLayout>
                        <BoxView Grid.Row="1" Grid.ColumnSpan="3"
                                         BackgroundColor="White" Opacity="0.2"
                                         HeightRequest="1"/>
                        </Grid>
                        
                    </StackLayout>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>
    <NavigationPage.TitleView>
        <StackLayout Orientation="Horizontal"
                     HorizontalOptions="FillAndExpand"
                     Padding="0,0,10,0">
            <StackLayout.Padding>
               <OnPlatform x:TypeArguments="Thickness">
                 <On Platform="Android" Value="0, 0, 10, 0"/>
                 <On Platform="iOS" Value="0, 0, 0, 0"/>
                </OnPlatform>
              </StackLayout.Padding>
            <Grid HorizontalOptions="FillAndExpand">
                <Grid.ColumnDefinitions>
                    <!--<ColumnDefinition Width="50"/>-->
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
            <!--<Button Grid.Column="0" x:Name="CloseButton"
                    HorizontalOptions="Start"
                    Clicked="CloseClicked"
                    FontFamily="{StaticResource fontAwesomeFamily}"
                    Text=""
                    FontSize="25"
                    TextColor="White"
                    VerticalOptions="FillAndExpand"
                    BackgroundColor="Transparent"
                    />-->
           <Label Grid.Column="0" Text="{Binding TeamName}"
                   TextColor="White"
                   FontAttributes="Bold"
                   HorizontalOptions="CenterAndExpand"
                   VerticalOptions="Center"/>
            <Button Grid.Column="1" x:Name="SaveButton"
                    HorizontalOptions="EndAndExpand"
                    Text="Save"
                    FontSize="Medium"
                    TextColor="White"
                    Command="{Binding SaveCommand}"
                    VerticalOptions="FillAndExpand"
                    BackgroundColor="Transparent"
                    />
                </Grid>
        </StackLayout>
    </NavigationPage.TitleView>
    <ContentPage.Content>
        <Grid BackgroundColor="{StaticResource primaryDarkBlueTwo}" HorizontalOptions="FillAndExpand" RowSpacing="0"
              VerticalOptions="FillAndExpand">
            <!--<BoxView Grid.ColumnSpan="3" Grid.Row="1" HeightRequest="3" VerticalOptions="FillAndExpand" BackgroundColor="{StaticResource primaryPink}"/>
            <StackLayout VerticalOptions="CenterAndExpand" HorizontalOptions="Center">
                <Label Text="Team Roster" TextColor="White" FontSize="Large" FontAttributes="Bold"/>
            </StackLayout>-->
            <!--<BoxView WidthRequest="1" VerticalOptions="FillAndExpand" BackgroundColor="White" Opacity=".3" Grid.RowSpan="3"/>
            <StackLayout Grid.Column="2" VerticalOptions="CenterAndExpand" HorizontalOptions="Center" Orientation="Horizontal" Spacing="20">
                <Label Text="Game Line-Up" TextColor="White" FontSize="Large" FontAttributes="Bold"/>
                <Label Text="{Binding PlayerCount}" TextColor="White" FontSize="Large" FontAttributes="Bold"/>
            </StackLayout>-->
            <Grid Grid.Row="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" RowSpacing="0">
                <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="2"/>
                <RowDefinition Height="*"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="50"/>
                <RowDefinition Height="2"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
                <StackLayout VerticalOptions="CenterAndExpand" HorizontalOptions="FillAndExpand" Orientation="Horizontal" Spacing="20">
                <Label Text="Game Line-Up" TextColor="White" FontSize="Large" FontAttributes="Bold"/>
                <Label Text="{Binding PlayerCount}" TextColor="White" FontSize="Large" FontAttributes="Bold"/>
            </StackLayout>
                <BoxView Grid.Row="1" HeightRequest="3" VerticalOptions="FillAndExpand" BackgroundColor="{StaticResource primaryPink}"/>
            <listView:SfListView Grid.Row="2" x:Name="RosterItemListView"
                                                ItemsSource="{Binding RosterCollection}"
                                                    HorizontalOptions="FillAndExpand"
                                                    VerticalOptions="FillAndExpand"
                                                    ItemTemplate="{StaticResource MatchRosterItemTemplate}"
                                                   SelectionMode="SingleDeselect"
                                                   ItemSpacing="0"
                                                    SelectionBackgroundColor="{StaticResource primaryPink}"
                                                 ItemSize="43">
                <listView:SfListView.Behaviors>
                    <extensions:ListViewEventToCommandBehavior EventName="SelectionChanged"
                                                  Command="{Binding SelectedPlayerRemovedCommand}"
                                                  Converter="{StaticResource eventArgsConverter}">
                    </extensions:ListViewEventToCommandBehavior>
                </listView:SfListView.Behaviors>
                <listView:SfListView.DataSource>
                                  <data:DataSource>
                                    <!--<data:DataSource.SortDescriptors>
                                      <data:SortDescriptor PropertyName="Date" Direction="Descending"/>
                                    </data:DataSource.SortDescriptors>-->
                                  </data:DataSource>
                                </listView:SfListView.DataSource>
                                    <listView:SfListView.GroupHeaderTemplate>
                                  <DataTemplate>
                                      <ViewCell>
                                        <ViewCell.View>
                                          <Grid>
                                              <!--<Grid.GestureRecognizers>
                                                  <TapGestureRecognizer Command="{Binding Path=BindingContext.LeagueSelectedCommand, Source={x:Reference FixtureList}}" CommandParameter="{Binding .}"/>
                                              </Grid.GestureRecognizers>-->
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <!--<ColumnDefinition Width="30"/>-->
                                                </Grid.ColumnDefinitions>
                                              <BoxView BackgroundColor="{StaticResource primaryPink}"  Grid.ColumnSpan="2" Opacity=".5"/>
                                              <!--<BoxView HeightRequest="1" BackgroundColor="{StaticResource primaryPink}"  Grid.ColumnSpan="3"/>-->
                                              <StackLayout Grid.Column="0" Padding="10,0" VerticalOptions="Center" HorizontalOptions="Start">
                                                <Label x:Name="leagueLabel" Text="{Binding ., Converter={StaticResource groupingSelectionConverter}, ConverterParameter={x:Reference leagueLabel}}"
                                                     FontSize="{Binding Key, 
                                                            Converter={StaticResource groupHeaderSizeConverter}}"
                                                     FontAttributes="Bold"
                                                    VerticalOptions="Center" HorizontalOptions="Start"
                                                     TextColor="White"/>
                                                  </StackLayout>
                                              <StackLayout Grid.Column="1" Padding="10,0" VerticalOptions="Center" HorizontalOptions="EndAndExpand">
                                                <Label Text="{Binding Count}"
                                                     FontSize="Large"
                                                     FontAttributes="Bold"
                                                    VerticalOptions="Center" HorizontalOptions="EndAndExpand"
                                                     TextColor="White"/>
                                                  </StackLayout>
                                              <!--<BoxView Grid.Row="2" HeightRequest="1" BackgroundColor="{StaticResource primaryPink}" Grid.ColumnSpan="3" />-->
                                          </Grid>
                                        </ViewCell.View>
                                      </ViewCell>
                                  </DataTemplate>
                                </listView:SfListView.GroupHeaderTemplate>
                <!--<listView:SfListView.Behaviors>
                    <extensions:ListViewBehavior/>
                </listView:SfListView.Behaviors>-->
                <listView:SfListView.SelectedItemTemplate>
                    <DataTemplate>
                     <Grid x:Name="grid">
                      <Grid.ColumnDefinitions>
                       <ColumnDefinition Width="40" />
                       <ColumnDefinition Width="*" />    
                       <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Editor x:Name="editorJerseyNumber" Text="{Binding JerseyNumber, Mode=OneWay}">
                          <Editor.Behaviors>
                              <extensions:EditorBehavior/>
                          </Editor.Behaviors>
                      </Editor>
                       <Label Grid.Column="1" Text="{Binding Name}" />
                      <Image Grid.Column="2" x:Name="selectionImage" IsVisible="True" Source="Selected.png"/>
                     </Grid>
                    </DataTemplate>
                   </listView:SfListView.SelectedItemTemplate>
            </listView:SfListView>
                <BoxView Grid.Row="3" HeightRequest="1" VerticalOptions="FillAndExpand" BackgroundColor="{StaticResource primaryPink}"/>
            <StackLayout Grid.Row="4" VerticalOptions="CenterAndExpand" HorizontalOptions="Center">
                <Label Text="Team Roster" TextColor="White" FontSize="Large" FontAttributes="Bold"/>
            </StackLayout>
                <BoxView Grid.Row="5" HeightRequest="2" VerticalOptions="FillAndExpand" BackgroundColor="{StaticResource primaryPink}"/>
            <listView:SfListView Grid.Row="6" x:Name="PlayerItemListView"
                                                ItemsSource="{Binding PlayerCollection}"
                                                    HorizontalOptions="FillAndExpand"
                                                    VerticalOptions="FillAndExpand"
                                                    ItemTemplate="{StaticResource PlayerItemTemplate}"
                                                   SelectionMode="SingleDeselect"
                                                   ItemSpacing="0"
                                                    SelectionBackgroundColor="{StaticResource primaryPink}"
                                                 ItemSize="43">
                <listView:SfListView.Behaviors>
                    <extensions:ListViewEventToCommandBehavior EventName="SelectionChanged"
                                                  Command="{Binding SelectedPlayerChangedCommand}"
                                                  Converter="{StaticResource eventArgsConverter}">
                    </extensions:ListViewEventToCommandBehavior>
                </listView:SfListView.Behaviors>
                <!--<listView:SfListView.Behaviors>
                    <extensions:ListViewBehavior/>
                </listView:SfListView.Behaviors>-->
                <!--<listView:SfListView.SelectedItemTemplate>
                    <DataTemplate>
                     <Grid x:Name="grid">
                      <Grid.ColumnDefinitions>
                       <ColumnDefinition Width="40" />
                       <ColumnDefinition Width="*" />    
                       <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Editor x:Name="editorJerseyNumber" Text="{Binding JerseyNumber, Mode=OneWay}">
                          <Editor.Behaviors>
                              <extensions:EditorBehavior/>
                          </Editor.Behaviors>
                      </Editor>
                       <Label Grid.Column="1" Text="{Binding Name}" />
                      <Image Grid.Column="2" x:Name="selectionImage" IsVisible="True" Source="Selected.png"/>
                     </Grid>
                    </DataTemplate>
                   </listView:SfListView.SelectedItemTemplate>-->
            </listView:SfListView>
                </Grid>
            <ContentView BackgroundColor="{StaticResource primaryDarkBlueTwo}" IsVisible="{Binding IsActivityIndicatorVisible}"/>
            <!--<extensions:CustomLoader x:Name="loader"
                                        Source="ontrackindicator.png"
                                        RotationLength="2000"
                                        VerticalOptions="CenterAndExpand"
                                        WidthRequest="100"
                                        HorizontalOptions="Center"
                                        IsRunning="{Binding IsActivityIndicatorVisible}"
                                        IsVisible="{Binding IsActivityIndicatorVisible}"/>-->
            <extensions:CustomBusyIndicator IsVisible="{Binding IsActivityIndicatorVisible}"/>
        </Grid>
    </ContentPage.Content>
</ContentPage>
