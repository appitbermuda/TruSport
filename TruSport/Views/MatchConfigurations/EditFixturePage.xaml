    <ContentPage.Content>
        <Grid HorizontalOptions="FillAndExpand" RowSpacing="0"
              VerticalOptions="FillAndExpand">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
           <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
        <Grid HorizontalOptions="FillAndExpand" RowSpacing="0" VerticalOptions="FillAndExpand">
            <Grid.RowDefinitions>
                <RowDefinition Height="70" />
                <RowDefinition Height="70" />
                <RowDefinition Height="70" />
                <RowDefinition Height="70" />
                <RowDefinition Height="70" />
                <RowDefinition Height="70" />
                <RowDefinition Height="70" />
                <RowDefinition Height="70" />
                <RowDefinition Height="70" />
                <RowDefinition Height="70" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackLayout Grid.Row="0" Padding="10,0" Grid.Column="0">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="FillAndExpand">
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OpenMatchDatePicker"/>
                    </StackLayout.GestureRecognizers>
                    <inputLayout:SfTextInputLayout Hint="Date" UnfocusedColor="White" FocusedColor="White" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" ContainerType="None" InputTransparent="true">
                        <Entry x:Name="matchDateEntry" TextColor="White" HeightRequest="50" Text="{Binding MatchDate, StringFormat='{0:MMMM dd, yyyy}'}"/>
                        <!--<Entry x:Name="matchDateEntry" TextColor="White" HeightRequest="50" Text="{Binding MatchDate}"/>-->
                    </inputLayout:SfTextInputLayout>
                    
                </StackLayout>
                <!--<Label Text="{Binding FixtureItem.League.Name}" TextColor="White" FontAttributes="Bold" FontSize="Medium" VerticalOptions="CenterAndExpand"/>-->
            </StackLayout>
            <StackLayout Grid.Row="0" Padding="10,0" Grid.Column="1">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="FillAndExpand">
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OpenMatchTimePicker"/>
                    </StackLayout.GestureRecognizers>
                    <inputLayout:SfTextInputLayout Hint="Time" UnfocusedColor="White" FocusedColor="White" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" ContainerType="None" InputTransparent="true">
                        <Entry x:Name="matchTimeEntry" TextColor="White" HeightRequest="50" Text="{Binding MatchTime, StringFormat='{0:hh:mm tt}'}"/>
                        <!--<Entry x:Name="matchTimeEntry" TextColor="White" HeightRequest="50" Text="{Binding MatchTime}"/>-->
                    </inputLayout:SfTextInputLayout>
                    
                </StackLayout>
                <!--<Label Text="{Binding FixtureItem.League.Name}" TextColor="White" FontAttributes="Bold" FontSize="Medium" VerticalOptions="CenterAndExpand"/>-->
            </StackLayout>
            <StackLayout Grid.Row="1" Padding="10,0" Grid.ColumnSpan="2">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="FillAndExpand">
                    <inputLayout:SfTextInputLayout Hint="League" UnfocusedColor="White" FocusedColor="White" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  HeightRequest="50">
                        <combobox:SfComboBox x:Name="leagueComboBox" Text="{Binding LeagueName}" TextColor="White" SelectedDropDownItemColor="Pink" SelectedItem="{Binding League}" DataSource="{Binding LeagueCollection}" DisplayMemberPath="Name">
                            <combobox:SfComboBox.Behaviors>
                    <extensions:ComboBoxEventToCommandBehavior EventName="SelectionChanged"
                                                  Command="{Binding SelectedLeagueChangedCommand}"
                                                  Converter="{StaticResource eventArgsConverter}">
                    </extensions:ComboBoxEventToCommandBehavior>
                  </combobox:SfComboBox.Behaviors>
                        </combobox:SfComboBox>
                    </inputLayout:SfTextInputLayout>
                </StackLayout>
                <!--<Label Text="{Binding FixtureItem.League.Name}" TextColor="White" FontAttributes="Bold" FontSize="Medium" VerticalOptions="CenterAndExpand"/>-->
            </StackLayout>
            <StackLayout Grid.Row="2" Padding="10,0" Grid.ColumnSpan="2">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="FillAndExpand">
                    <!--<StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OpenMatchTypePicker"/>
                    </StackLayout.GestureRecognizers>-->
                    <!--<inputLayout:SfTextInputLayout Hint="Match Type"
                                                   ContainerType="None"
                                                   HorizontalOptions="FillAndExpand">
                        <Label x:Name="matchTypeName"
                               TextColor="White"
                               Text="{Binding MatchTypeName}"
                               IsEnabled="false"/>
                    </inputLayout:SfTextInputLayout>-->
                    <inputLayout:SfTextInputLayout Hint="Match Type"
                                                   UnfocusedColor="White"
                                                    FocusedColor="White"
                                                   HorizontalOptions="FillAndExpand"
                                                   VerticalOptions="FillAndExpand"
                                                     HeightRequest="50">
                        <combobox:SfComboBox x:Name="matchTypeComboBox" Text="{Binding MatchTypeName}"  TextColor="White" SelectedDropDownItemColor="Pink" SelectedItem="{Binding MatchType}" DataSource="{Binding MatchTypeCollection}" DisplayMemberPath="Name">
                            <combobox:SfComboBox.Behaviors>
                    <extensions:ComboBoxEventToCommandBehavior EventName="SelectionChanged"
                                                  Command="{Binding SelectedMatchTypeChangedCommand}"
                                                  Converter="{StaticResource eventArgsConverter}">
                    </extensions:ComboBoxEventToCommandBehavior>
                  </combobox:SfComboBox.Behaviors>
                        </combobox:SfComboBox>
                    </inputLayout:SfTextInputLayout>
                </StackLayout>
            </StackLayout>
            <StackLayout Grid.Row="3" Padding="10,0" Grid.ColumnSpan="2">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="FillAndExpand">
                    <!--<StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OpenFieldPicker"/>
                    </StackLayout.GestureRecognizers>-->
                    <inputLayout:SfTextInputLayout Hint="Field"
                                                   UnfocusedColor="White"
                                                    FocusedColor="White"
                                                   HorizontalOptions="FillAndExpand"
                                                   VerticalOptions="FillAndExpand"
                                                     HeightRequest="50">
                        <!--<Label x:Name="fieldName"
                               TextColor="White"
                               Text="{Binding FieldName, StringFormat='{0:dd MMM}'}"
                               IsEnabled="false"/>-->
                        <combobox:SfComboBox x:Name="fieldComboBox" Text="{Binding FieldName}" TextColor="White" SelectedDropDownItemColor="Pink" SelectedItem="{Binding Field}" DataSource="{Binding FieldCollection}" DisplayMemberPath="Name">
                            <combobox:SfComboBox.Behaviors>
                        <extensions:ComboBoxEventToCommandBehavior EventName="SelectionChanged" Command="{Binding SelectedFieldChangedCommand}" Converter="{StaticResource eventArgsConverter}">
                        </extensions:ComboBoxEventToCommandBehavior>
                    </combobox:SfComboBox.Behaviors>
                        </combobox:SfComboBox>
                    </inputLayout:SfTextInputLayout>
                </StackLayout>
                <!--<Label Text="{Binding FixtureItem.Date, StringFormat='{0:dd MMM}'}" TextColor="White" FontAttributes="Bold" FontSize="Small" VerticalOptions="End" HorizontalTextAlignment="Center"/>-->
                <!--<Label Text="{Binding FixtureItem.Time, Converter={StaticResource timeConverter}}" TextColor="White" FontAttributes="Bold" FontSize="Small" VerticalOptions="Start" HorizontalTextAlignment="Center"/>-->
            </StackLayout>
            <StackLayout Grid.Row="4" Padding="10,0" Grid.Column="0">
            <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="FillAndExpand">
                    <!--<StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OpenHomeTeamPicker"/>
                    </StackLayout.GestureRecognizers>-->
                    <inputLayout:SfTextInputLayout Hint="Home Team"
