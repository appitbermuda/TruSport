<?xml version="1.0" encoding="UTF-8"?>
<ContentPage  xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup" xmlns="http://xamarin.com/schemas/2014/forms" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                  xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
                  xmlns:converters="clr-namespace:TruSport.Converters"
                  x:Class="TruSport.Views.MatchConfigurations.MatchPopupPage"
              BackgroundColor="{StaticResource primaryDarkBlueTwo}" >
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:OwnGoalBackgroundConverter x:Key="ownGoalBackgroundConverter" />
            <converters:OwnGoalTextConverter x:Key="ownGoalTextConverter" />
            <converters:ButtonSelectedConverter x:Key="buttonSelectedConverter"/>
        <DataTemplate x:Name="MatchRosterItemTemplate"  x:Key="MatchRosterItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="Center"
                             Padding="0,0"
                             >
                <Grid x:Name="grid"
                      Padding="0,0"
                      RowSpacing="1"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">    
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                            <RowDefinition Height="35" />
                            <RowDefinition Height="1" />
                    </Grid.RowDefinitions>
                    <StackLayout Grid.Row="0" Grid.Column="0" Padding="5,0,0,0"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label x:Name="JerseyNumberLabel"
                                   FontSize="Medium"
                                   FontAttributes="Bold"
                                   TextColor="Black"
                                        Text="{Binding JerseyNumber}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="1"
                                     Spacing="5"
                                     Orientation="Horizontal"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="0">
                                <Label x:Name="FirstNameLabel"
                                   FontSize="Medium"
                                       FontAttributes="Bold"
                                       Text="{Binding Name}"
                                   TextColor="Black"/>
                        </StackLayout>
                        <BoxView Grid.Row="1" Grid.ColumnSpan="2"
                                         BackgroundColor="{StaticResource primaryDarkBlueTwo}" Opacity="0.2"
                                         HeightRequest="1"/>
                        </Grid>
                        
                    </StackLayout>
            </DataTemplate>
            </ResourceDictionary>
    </ContentPage.Resources>
    <StackLayout VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
        <StackLayout>
            <Button x:Name="BackButton"
                    HorizontalOptions="Start"
                        TextColor="White"
                    Text=""
                    Clicked="BackClicked"
                    FontFamily="{StaticResource fontAwesomeSolidFamily}"
                    VerticalOptions="Center"
                        FontSize="Medium"
                        BackgroundColor="Transparent"
                    />
        </StackLayout>
    <ScrollView Grid.Row="1" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
        <StackLayout Padding="10,10,10,5">
                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackLayout Grid.Row="0" Grid.ColumnSpan="2" Padding="10">
                        <Label Text="{Binding RosterPlayer.Player.Name}" FontAttributes="Bold" FontSize="Medium" TextColor="White" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"/>
                    </StackLayout>
                    <StackLayout Grid.Row="1" Grid.ColumnSpan="2"  Padding="10,0" HorizontalOptions="FillAndExpand">
                                        <!--<Label Text="Minute" TextColor="White" FontSize="Micro" FontAttributes="Bold" VerticalOptions="CenterAndExpand"/>-->
                        <Label x:Name="displayLabel" Text="{Binding Source={x:Reference minuteSlider}, Path=Value, StringFormat='Minute {0:F0}\''}" FontAttributes="Bold" HorizontalOptions="Start" VerticalOptions="CenterAndExpand" TextColor="White" FontSize="Micro"/>
                        <Slider x:Name="minuteSlider" MaximumTrackColor="Red" MinimumTrackColor="Green" Maximum="120" Minimum="1" Value="{Binding Minute}"/>
                    </StackLayout> 
                    <StackLayout Grid.Column="0" Grid.Row="2">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OnGoalSelected}"/>
                        </StackLayout.GestureRecognizers>
                        <!--Goal-->
                        <Frame CornerRadius="5" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="0" BackgroundColor="{Binding GoalButtonSelected, Converter={StaticResource buttonSelectedConverter}}">
                            <Frame CornerRadius="5" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" IsClippedToBounds="True" Padding="0" BackgroundColor="Transparent" HasShadow="False">
                            <Grid  >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <ContentView BackgroundColor="White" Opacity=".1"/>
                                <StackLayout VerticalOptions="CenterAndExpand">
                                    <Label Text="" FontSize="Medium" TextColor="White" FontFamily="{StaticResource fontAwesomeLightFamily}" HorizontalOptions="CenterAndExpand" VerticalOptions="End"/>
                                    <Label Text="Goal" TextColor="White" HorizontalOptions="CenterAndExpand" VerticalOptions="Start"/>
                                </StackLayout>
                            </Grid>
                            </Frame>
                        </Frame>
                    </StackLayout>
                    <StackLayout Grid.Column="0" Grid.Row="3">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OnYellowCardSelected}"/>
                        </StackLayout.GestureRecognizers>
                        <!--Yellow-->
                        <Frame CornerRadius="5" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="0" BackgroundColor="{Binding YellowCardButtonSelected, Converter={StaticResource buttonSelectedConverter}}">
                            <Frame CornerRadius="5" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" IsClippedToBounds="True" Padding="0" BackgroundColor="Transparent" HasShadow="False">
                            <Grid  >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <ContentView BackgroundColor="White" Opacity=".1"/>
                                <StackLayout VerticalOptions="CenterAndExpand" Padding="5">
                                    <Label Text="" FontSize="Medium" TextColor="Yellow" FontFamily="{StaticResource fontAwesomeSolidFamily}" HorizontalOptions="CenterAndExpand" VerticalOptions="End"/>
                                    <Label Text="Yellow" TextColor="White" HorizontalOptions="CenterAndExpand" VerticalOptions="Start"/>
                                </StackLayout>
                            </Grid>
                            </Frame>
                        </Frame>
                    </StackLayout>
                    <StackLayout Grid.Column="1" Grid.Row="3">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OnRedCardSelected}"/>
                        </StackLayout.GestureRecognizers>
                        <!--Red-->
                        <Frame CornerRadius="5" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="0" BackgroundColor="{Binding RedCardButtonSelected, Converter={StaticResource buttonSelectedConverter}}">
                            <Frame CornerRadius="5" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" IsClippedToBounds="True" Padding="0" BackgroundColor="Transparent" HasShadow="False">
                            <Grid  >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <ContentView BackgroundColor="White" Opacity=".1"/>
                                <StackLayout VerticalOptions="CenterAndExpand" Padding="5">
                                    <Label Text="" FontSize="Medium" TextColor="Red" FontFamily="{StaticResource fontAwesomeSolidFamily}" HorizontalOptions="CenterAndExpand" VerticalOptions="End"/>
                                    <Label Text="Red" TextColor="White" HorizontalOptions="CenterAndExpand" VerticalOptions="Start"/>
                                </StackLayout>
                            </Grid>
                            </Frame>
                        </Frame>
                    </StackLayout>
                    <StackLayout Grid.Column="1"  Grid.Row="2">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OnSubSelected}"/>
                        </StackLayout.GestureRecognizers>
                        <!--Sub-->
                        <Frame CornerRadius="5" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="0" BackgroundColor="{Binding SubButtonSelected, Converter={StaticResource buttonSelectedConverter}}">
                            <Frame CornerRadius="5" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" IsClippedToBounds="True" Padding="0" BackgroundColor="Transparent" HasShadow="False">
                            <Grid >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <ContentView BackgroundColor="White" Opacity=".1"/>
                                <StackLayout VerticalOptions="CenterAndExpand" Padding="5">
                                    <Label Text="" FontSize="Medium" TextColor="White" FontFamily="{StaticResource fontAwesomeSolidFamily}" HorizontalOptions="CenterAndExpand" VerticalOptions="End"/>
                                    <Label Text="Sub" TextColor="White" HorizontalOptions="CenterAndExpand" VerticalOptions="Start"/>
                                </StackLayout>
                            </Grid>
                            </Frame>
                        </Frame>
                    </StackLayout>
                    <StackLayout Grid.Row="4" Grid.ColumnSpan="2" IsVisible="{Binding IsSubstituteVisible}" Padding="0,20,0,0">
                        <Frame CornerRadius="5" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="0" BackgroundColor="White">
                            <Frame CornerRadius="5" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" IsClippedToBounds="True" Padding="0" BackgroundColor="Transparent" HasShadow="False">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="50"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <ContentView BackgroundColor="{StaticResource primaryDarkBlueTwo}"/>
                                <ContentView BackgroundColor="White" Opacity=".1"/>
                                <StackLayout VerticalOptions="CenterAndExpand" Padding="5">
                                    <Label Text="Substitute" TextColor="White" HorizontalOptions="CenterAndExpand" VerticalOptions="Start"/>
                                </StackLayout>
                                <StackLayout Grid.Row="1" HeightRequest="250">
                                    <listView:SfListView
                                             x:Name="SubsListView"
                                                ItemsSource="{Binding SubCollection}"
                                                    HorizontalOptions="FillAndExpand"
                                                    VerticalOptions="FillAndExpand"
                                                    ItemTemplate="{StaticResource MatchRosterItemTemplate}"
                                                   SelectionMode="Single"
                                                   ItemSpacing="0"
                                                    SelectionBackgroundColor="{StaticResource primaryPink}"
                                                 ItemSize="45"
                                        TapCommand="{Binding SelectedSubstituteCommand}">

                        </listView:SfListView>
                                </StackLayout>
                            </Grid>
                            </Frame>
                        </Frame>
                    </StackLayout>
                    <StackLayout Grid.Row="4" Grid.ColumnSpan="2" IsVisible="{Binding IsAssistVisible}" Padding="0,20,0,0">
                        <Frame CornerRadius="5" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="0"  BackgroundColor="White">
                            <Frame CornerRadius="5" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" IsClippedToBounds="True" Padding="0" BackgroundColor="Transparent" HasShadow="False">
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="50"/>
                                    <RowDefinition Height="50"/>
                                    <RowDefinition Height="50"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <ContentView BackgroundColor="{StaticResource primaryDarkBlueTwo}"/>
                                <ContentView BackgroundColor="White" Opacity=".1"/>
                                <StackLayout VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" Orientation="Horizontal" Spacing="20">
                                    <Label Text="Goal" FontAttributes="Bold" TextColor="White" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"/>
                                    <Button BackgroundColor="White" Text="No Assist" TextColor="{StaticResource primaryDarkBlueTwo}" FontAttributes="Bold" Padding="10,5" HeightRequest="30" Command="{Binding SelectedAssistCommand}"/>
                                </StackLayout>
                                    <StackLayout Grid.Row="1" Padding="10,0" Orientation="Horizontal" HorizontalOptions="FillAndExpand">
                                        <Label Text="Own Goal?" FontSize="Medium" FontAttributes="Bold" VerticalOptions="CenterAndExpand"/>
                                        <Button Text="{Binding IsOwnGoal, Converter={StaticResource ownGoalTextConverter}}" TextColor="White" WidthRequest="60" HorizontalOptions="EndAndExpand" VerticalOptions="CenterAndExpand" CornerRadius="15" Command="{Binding SelectedOwnGoalCommand}" CommandParameter="{Binding .}" BackgroundColor="{Binding IsOwnGoal, Converter={StaticResource ownGoalBackgroundConverter}}" />
                                        <!--<Switch OnColor="Green" HorizontalOptions="EndAndExpand" VerticalOptions="CenterAndExpand" IsToggled="{Binding IsOwnGoal}"/>-->
                                    </StackLayout> 
                                <ContentView Grid.Row="2" BackgroundColor="{StaticResource primaryDarkBlueTwo}" Opacity=".7"/>
                                <StackLayout Grid.Row="2" Orientation="Horizontal" HorizontalOptions="FillAndExpand">
                                        <Label Text="Assist" TextColor="White" FontAttributes="Bold" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand"/>
                                    </StackLayout>
                                <StackLayout Grid.Row="3" HeightRequest="350">
                                    <listView:SfListView
                                             x:Name="AssistListView"
                                                ItemsSource="{Binding AssistCollection}"
                                                    HorizontalOptions="FillAndExpand"
                                                    VerticalOptions="FillAndExpand"
                                                    ItemTemplate="{StaticResource MatchRosterItemTemplate}"
                                                   SelectionMode="Single"
                                                   ItemSpacing="0"
                                                    SelectionBackgroundColor="{StaticResource primaryPink}"
                                                 ItemSize="40"
                                        TapCommand="{Binding SelectedAssistCommand}">

                        </listView:SfListView>
                                </StackLayout>
                            </Grid>
                            </Frame>
                        </Frame>
                    </StackLayout>
                    <!--<StackLayout Grid.Row="3" Grid.ColumnSpan="2" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand">
                        <Button Text="Update" FontAttributes="Bold" TextColor="{StaticResource primaryDarkBlueTwo}" BackgroundColor="White" Padding="50,0" HorizontalOptions="FillAndExpand"/>
                    </StackLayout>-->
                </Grid>
            </StackLayout>
    </ScrollView>
            </Grid>
    </StackLayout>
</ContentPage>
