<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             xmlns:animations="clr-namespace:Rg.Plugins.Popup.Animations;assembly=Rg.Plugins.Popup" xmlns:combobox="clr-namespace:Syncfusion.XForms.ComboBox;assembly=Syncfusion.SfComboBox.XForms" xmlns:extensions="clr-namespace:TruSport.Extensions" xmlns:converter="clr-namespace:TruSport.Converters" x:Class="TruSport.Views.SignUpPage"
             Title="Sign Up">
    <ContentPage.Resources>
        <converter:EventArgsConverter x:Key="eventArgsConverter"/>
        <converter:EntryValidationConverter x:Key="entryValidationConverter"/>
        <DataTemplate x:Key="TeamItemTemplate">
                <ViewCell>
                    <Grid Padding="5" HeightRequest="50">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="2*"/>
                            <!--<RowDefinition Height="1"/>-->
                        </Grid.RowDefinitions>
                        <Label Grid.Row="1" Text="{Binding Name}" FontSize="Medium" FontAttributes="Bold"/>
                        <Label Grid.Row="0" Text="{Binding League.Name}" FontSize="Micro"/>
                        <!--<BoxView Grid.Row="2" HeightRequest="1" HorizontalOptions="FillAndExpand"/>-->
                    </Grid>
                </ViewCell>
            </DataTemplate>
            <DataTemplate x:Key="specific">
                <ViewCell>
                    <Grid  Padding="5">
                        <Label Text="{Binding Mobile}" BackgroundColor="LightGray" TextColor="Red"/>
                    </Grid>
                </ViewCell>
            </DataTemplate>
    </ContentPage.Resources>
    <ContentPage.Content>
        <StackLayout>
            <Grid>
            
            <ScrollView>

            
   <Grid VerticalOptions="FillAndExpand"
         RowSpacing="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="50" />
                <RowDefinition Height="50" />
                <RowDefinition Height="50" />
                <RowDefinition Height="50" />
                <RowDefinition Height="50" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
        <StackLayout Grid.Row="0"
            Padding="10,0">
            <Image
              HorizontalOptions="Center"
              x:Name="LogoImage"
              Margin="10"
              Aspect="AspectFit"
                HeightRequest="80"
              WidthRequest="250">
              <Image.Source>
                <OnPlatform
                  x:TypeArguments="ImageSource"
                  Android="ontrack_wordmark.png"
                  iOS="ontrack_wordmark_.png"
                  />
              </Image.Source>
            </Image>
        </StackLayout>
       <StackLayout Grid.Row="1" Padding="10,20" VerticalOptions="CenterAndExpand">
           <Label Text="Please note: This sign up is only for users who are requesting Match Commissioner or Team Administrator authentication." FontSize="Micro" FontAttributes="Bold"/>
        </StackLayout>
            <StackLayout Grid.Row="2"
            Padding="10,0">
            <Entry
                HorizontalOptions="FillAndExpand"
                x:Name="FirstNameEntry"
                Text="{Binding FirstName}"
                Placeholder="First Name"
                Keyboard="Text"
                HeightRequest="50"
                PlaceholderColor="{Binding FirstNameError, Converter={StaticResource entryValidationConverter}}"
                TextColor="{Binding FirstNameError, Converter={StaticResource entryValidationConverter}}"
                TextChanged="FirstNameTextChanged"/>
                </StackLayout>
            <StackLayout Grid.Row="3"
            Padding="10,0">
            <Entry
              HorizontalOptions="FillAndExpand"
              x:Name="LastNameEntry"
              Text="{Binding LastName}"
              Placeholder="Last Name"
                Keyboard="Text"
                    HeightRequest="50"
                PlaceholderColor="{Binding LastNameError, Converter={StaticResource entryValidationConverter}}"
                TextColor="{Binding LastNameError, Converter={StaticResource entryValidationConverter}}"
                    TextChanged="LastNameTextChanged"/>
                </StackLayout>
            <StackLayout Grid.Row="4"
            Padding="10,0">
            <Entry
              HorizontalOptions="FillAndExpand"
              x:Name="EmailEntry"
              Text="{Binding Email}"
              Placeholder="Email"
                Keyboard="Email"
                    HeightRequest="50"
                PlaceholderColor="{Binding EmailError, Converter={StaticResource entryValidationConverter}}"
                TextColor="{Binding EmailError, Converter={StaticResource entryValidationConverter}}"
                    TextChanged="EmailTextChanged"/>
            </StackLayout>
            <StackLayout Grid.Row="5"
            Padding="10,0">
            <Entry
              HorizontalOptions="FillAndExpand"
              x:Name="PasswordEntry"
              Text="{Binding Password}"
              Placeholder="Password"
              IsPassword="True"
                    HeightRequest="50"
                PlaceholderColor="{Binding PasswordError, Converter={StaticResource entryValidationConverter}}"
                TextColor="{Binding PasswordError, Converter={StaticResource entryValidationConverter}}"
                    TextChanged="PasswordTextChanged"/>
                </StackLayout>
            <StackLayout Grid.Row="6"
            Padding="10,0">
            <Entry
              HorizontalOptions="FillAndExpand"
              x:Name="ConfirmPasswordEntry"
              Text="{Binding ConfirmPassword}"
              Placeholder="Confirm Password"
              IsPassword="True"
                
                    HeightRequest="50"
                    TextChanged="ConfirmPasswordTextChanged"/>
                </StackLayout>
       <StackLayout Grid.Row="7" Padding="10,0">
           <StackLayout>
               <Label FontSize="Micro" FontAttributes="Bold" Text="Select Role:" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"/>
           </StackLayout>
           <StackLayout>
            <combobox:SfComboBox x:Name="roleComboBox" Text="{Binding UserTypeName}" SelectedDropDownItemColor="{StaticResource primaryDarkBlue}"  DataSource="{Binding UserTypeCollection}" DisplayMemberPath="Name" HeightRequest="50" SelectedItem="{Binding UserType}">
                        <combobox:SfComboBox.Behaviors>
                            <extensions:ComboBoxEventToCommandBehavior EventName="SelectionChanged"
                                                            Command="{Binding SelectedRoleChangedCommand}"
                                                            Converter="{StaticResource eventArgsConverter}">
                            </extensions:ComboBoxEventToCommandBehavior>
                            </combobox:SfComboBox.Behaviors>
                        </combobox:SfComboBox>
               </StackLayout>
                </StackLayout>
       <StackLayout Grid.Row="8" Padding="10,0" IsVisible="{Binding IsTeamComboVisible}">
           <StackLayout>
               <Label FontSize="Micro" FontAttributes="Bold" Text="Select Team:" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"/>
           </StackLayout>
           <StackLayout>
            <combobox:SfComboBox x:Name="teamComboBox" Text="{Binding TeamName}" SelectedDropDownItemColor="{StaticResource primaryDarkBlue}"  SelectedItem="{Binding Team}" DataSource="{Binding TeamCollection}" ItemTemplate="{StaticResource TeamItemTemplate}" DisplayMemberPath="Name" HeightRequest="50">
                            <combobox:SfComboBox.Behaviors>
                    <extensions:ComboBoxEventToCommandBehavior EventName="SelectionChanged"
                                                  Command="{Binding SelectedTeamChangedCommand}"
                                                  Converter="{StaticResource eventArgsConverter}">
                    </extensions:ComboBoxEventToCommandBehavior>
                  </combobox:SfComboBox.Behaviors>
                        </combobox:SfComboBox>
                </StackLayout>
           </StackLayout>
       <StackLayout Grid.Row="9" Padding="10,20" VerticalOptions="CenterAndExpand" Spacing="30">
           <Label Text="You will receive an email confirming account activation once we have validated you for this role. If you are not validated your account will be deleted." FontSize="Micro" FontAttributes="Bold"/>
       </StackLayout>
            <StackLayout Grid.Row="10" Padding="10,15"
                         VerticalOptions="EndAndExpand">
          <Button CornerRadius="25"
            Margin="0,10,0,0"
                  HeightRequest="50"
            BackgroundColor="#2a348d"
                        TextColor="White"
            HorizontalOptions="FillAndExpand"
                        VerticalOptions="End"
            Command="{Binding SignUpCommand}"
            x:Name="SignUpButton"
            Text="Sign Up">
          </Button>
          </StackLayout>
       
    <!--<syncfusion:SfBusyIndicator x:Name="BusyIndicator"
                          AbsoluteLayout.LayoutFlags="PositionProportional"
                          AbsoluteLayout.LayoutBounds="0.5, 0.5, -1, -1"
                          BackgroundColor="#2a348d"
                          TextColor="White"
                          VerticalOptions="FillAndExpand"
                          HorizontalOptions="FillAndExpand"
                          AnimationType="HorizontalPulsingBox"  
                          ViewBoxWidth = "100" 
                          ViewBoxHeight="100" 
                          Title="Registering"
                          IsVisible="false"
                          Duration="0.5" />-->
    </Grid>
                </ScrollView>
                <ContentView IsVisible="{Binding IsActivityIndicatorVisible}" Opacity=".3" BackgroundColor="Black"/>
                <extensions:CustomBusyIndicator IsVisible="{Binding IsActivityIndicatorVisible}"/>
                </Grid>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
