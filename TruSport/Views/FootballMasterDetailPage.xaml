<?xml version="1.0" encoding="utf-8"?>
<FlyoutPage xmlns="http://xamarin.com/schemas/2014/forms" 
                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
                  x:Class="TruSport.Views.FootballMasterDetailPage" 
                  xmlns:pages="clr-namespace:TruSport.Views"
                  xmlns:footballPages="clr-namespace:TruSport.Views.Football"
                  
                  NavigationPage.HasNavigationBar="False">
    <FlyoutPage.Flyout>
        <pages:FootballMasterDetailPageMaster x:Name="MasterPage" />
    </FlyoutPage.Flyout>
    <FlyoutPage.Detail>
        <NavigationPage BarBackgroundColor="{DynamicResource navBackgroundColor}"
                BarTextColor="{DynamicResource navTextColor}">
            <x:Arguments>
                <pages:FootballMasterDetailPageDetail />
            </x:Arguments>
        </NavigationPage>
    </FlyoutPage.Detail>
</FlyoutPage>
