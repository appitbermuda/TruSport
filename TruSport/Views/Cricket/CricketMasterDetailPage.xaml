<?xml version="1.0" encoding="utf-8"?>
<FlyoutPage xmlns="http://xamarin.com/schemas/2014/forms"
                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                  x:Class="TruSport.Views.Cricket.CricketMasterDetailPage"
                  xmlns:pages="clr-namespace:TruSport.Views.Cricket"
                  NavigationPage.HasNavigationBar="False">
    <FlyoutPage.Flyout>
        <pages:CricketMasterDetailPageMaster x:Name="MasterPage" />
    </FlyoutPage.Flyout>
    <FlyoutPage.Detail>
        <NavigationPage BarBackgroundColor="{DynamicResource navBackgroundColor}"
                BarTextColor="{DynamicResource navTextColor}">
            <x:Arguments>
                <pages:CricketMasterDetailPageDetail />
            </x:Arguments>
        </NavigationPage>
    </FlyoutPage.Detail>
</FlyoutPage>
