<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:tabView="clr-namespace:Syncfusion.XForms.TabView;assembly=Syncfusion.SfTabView.XForms" xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms" xmlns:extension="clr-namespace:TruSport.Extensions" xmlns:converter="clr-namespace:TruSport.Converters" xmlns:ff="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    x:Class="TruSport.Views.Cricket.StatPage">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:CricketImageConverter x:Key="imageConverter"/>
            <converter:TeamNameConverter x:Key="teamNameConverter"/>
            <converter:InverseBooleanConverter x:Key="inverseBooleanConverter"/>
            <converter:TableIndexToColorConverter x:Key="tableIndexConverter"/>
            <converter:GameTimeConverter x:Key="gameTimeConverter"/>
            <OnPlatform x:TypeArguments="x:String" x:Key="fontFamily" iOS="icomoon" Android="icomoon.ttf#icomoon" />
            <DataTemplate x:Name="TableItemTemplate"  x:Key="TableItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="Center">
                    <StackLayout 
                                 HorizontalOptions="FillAndExpand"
                                 VerticalOptions="FillAndExpand">
                    
                <Grid x:Name="grid"
                      Padding="0"
                      RowSpacing="1"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">    
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                            <RowDefinition Height="45" />
                            <RowDefinition Height="1" />
                    </Grid.RowDefinitions>
                        <StackLayout Grid.Row="0" Grid.Column="0"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="0">
                                <Label x:Name="PositionLabel"
                                       HorizontalTextAlignment="Center"
                                   FontSize="12"
                                       Text="{Binding Position}"
                                   TextColor="{DynamicResource TextPrimaryColor}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="1"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand" Orientation="Horizontal">
                            <StackLayout Padding="0" VerticalOptions="Center">
                        <Frame HeightRequest="40" WidthRequest="40" CornerRadius="20" Padding="0" HorizontalOptions="Center" VerticalOptions="Center" HasShadow="False" IsClippedToBounds="True">
                        <ff:CachedImage Source="{Binding TeamLogo, Converter={StaticResource imageConverter}}"
                                                        ErrorPlaceholder="bcblogo.png"
                                        LoadingPlaceholder="bcblogo.png"
                                                        CacheDuration="50"
                                                        RetryCount="3"
                                                        RetryDelay="600"
                                        Aspect="AspectFit"
                                        HeightRequest="30"
                                                  WidthRequest="30"
                                                        DownsampleToViewSize="True">  
                                            <!--<ff:CachedImage.Transformations>  
                                                <ffTransformations:CircleTransformation />  
                                            </ff:CachedImage.Transformations>-->  
                                        </ff:CachedImage>
                            </Frame>
                    </StackLayout>
                            <Label x:Name="TeamAlias" Text="{Binding Alias}" IsVisible="false"/>
                            <Label x:Name="TeamNameLabel"
                                   FontSize="12"
                                   FontAttributes="None"
                                   VerticalTextAlignment="Center"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                        Text="{Binding Name, Converter={StaticResource teamNameConverter}, ConverterParameter={x:Reference TeamAlias}}"/>
                            <!--<Label x:Name="TeamNameLabel"
                                   FontSize="12"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   FontAttributes="Bold"
                                   VerticalTextAlignment="Center"
                                        Text="{Binding Name}"/>-->
                        </StackLayout>
                           <StackLayout Grid.Row="0" Grid.Column="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label
                                   FontSize="12"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding Played}"/>
                        </StackLayout>
                    <StackLayout Grid.Row="0" Grid.Column="3"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label
                                   FontSize="12"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding Wins}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="4"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label x:Name="LossLabel"
                                   FontSize="12"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding Loss}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="5"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label x:Name="DrawLabel"
                                   FontSize="12"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding Draws}"/>
                        </StackLayout>
                     <StackLayout Grid.Row="0" Grid.Column="6"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label x:Name="PointsLabel"
                                   FontSize="12"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding Points}"/>
                        </StackLayout>
                         <BoxView Grid.Row="1" Grid.ColumnSpan="7"
                                         BackgroundColor="{DynamicResource controlHeaderBackgroundColor}"
                                         HeightRequest="1"/>
                        </Grid>
                    </StackLayout>
                    </StackLayout>
            </DataTemplate>
            <DataTemplate x:Name="PlayerItemTemplate"  x:Key="PlayerItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="Center"
                             >
                <Grid x:Name="grid"
                      Padding="1"
                      RowSpacing="1"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">    
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1"/>
                    </Grid.RowDefinitions>
                        <StackLayout Grid.Row="0" Grid.Column="0"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="10,0,0,0">
                                <Label x:Name="PlayerNameLabel"
                                   FontSize="Medium"
                                       Text="{Binding PlayerName}"
                                   TextColor="{DynamicResource TextPrimaryColor}"/>
                        </StackLayout>
                        
                    <StackLayout Grid.Row="1" Grid.Column="0"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="10,0,0,10">
                                <Label x:Name="TeamNameLabel"
                                   FontSize="Micro"
                                       Text="{Binding TeamName}"
                                   TextColor="{DynamicResource TextPrimaryColor}"/>
                        </StackLayout>
                    <StackLayout Grid.RowSpan="2" Grid.Column="1"
                                 VerticalOptions="Center"
                                     HorizontalOptions="EndAndExpand"
                                     Padding="0,0,10,0">
                            <Label x:Name="StatLabel"
                                   FontSize="Large"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   FontAttributes="Bold"
                                   VerticalTextAlignment="Center"
                                   HorizontalOptions="EndAndExpand"
                                        Text="{Binding Stat}"/>
                        </StackLayout>
                    <BoxView Grid.Row="2" HeightRequest="1" Grid.ColumnSpan="2" BackgroundColor="{DynamicResource borderColor}" HorizontalOptions="FillAndExpand"/>
                        </Grid>
                    </StackLayout>
            </DataTemplate>
            <DataTemplate x:Name="LeagueHeaderItemTemplate"  x:Key="LeagueHeaderItemTemplate">
              <StackLayout Padding="5,15,5,0">
                <Frame CornerRadius="5" Padding="0" BackgroundColor="Transparent">
                    <Frame IsClippedToBounds="True" CornerRadius="5" Padding="0"  BackgroundColor="{DynamicResource GroupHeaderBackgroundColor}">
                        <Grid VerticalOptions="FillAndExpand" Padding="0,10">
                            <StackLayout  Grid.Column="0" Padding="10,0" VerticalOptions="Center" HorizontalOptions="Start">
                            <Label x:Name="leagueLabel" Text="{Binding .}"
                                    FontSize="Medium"
                                    FontAttributes="Bold"
                                    TextColor="White"/>
                            </StackLayout>
                        </Grid>
                    </Frame>
                </Frame>
                </StackLayout>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <StackLayout Spacing="0"
                     Padding="0"
                     HorizontalOptions="FillAndExpand"
                     VerticalOptions="FillAndExpand">
        <Grid x:Name="PageGrid"
              RowSpacing="0"
              BackgroundColor="{DynamicResource backgroundColor}"
              HorizontalOptions="FillAndExpand"
              VerticalOptions="FillAndExpand">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
                <tabView:SfTabView Grid.Row="0" IsVisible="{Binding NoConnectivity, Converter={StaticResource inverseBooleanConverter}}" VisibleHeaderCount="2"
                               TabHeaderBackgroundColor="{StaticResource tabHeaderColor}"
                               DisplayMode="Text"
                               SelectedIndex="0"
                                EnableSwiping="False"
                                   TabHeight="50">
                <tabView:SfTabView.SelectionIndicatorSettings>
                        <tabView:SelectionIndicatorSettings Color="{DynamicResource tabIndicatorColor}" 
                                                              Position="Bottom" 
                                                          StrokeThickness="2"/>
                </tabView:SfTabView.SelectionIndicatorSettings>
                    <tabView:SfTabItem Title="Standings" TitleFontColor="Gray" SelectionColor="{DynamicResource TextPrimaryColor}">
                        <tabView:SfTabItem.Content>
                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackLayout Grid.Row="0">
                                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" HorizontalOptions="FillAndExpand">
                                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="Center" Padding="10,20" WidthRequest="350">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Frame x:Name="PremierDivision" Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center" CornerRadius="15" HeightRequest="20" Padding="15,5" BackgroundColor="{DynamicResource buttonBackgroundColor}">
                                                <Frame.GestureRecognizers>
                                                    <TapGestureRecognizer x:Name="PremierDivisionTap" Tapped="PremierDivisionTap_Tapped"/>
                                                </Frame.GestureRecognizers>
                                                <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                                                    <Label x:Name="PremierLabel" Text="Premier Division" FontSize="Micro" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="{DynamicResource buttonTextColor}"/>
                                                </StackLayout>
                                            </Frame>
                                            <Frame x:Name="FirstDivision" Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" CornerRadius="15" HeightRequest="20" Padding="15,5" BackgroundColor="{DynamicResource buttonTextColor}" >
                                                <Frame.GestureRecognizers>
                                                    <TapGestureRecognizer x:Name="FirstDivisionTap" Tapped="FirstDivisionTap_Tapped"/>
                                                </Frame.GestureRecognizers>
                                                <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                                                    <Label x:Name="FirstLabel" Text="First Division" FontSize="Micro" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="{DynamicResource buttonBackgroundColor}"/>                                                
                                                </StackLayout>
                                            </Frame>
                                        </Grid>
                                    </ScrollView>
                                </StackLayout>
                                <StackLayout Grid.Row="1">
                                        <Grid HorizontalOptions="FillAndExpand" Padding="0,0,0,0"
                              VerticalOptions="FillAndExpand"
                              RowSpacing="0" BackgroundColor="{DynamicResource backgroundColor}">
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="30" />
                                    <RowDefinition Height="2" />
                                        <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                                <StackLayout Grid.Row="0" HorizontalOptions="FillAndExpand"
                             VerticalOptions="Center"
                             Padding="0,0">
                        <Grid Grid.Row="1" 
                              x:Name="PremierDivTableHeaderGrid"
                              Padding="0,0"
                              RowSpacing="1"
                              ColumnSpacing="1"

                              VerticalOptions="FillAndExpand"
                              HorizontalOptions="FillAndExpand">    
                        <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                        <StackLayout Grid.Row="0" Grid.ColumnSpan="2" Padding="10,0,0,0"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label 
                                   FontSize="13"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   FontAttributes="Bold"
                                   VerticalTextAlignment="Center"
                                        Text="TEAM"/>
                        </StackLayout>
                           <StackLayout Grid.Row="0" Grid.Column="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label 
                                   FontSize="13"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   FontAttributes="Bold"
                                   VerticalTextAlignment="Center"
                                HorizontalTextAlignment="Center"
                                        Text="P"/>
                        </StackLayout>
                            <StackLayout Grid.Row="0" Grid.Column="3"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label 
                                   FontSize="13"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   FontAttributes="Bold"
                                   VerticalTextAlignment="Center"
                                HorizontalTextAlignment="Center"
                                        Text="W"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="4"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label
                                   FontSize="13"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   FontAttributes="Bold"
                                   VerticalTextAlignment="End"
                                HorizontalTextAlignment="Center"
                                        Text="L"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="5"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label 
                                   FontSize="13"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   FontAttributes="Bold"
                                   VerticalTextAlignment="End"
                                HorizontalTextAlignment="Center"
                                        Text="T"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="6"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label 
                                   FontSize="13"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   FontAttributes="Bold"
                                   VerticalTextAlignment="End"
                                HorizontalTextAlignment="Center"
                                        Text="Pts"/>
                        </StackLayout>
                        </Grid>
                    </StackLayout>
                                <BoxView Grid.Row="1"
                                         BackgroundColor="{DynamicResource borderColor}"
                                         HeightRequest="2"/>
                             
                                <listView:SfListView Grid.Row="2" x:Name="PremierLeagueList"
                                ItemsSource="{Binding PremierDivisionCollection}"
                                    ItemTemplate="{StaticResource TableItemTemplate}"
                                   SelectionMode="None"
                                                      HorizontalOptions="FillAndExpand"
                                    VerticalOptions="FillAndExpand"
                                   ItemSpacing="0"
                                    SelectionBackgroundColor="White"
                                 AutoFitMode="DynamicHeight"/>

                                            <listView:SfListView Grid.Row="2" x:Name="FirstDivisionList" IsVisible="false"
                                ItemsSource="{Binding FirstDivisionCollection}"
                                    ItemTemplate="{StaticResource TableItemTemplate}"
                                   SelectionMode="None"
                                                      HorizontalOptions="FillAndExpand"
                                    VerticalOptions="FillAndExpand"
                                   ItemSpacing="0"
                                    SelectionBackgroundColor="White"
                                 AutoFitMode="DynamicHeight"/>

                                    <extension:CustomBusyIndicator Grid.Row="2" IsVisible="{Binding IsActivityIndicatorVisible}"/>
                                    </Grid>
                                </StackLayout>
                            </Grid>
                            </tabView:SfTabItem.Content>
                        </tabView:SfTabItem>
                    <tabView:SfTabItem Title="Leaderboard" TitleFontColor="Gray" SelectionColor="{DynamicResource TextPrimaryColor}">
                        <tabView:SfTabItem.Content>
                            <Grid>
                                 <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackLayout Grid.Row="0">
                                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" HorizontalOptions="FillAndExpand">
                                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="Center" Padding="10,20" WidthRequest="350">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Frame x:Name="PremierDivisionLB" Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center" CornerRadius="15" HeightRequest="20" Padding="15,5" BackgroundColor="{DynamicResource buttonBackgroundColor}">
                                                <Frame.GestureRecognizers>
                                                    <TapGestureRecognizer x:Name="PremierDivisionTapLB" Tapped="PremierDivisionTap_Tapped"/>
                                                </Frame.GestureRecognizers>
                                                <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                                                    <Label x:Name="PremierLabelLB" Text="Premier Division" FontSize="Micro" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="{DynamicResource buttonTextColor}"/>
                                                </StackLayout>
                                            </Frame>
                                            <Frame x:Name="FirstDivisionLB" Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" CornerRadius="15" HeightRequest="20" Padding="15,5" BackgroundColor="{DynamicResource buttonTextColor}" >
                                                <Frame.GestureRecognizers>
                                                    <TapGestureRecognizer x:Name="FirstDivisionTapLB" Tapped="FirstDivisionTap_Tapped"/>
                                                </Frame.GestureRecognizers>
                                                <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                                                    <Label x:Name="FirstLabelLB" Text="First Division" FontSize="Micro" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="{DynamicResource buttonBackgroundColor}"/>                                                
                                                </StackLayout>
                                            </Frame>
                                        </Grid>
                                    </ScrollView>
                                </StackLayout>
                                <StackLayout Grid.Row="1">
                                        <tabView:SfTabView Grid.Row="0" IsVisible="{Binding NoConnectivity, Converter={StaticResource inverseBooleanConverter}}" VisibleHeaderCount="2"
                                 TabHeaderBackgroundColor="{StaticResource tabHeaderColor}"
                                 DisplayMode="Text"
                               SelectedIndex="0"
                               EnableSwiping="False"
                                TabHeight="50">
                <tabView:SfTabView.SelectionIndicatorSettings>
                        <tabView:SelectionIndicatorSettings Color="{DynamicResource tabIndicatorColor}" 
                                                              Position="Bottom"
                                                            StrokeThickness="2"/>
                </tabView:SfTabView.SelectionIndicatorSettings>
                    
                    <tabView:SfTabItem Title="Most Runs" TitleFontColor="Gray"  SelectionColor="{DynamicResource TextPrimaryColor}">
                        <tabView:SfTabItem.Content>
                            <Grid HorizontalOptions="FillAndExpand"
                              VerticalOptions="FillAndExpand"
                              BackgroundColor="{DynamicResource backgroundColor}"
                              RowSpacing="0">
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                                <listView:SfListView Grid.Row="0" x:Name="PremierPlayerMostRunsList"
                                ItemsSource="{Binding PremierPlayerMostRunsCollection}"
                                    ItemTemplate="{StaticResource PlayerItemTemplate}"
                                    GroupHeaderTemplate="{StaticResource LeagueHeaderItemTemplate}"
                                   SelectionMode="None"
                                                      HorizontalOptions="FillAndExpand"
                                    VerticalOptions="FillAndExpand"
                                   ItemSpacing="0"
                                    SelectionBackgroundColor="Transparent"
                                                     AllowGroupExpandCollapse="True"
                                 GroupHeaderSize="60"
                                                 AutoFitMode="DynamicHeight">
                                </listView:SfListView>

                                <listView:SfListView Grid.Row="0" x:Name="FirstPlayerMostRunsList" IsVisible="false"
                                ItemsSource="{Binding FirstPlayerMostRunsCollection}"
                                    ItemTemplate="{StaticResource PlayerItemTemplate}"
                                    GroupHeaderTemplate="{StaticResource LeagueHeaderItemTemplate}"
                                   SelectionMode="None"
                                                      HorizontalOptions="FillAndExpand"
                                    VerticalOptions="FillAndExpand"
                                   ItemSpacing="0"
                                    SelectionBackgroundColor="Transparent"
                                                     AllowGroupExpandCollapse="True"
                                 GroupHeaderSize="60"
                                                 AutoFitMode="DynamicHeight">
                                </listView:SfListView>

                        </Grid>
                        </tabView:SfTabItem.Content>
                    </tabView:SfTabItem>
                                            <tabView:SfTabItem Title="Most Wickets" TitleFontColor="Gray" SelectionColor="{DynamicResource TextPrimaryColor}">
                        <tabView:SfTabItem.Content>
                            <Grid HorizontalOptions="FillAndExpand" Padding="0,0,0,0"
                              VerticalOptions="FillAndExpand"
                              BackgroundColor="{DynamicResource backgroundColor}"
                              RowSpacing="0">
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                                <listView:SfListView Grid.Row="0" x:Name="PremierPlayerMostWicketsList"
                                ItemsSource="{Binding PremierPlayerMostWicketsCollection}"
                                    ItemTemplate="{StaticResource PlayerItemTemplate}"
                                    GroupHeaderTemplate="{StaticResource LeagueHeaderItemTemplate}"
                                   SelectionMode="None"
                                   HorizontalOptions="FillAndExpand"
                                    VerticalOptions="FillAndExpand"
                                   ItemSpacing="0"
                                    SelectionBackgroundColor="Transparent"
                                    AllowGroupExpandCollapse="True"
                                    GroupHeaderSize="60"
                                 AutoFitMode="DynamicHeight">
                                </listView:SfListView>

                                <listView:SfListView Grid.Row="0" x:Name="FirstPlayerMostWicketsList" IsVisible="false"
                                ItemsSource="{Binding FirstPlayerMostWicketsCollection}"
                                    ItemTemplate="{StaticResource PlayerItemTemplate}"
                                    GroupHeaderTemplate="{StaticResource LeagueHeaderItemTemplate}"
                                   SelectionMode="None"
                                   HorizontalOptions="FillAndExpand"
                                    VerticalOptions="FillAndExpand"
                                   ItemSpacing="0"
                                    SelectionBackgroundColor="Transparent"
                                    AllowGroupExpandCollapse="True"
                                    GroupHeaderSize="60"
                                 AutoFitMode="DynamicHeight">
                                </listView:SfListView>
                                </Grid>
                        </tabView:SfTabItem.Content>
                    </tabView:SfTabItem>
            </tabView:SfTabView>
                                </StackLayout>
                            </Grid>
                            </Grid>
                            </tabView:SfTabItem.Content>
                        </tabView:SfTabItem>
                    </tabView:SfTabView>
            </Grid>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
