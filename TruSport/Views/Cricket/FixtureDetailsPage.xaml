                            <Label x:Name="AwayTeamNameLabel"
                                   FontSize="14"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   Text="{Binding AwayTeam.Name, Converter={StaticResource teamNameConverter}, ConverterParameter={x:Reference AwayTeamAlias}}"/>
                        </StackLayout>
                    
                            <StackLayout Grid.Row="0" Grid.Column="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                 Padding="5,2"
                                 Spacing="0">
                            <Label x:Name="HomeTeamScoreLabel"
                                   FontSize="15"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                        Text="{Binding Match.HomeTeamScore}"/>
                        </StackLayout>
                            <StackLayout Grid.Row="1" Grid.Column="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                 Padding="5,2"
                                 Spacing="0">
                            <Label x:Name="AwayTeamScoreLabel"
