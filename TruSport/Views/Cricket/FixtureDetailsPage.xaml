    <ContentPage.Content>
        <Grid HorizontalOptions="FillAndExpand" RowSpacing="0"
              VerticalOptions="FillAndExpand">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>

            <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" Padding="0,0,0,0" BackgroundColor="{DynamicResource navBackgroundColor}">
            <StackLayout.Padding>
               <OnPlatform x:TypeArguments="Thickness">
                 <On Platform="Android" Value="0, 0, 0, 0"/>
                 <On Platform="iOS" Value="0, 50, 0, 0"/>
                </OnPlatform>
              </StackLayout.Padding>
            <Grid HorizontalOptions="FillAndExpand" HeightRequest="50">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                    <StackLayout Grid.Column="1" Padding="0,0,0,0" HeightRequest="30" WidthRequest="100" VerticalOptions="CenterAndExpand">
                        <StackLayout.HorizontalOptions>
                            <OnPlatform x:TypeArguments="LayoutOptions">
                                <On Platform="Android" Value="StartAndExpand"/>
                                <On Platform="iOS" Value="CenterAndExpand"/>
                            </OnPlatform>
                        </StackLayout.HorizontalOptions>
                        <Image Source="ontrack_wordmark_reversed" VerticalOptions="CenterAndExpand" Aspect="AspectFit"/>
                    </StackLayout>
                <StackLayout Grid.Column="2"  Padding="0,0,0,0" HorizontalOptions="End">
                    <Button x:Name="FavouriteButton" HorizontalOptions="End" TextColor="White"
                        Text="{Binding IsFavourite, Converter={StaticResource favouriteConverter}}"
                        Command="{Binding FavouriteCommand}"
                        FontFamily="{Binding IsFavourite, Converter={StaticResource favouriteFontConverter}}"
                        VerticalOptions="Center" FontSize="Medium" BackgroundColor="Transparent" IsVisible="{Binding IsFavouriteVisible}" />
                </StackLayout>
                <Button x:Name="BackButton" Text="" TextColor="{DynamicResource navTextColor}" FontSize="25" BackgroundColor="Transparent" FontFamily="{StaticResource fontAwesomeSolidFamily}" Clicked="BackButton_Clicked"/>
            </Grid>
        </StackLayout>

        <Grid Grid.Row="1" HorizontalOptions="FillAndExpand" RowSpacing="0" VerticalOptions="FillAndExpand">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackLayout Grid.Row="0" Grid.Column="0" Padding="0,10,0,0" BackgroundColor="{DynamicResource tabHeaderColor}">
                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="10,20" ColumnSpacing="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackLayout Grid.Row="0" Grid.Column="0">
                        <Frame HeightRequest="60" WidthRequest="60" CornerRadius="30" Padding="0" HorizontalOptions="Center" VerticalOptions="Center"  IsClippedToBounds="True">
                        <ff:CachedImage Source="{Binding FixtureItem.HomeTeam.TeamLogo, Converter={StaticResource imageConverter}}"
                                                    ErrorPlaceholder="bcblogo.png"
                                                    LoadingPlaceholder="bcblogo.png"
                                                    CacheDuration="50"
                                                    RetryCount="3"
                                                    RetryDelay="600"
                                                    Aspect="AspectFit"
                                                    HeightRequest="50"
                                                    WidthRequest="50"
                                                    DownsampleToViewSize="True">
                                        </ff:CachedImage>
                        </Frame>
                    </StackLayout>

                    <StackLayout Grid.Row="1" Grid.Column="0" Padding="0,0,0,0">
                        <Label x:Name="HomeTeamAlias" Text="{Binding FixtureItem.HomeTeam.Alias}" IsVisible="false"/>
                        <Label Text="{Binding FixtureItem.HomeTeam.Name, Converter={StaticResource teamNameConverter}, ConverterParameter={x:Reference HomeTeamAlias}}" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" LineBreakMode="WordWrap" TextColor="{DynamicResource TextPrimaryColor}" FontSize="Small"  />
                    </StackLayout>

                    <StackLayout Grid.Row="0" Grid.Column="2">
                        <Frame HeightRequest="60" WidthRequest="60" CornerRadius="30" Padding="0" HorizontalOptions="Center" VerticalOptions="Center" IsClippedToBounds="True">
                     <ff:CachedImage Source="{Binding FixtureItem.AwayTeam.TeamLogo, Converter={StaticResource imageConverter}}"
                                                        ErrorPlaceholder="bcblogo.png"
                                        LoadingPlaceholder="bcblogo.png"
                                                        CacheDuration="50"
                                                        RetryCount="3"
                                                        RetryDelay="600"
                                        Aspect="AspectFit"
                                        HeightRequest="50"
                                                  WidthRequest="50"
                                                        DownsampleToViewSize="True">
                                        </ff:CachedImage>
                            </Frame>
                    </StackLayout>

                    <StackLayout Grid.Row="1" Grid.Column="2" Padding="0,0,5,0">
                        <Label x:Name="AwayTeamAlias" Text="{Binding FixtureItem.AwayTeam.Alias}" IsVisible="false"/>
                        <Label Text="{Binding FixtureItem.AwayTeam.Name, Converter={StaticResource teamNameConverter}, ConverterParameter={x:Reference AwayTeamAlias}}" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" LineBreakMode="WordWrap" TextColor="{DynamicResource TextPrimaryColor}" FontSize="Small" />
                    </StackLayout>

                   <StackLayout Grid.Row="2" Grid.Column="0" Orientation="Vertical" VerticalOptions="CenterAndExpand" Margin="0,20" IsVisible="{Binding FixtureItem.HomeTeamScore, Converter={StaticResource isNullConverter}}">
                        <StackLayout>
                            <Label Text="{Binding FixtureItem.HomeTeamScore}" VerticalOptions="End" HorizontalOptions="Center" TextColor="{DynamicResource TextPrimaryColor}" FontSize="Micro" FontAttributes="Bold"/>
                        </StackLayout>
                    </StackLayout>

                    <StackLayout Grid.Row="2" Grid.Column="2" Orientation="Vertical" VerticalOptions="CenterAndExpand" Margin="0,20" IsVisible="{Binding FixtureItem.AwayTeamScore, Converter={StaticResource isNullConverter}}">
                        <StackLayout>
                            <Label Text="{Binding FixtureItem.AwayTeamScore}" VerticalOptions="End" HorizontalOptions="Center" TextColor="{DynamicResource TextPrimaryColor}" FontSize="Micro" FontAttributes="Bold"/>
                        </StackLayout>
                    </StackLayout>

                    <StackLayout Grid.Row="3" Grid.ColumnSpan="3" Padding="10,10,10,0" IsVisible="{Binding FixtureItem.MatchResult, Converter={StaticResource isNullConverter}}">
                        <Label Text="{Binding FixtureItem.MatchResult}" HorizontalOptions="CenterAndExpand" FontSize="Micro" TextColor="Gray"/>
                    </StackLayout>
                </Grid>
            </StackLayout>
           <StackLayout Grid.Row="1" VerticalOptions="FillAndExpand" Padding="0,0,0,0">
                <tabview:SfTabView TabHeaderBackgroundColor="{StaticResource tabHeaderColor}" VisibleHeaderCount="3" DisplayMode="Text" TabHeight="50" EnableSwiping="False" TabItemTapped="SfTabView_TabItemTapped">
                    <tabview:SfTabView.SelectionIndicatorSettings>
                        <tabview:SelectionIndicatorSettings Color="{DynamicResource tabIndicatorColor}"
                                                              Position="Bottom" 
                                                          StrokeThickness="2"/>
                        </tabview:SfTabView.SelectionIndicatorSettings>
                    <tabview:SfTabItem Title="Match Summary" SelectionColor="{DynamicResource TextPrimaryColor}"
                                       TitleFontColor="Gray">
                        <tabview:SfTabItem.Content>
                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="Start" BackgroundColor="{DynamicResource backgroundColor}" >
                               <Grid.RowDefinitions>
                                   <RowDefinition Height="Auto" />
                                   <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackLayout IsVisible="{Binding SummaryAvailable}">
                                    <listView:SfListView 
                                             x:Name="MatchSummaryListView"
                                                ItemsSource="{Binding MatchRosterSummaryCollection}"
                                                    HorizontalOptions="FillAndExpand"
                                                    VerticalOptions="FillAndExpand"
                                                    ItemTemplate="{StaticResource MatchSummaryItemTemplate}"
                                                 SelectionMode="None"
                                                   ItemSpacing="0"
                                                 AutoFitMode="DynamicHeight">

                        </listView:SfListView>
                                    <BoxView HeightRequest="1" HorizontalOptions="FillAndExpand" BackgroundColor="{DynamicResource controlHeaderBackgroundColor}" Opacity=".1"/>
                                </StackLayout>
                                
                                <StackLayout Grid.Row="1" HorizontalOptions="FillAndExpand" Padding="10,15">
                                    <StackLayout>
                            <Frame Padding="10,0" HeightRequest="30" CornerRadius="15" HasShadow="False" BackgroundColor="{DynamicResource controlHeaderBackgroundColor}" VerticalOptions="CenterAndExpand" HorizontalOptions="Start">
                                <Label Text="Match Info" FontAttributes="Bold" TextColor="{DynamicResource TextPrimaryColor}" FontSize="Small" VerticalOptions="CenterAndExpand"/>
                            </Frame>
                        </StackLayout>
                                 <Grid RowSpacing="15" VerticalOptions="Start">
                    <Grid.RowDefinitions>
                                   <RowDefinition Height="Auto" />
                                   <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackLayout Padding="10,0" Grid.Column="0">
                <Label Text="Match" TextColor="Gray" FontSize="Micro"/>
            </StackLayout>
             <StackLayout Padding="10,0" Grid.Column="1" Orientation="Horizontal">
                <Label Text="{Binding FixtureItem.League.Name}" TextColor="{DynamicResource TextPrimaryColor}" FontSize="Small"/>
                 <Label Text="{Binding FixtureItem.MatchType.Name, StringFormat='- {0}'}" TextColor="{DynamicResource TextPrimaryColor}" FontSize="Small"/>
            </StackLayout>
                    <StackLayout Padding="10,0" Grid.Row="1" Grid.Column="0">
                <Label Text="Date" TextColor="Gray"  FontSize="Micro" />
            </StackLayout>
            <StackLayout Padding="10,0" Grid.Row="1" Grid.Column="1" HorizontalOptions="FillAndExpand" Spacing="0">
                <Label Text="{Binding FixtureItem.Date, StringFormat='{0:dd MMM yyyy}'}" TextColor="{DynamicResource TextPrimaryColor}" FontSize="Small" />
               </StackLayout>
            <StackLayout Padding="10,0" Grid.Row="2" Grid.Column="0">
                <Label Text="Time" TextColor="Gray"  FontSize="Micro" />
            </StackLayout>
            <StackLayout Padding="10,0" Grid.Row="2" Grid.Column="1" HorizontalOptions="FillAndExpand" Spacing="0">
                <Label Text="{Binding FixtureItem.FixtureTime, StringFormat='{0:h:mm tt}'}" TextColor="{DynamicResource TextPrimaryColor}" FontSize="Small" />
            </StackLayout>
            <StackLayout Padding="10,0" Grid.Row="3" Grid.Column="0">
                <Label Text="Venue" TextColor="Gray"  FontSize="Micro"/>
            </StackLayout>
            <StackLayout Padding="10,0" Grid.Row="3" Grid.Column="1" HorizontalOptions="FillAndExpand" Spacing="0">
                <Label Text="{Binding FixtureItem.Field.Name}" TextColor="{DynamicResource TextPrimaryColor}" FontSize="Small"/>
                </StackLayout>
                    </Grid>
            </StackLayout>
                              </Grid>
                        </tabview:SfTabItem.Content>
                    </tabview:SfTabItem>
                    <tabview:SfTabItem Title="Lineup" SelectionColor="{DynamicResource TextPrimaryColor}"
                                       TitleFontColor="Gray" IsVisible="{Binding RosterCollection, Converter={StaticResource listCountConverter}}">
                        <tabview:SfTabItem.Content>
                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="{DynamicResource backgroundColor}">
                               <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                    <StackLayout Grid.Row="0" Padding="5" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Grid HorizontalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                        <StackLayout HorizontalOptions="FillAndExpand" Padding="10,0" IsVisible="{Binding SquadAvailable}">
                        <listView:SfListView x:Name="StartingsRosterItemListView" HeightRequest="450"
                                                ItemsSource="{Binding RosterCollection}"
                                                    HorizontalOptions="FillAndExpand"
                                                    VerticalOptions="FillAndExpand"
                                                    ItemTemplate="{StaticResource MatchRosterItemTemplate}"
                                                   ItemSpacing="0"
                                             SelectionMode="None"
                                                    SelectionBackgroundColor="{StaticResource primaryPink}"
                                                 ItemSize="40"/>
                            </StackLayout>
                        <StackLayout Grid.Row="1" Padding="10,0" IsVisible="{Binding SquadAvailable}">
                            <Grid HorizontalOptions="FillAndExpand">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                             <StackLayout Grid.Row="0">
                            <Frame Padding="10,0" HeightRequest="30" CornerRadius="15" HasShadow="False" BackgroundColor="{DynamicResource controlHeaderBackgroundColor}" VerticalOptions="CenterAndExpand" HorizontalOptions="Start">
                                <Label Text="Subs" FontAttributes="Bold" TextColor="{DynamicResource TextPrimaryColor}" FontSize="Small" VerticalOptions="CenterAndExpand"/>
                            </Frame>
                        </StackLayout>
                                <StackLayout Grid.Row="1">
                                    <listView:SfListView x:Name="SubsRosterItemListView" HeightRequest="{Binding SubHeight}"
                                                ItemsSource="{Binding SubRosterCollection}"
                                                    HorizontalOptions="FillAndExpand"
                                                    VerticalOptions="FillAndExpand"
                                                    ItemTemplate="{StaticResource MatchRosterItemTemplate}"
                                                   ItemSpacing="0"
                                                    SelectionBackgroundColor="{StaticResource primaryPink}"
                                                 ItemSize="40"/>
                                </StackLayout>
                            </Grid>
                        </StackLayout>
                        <StackLayout Grid.Row="2" Padding="10,0">
                            <Grid HorizontalOptions="FillAndExpand" RowSpacing="15">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                             <StackLayout Grid.Row="0">
                            <Frame Padding="10,0" HeightRequest="30" CornerRadius="15" HasShadow="False" BackgroundColor="{DynamicResource controlHeaderBackgroundColor}" VerticalOptions="CenterAndExpand" HorizontalOptions="Start">
                                <Label Text="Coach" FontAttributes="Bold" TextColor="{DynamicResource TextPrimaryColor}" FontSize="Small" VerticalOptions="CenterAndExpand" />
                            </Frame>
                        </StackLayout>
                                <StackLayout Grid.Row="1" Grid.Column="0" Padding="10,0">
                                    <Label Text="{Binding FixtureItem.HomeTeam.Coaches[0].Name}" FontSize="Small" TextColor="{DynamicResource TextPrimaryColor}"/>
                                </StackLayout>
                                <StackLayout Grid.Row="1" Grid.Column="1" Padding="10,0">
                                    <Label Text="{Binding FixtureItem.AwayTeam.Coaches[0].Name}" FontSize="Small" TextColor="{DynamicResource TextPrimaryColor}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                </StackLayout>
                            </Grid>
                        </StackLayout>
                            </Grid>
                                        </StackLayout>
                                </Grid>
                        </tabview:SfTabItem.Content>
                    </tabview:SfTabItem>
                    <tabview:SfTabItem Title="Head to Head" SelectionColor="{DynamicResource TextPrimaryColor}"
                                       TitleFontColor="Gray">
                        <tabview:SfTabItem.Content>
                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="{DynamicResource backgroundColor}">
                               <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <listView:SfListView Grid.Row="0" x:Name="HeadToHeadFixtureListView"
                                                ItemsSource="{Binding HeadToHeadFixtureCollection}"
                                                    HorizontalOptions="FillAndExpand"
                                                    VerticalOptions="FillAndExpand"
                                                   SelectionMode="None"
                                                   ItemSpacing="0"
                                                 AutoFitMode="DynamicHeight">
                                    <listView:SfListView.ItemTemplate>
                                    <DataTemplate>
                                        <templates:HeadToHeadList />
                                    </DataTemplate>
                                </listView:SfListView.ItemTemplate>
                                </listView:SfListView>
                                <extensions:CustomBusyIndicator IsVisible="{Binding IsHeadToHeadActivityIndicatorVisible}"/>
                            </Grid>
                        </tabview:SfTabItem.Content>
                    </tabview:SfTabItem>
                    <tabview:SfTabItem Title="Table" SelectionColor="{DynamicResource TextPrimaryColor}" TitleFontColor="Gray">
                        <tabview:SfTabItem.Content>
                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="{DynamicResource backgroundColor}">
                               <Grid.RowDefinitions>
                                   <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <listView:SfListView Grid.Row="0" x:Name="TableListView"
                                                ItemsSource="{Binding TableCollection}"
                                                     ItemTemplate="{StaticResource TableItemTemplate}"
                                                    HorizontalOptions="FillAndExpand"
                                                    VerticalOptions="FillAndExpand"
                                                   SelectionMode="None"
                                                   ItemSpacing="0"
                                                 AutoFitMode="DynamicHeight">
                                    <listView:SfListView.HeaderTemplate>
                                        <DataTemplate>
                                            <ViewCell>
                                                <ViewCell.View>
                                                    <Grid Grid.Row="0" 
                              x:Name="FirstDivTableHeaderGrid"
                              Padding="0,10,0,0"
                              RowSpacing="1"
                              ColumnSpacing="1"
                              
                              VerticalOptions="FillAndExpand"
                              HorizontalOptions="FillAndExpand">    
                        <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                    <RowDefinition Height="35" />
                                <RowDefinition Height="1" />
                            </Grid.RowDefinitions>
                        <BoxView Grid.Row="1" Grid.ColumnSpan="7" BackgroundColor="{DynamicResource controlHeaderBackgroundColor}" />
                        <StackLayout Grid.Row="0" Grid.ColumnSpan="2" Padding="10,0,0,0"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label 
                                   FontSize="13"
