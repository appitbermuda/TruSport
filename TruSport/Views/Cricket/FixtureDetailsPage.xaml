                                     HorizontalOptions="FillAndExpand"
                                     >
                            <Label x:Name="PointsLabel"
                                   FontSize="12"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   HorizontalTextAlignment="Center"
                                        Text="{Binding Points}"/>
                        </StackLayout>
                            <BoxView Grid.Row="1" Grid.ColumnSpan="8"
