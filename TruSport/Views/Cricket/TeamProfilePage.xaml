                                                    VerticalOptions="FillAndExpand"
                                                    ItemTemplate="{StaticResource TableItemTemplate}"
                                                   SelectionMode="None"
                                                   ItemSpacing="0"
                                                    SelectionBackgroundColor="{DynamicResource listSelectedBackgroundColor}"
                                                 AutoFitMode="DynamicHeight" />
                            
                        </Grid>
                            </tabView:SfTabItem.Content>
                        </tabView:SfTabItem>
                        <tabView:SfTabItem Title="Fixtures" SelectionColor="{DynamicResource TextPrimaryColor}" TitleFontColor="Gray">
                        <tabView:SfTabItem.Content>
                        <Grid HorizontalOptions="FillAndExpand"
                              VerticalOptions="FillAndExpand" RowSpacing="0" BackgroundColor="{DynamicResource backgroundColor}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <listView:SfListView Grid.Row="0" x:Name="FixtureListView"
                                                ItemsSource="{Binding FixtureCollection}"
                                                    HorizontalOptions="FillAndExpand"
                                                    VerticalOptions="FillAndExpand"
                                                   SelectionMode="None"
                                                   ItemSpacing="0"
                                                    SelectionBackgroundColor="{DynamicResource listSelectedBackgroundColor}"
                                                 AutoFitMode="DynamicHeight">
                                <listView:SfListView.ItemTemplate>
                                    <DataTemplate>
                                        <templates:CricketFixtureList/>
                                    </DataTemplate>
                                </listView:SfListView.ItemTemplate>
                                    <listView:SfListView.DataSource>
                                  <data:DataSource>
                                      <data:DataSource.SortDescriptors>
                                      <data:SortDescriptor PropertyName="Date" Direction="Ascending"/>
                                    </data:DataSource.SortDescriptors>
                                  </data:DataSource>
                                </listView:SfListView.DataSource>
                                    <listView:SfListView.GroupHeaderTemplate>
                                  <DataTemplate>
                                      <ViewCell>
                                        <ViewCell.View>
                                            <StackLayout Padding="8,25,8,0">
<Frame CornerRadius="10" Padding="0" BackgroundColor="Transparent">
<Frame IsClippedToBounds="True" CornerRadius="10" Padding="0"  BackgroundColor="{DynamicResource GroupHeaderBackgroundColor}">
                                            <Grid>
                                                <Grid.GestureRecognizers>
                                                  <TapGestureRecognizer Command="{Binding Path=BindingContext.LeagueSelectedCommand, Source={x:Reference FixtureListView}}" CommandParameter="{Binding .}"/>
                                              </Grid.GestureRecognizers>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>
                                                <BoxView  Grid.ColumnSpan="2"/>
                                                <StackLayout  Grid.Column="0" Padding="10,0" VerticalOptions="Center" HorizontalOptions="Start">
                                                <Label x:Name="leagueLabel" Text="{Binding ., Converter={StaticResource groupingSelectionConverter}, ConverterParameter={x:Reference leagueLabel}}"
                                                     FontSize="{Binding Key, 
                                                            Converter={StaticResource groupHeaderSizeConverter}}"
                                                     FontAttributes="Bold"
                                                     TextColor="White"/>
                                                </StackLayout>
                                                <StackLayout Grid.Column="1" Padding="10,0" VerticalOptions="Center" HorizontalOptions="EndAndExpand">
                                                <Label Text="{Binding ., Converter={StaticResource groupingSelectionConverter}, ConverterParameter={x:Reference FixtureListView}}"
                                                     FontSize="{Binding Key, 
                                                            Converter={StaticResource groupHeaderSizeConverter}}"
                                                     FontAttributes="Bold"
                                                     TextColor="White"/>
                                                    </StackLayout>
                                          </Grid>
    </Frame>
</Frame>
                                            </StackLayout>
                                        </ViewCell.View>
                                      </ViewCell>
                                  </DataTemplate>
                                </listView:SfListView.GroupHeaderTemplate>
                                </listView:SfListView>
                            
                        </Grid>
                        </tabView:SfTabItem.Content>
                    </tabView:SfTabItem>
                        <tabView:SfTabItem Title="Transfers" SelectionColor="{DynamicResource TextPrimaryColor}" TitleFontColor="Gray">
                           <tabView:SfTabItem.Content>
                        <Grid BackgroundColor="{DynamicResource backgroundColor}"
                              HorizontalOptions="FillAndExpand"
                              VerticalOptions="FillAndExpand" RowSpacing="0">
                            <listView:SfListView IsVisible="{Binding NoTransfers, Converter={StaticResource inverseBooleanConverter}}" x:Name="TransferList"
                                    ItemsSource="{Binding TeamItem.TeamSeasons[0].Transfers}"
                                    ItemTemplate="{StaticResource TransferItemTemplate}"
                                    SelectionMode="None"
                                    HorizontalOptions="FillAndExpand"
                                    VerticalOptions="FillAndExpand"
                                    ItemSpacing="0"
                                     AllowGroupExpandCollapse="True"
                                     IsStickyGroupHeader="True"
                                    SelectionBackgroundColor="{DynamicResource listSelectedBackgroundColor}"
                                    AutoFitMode="Height" >
                    <listView:SfListView.DataSource>
                                  <data:DataSource>
                                    <data:DataSource.SortDescriptors>
                                      <data:SortDescriptor PropertyName="PreviousTeam" Direction="Ascending"/>
                                    </data:DataSource.SortDescriptors>
                                  </data:DataSource>
                                </listView:SfListView.DataSource>
                                    <listView:SfListView.GroupHeaderTemplate>
                                  <DataTemplate>
                                      <ViewCell>
                                        <ViewCell.View>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <BoxView BackgroundColor="LightGray"  Grid.ColumnSpan="2" Opacity=".5"/>
                                                <StackLayout  Grid.Column="0" Padding="10,0" VerticalOptions="Center" HorizontalOptions="Start">
                                                <Label x:Name="leagueLabel" Text="{Binding ., Converter={StaticResource groupingTransferSelectionConverter}, ConverterParameter={x:Reference leagueLabel}}"
                                                     FontSize="{Binding Key, 
                                                            Converter={StaticResource groupHeaderSizeConverter}}"
                                                     FontAttributes="Bold"
                                                     TextColor="{DynamicResource TextPrimaryColor}"/>
                                                </StackLayout>
                                                <StackLayout Grid.Column="1" Padding="10,0" VerticalOptions="Center" HorizontalOptions="EndAndExpand">
                                                <Label Text="{Binding Count}"
                                                     FontSize="14"
                                                     FontAttributes="Bold"
                                                    VerticalOptions="Center" HorizontalOptions="EndAndExpand"
                                                     TextColor="{DynamicResource TextPrimaryColor}">
                                                </Label>
                                                    </StackLayout>
                                          </Grid>
                                        </ViewCell.View>
                                      </ViewCell>
                                  </DataTemplate>
                                </listView:SfListView.GroupHeaderTemplate>
                </listView:SfListView>
            <!--<StackLayout Padding="10"  IsVisible="{Binding NoTransfers}">
                <Label Text="There aren't any transfers" FontSize="Caption" TextColor="{DynamicResource TextPrimaryColor}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
            </StackLayout>-->
                            <extension:NotContentView ActionText="There aren't any transfers"  IsVisible="{Binding NoTransfers}"/>
                        </Grid>
                        </tabView:SfTabItem.Content>
                        </tabView:SfTabItem>
                    </tabView:SfTabView>
                    <StackLayout Grid.Row="2" Padding="0,0,0,0" HeightRequest="45" WidthRequest="200" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand">
                        <Image Source="ontrack_wordmark_reversed" VerticalOptions="CenterAndExpand" Aspect="AspectFit"/>
                    </StackLayout>
                <model:AdMobView Grid.Row="2" VerticalOptions="EndAndExpand" MinimumHeightRequest="50" Size="Standardbanner" />
 <extension:CustomBusyIndicator Grid.Row="1" IsVisible="{Binding IsActivityIndicatorVisible}" />
            </Grid>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
