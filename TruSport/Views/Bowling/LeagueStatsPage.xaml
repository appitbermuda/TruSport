<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:tabView="clr-namespace:Syncfusion.XForms.TabView;assembly=Syncfusion.SfTabView.XForms" xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms" xmlns:data="clr-namespace:Syncfusion.DataSource;assembly=Syncfusion.DataSource.Portable" xmlns:extension="clr-namespace:TruSport.Extensions" xmlns:ff="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms" xmlns:converter="clr-namespace:TruSport.Converters" x:Class="TruSport.Views.Bowling.LeagueStatsPage">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:InverseBooleanConverter x:Key="inverseBooleanConverter"/>
            <converter:BowlingImageConverter x:Key="imageConverter"/>
            <DataTemplate x:Name="PlayerItemTemplate"  x:Key="PlayerItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="Center">
                <Grid x:Name="grid"
                      Padding="1"
                      RowSpacing="1"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">    
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1"/>
                    </Grid.RowDefinitions>
                        <StackLayout Grid.Row="0" Grid.Column="0"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="10,0,0,0">
                                <Label x:Name="PlayerNameLabel"
                                   FontSize="Medium"
                                       Text="{Binding PlayerName}"
                                   TextColor="{DynamicResource TextPrimaryColor}"/>
                        </StackLayout>
                        
                    <StackLayout Grid.Row="1" Grid.Column="0"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="10,0,0,10">
                                <Label x:Name="TeamNameLabel"
                                   FontSize="Micro"
                                       Text="{Binding TeamName}"
                                   TextColor="{DynamicResource TextPrimaryColor}"/>
                        </StackLayout>
                    <StackLayout Grid.RowSpan="2" Grid.Column="1"
                                 VerticalOptions="Center"
                                     HorizontalOptions="EndAndExpand"
                                     Padding="0,0,10,0">
                            <Label x:Name="StatLabel"
                                   FontSize="Large"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   FontAttributes="Bold"
                                   VerticalTextAlignment="Center"
                                   HorizontalOptions="EndAndExpand"
                                        Text="{Binding Stat}"/>
                        </StackLayout>
                    <BoxView Grid.Row="2" HeightRequest="1" Grid.ColumnSpan="2" BackgroundColor="{DynamicResource borderColor}" HorizontalOptions="FillAndExpand"/>
                        </Grid>
                    </StackLayout>
            </DataTemplate>
            <DataTemplate x:Name="TeamItemTemplate"  x:Key="TeamItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="Center">
                    
                <Grid x:Name="grid"
                      Padding="1"
                      RowSpacing="1"
                      ColumnSpacing="5"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">    
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="1"/>
                    </Grid.RowDefinitions>
                    <StackLayout Grid.Row="0" Grid.Column="0"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="10,0,0,0">
                        <Frame HeightRequest="40" WidthRequest="40" CornerRadius="20" Padding="0" HorizontalOptions="Center" VerticalOptions="Center" HasShadow="False" IsClippedToBounds="True">
                        <ff:CachedImage Source="{Binding TeamLogo, Converter={StaticResource imageConverter}}"
                                                        ErrorPlaceholder="bcblogo.png"
                                        LoadingPlaceholder="bcblogo.png"
                                                        CacheDuration="50"
                                                        RetryCount="3"
                                                        RetryDelay="600"
                                        Aspect="AspectFit"
                                        HeightRequest="40"
                                                  WidthRequest="40"
                                                        DownsampleToViewSize="True">  
                                        </ff:CachedImage>
                            </Frame>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="1"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="0">
                                <Label x:Name="PlayerNameLabel"
                                   FontSize="Medium"
                                       Text="{Binding TeamName}"
                                   TextColor="{DynamicResource TextPrimaryColor}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="EndAndExpand"
                                     Padding="0,0,10,0">
                            <Label x:Name="TeamNameLabel"
                                   FontSize="Large"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   FontAttributes="Bold"
                                   VerticalTextAlignment="Center"
                                   HorizontalOptions="EndAndExpand"
                                        Text="{Binding Stat}"/>
                        </StackLayout>
                    <BoxView Grid.Row="1" HeightRequest="1" Grid.ColumnSpan="3" BackgroundColor="White" Opacity=".2" HorizontalOptions="FillAndExpand"/>
                        </Grid>
                    </StackLayout>
            </DataTemplate>
            <DataTemplate x:Name="LeagueHeaderItemTemplate"  x:Key="LeagueHeaderItemTemplate">
              <StackLayout Padding="5,15,5,0">
                <Frame CornerRadius="5" Padding="0" BackgroundColor="Transparent">
                    <Frame IsClippedToBounds="True" CornerRadius="5" Padding="0"  BackgroundColor="{DynamicResource GroupHeaderBackgroundColor}">
                        <Grid VerticalOptions="FillAndExpand" Padding="0,10">
                            <StackLayout  Grid.Column="0" Padding="10,0" VerticalOptions="Center" HorizontalOptions="Start">
                            <Label x:Name="leagueLabel" Text="{Binding .}"
                                    FontSize="Medium"
                                    FontAttributes="Bold"
                                    TextColor="White"/>
                            </StackLayout>
                        </Grid>
                    </Frame>
                </Frame>
                </StackLayout>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <StackLayout Spacing="0"
                     Padding="0"
                     HorizontalOptions="FillAndExpand"
                     VerticalOptions="FillAndExpand">
        <Grid x:Name="PageGrid"
              RowSpacing="0"
              BackgroundColor="{DynamicResource backgroundColor}"
              HorizontalOptions="FillAndExpand"
              VerticalOptions="FillAndExpand">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <tabView:SfTabView Grid.Row="0" VisibleHeaderCount="3"
                TabHeaderBackgroundColor="{StaticResource tabHeaderColor}"
                DisplayMode="Text"
            SelectedIndex="0"
            TabHeight="50"
                                TabHeaderPosition="Top">
                <tabView:SfTabView.SelectionIndicatorSettings>
                        <tabView:SelectionIndicatorSettings Color="{DynamicResource tabIndicatorColor}" 
                                                              Position="Bottom" 
                                                          StrokeThickness="2"/>
                </tabView:SfTabView.SelectionIndicatorSettings>
                                     <tabView:SfTabItem Title="Bowler High Game" TitleFontColor="Gray" SelectionColor="{DynamicResource TextPrimaryColor}">
                        <tabView:SfTabItem.Content>
                            <Grid HorizontalOptions="FillAndExpand" Padding="0,0,0,0"
                              VerticalOptions="FillAndExpand"
                              BackgroundColor="{DynamicResource backgroundColor}"
                              RowSpacing="0">
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                                <listView:SfListView Grid.Row="0" x:Name="PlayerSeasonHGList"
                                ItemsSource="{Binding PlayerSeasonHGCollection}"
                                    ItemTemplate="{StaticResource PlayerItemTemplate}"
                                                     GroupHeaderTemplate="{StaticResource LeagueHeaderItemTemplate}"
                                   SelectionMode="None"
                                                      HorizontalOptions="FillAndExpand"
                                    VerticalOptions="FillAndExpand"
                                   ItemSpacing="0"
                                    SelectionBackgroundColor="White"
                                 AutoFitMode="DynamicHeight"      
                                >
                                    <listView:SfListView.DataSource>
                <data:DataSource>
                    <data:DataSource.SortDescriptors>
                        <data:SortDescriptor PropertyName="LeagueName" Direction="Descending"/>
                    </data:DataSource.SortDescriptors>
                </data:DataSource>
            </listView:SfListView.DataSource>
                                </listView:SfListView>
                                </Grid>
                                </tabView:SfTabItem.Content>
                                </tabView:SfTabItem>
                            <tabView:SfTabItem Title="Bowler High Series" TitleFontColor="Gray" SelectionColor="{DynamicResource TextPrimaryColor}">
                         <tabView:SfTabItem.Content>
                            <Grid HorizontalOptions="FillAndExpand" Padding="0,0,0,0"
                              VerticalOptions="FillAndExpand"
                              BackgroundColor="{DynamicResource backgroundColor}"
                              RowSpacing="0">
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                                <listView:SfListView Grid.Row="0" x:Name="PlayerSeasonHSList"
                                ItemsSource="{Binding PlayerSeasonHSCollection}"
                                    ItemTemplate="{StaticResource PlayerItemTemplate}"
                                                     GroupHeaderTemplate="{StaticResource LeagueHeaderItemTemplate}"
                                   SelectionMode="None"
                                                      HorizontalOptions="FillAndExpand"
                                    VerticalOptions="FillAndExpand"
                                   ItemSpacing="0"
                                    SelectionBackgroundColor="White"
                                 AutoFitMode="DynamicHeight"     
                                >
                                    <listView:SfListView.DataSource>
                <data:DataSource>
                    <data:DataSource.SortDescriptors>
                        <data:SortDescriptor PropertyName="LeagueName" Direction="Descending"/>
                    </data:DataSource.SortDescriptors>
                </data:DataSource>
            </listView:SfListView.DataSource>
                                </listView:SfListView>
                                </Grid>
                                </tabView:SfTabItem.Content>
                                </tabView:SfTabItem>
                <tabView:SfTabItem Title="Team High Game" TitleFontColor="Gray" SelectionColor="{DynamicResource TextPrimaryColor}">
                        <tabView:SfTabItem.Content>
                            <Grid HorizontalOptions="FillAndExpand" Padding="0,0,0,0"
                              VerticalOptions="FillAndExpand"
                              BackgroundColor="{DynamicResource backgroundColor}"
                              RowSpacing="0">
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                                <listView:SfListView Grid.Row="0" x:Name="TeamSeasonHGList"
                                ItemsSource="{Binding TeamSeasonHGCollection}"
                                    ItemTemplate="{StaticResource TeamItemTemplate}"
                                                     GroupHeaderTemplate="{StaticResource LeagueHeaderItemTemplate}"
                                   SelectionMode="None"
                                                      HorizontalOptions="FillAndExpand"
                                    VerticalOptions="FillAndExpand"
                                   ItemSpacing="0"
                                    SelectionBackgroundColor="White"
                                 AutoFitMode="DynamicHeight"      
                                >
                                    <listView:SfListView.DataSource>
                <data:DataSource>
                    <data:DataSource.SortDescriptors>
                        <data:SortDescriptor PropertyName="LeagueName" Direction="Descending"/>
                    </data:DataSource.SortDescriptors>
                </data:DataSource>
            </listView:SfListView.DataSource>
                                </listView:SfListView>
                                </Grid>
                                </tabView:SfTabItem.Content>
                                </tabView:SfTabItem>
                            <tabView:SfTabItem Title="Team High Series" TitleFontColor="Gray" SelectionColor="{DynamicResource TextPrimaryColor}">
                         <tabView:SfTabItem.Content>
                            <Grid HorizontalOptions="FillAndExpand" Padding="0,0,0,0"
                              VerticalOptions="FillAndExpand"
                              BackgroundColor="{DynamicResource backgroundColor}"
                              RowSpacing="0">
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                                <listView:SfListView Grid.Row="0" x:Name="TeamSeasonHSList"
                                ItemsSource="{Binding TeamSeasonHSCollection}"
                                    ItemTemplate="{StaticResource TeamItemTemplate}"
                                                     GroupHeaderTemplate="{StaticResource LeagueHeaderItemTemplate}"
                                   SelectionMode="None"
                                                      HorizontalOptions="FillAndExpand"
                                    VerticalOptions="FillAndExpand"
                                   ItemSpacing="0"
                                    SelectionBackgroundColor="White"
                                 AutoFitMode="DynamicHeight"     
                                >
                                    <listView:SfListView.DataSource>
                <data:DataSource>
                    <data:DataSource.SortDescriptors>
                        <data:SortDescriptor PropertyName="LeagueName" Direction="Descending"/>
                    </data:DataSource.SortDescriptors>
                </data:DataSource>
            </listView:SfListView.DataSource>
                                </listView:SfListView>
                                </Grid>
                                </tabView:SfTabItem.Content>
                                </tabView:SfTabItem>
                            </tabView:SfTabView>
            <StackLayout Padding="10"  IsVisible="{Binding NoConnectivity}">
                <Label Text="There are no stats available" FontSize="Caption" TextColor="{DynamicResource TextPrimaryColor}" HorizontalOptions="Center" HorizontalTextAlignment="Center"  IsVisible="{Binding NoConnectivity}"/>
            </StackLayout>
            <StackLayout Grid.Row="1" Padding="0,0,0,0" HeightRequest="45" WidthRequest="200" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand">
                        <Image Source="ontrack_wordmark_reversed" VerticalOptions="CenterAndExpand" Aspect="AspectFit"/>
                    </StackLayout>
                <!--<model:AdMobView Grid.Row="1"  VerticalOptions="EndAndExpand" MinimumHeightRequest="50" Size="Standardbanner"/>-->
                <!--<ContentView Grid.Row="0" BackgroundColor="{StaticResource primaryDarkBlueTwo}" IsVisible="{Binding IsActivityIndicatorVisible}"/>-->
                
            <extension:CustomBusyIndicator IsVisible="{Binding IsActivityIndicatorVisible}"/>
        </Grid>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
