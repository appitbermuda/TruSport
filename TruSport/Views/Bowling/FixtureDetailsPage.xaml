                    </StackLayout>
                    <StackLayout Grid.Row="0" Grid.Column="2" Orientation="Vertical" VerticalOptions="CenterAndExpand">
                        <StackLayout>
                            <Label Text="{Binding FixtureItem.BowlingScore.AwayTeamMatchPoints}" VerticalOptions="End" HorizontalOptions="Center" TextColor="{DynamicResource TextPrimaryColor}" FontSize="Small"/>
                        </StackLayout>
                    </StackLayout>

                        <StackLayout Grid.Row="1" Grid.Column="0" Orientation="Vertical" VerticalOptions="CenterAndExpand">
                        <StackLayout>
                            <Label Text="{Binding FixtureItem.BowlingScore.HomeTeamPoints}" VerticalOptions="End" HorizontalOptions="Center" TextColor="{DynamicResource TextPrimaryColor}" FontSize="Small" />
                        </StackLayout>
                    </StackLayout>
                        <StackLayout Grid.Row="1" Grid.Column="1" Orientation="Vertical" VerticalOptions="CenterAndExpand">
