                        </StackLayout>
                    </StackLayout>
                    <StackLayout Grid.Row="1" Grid.Column="2" Orientation="Vertical" VerticalOptions="CenterAndExpand">
                        <StackLayout>
                            <Label Text="{Binding FixtureItem.BowlingScore.AwayTeamPoints}" VerticalOptions="End" HorizontalOptions="Center" TextColor="{DynamicResource TextPrimaryColor}" FontSize="Small"/>
                        </StackLayout>
                    </StackLayout>

