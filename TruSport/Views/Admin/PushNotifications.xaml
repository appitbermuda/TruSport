    <ContentPage.Content>
        <StackLayout HorizontalOptions="FillAndExpand"
                  VerticalOptions="FillAndExpand">
            <Grid HorizontalOptions="FillAndExpand"
                  VerticalOptions="FillAndExpand"
                  Padding="10"
                  RowSpacing="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="100"/>
                </Grid.RowDefinitions>
                <StackLayout Grid.Row="0" Orientation="Horizontal"
                             Spacing="10"
                             HorizontalOptions="FillAndExpand"
                             VerticalOptions="FillAndExpand">
                    <inputLayout:SfTextInputLayout Hint="Name"
                                                    ContainerType="None"
                                                   UnfocusedColor="White"
                                                   FocusedColor="White"
                                                   HorizontalOptions="FillAndExpand"
                                                   HelperText="Name of the notification.">
                        <Entry x:Name="NameEntry" Text="{Binding Name}" TextColor="White" />
                    </inputLayout:SfTextInputLayout>
                </StackLayout>
                <StackLayout Grid.Row="1" Orientation="Horizontal"
                             HorizontalOptions="FillAndExpand"
                             VerticalOptions="FillAndExpand">
                    <inputLayout:SfTextInputLayout Hint="Title"
                                                   ContainerType="None"
                                                   UnfocusedColor="White"
                                                   FocusedColor="White"
                                                   HorizontalOptions="FillAndExpand"
                                                   HelperText="Title of the notification (users will see)."
                                                   >
                        <Entry x:Name="TitleEntry" Text="{Binding Title}" TextColor="White"/>
                    </inputLayout:SfTextInputLayout>
                </StackLayout>
                <StackLayout Grid.Row="2" Orientation="Horizontal"
                             HorizontalOptions="FillAndExpand"
                             VerticalOptions="FillAndExpand">
                    <inputLayout:SfTextInputLayout Hint="Message" ContainerType="None"
                                                   UnfocusedColor="White"
                                                   FocusedColor="White"
                                                   HorizontalOptions="FillAndExpand"
                                                   HelperText="Enter the message you want users to see.">
                        <Entry x:Name="BodyEntry" Text="{Binding Body}" TextColor="White"/>
                    </inputLayout:SfTextInputLayout>
                </StackLayout>
                
            </Grid>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
