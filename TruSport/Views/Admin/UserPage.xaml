<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns:local="clr-namespace:TruSport.ViewModels"
             xmlns:data="clr-namespace:Syncfusion.DataSource;assembly=Syncfusion.DataSource.Portable"
             xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             xmlns:converter="clr-namespace:TruSport.Converters" xmlns:extension="clr-namespace:TruSport.Extensions"
             x:Class="TruSport.Views.Admin.UserPage"
             Title="Users"
             Icon="FootballNews24.png">
    <!--<ContentPage.BindingContext>
        <local:UserPageViewModel x:Name="viewModel"/>
    </ContentPage.BindingContext>-->
    <ContentPage.ToolbarItems>
<!--        <ToolbarItem x:Name="AddToolbarItem" Icon="AddNew32.png" Activated="AddClicked" Order="Primary" Priority="1" />-->
<!--<ToolbarItem x:Name="CloseToolbarItem" Icon="Close.png" Activated="CloseClicked" Order="Primary" Priority="0" />-->
    </ContentPage.ToolbarItems>
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:GroupHeaderNameConverter x:Key="groupHeaderNameConverter"/>
            <converter:GroupHeaderSizeConverter x:Key="groupHeaderSizeConverter"/>
            <converter:GroupHeaderFontConverter x:Key="groupHeaderFontConverter"/>
            <converter:IsValidatedConverter x:Key="isValidatedConverter"/>
            <DataTemplate x:Name="UserItemTemplate"  x:Key="UserItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="FillAndExpand" BackgroundColor="{Binding IsValidated, Converter={StaticResource isValidatedConverter}}">
                <Grid x:Name="grid"
                      Padding="0,0"
                      RowSpacing="1"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand"> 
                        <Grid.RowDefinitions>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="1"/>
                        </Grid.RowDefinitions>
                        <StackLayout Grid.Row="0" Spacing="5"
                                     Orientation="Horizontal"
                                 VerticalOptions="CenterAndExpand"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="10,0">
                                <Label x:Name="FirstNameLabel"
                                   FontSize="16"
                                       FontAttributes="Bold"
                                       Text="{Binding FirstName}"
                                   TextColor="White"/>
                            <Label x:Name="LastNameLabel"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                       Text="{Binding LastName}"
                                   TextColor="White"/>
                        </StackLayout>
                        <!--<BoxView Grid.Row="1"
                                 HeightRequest="1"
                                 Opacity=".5"
                                 HorizontalOptions="FillAndExpand"
                                 VerticalOptions="FillAndExpand"
                                 BackgroundColor="{StaticResource primaryDarkBlue}"/>-->
                    <BoxView Grid.Row="1" HeightRequest="1" Opacity=".3" BackgroundColor="White" HorizontalOptions="FillAndExpand" VerticalOptions="EndAndExpand"/>
                        </Grid>
                    </StackLayout>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <ContentPage.Content>
        <StackLayout Spacing="0"
                     Padding="0"
                     HorizontalOptions="FillAndExpand"
                     VerticalOptions="FillAndExpand">
        <Grid x:Name="PageGrid"
              RowSpacing="0"
              BackgroundColor="{StaticResource primaryDarkBlueTwo}"
              HorizontalOptions="FillAndExpand"
              VerticalOptions="FillAndExpand">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
            <StackLayout>
                    <SearchBar BackgroundColor="Transparent"
                               CancelButtonColor="White"
                                                       
                                                       Placeholder="Search"
                                                       PlaceholderColor="LightGray"
                                                       TextColor="White"
                               TextChanged="SearchTextChanged" VerticalOptions="CenterAndExpand"/>
                </StackLayout>
                <listView:SfListView Grid.Row="1" x:Name="UserSyncList"
                                     HorizontalOptions="FillAndExpand"
                                     VerticalOptions="FillAndExpand"
                                     IsStickyGroupHeader="true"
                                     AllowGroupExpandCollapse="true"
                                     SelectionMode="SingleDeselect"
                                     ItemTemplate="{StaticResource UserItemTemplate}"
                                     ItemsSource="{Binding UserCollection}"
                                     ItemSize="48"
                                     TapCommand="{Binding UserSelectedCommand}"
                                     SelectionBackgroundColor="Transparent"
                                     >
                     <listView:SfListView.DataSource>
                                    <data:DataSource>
                                    <data:DataSource.GroupDescriptors>
                                                <data:GroupDescriptor PropertyName="UserType.Name"/>
                                    </data:DataSource.GroupDescriptors>
                                    <!--<data:DataSource.SortDescriptors>
                                      <data:SortDescriptor PropertyName="League.Name" Direction="Descending"/>
                                    </data:DataSource.SortDescriptors>-->
                                  </data:DataSource>
                                </listView:SfListView.DataSource>
                    <!--<listView:SfListView.DataSource>
                                  <data:DataSource>
                                    <data:DataSource.GroupDescriptors>
                                      <data:GroupDescriptor PropertyName="UserTypeName"/>
                                    </data:DataSource.GroupDescriptors>
                                  </data:DataSource>
                                </listView:SfListView.DataSource>-->
                    <listView:SfListView.GroupHeaderTemplate>
                                  <DataTemplate>
                                      <ViewCell>
                                        <ViewCell.View>
                                          <Grid HeightRequest="50" >
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <!--<ColumnDefinition Width="*"/>-->
                                                </Grid.ColumnDefinitions>
                                               <BoxView BackgroundColor="{StaticResource primaryPink}" Opacity=".5"/>
                                              <StackLayout Padding="10,0" VerticalOptions="Center" HorizontalOptions="Start">
                                                <!--<Label x:Name="leagueLabel" Text="{Binding ., Converter={StaticResource groupingSelectionConverter}, ConverterParameter={x:Reference TeamSyncList}}"
                                                     FontSize="{Binding Key, 
                                                            Converter={StaticResource groupHeaderSizeConverter}}"
                                                     FontAttributes="Bold"
                                                    VerticalOptions="Center" HorizontalOptions="Start"
                                                     TextColor="White"/>-->
                                                  <Label Text="{Binding Key, 
                                                            Converter={StaticResource groupHeaderNameConverter}}"
                                                     FontSize="Medium"
                                                     FontAttributes="Bold"
                                                    VerticalOptions="Center" HorizontalOptions="Start"
                                                     HorizontalTextAlignment="Center"
                                                     TextColor="White"/>
                                                  </StackLayout>
                                          </Grid>
                                        </ViewCell.View>
                                      </ViewCell>
                                  </DataTemplate>
                                </listView:SfListView.GroupHeaderTemplate>
                                    <!--<listView:SfListView.GroupHeaderTemplate>
                                  <DataTemplate>
                                      <ViewCell>
                                        <ViewCell.View>
                                    <Grid BackgroundColor="{StaticResource primaryDarkBlue}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                          <StackLayout Padding="10">
                                              <Label Text="{Binding Key, 
                                                            Converter={StaticResource groupHeaderNameConverter}}"
                                                     FontSize="Medium"
                                                     FontAttributes="Bold"
                                                    VerticalOptions="Center" HorizontalOptions="Start"
                                                     HorizontalTextAlignment="Center"
                                                     TextColor="White"/>
                                          </StackLayout>
                                        <StackLayout Padding="10" Grid.Column="1">
                                              <Label Text="{Binding Count}" FontSize="Medium" VerticalOptions="Center" HorizontalOptions="End" HorizontalTextAlignment="End" TextColor="White" />
                                          </StackLayout>
                                        </Grid>
                                        </ViewCell.View>
                                      </ViewCell>
                                  </DataTemplate>
                                </listView:SfListView.GroupHeaderTemplate>-->
                </listView:SfListView>
            <ContentView Grid.Row="1" BackgroundColor="{StaticResource primaryDarkBlueTwo}" IsVisible="{Binding IsActivityIndicatorVisible}"/>
            <extension:CustomBusyIndicator Grid.Row="1" IsVisible="{Binding IsActivityIndicatorVisible}"/>
                </Grid>
            </StackLayout>
    </ContentPage.Content>
</ContentPage>
