<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns:local="clr-namespace:TruSport.ViewModels"
             xmlns:controls="clr-namespace:ImageCircle.Forms.Plugin.Abstractions;assembly=ImageCircle.Forms.Plugin"
             xmlns:data="clr-namespace:Syncfusion.DataSource;assembly=Syncfusion.DataSource.Portable"
             xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             xmlns:converter="clr-namespace:TruSport.Converters" xmlns:ff="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms" xmlns:extension="clr-namespace:TruSport.Extensions"
             x:Class="TruSport.Views.Admin.FixturePage"
             Title="Fixtures"
             Icon="Field.png">
    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="AddToolbarItem" Text="Add" Command="{Binding AddClickedCommand}" Order="Primary" Priority="1" />
<!--        <ToolbarItem x:Name="CloseToolbarItem" Icon="Close.png" Activated="CloseClicked" Order="Primary" Priority="0" />-->
    </ContentPage.ToolbarItems>
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:GameTimeConverter x:Key="gameTimeConverter"/>
            <converter:TimeConverter x:Key="timeConverter"/>
            <converter:TeamNameConverter x:Key="teamNameConverter"/>
            <converter:ImageConverter x:Key="imageConverter"/>
            <converter:GroupHeaderNameConverter x:Key="groupHeaderNameConverter"/>
            <converter:GroupHeaderSizeConverter x:Key="groupHeaderSizeConverter"/>
            <converter:GroupHeaderFontConverter x:Key="groupHeaderFontConverter"/>
            <converter:GroupingSelectionConverter x:Key="groupingSelectionConverter"/>
            <OnPlatform x:TypeArguments="x:String" x:Key="fontFamily" iOS="icomoon" Android="icomoon.ttf#icomoon" />
            <DataTemplate x:Name="PastItemTemplate"  x:Key="PastItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="FillAndExpand">
                <Grid x:Name="grid" Padding="0,10,0,0"
                      RowSpacing="5"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">    
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                            <RowDefinition Height="20" />
                            <RowDefinition Height="50" />
                        <RowDefinition Height="1" />
                    </Grid.RowDefinitions>
                        <StackLayout Grid.Row="0" Grid.Column="0"  Grid.ColumnSpan="3" Spacing="5" Padding="5,2"
                                 VerticalOptions="EndAndExpand"
                                     HorizontalOptions="StartAndExpand"
                                     Orientation="Horizontal">
                            <StackLayout Padding="2">
                                <Label x:Name="FieldIcon"
                                   FontSize="Small"
                                       Text="&#xe901;"
                                       VerticalOptions="Center"
                                   TextColor="White"
                                    FontFamily="{StaticResource fontFamily}"/>
                                </StackLayout>
                            <StackLayout>
                                <Label x:Name="FieldName"
                                   FontSize="Small"
                                   TextColor="White"
                                    Text="{Binding Field.Name}"/>
                                </StackLayout>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="EndAndExpand"
                                     Orientation="Horizontal"
                                 Padding="5,2">
                                <Label x:Name="TimeIcon"
                                   FontSize="Small"
                                   TextColor="White"
                                        Text="&#xe904;"
                                       FontFamily="{StaticResource fontFamily}"/>
                            <Label x:Name="TimeLabel"
                                   FontSize="Small"
                                   TextColor="White"
                                   VerticalTextAlignment="End"
                                        Text="{Binding Time, Converter={StaticResource timeConverter}}"/>
                        </StackLayout>
                    <StackLayout Grid.Row="1" Grid.Column="0" Padding="5,0" HorizontalOptions="Center" VerticalOptions="Center">
                            <!--<controls:CircleImage 
                                                    x:Name="HomeTeamLogo"
                                                    Source="{Binding HomeTeam.TeamLogo, Converter={StaticResource imageConverter}}"
                                                    FillColor="White"
                                                  HeightRequest="30"
                                                  WidthRequest="30"
                                                  
                                                  Aspect="AspectFit" />-->
                        <Frame HeightRequest="40" WidthRequest="40" CornerRadius="20" Padding="0">
                        <ff:CachedImage Source="{Binding HomeTeam.TeamLogo, Converter={StaticResource imageConverter}}"
                                                        ErrorPlaceholder="ontrack.png"
                                        LoadingPlaceholder="ontrack.png"
                                                        CacheDuration="50"
                                                        RetryCount="3"
                                                        RetryDelay="600"
                                        Aspect="AspectFit"
                                        HeightRequest="30"
                                                  WidthRequest="30"
                                                        DownsampleToViewSize="True">  
                                            <!--<ff:CachedImage.Transformations>  
                                                <ffTransformations:CircleTransformation />  
                                            </ff:CachedImage.Transformations>-->  
                                        </ff:CachedImage>
                            </Frame>
                    </StackLayout>
                    <StackLayout Grid.Row="1" Grid.Column="4" Padding="5,0" HorizontalOptions="Center" VerticalOptions="Center">
                            <!--<controls:CircleImage 
                                                  x:Name="AwayTeamLogo"
                                                    Source="{Binding AwayTeam.TeamLogo, Converter={StaticResource imageConverter}}"
                                                    FillColor="White"
                                                  HeightRequest="30"
                                                  WidthRequest="30"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                                  Aspect="AspectFit"/>-->
                        <Frame HeightRequest="40" WidthRequest="40" CornerRadius="20" Padding="0">
                        <ff:CachedImage Source="{Binding AwayTeam.TeamLogo, Converter={StaticResource imageConverter}}"
                                                        ErrorPlaceholder="ontrack.png"
                                        LoadingPlaceholder="ontrack.png"
                                                        CacheDuration="50"
                                                        RetryCount="3"
                                                        RetryDelay="600"
                                        Aspect="AspectFit"
                                        HeightRequest="30"
                                                  WidthRequest="30"
                                                        DownsampleToViewSize="True">  
                                            <!--<ff:CachedImage.Transformations>  
                                                <ffTransformations:CircleTransformation />  
                                            </ff:CachedImage.Transformations>-->  
                                        </ff:CachedImage>
                            </Frame>
                    </StackLayout>
                            <StackLayout Grid.Row="1" Grid.Column="2" VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                         Orientation="Vertical"
                                 Padding="5,2"
                                 Spacing="5">
                            <StackLayout IsVisible="{Binding Match.IsPenalties}" Orientation="Horizontal">
                            <Label x:Name="HomeTeamPenaltyLabel"
                                   FontSize="Micro"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                        Text="{Binding Match.HomeTeamPenalty, StringFormat='({0}'}"/>
                            <Label 
                                   
                                   FontSize="Micro"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                   TextColor="White"
                                        Text="-"/>
                            <Label x:Name="AwayTeamPenaltyLabel"
                                   FontSize="Micro"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                        Text="{Binding Match.AwayTeamPenalty, StringFormat='{0})'}"/>
                                
                        </StackLayout>
                     <StackLayout Orientation="Horizontal">
                            <Label x:Name="HomeTeamScoreLabel"
                                   FontSize="Medium"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                        Text="{Binding Match.HomeTeamScore}"/>
                            <Label 
                                   x:Name="Versus"
                                   FontSize="Small"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                   TextColor="White"
                                        Text="-"/>
                            <Label x:Name="AwayTeamScoreLabel"
                                   FontSize="Medium"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                        Text="{Binding Match.AwayTeamScore}"/>
                                
                        </StackLayout>
                    </StackLayout>
                            <StackLayout Grid.Row="1" Grid.Column="1"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="5,2"
                                 Spacing="0">
                                <Label x:Name="HomeTeamAlias" Text="{Binding HomeTeam.Alias}" IsVisible="false"/>
                            <Label x:Name="HomeTeamNameLabel"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   HorizontalOptions="EndAndExpand"
                                   HorizontalTextAlignment="End"
                                   TextColor="White"
                                        Text="{Binding HomeTeam.Name, Converter={StaticResource teamNameConverter}, ConverterParameter={x:Reference HomeTeamAlias}}"/>
                        </StackLayout>
                            <StackLayout Grid.Row="1" Grid.Column="3"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="5,2"
                                 Spacing="0">
                                <Label x:Name="AwayTeamAlias" Text="{Binding AwayTeam.Alias}" IsVisible="false"/>
                            <Label x:Name="AwayTeamNameLabel"
                                   HorizontalOptions="StartAndExpand"
                                   HorizontalTextAlignment="Start"
                                   FontSize="12"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                        Text="{Binding AwayTeam.Name, Converter={StaticResource teamNameConverter}, ConverterParameter={x:Reference AwayTeamAlias}}"/>
                        </StackLayout>
                    <BoxView HeightRequest="1" BackgroundColor="White" Grid.ColumnSpan="5" Grid.Row="2" Opacity="0.3"/>
                        </Grid>
                    </StackLayout>
            </DataTemplate>
            <DataTemplate x:Name="FixtureItemTemplate"  x:Key="FixtureItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="FillAndExpand"
                             Padding="10,5">
                    <Frame HasShadow="false"
                           CornerRadius="10"
                           Padding="5"
                           BackgroundColor="#ECEFF1">
                <Grid x:Name="grid"
                      Padding="5"
                      RowSpacing="5"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">    
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
<!--                            <RowDefinition Height="25" />-->
                            <RowDefinition Height="20" />
                            <RowDefinition Height="50" />
<!--                            <RowDefinition Height="30" />-->
                    </Grid.RowDefinitions>
                        <StackLayout Grid.Row="0" Grid.Column="0"  Grid.ColumnSpan="2"
                                 VerticalOptions="EndAndExpand"
                                     HorizontalOptions="StartAndExpand"
                                     Orientation="Horizontal"
                                 Padding="0">
                                <Label x:Name="FieldIcon"
                                   FontSize="Small"
                                       Text="&#xe901;"
                                       VerticalOptions="Center"
                                   TextColor="Black"
                                    FontFamily="{StaticResource fontFamily}"/>
                                <Label x:Name="FieldName"
                                   FontSize="Small"
                                   TextColor="Black"
                                    Text="{Binding FieldName}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="EndAndExpand"
                                     Orientation="Horizontal"
                                 Padding="5,2">
                                <Label x:Name="TimeIcon"
                                   FontSize="Small"
                                   TextColor="Black"
                                        Text="&#xe904;"
                                       FontFamily="{StaticResource fontFamily}"/>
                            <Label x:Name="TimeLabel"
                                   FontSize="Small"
                                   TextColor="Black"
                                   VerticalTextAlignment="End"
                                        Text="{Binding Time,
                                                StringFormat='{0:h:mm tt}'}"/>
                        </StackLayout>
                            <controls:CircleImage Grid.Row="1" Grid.Column="0"
                                                    x:Name="HomeTeamLogo"
                                                    Source="{Binding HomeTeamLogo}"
                                                    FillColor="White"
                                                  HeightRequest="30"
                                                  WidthRequest="30"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                                  Aspect="AspectFit"/>
                            <controls:CircleImage Grid.Row="1" Grid.Column="4" 
                                                  x:Name="AwayTeamLogo"
                                                    Source="{Binding AwayTeamLogo}"
                                                    FillColor="White"
                                                  HeightRequest="30"
                                                  WidthRequest="30"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                                  Aspect="AspectFit"/>
                            <StackLayout Grid.Row="1" Grid.Column="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                         Orientation="Horizontal"
                                 Padding="5,2"
                                 Spacing="0">
                            <Label x:Name="HomeTeamScoreLabel"
                                   FontSize="Medium"
                                   FontAttributes="Bold"
                                   TextColor="Black"
                                        Text="{Binding HomeTeamScore}"/>
                            <Label 
                                   x:Name="Versus"
                                   FontSize="Small"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                   TextColor="Black"
                                        Text="-"/>
                            <Label x:Name="AwayTeamScoreLabel"
                                   FontSize="Medium"
                                   TextColor="Black"
                                   FontAttributes="Bold"
                                        Text="{Binding AwayTeamScore}"/>
                                
                        </StackLayout>
                            <StackLayout Grid.Row="1" Grid.Column="1"
                                 VerticalOptions="Center"
                                     HorizontalOptions="StartAndExpand"
                                 Padding="5,2"
                                 Spacing="0">
                            <Label x:Name="HomeTeamNameLabel"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="Black"
                                        Text="{Binding HomeTeamName}"/>
                        </StackLayout>
                            <StackLayout Grid.Row="1" Grid.Column="3"
                                 VerticalOptions="Center"
                                     HorizontalOptions="EndAndExpand"
                                 Padding="5,2"
                                 Spacing="0">
                            <Label x:Name="AwayTeamNameLabel"
                                   FontSize="12"
                                   TextColor="Black"
                                   FontAttributes="Bold"
                                        Text="{Binding AwayTeamName}"/>
                        </StackLayout>
                        </Grid>
                        </Frame>
                    </StackLayout>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <StackLayout Spacing="0"
                     Padding="0"
                     HorizontalOptions="FillAndExpand"
                     VerticalOptions="FillAndExpand">
        <Grid x:Name="PageGrid"
              RowSpacing="0"
              BackgroundColor="{StaticResource primaryDarkBlueTwo}"
              HorizontalOptions="FillAndExpand"
              VerticalOptions="FillAndExpand">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackLayout>
                    <SearchBar BackgroundColor="Transparent"
                               CancelButtonColor="White"
                                                       
                                                       Placeholder="Search"
                                                       PlaceholderColor="LightGray"
                                                       TextColor="White"
                               TextChanged="SearchTextChanged" VerticalOptions="CenterAndExpand"/>
                </StackLayout>
                <!--<listView:SfListView Grid.Row="1" x:Name="FixtureSyncList"
                                     HorizontalOptions="FillAndExpand"
                                     VerticalOptions="FillAndExpand"
                                     IsStickyGroupHeader="true"
                                     AllowGroupExpandCollapse="true"
                                     ItemTemplate="{StaticResource PastItemTemplate}"
                                     ItemsSource="{Binding FixtureCollection}"
                                     ItemSize="100"
                                     ItemTapped="FixtureTapped"
                                     SelectionBackgroundColor="Transparent"
                                     >
                    <listView:SfListView.DataSource>
                                  <data:DataSource>
                                    <data:DataSource.GroupDescriptors>
                                      <data:GroupDescriptor PropertyName="Date"/>
                                    </data:DataSource.GroupDescriptors>
                                  </data:DataSource>
                                </listView:SfListView.DataSource>
                                    <listView:SfListView.GroupHeaderTemplate>
                                  <DataTemplate>
                                      <ViewCell>
                                        <ViewCell.View>
                                          <StackLayout Padding="10,10,0,0" BackgroundColor="{StaticResource primaryDarkBlue}">
                                              <Label Text="{Binding Key, 
                                                            Converter={StaticResource groupHeaderNameConverter}}"
                                                     FontSize="{Binding Key, 
                                                            Converter={StaticResource groupHeaderSizeConverter}}"
                                                     FontAttributes="{Binding Key, 
                                                            Converter={StaticResource groupHeaderFontConverter}}"
                                                    VerticalOptions="Center" HorizontalOptions="Start"
                                                     HorizontalTextAlignment="Center"
                                                     TextColor="White"/>
                                          </StackLayout>
                                        </ViewCell.View>
                                      </ViewCell>
                                  </DataTemplate>
                                </listView:SfListView.GroupHeaderTemplate>
                </listView:SfListView>-->
                <listView:SfListView Grid.Row="1" x:Name="FixtureList"
                                                ItemsSource="{Binding FixturesCollection}"
                                     IsStickyGroupHeader="True"
                                                    HorizontalOptions="FillAndExpand"
                                                    VerticalOptions="FillAndExpand"
                                                    BackgroundColor="{StaticResource primaryDarkBlueTwo}"
                                                    ItemTemplate="{StaticResource PastItemTemplate}"
                                                   SelectionMode="SingleDeselect"
                                                   ItemSpacing="0"
                                                    SelectionBackgroundColor="Transparent"
                                                 ItemSize="92"
                                                 TapCommand="{Binding OnFixtureSelectedCommand}"
                                                 >
                                    <listView:SfListView.DataSource>
                                  <data:DataSource>
                                    <data:DataSource.SortDescriptors>
                                      <data:SortDescriptor PropertyName="Date" Direction="Descending"/>
                                    </data:DataSource.SortDescriptors>
                                  </data:DataSource>
                                </listView:SfListView.DataSource>
                                    <listView:SfListView.GroupHeaderTemplate>
                                  <DataTemplate>
                                      <ViewCell>
                                        <ViewCell.View>
                                          <Grid>
                                              <!--<Grid.GestureRecognizers>
                                                  <TapGestureRecognizer Command="{Binding Path=BindingContext.LeagueSelectedCommand, Source={x:Reference FixtureList}}" CommandParameter="{Binding .}"/>
                                              </Grid.GestureRecognizers>-->
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <!--<ColumnDefinition Width="30"/>-->
                                                </Grid.ColumnDefinitions>
                                              <BoxView BackgroundColor="{StaticResource primaryPink}"  Grid.ColumnSpan="2" Opacity=".5"/>
                                              <!--<BoxView HeightRequest="1" BackgroundColor="{StaticResource primaryPink}"  Grid.ColumnSpan="3"/>-->
                                              <StackLayout Grid.Column="0" Padding="10,0" VerticalOptions="Center" HorizontalOptions="Start">
                                                <Label x:Name="leagueLabel" Text="{Binding ., Converter={StaticResource groupingSelectionConverter}, ConverterParameter={x:Reference leagueLabel}}"
                                                     FontSize="Small"
                                                     FontAttributes="Bold"
                                                    VerticalOptions="Center" HorizontalOptions="Start"
                                                     TextColor="White"/>
                                                  </StackLayout>
                                              <StackLayout Grid.Column="1" Padding="10,0" VerticalOptions="Center" HorizontalOptions="EndAndExpand">
                                                <Label Text="{Binding ., Converter={StaticResource groupingSelectionConverter}, ConverterParameter={x:Reference FixtureList}}"
                                                     FontSize="Small"
                                                     FontAttributes="Bold"
                                                    VerticalOptions="Center" HorizontalOptions="EndAndExpand"
                                                     TextColor="White"/>
                                                  </StackLayout>
                                              <!--<BoxView Grid.Row="2" HeightRequest="1" BackgroundColor="{StaticResource primaryPink}" Grid.ColumnSpan="3" />-->
                                          </Grid>
                                        </ViewCell.View>
                                      </ViewCell>
                                  </DataTemplate>
                                </listView:SfListView.GroupHeaderTemplate>
                                </listView:SfListView>
            <ContentView Grid.Row="1" BackgroundColor="{StaticResource primaryDarkBlueTwo}" IsVisible="{Binding IsActivityIndicatorVisible}"/>
            <extension:CustomBusyIndicator Grid.Row="1" IsVisible="{Binding IsActivityIndicatorVisible}"/>
                </Grid>
            </StackLayout>
    </ContentPage.Content>
</ContentPage>
