<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns:local="clr-namespace:TruSport.ViewModels"
             xmlns:data="clr-namespace:Syncfusion.DataSource;assembly=Syncfusion.DataSource.Portable"
             xmlns:controls="clr-namespace:ImageCircle.Forms.Plugin.Abstractions;assembly=ImageCircle.Forms.Plugin"
             xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             xmlns:converter="clr-namespace:TruSport.Converters"
             x:Class="TruSport.Views.Admin.UserTypePage"
             Title="User Types"
             Icon="UserType.png">
    <ContentPage.BindingContext>
        <local:UserTypeAdminPageViewModel x:Name="viewModel"/>
    </ContentPage.BindingContext>
    <ContentPage.ToolbarItems>
<!--        <ToolbarItem x:Name="AddToolbarItem" Icon="AddNew32.png" Activated="AddClicked" Order="Primary" Priority="1" />-->
<!--        <ToolbarItem x:Name="CloseToolbarItem" Icon="Close.png" Activated="CloseClicked" Order="Primary" Priority="0" />-->
    </ContentPage.ToolbarItems>
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:GroupHeaderNameConverter x:Key="groupHeaderNameConverter"/>
            <converter:GroupHeaderSizeConverter x:Key="groupHeaderSizeConverter"/>
            <converter:GroupHeaderFontConverter x:Key="groupHeaderFontConverter"/>
            <DataTemplate x:Name="UserTypeItemTemplate"  x:Key="UserTypeItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="FillAndExpand">
                <Grid x:Name="grid"
                      Padding="1"
                      RowSpacing="0"
                      ColumnSpacing="5"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand">  
                    <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="1" />
                    </Grid.RowDefinitions>
                        <StackLayout Grid.Row="0"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="10,0"
                                 Spacing="0">
                            <Label x:Name="UserTypeName"
                                   FontSize="16"
                                   TextColor="Black"
                                        Text="{Binding Name}"/>
                        </StackLayout>
                        <BoxView Grid.Row="1"
                                 HeightRequest="1"
                                 BackgroundColor="{StaticResource primaryDarkBlue}"
                                 Opacity=".3"/>
                        </Grid>
                    </StackLayout>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <ContentPage.Content>
        <StackLayout>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <listView:SfListView x:Name="UserTypeSyncList"
                                     HorizontalOptions="FillAndExpand"
                                     VerticalOptions="FillAndExpand"
                                     IsStickyGroupHeader="true"
                                     AllowGroupExpandCollapse="true"
                                     ItemTemplate="{StaticResource UserTypeItemTemplate}"
                                     ItemsSource="{Binding UserTypeCollection}"
                                     ItemSize="60"
                                     ItemTapped="UserTypeTapped"
                                     SelectionBackgroundColor="Transparent"/>
                    
                </Grid>
            </StackLayout>
    </ContentPage.Content>
</ContentPage>
