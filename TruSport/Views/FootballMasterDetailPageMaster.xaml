<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             xmlns:data="clr-namespace:Syncfusion.DataSource;assembly=Syncfusion.DataSource.Portable"
             xmlns:converter="clr-namespace:TruSport.Converters"
             x:Class="TruSport.Views.FootballMasterDetailPageMaster" 
             Icon="menu.png"
             Title="Master">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:GroupHeaderNameConverter x:Key="groupHeaderNameConverter"/>
            <converter:GroupHeaderSizeConverter x:Key="groupHeaderSizeConverter"/>
            <converter:GroupHeaderFontConverter x:Key="groupHeaderFontConverter"/>
            <converter:GroupingSelectionConverter x:Key="groupingSelectionConverter"/>
            <OnPlatform x:TypeArguments="x:String" x:Key="fontAwesomeFamily" Android="fa-light-300.ttf#Font Awesome 5 Pro Light" iOS="FontAwesome5ProLight"  />
        </ResourceDictionary>
    </ContentPage.Resources>
    <StackLayout>
        <Grid RowSpacing="0"  BackgroundColor="{StaticResource primaryDarkBlueTwo}" VerticalOptions="FillAndExpand">
            <Grid.RowDefinitions>
                <RowDefinition Height="150"/>
                <RowDefinition Height="3"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ContentView Grid.Row="0" BackgroundColor="{StaticResource primaryBarBlue}"/>
            <Grid Grid.Row="0" VerticalOptions="CenterAndExpand" Padding="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="80" />
                    </Grid.RowDefinitions>
                <StackLayout Grid.RowSpan="2" Grid.ColumnSpan="3" Padding="50,0">
                    <Image x:Name="LogoImage"
                           Source="ontrack_wordmark_reversed.png"
                           Aspect="AspectFit"
                           VerticalOptions="CenterAndExpand"
                           HorizontalOptions="CenterAndExpand"
                       />
                    </StackLayout>
                    
<!--                    <Label Grid.Column="1" Grid.Row="2" Text="OnTrack" Style="{DynamicResource SubtitleStyle}" />-->
                </Grid>
            <BoxView Grid.Row="1" HeightRequest="3" BackgroundColor="{StaticResource primaryPink}"/>
            <ScrollView Grid.Row="2" BackgroundColor="{StaticResource primaryDarkBlueTwo}" VerticalOptions="FillAndExpand">
                <Grid Grid.Row="0" VerticalOptions="FillAndExpand" Padding="0,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <listView:SfListView Grid.Row="0" HeightRequest="{Binding OnTrackHeight}" x:Name="OnTrackMenuItemsListView" ItemSize="50" ItemsSource="{Binding OnTrackMenuItems}" SelectionBackgroundColor="{StaticResource primaryBarBlue}"
                  BackgroundColor="Transparent">
            <listView:SfListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Grid Padding="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        <Label Grid.Column="0"
                               Text="{Binding IconSource}"
                               HorizontalOptions="CenterAndExpand"
                               VerticalOptions="CenterAndExpand"
                               TextColor="White"
                               FontFamily="{StaticResource fontAwesomeLightFamily}"
                               FontSize="20"/>
                        <StackLayout Grid.Column="1" Padding="15,0" HorizontalOptions="FillAndExpand">
                            <Label VerticalOptions="CenterAndExpand" VerticalTextAlignment="Center" Text="{Binding Title}" FontSize="18" TextColor="White" />
                        </StackLayout>
                            </Grid>
                    </ViewCell>
                </DataTemplate>
            </listView:SfListView.ItemTemplate>
        </listView:SfListView>
                    <StackLayout Grid.Row="1" Padding="10,20,0,0" VerticalOptions="EndAndExpand" IsVisible="{Binding MatchCommissionerVisible}">
                        <Label Text="Match Commissioner" FontSize="Medium" FontAttributes="Bold" TextDecorations="Underline" TextColor="White"/>
                    </StackLayout>
        <listView:SfListView Grid.Row="2"  HeightRequest="{Binding MatchConfigHeight}" x:Name="MatchMenuItemsListView" ItemSize="50" ItemsSource="{Binding MatchMenuItems}" SelectionBackgroundColor="{StaticResource primaryBarBlue}"
                  BackgroundColor="Transparent" IsVisible="{Binding MatchCommissionerVisible}">
            <listView:SfListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Grid Padding="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        <Label Grid.Column="0"
                               Text="{Binding IconSource}"
                               HorizontalOptions="CenterAndExpand"
                               VerticalOptions="CenterAndExpand"
                               TextColor="White"
                               FontFamily="{StaticResource fontAwesomeLightFamily}"
                               FontSize="20"/>
                        <StackLayout Grid.Column="1" Padding="15,0" HorizontalOptions="FillAndExpand">
                            <Label VerticalOptions="CenterAndExpand" VerticalTextAlignment="Center" Text="{Binding Title}" FontSize="18" TextColor="White" />
                        </StackLayout>
                            </Grid>
                    </ViewCell>
                </DataTemplate>
            </listView:SfListView.ItemTemplate>
        </listView:SfListView>
                    <StackLayout Grid.Row="3" Padding="10,20,0,0" VerticalOptions="EndAndExpand" IsVisible="{Binding TeamAdminVisible}">
                        <Label Text="My Team" FontSize="Medium" FontAttributes="Bold" TextDecorations="Underline" TextColor="White"/>
                    </StackLayout>
        <listView:SfListView Grid.Row="4"  HeightRequest="{Binding TeamHeight}" x:Name="TeamMenuItemsListView" ItemSize="50" ItemsSource="{Binding TeamMenuItems}" SelectionBackgroundColor="{StaticResource primaryBarBlue}"
                  BackgroundColor="Transparent" IsVisible="{Binding TeamAdminVisible}">
            <listView:SfListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Grid Padding="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        <Label Grid.Column="0"
                               Text="{Binding IconSource}"
                               HorizontalOptions="CenterAndExpand"
                               VerticalOptions="CenterAndExpand"
                               TextColor="White"
                               FontFamily="{StaticResource fontAwesomeLightFamily}"
                               FontSize="20"/>
                        <StackLayout Grid.Column="1" Padding="15,0" HorizontalOptions="FillAndExpand">
                            <Label VerticalOptions="CenterAndExpand" VerticalTextAlignment="Center" Text="{Binding Title}" FontSize="18" TextColor="White" />
                        </StackLayout>
                            </Grid>
                    </ViewCell>
                </DataTemplate>
            </listView:SfListView.ItemTemplate>
        </listView:SfListView>
                    <StackLayout Grid.Row="5" Padding="10,20,0,0" VerticalOptions="EndAndExpand" IsVisible="{Binding AdminVisible}">
                        <Label Text="Admin" FontSize="Medium" FontAttributes="Bold" TextDecorations="Underline" TextColor="White"/>
                    </StackLayout>
            <listView:SfListView Grid.Row="6" HeightRequest="{Binding AdminHeight}" x:Name="AdminMenuItemsListView" ItemSize="50" ItemsSource="{Binding AdminMenuItems}" SelectionBackgroundColor="{StaticResource primaryBarBlue}"
                  BackgroundColor="Transparent" IsVisible="{Binding AdminVisible}">
            <listView:SfListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Grid Padding="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        <Label Grid.Column="0"
                               Text="{Binding IconSource}"
                               HorizontalOptions="CenterAndExpand"
                               VerticalOptions="CenterAndExpand"
                               TextColor="White"
                               FontFamily="{StaticResource fontAwesomeLightFamily}"
                               FontSize="20"/>
                        <StackLayout Grid.Column="1" Padding="15,0" HorizontalOptions="FillAndExpand">
                            <Label VerticalOptions="CenterAndExpand" VerticalTextAlignment="Center" Text="{Binding Title}" FontSize="18" TextColor="White" />
                        </StackLayout>
                            </Grid>
                    </ViewCell>
                </DataTemplate>
            </listView:SfListView.ItemTemplate>
        </listView:SfListView>
                </Grid>
            </ScrollView>
        <StackLayout Grid.Row="3" x:Name="SignOutLabel" HeightRequest="60" IsVisible="{Binding SignOutVisible}" BackgroundColor="{StaticResource primaryBarBlue}">
            <StackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="SignOutTapped"/>
            </StackLayout.GestureRecognizers>
            <Grid Padding="10" HeightRequest="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        <Label Grid.Column="0"
                               Text=""
                               HorizontalOptions="CenterAndExpand"
                               VerticalOptions="CenterAndExpand"
                               TextColor="White"
                               FontFamily="{StaticResource fontAwesomeLightFamily}"
                               FontSize="20"/>
                        <StackLayout Grid.Column="1" Padding="15,0" HorizontalOptions="FillAndExpand">
                            <Label VerticalOptions="CenterAndExpand" VerticalTextAlignment="Center" Text="Sign Out" FontSize="18" TextColor="White" />
                        </StackLayout>
                            </Grid>
        </StackLayout>
            </Grid>
    </StackLayout>
</ContentPage>
