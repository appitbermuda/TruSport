<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             xmlns:animations="clr-namespace:Rg.Plugins.Popup.Animations;assembly=Rg.Plugins.Popup" xmlns:extensions="clr-namespace:TruSport.Extensions" x:Class="TruSport.Views.SignInPage"
             Title="Sign In">
 <ContentPage.Content>
        <Grid VerticalOptions="FillAndExpand"
              >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="60" />
                <RowDefinition Height="60" />
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
 <StackLayout Grid.Row="0">
           <Image
              HorizontalOptions="Center"
              x:Name="LogoImage"
              Margin="10"
              HeightRequest="250"
              WidthRequest="250">
              <Image.Source>
                <OnPlatform
                  x:TypeArguments="ImageSource"
                  Android="ontrack_wordmark.png"
                  iOS="ontrack_wordmark_.png"
                  />
              </Image.Source>
            </Image>
                </StackLayout>
            <StackLayout Grid.Row="1" Padding="10,5">
            <Entry IsEnabled="true"
              HorizontalOptions="FillAndExpand"
              x:Name="EmailEntry"
              Placeholder="Email"
                    Text="{Binding Email}"
                Keyboard="Email"
                    HeightRequest="50"/>
                </StackLayout>
                <StackLayout Grid.Row="2" Padding="10,5">
            <Entry
              HorizontalOptions="FillAndExpand"
              x:Name="PasswordEntry"
              Placeholder="Password"
              IsPassword="True"
                        Text="{Binding Password}"
                    HeightRequest="50"/>
                </StackLayout>
      <StackLayout Grid.Row="3" Padding="10,5">
            <Label
              HorizontalOptions="CenterAndExpand"
                FontAttributes="Bold"
              x:Name="passwordReset"
              Text="Forgot Password"
                TextColor="{StaticResource primaryBarBlue}"
                BackgroundColor="Transparent"
                    HeightRequest="50"
                TextDecorations="Underline"
                >
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding PasswordResetClickedCommand}"/>
                </Label.GestureRecognizers>
            </Label>
                </StackLayout>
            <StackLayout Grid.Row="4" Padding="10,15"
                         VerticalOptions="EndAndExpand">
          <Button CornerRadius="25"
                  HeightRequest="50"
            BackgroundColor="#2a348d"
                        TextColor="White"
            HorizontalOptions="FillAndExpand"
                        VerticalOptions="End"
            Command="{Binding SignInCommand}"
            x:Name="SigninButton"
                  FontAttributes="Bold"
            Text="Sign In"/>
            </StackLayout>
            <ContentView IsVisible="{Binding IsActivityIndicatorVisible}" Opacity=".3" BackgroundColor="Black" Grid.RowSpan="5"/>
                <extensions:CustomBusyIndicator IsVisible="{Binding IsActivityIndicatorVisible}" Grid.RowSpan="5"/>
        </Grid>
    </ContentPage.Content>
    </ContentPage>
