<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:extensions="clr-namespace:TruSport.Extensions" xmlns:converter="clr-namespace:TruSport.Converters" xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms" xmlns:tabview="clr-namespace:Syncfusion.XForms.TabView;assembly=Syncfusion.SfTabView.XForms" xmlns:abstractions="clr-namespace:ImageCircle.Forms.Plugin.Abstractions;assembly=ImageCircle.Forms.Plugin" xmlns:ff="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms" x:Class="TruSport.Views.MyTeam.TeamFixturePage"
                BackgroundColor="{StaticResource primaryDarkBlueTwo}"
             Title="{Binding TeamName}">
    <ContentPage.Resources>
        <converter:IsNullConverter x:Key="isNullConverter" />
        <converter:ImageConverter x:Key="imageConverter"/>
        <converter:MatchSummaryConverter x:Key="matchSummaryConverter"/>
        <converter:InverseBooleanConverter x:Key="inverseBooleanConverter"/>
        <converter:SelectedTeamConverter x:Key="selectedTeamConverter"/>
            <converter:SelectedTeamBackgroundConverter x:Key="selectedTeamBackgroundConverter"/>
            <converter:SelectedTeamTextConverter x:Key="selectedTeamTextConverter"/>
        <converter:GameTimeConverter x:Key="gameTimeConverter"/>
        <converter:MatchTimeConverter x:Key="matchTimeConverter"/>
            <converter:TimeConverter x:Key="timeConverter"/>
        <converter:SelectedTeamResultConverter x:Key="selectedTeamResultConverter"/>
            <converter:SelectedTeamProfileConverter x:Key="selectedTeamProfileConverter"/>
            <converter:TeamNameConverter x:Key="teamNameConverter" />
        <converter:GroupHeaderNameConverter x:Key="groupHeaderNameConverter"/>
            <converter:GroupHeaderSizeConverter x:Key="groupHeaderSizeConverter"/>
            <converter:GroupHeaderFontConverter x:Key="groupHeaderFontConverter"/>
            <converter:GroupingSelectionFootballConverter x:Key="groupingSelectionConverter"/>
            <converter:FavouriteFontConverter x:Key="favouriteFontConverter"/>
            <converter:FavouriteConverter x:Key="favouriteConverter"/>
        <DataTemplate x:Name="MatchRosterHomeItemTemplate"  x:Key="MatchRosterHomeItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="Center"
                             Padding="0,0"
                             >
                <Grid x:Name="grid"
                      Padding="0,0"
                      RowSpacing="1"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">    
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                            <RowDefinition Height="35" />
                            <RowDefinition Height="1" />
                    </Grid.RowDefinitions>
                    <StackLayout Grid.Row="0" Grid.Column="0"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label x:Name="JerseyNumberLabel"
                                   FontSize="Micro"
                                   TextColor="White"
                                        Text="{Binding JerseyNumber}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="1"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="0">
                                <Label x:Name="FirstNameLabel"
                                   FontSize="Small"
                                       FontAttributes="Bold"
                                       Text="{Binding Player.Name}"
                                   TextColor="White"/>
                            <!--<Label x:Name="LastNameLabel"
                                   FontSize="Small"
                                   FontAttributes="Bold"
                                       Text="{Binding Player.LastName}"
                                   TextColor="White"/>-->
                        </StackLayout>
                    <StackLayout Grid.Row="0" Grid.Column="2" IsVisible="{Binding IsStarter}" HorizontalOptions="EndAndExpand" VerticalOptions="Center" >
                        <BoxView CornerRadius="5" WidthRequest="10" HeightRequest="10" HorizontalOptions="Center" VerticalOptions="Center" BackgroundColor="Green"/>
                    </StackLayout>
                        <BoxView Grid.Row="1" Grid.ColumnSpan="3"
                                         BackgroundColor="White" Opacity="0.1"
                                         HeightRequest="1"/>
                        </Grid>
                        
                    </StackLayout>
            </DataTemplate>
        <DataTemplate x:Name="MatchRosterAwayItemTemplate"  x:Key="MatchRosterAwayItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="Center"
                             Padding="0,0"
                             >
                <Grid x:Name="grid"
                      Padding="0,0"
                      RowSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">    
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                            <RowDefinition Height="35" />
                            <RowDefinition Height="1" />
                    </Grid.RowDefinitions>
                    <StackLayout Grid.Row="0" Grid.Column="2"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label x:Name="JerseyNumberLabel"
                                   FontSize="Micro"
                                   TextColor="White"
                                        Text="{Binding JerseyNumber}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="1"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand"
                                 Padding="0">
                                <Label x:Name="FirstNameLabel"
                                   FontSize="Small"
                                       FontAttributes="Bold"
                                       Text="{Binding Player.Name}"
                                   TextColor="White"/>
                            <!--<Label x:Name="LastNameLabel"
                                   FontSize="Small"
                                   FontAttributes="Bold"
                                       Text="{Binding Player.LafstName}"
                                   TextColor="White"/>-->
                        </StackLayout>
                    <StackLayout Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsStarter}" HorizontalOptions="EndAndExpand" VerticalOptions="Center" >
                        <BoxView CornerRadius="5" WidthRequest="10" HeightRequest="10" HorizontalOptions="Center" VerticalOptions="Center" BackgroundColor="Green"/>
                    </StackLayout>
                        <BoxView Grid.Row="1" Grid.ColumnSpan="3"
                                         BackgroundColor="White" Opacity="0.1"
                                         HeightRequest="1"/>
                        </Grid>
                        
                    </StackLayout>
            </DataTemplate>
        <DataTemplate x:Name="MatchSummaryItemTemplate"  x:Key="MatchSummaryItemTemplate">
                <StackLayout HorizontalOptions="FillAndExpand"
                             VerticalOptions="Center"
                             Padding="0,10"
                             >
                <Grid x:Name="grid"
                      Padding="0,0"
                      RowSpacing="1"
                      ColumnSpacing="1"
                      BackgroundColor="Transparent"
                      VerticalOptions="FillAndExpand"
                      HorizontalOptions="FillAndExpand">    
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackLayout Grid.Column="0" Padding="5,0" IsVisible="{Binding IsHomeTeam}" VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                        <Label Text="{Binding Minute, StringFormat='{0}\''}" TextColor="White" FontAttributes="Bold" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" FontSize="Micro"/>
                    </StackLayout>
                    <StackLayout Grid.Column="1" Padding="5" IsVisible="{Binding IsHomeTeam}"
                                 VerticalOptions="Center"
                                     HorizontalOptions="FillAndExpand">
                            <Label x:Name="HomeTeamPlayer"
                                   FontSize="Small"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                        Text="{Binding PlayerName}"/>
                        <Label x:Name="HomeTeamSubPlayer"
                                   FontSize="Micro"
                                   TextColor="White"
                                   FontAttributes="Bold" IsVisible="{Binding IsSub}"
                                        Text="{Binding SubstitutePlayerName, StringFormat='Off for {0}'}"/>
                        <Label x:Name="HomeTeamAssistPlayer" IsVisible="{Binding AssistPlayerName, Converter={StaticResource isNullConverter}}"
                                   FontSize="Micro"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                        Text="{Binding AssistPlayerName, StringFormat='Assist {0}'}"/>
                        </StackLayout>
                    <StackLayout Grid.Column="2" Padding="5,0">
                        <Label Text="" FontSize="Medium" TextColor="White" IsVisible="{Binding Goal, Converter={StaticResource matchSummaryConverter}}" FontFamily="{StaticResource fontAwesomeSolidFamily}" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"/>
                        <Label Text="" FontSize="Medium" TextColor="White" IsVisible="{Binding IsSub}" FontFamily="{StaticResource fontAwesomeSolidFamily}" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"/>
                        <Label Text="" FontSize="Medium" TextColor="Yellow" IsVisible="{Binding YellowCard, Converter={StaticResource matchSummaryConverter}}" FontFamily="{StaticResource fontAwesomeSolidFamily}" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"/>
                        <Label Text="" FontSize="Medium" TextColor="Red" IsVisible="{Binding RedCard, Converter={StaticResource matchSummaryConverter}}" FontFamily="{StaticResource fontAwesomeSolidFamily}" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"/>
                    </StackLayout>
                    <StackLayout Grid.Column="3" Padding="5" IsVisible="{Binding IsHomeTeam, Converter={StaticResource inverseBooleanConverter}}"
                                 VerticalOptions="Center"
                                     HorizontalOptions="StartAndExpand">
                            <Label x:Name="AwayTeamPlayer"
                                   FontSize="Small"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   Text="{Binding PlayerName}"/>
                        <Label x:Name="AwayTeamSubPlayer"
                                   FontSize="Micro"
                                   TextColor="White"
                                   FontAttributes="Bold" IsVisible="{Binding IsSub}"
                                        Text="{Binding SubstitutePlayerName, StringFormat='Off for {0}'}"/>
                        <Label x:Name="AwayTeamAssistPlayer"
                                   FontSize="Micro"
                                   TextColor="White"
                                   FontAttributes="Bold"  IsVisible="{Binding AssistPlayerName, Converter={StaticResource isNullConverter}}"
                                        Text="{Binding AssistPlayerName, StringFormat='Assist {0}'}"/>
                        </StackLayout>
                        <StackLayout Grid.Column="4" Padding="5,0"  IsVisible="{Binding IsHomeTeam, Converter={StaticResource inverseBooleanConverter}}" VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                        <Label Text="{Binding Minute, StringFormat='{0}\''}" TextColor="White" FontAttributes="Bold" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" FontSize="Micro"/>
                    </StackLayout>
                        </Grid>
                        
                    </StackLayout>
            </DataTemplate>

    </ContentPage.Resources>
    <!--<NavigationPage.TitleView>
         <StackLayout Orientation="Horizontal"
                     HorizontalOptions="FillAndExpand"
                     Padding="0,0,0,0">
