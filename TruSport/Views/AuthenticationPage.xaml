<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             x:Class="TruSport.Views.AuthenticationPage"
             Title="Home"
             BackgroundColor="{StaticResource primaryDarkBlueTwo}">
    <ContentPage.Content>
        <StackLayout>
            <Grid HorizontalOptions="FillAndExpand"
                  VerticalOptions="FillAndExpand">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="100"/>
                </Grid.RowDefinitions>
                
            <StackLayout Grid.RowSpan="3"
                         VerticalOptions="Center" Padding="50,0">
                <Image x:Name="LogoImage"
                       
                       VerticalOptions="Center"
                       HorizontalOptions="Center"
                       Source="ontrack_wordmark_reversed.png"
                       >
                    </Image>
            </StackLayout>
            <StackLayout Grid.Row="2"
                         Padding="10,15"
                         VerticalOptions="EndAndExpand"
                         HorizontalOptions="FillAndExpand" Orientation="Horizontal" Spacing="10">
                <Button CornerRadius="25"
                        HorizontalOptions="FillAndExpand"
                        HeightRequest="50"
                        VerticalOptions="Start"
                        Text="Sign In"
                        TextColor="{StaticResource primaryDarkBlueTwo}"
                        BackgroundColor="White"
                        Clicked="SignInClicked"
                        x:Name="SignInButton"/>
                <Button HorizontalOptions="FillAndExpand"
                        HeightRequest="50"
                        CornerRadius="25"
                        VerticalOptions="Start"
                        Text="Sign Up"
                        TextColor="White"
                        BackgroundColor="#37474F"
                        Clicked="SignUpClicked"
                        x:Name="SignUpButton"/>
            </StackLayout>
                </Grid>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
